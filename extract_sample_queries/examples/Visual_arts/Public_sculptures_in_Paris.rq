#title: Public sculptures in Paris
SELECT DISTINCT ?item ?Titre ?createur (year(?date) as ?AnneeCreation) ?image ?coord
WHERE
{
   ?item wdt:P31/wdt:P279* wd:Q860861.                    # work
   ?item wdt:P136 wd:Q557141 .                            # genre : public art
   {?item wdt:P131 wd:Q90.}                               # ... located in Paris
   UNION
   {?item wdt:P131 ?arr.                                  # ... or in a disctrict of Paris
   ?arr wdt:P131 wd:Q90. }
   ?item rdfs:label ?Titre FILTER (lang(?Titre) = "fr").  # Title

   OPTIONAL {?item wdt:P170 ?Qcreateur.                   # creator (option)
   ?Qcreateur rdfs:label ?createur FILTER (lang(?createur) = "fr") .}
   OPTIONAL {?item wdt:P571 ?date.}                       # date of creation (option)
   OPTIONAL {?item wdt:P18  ?image.}                      # image (option)
   OPTIONAL {?item wdt:P625 ?coord.}                      # geographical coordinate (option)
}
