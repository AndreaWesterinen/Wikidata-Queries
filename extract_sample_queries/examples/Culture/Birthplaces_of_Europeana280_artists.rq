#title: Birthplaces of Europeana280 artists
#defaultView:Map
SELECT ?creator ?creatorLabel ?placebirthLabel ?geoloc where {
  ?item wdt:P31/wdt:P279* wd:Q838948 . # work and sub-class
  ?item wdt:P608 wd:Q20980830 . # of project Europeana 280
  ?item wdt:P170 ?creator . # creator
  ?creator wdt:P19 ?placebirth . # place of birth
  ?placebirth wdt:P625 ?geoloc . # geographical coordinates
  SERVICE wikibase:label {
       bd:serviceParam wikibase:language "fr,es,en" .
    }
}
