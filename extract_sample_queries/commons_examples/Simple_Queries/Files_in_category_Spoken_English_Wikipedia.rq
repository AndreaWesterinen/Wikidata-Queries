# Files in category "Spoken English Wikipedia"
SELECT ?member WHERE {
  BIND("Category:Spoken English Wikipedia" AS ?category) .
  SERVICE wikibase:mwapi {
     bd:serviceParam wikibase:endpoint "commons.wikimedia.org";
                     wikibase:api "Generator";
                     mwapi:generator "categorymembers";
                     mwapi:gcmtype "file"; # if you leave out this line it also returns subcategories and templates
                     mwapi:gcmtitle ?category;
                     mwapi:gcmprop "title";
                     mwapi:gcmlimit "max".
     ?member wikibase:apiOutput mwapi:title.
  }
}
