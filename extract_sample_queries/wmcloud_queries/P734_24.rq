#title: Value shouldn't be an item for families
# Complex constraint from [[Property talk:P734]]
# TODO: split the items, use another value/move statement to P53
SELECT ?item ?itemLabel ?itemDescription
{
	?item wdt:P734 ?fn . ?fn wdt:P31 wd:Q8436 .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" }
}
