SELECT ?item ?l ?l_ru
  (COUNT(DISTINCT ?p) as ?count)
  (SAMPLE(?p) as ?sample_p)
{
    ?item wdt:P407 wd:Q7737 ;
          wdt:P31/wdt:P279? wd:Q101352. 
    [] schema:about ?item ; schema:isPartOf <https://ru.wikipedia.org/> ; schema:name ?l.
    ?item rdfs:label ?l_ru. 
    FILTER (lang(?l_ru) = "ru"  
            && str(?l_ru) != str(?l)
            && str(?l) != CONCAT( str(?l_ru), " (фамилия)")
           ) 
    OPTIONAL { ?p wdt:P734 ?item }
}
GROUP BY ?item ?l ?l_ru
ORDER BY DESC(?count) ?item
