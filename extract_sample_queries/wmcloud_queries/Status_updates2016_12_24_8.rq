#defaultView:Map
SELECT DISTINCT ?item ?itemLabel ?placeLabel ?countryLabel ?coords WHERE {
  ?item wdt:P31/wdt:P279* wd:Q294440 ;
        wdt:P131/wdt:P131 wd:Q90 ;
        wdt:P138 ?place .
  ?place wdt:P625 ?coords ;
         wdt:P1376 ?country .
  ?country wdt:P31 wd:Q3624078 .
  FILTER NOT EXISTS { ?country wdt:P576 ?x }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "fr" . }
} ORDER BY ?placeLabel ?itemLabel
