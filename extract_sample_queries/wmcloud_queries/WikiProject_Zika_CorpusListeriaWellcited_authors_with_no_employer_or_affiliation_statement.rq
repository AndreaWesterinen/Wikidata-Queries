SELECT ?number_of_citations ?item ?itemLabel ?cited_work_example ?cited_work_exampleLabel
WITH {
  # Find works about the topic
  SELECT DISTINCT ?work WHERE {
	  ?work wdt:P921 / (wdt:P361+ | wdt:P1269+ | (wdt:P31* / wdt:P279*) ) wd:Q202864 .
  }
} AS %works
WITH {
  # Find cited works
  SELECT (COUNT(?work) AS ?number_of_citations) ?item (SAMPLE(?cited_work) AS ?cited_work_example)
  WHERE {
    INCLUDE %works
    ?cited_work wdt:P50 ?item . 
    ?work wdt:P2860 ?cited_work .
  } 
  GROUP BY ?item
} AS %result
WHERE {
  # Label the results
  INCLUDE %result
  FILTER NOT EXISTS { ?item wdt:P108 ?employer . }
  FILTER NOT EXISTS { ?item wdt:P1416 ?affiliation . }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en,da,de,es,fr,jp,nl,no,ru,sv,zh". }
} 
ORDER BY DESC(?number_of_citations)
LIMIT 200
