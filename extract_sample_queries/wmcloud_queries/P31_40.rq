#title: Can't be instance of both fictional character and narrative.
# Complex constraint from [[Property talk:P31]]
# Should not be an [[Property:P31|instance of&#32;<small dir="ltr">(P31)</small>]] both a [[d:Q95074|fictional character <small>(Q95074)</small>]] and an [[d:Q1318295|narrative <small>(Q1318295)</small>]]. This is usually caused by conflation between a narrative and the main character that it is named after.
SELECT ?item WHERE { 
  ?item (wdt:P31/(wdt:P279*)) wd:Q95074, wd:Q1318295.
} GROUP BY ?item
