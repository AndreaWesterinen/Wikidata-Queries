SELECT ?item ?itemLabel ?city ?position ?electoraldistrict ?edtype ?starttime ?parliametarygroup ?fbid WHERE { 
    VALUES ?city {wd:Q490 wd:Q220 wd:Q3940419 wd:Q2634 wd:Q495 wd:Q2656 wd:Q1449 wd:Q1891 wd:Q2044 wd:Q3519 wd:Q1903 wd:Q641 wd:Q2028}
    ?city wdt:P31/wdt:P279* wd:Q515 ; 
            wdt:P17 wd:Q38 ;
            wdt:P1313 ?head ;
            wdt:P194 ?council .
    ?council wdt:P1001 ?city .
    ?member wdt:P361 ?council ;
            wdt:P279 wd:Q4175034 .
    MINUS {?member wdt:P576 [] }
    MINUS { ?region wdt:P576 [] }
    MINUS { ?council wdt:P576 [] }
    { ?node ps:P39 ?member } UNION { ?node ps:P39 ?head }
    OPTIONAL { ?node pq:P4100 ?parliametarygroup }
    OPTIONAL { ?node pq:P580 ?starttime }
    OPTIONAL { ?node pq:P768 ?electoraldistrict .
               ?electoraldistrict wdt:P31 ?edtype }
    MINUS { ?node pq:P582 []}
    ?node ps:P39 ?position .
    ?item p:P39 ?node .
    OPTIONAL { ?item wdt:P2013 ?fbid }
    SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
ORDER BY ?item
