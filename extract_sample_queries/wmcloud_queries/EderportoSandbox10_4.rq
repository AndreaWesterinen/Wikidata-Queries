SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity (wdt:P31/(wdt:P279*)) wd:Q1030034; (wdt:P131/wdt:P131) wd:Q40430 . 
  MINUS { ?entity wdt:P31 []; (wdt:P31/(wdt:P279*)) wd:Q1030034; (wdt:P131/wdt:P131) wd:Q40430  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
