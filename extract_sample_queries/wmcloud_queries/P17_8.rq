SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P17 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P580, wd:P1319, wd:P585, wd:P1326, wd:P582, wd:P518, wd:P805, wd:P1310, wd:P2241, wd:P131, wd:P710, wd:P531, wd:P1706, wd:P459, wd:P3831, wd:P828, wd:P1534, wd:P3680, wd:P2868, wd:P7452, wd:P5102, wd:P8555, wd:P8554 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
