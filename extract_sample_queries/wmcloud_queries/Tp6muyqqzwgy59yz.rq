# Title: Works with creator missing link
# Complex constraint from [[Property talk:P3888]]
# List of works that are in [[Property:P195|collection&#32;<small>(P195)</small>]] [[Q679527|Museum Boijmans Van Beuningen <small>(Q679527)</small>]] and have [[Property:P170|creator&#32;<small>(P170)</small>]] set, but that creator doesn't have a [[Property:P3888|Boijmans artist ID&#32;<small>(P3888)</small>]] link
SELECT ?creator ?creatorLabel (COUNT(?item) AS ?count) 
{
	?item wdt:P195 wd:Q679527 .
    ?item wdt:P170 ?creator .
	MINUS { ?creator wdt:P3888 [] } .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en,en" }
} GROUP BY ?creator ?creatorLabel ORDER BY DESC(?count)
