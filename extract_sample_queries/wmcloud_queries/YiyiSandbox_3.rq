SELECT ?grouping (COUNT(DISTINCT ?entity) as ?count) (SAMPLE(?entity) as ?sample) WHERE { ?entity SELECT ?item ?itemLabel ?wlmid ?coordinate_geografiche ?indirizzo_stradale WHERE { ?item (wdt:P131*) wd:Q55036; wdt:P2186 ?wlmid. SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],it". } OPTIONAL { ?item wdt:P625 ?coordinate_geografiche. } OPTIONAL { ?item wdt:P6375 ?indirizzo_stradale. } } ORDER BY (?wlmid). ?entity wdt:P131 ?grouping .} GROUP BY ?grouping HAVING (?count >= 20) ORDER BY DESC(?count) LIMIT 1000
