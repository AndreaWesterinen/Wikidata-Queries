SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P1896 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P1476, wd:P407, wd:P2241, wd:P7452, wd:P1065, wd:P2916, wd:P2960, wd:P518, wd:P400, wd:P348, wd:P393, wd:P580, wd:P582, wd:P17, wd:P1001, wd:P2701, wd:P282, wd:P813 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
