# number of demonstrations per country (but lots of missing or insufficiently linked data)
SELECT ?country ?countryLabel (COUNT(DISTINCT ?demo) AS ?count) WHERE {
  ?demo wdt:P31/wdt:P279* wd:Q175331;
        wdt:P17 ?country.
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
GROUP BY ?country ?countryLabel
ORDER BY DESC(?count)
