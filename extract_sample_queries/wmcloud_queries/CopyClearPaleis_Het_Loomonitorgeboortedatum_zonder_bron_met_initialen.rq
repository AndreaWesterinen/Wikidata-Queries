SELECT DISTINCT ?item (?label AS ?Anl) WHERE {
  ?item rdfs:label ?label.
  ?item wdt:P6379 wd:Q99349995.
  ?item wdt:P31 wd:Q5.
    FILTER NOT EXISTS {
   ?item p:P569 [ ps:P569 ?geboortedatum;
                    prov:wasDerivedFrom 
                    [  ]
                  ].
    }
      ?item wdt:P569 ?geboortedatum.
  SERVICE wikibase:label { bd:serviceParam wikibase:language "nl, en". }
  FILTER((LANG(?label)) = "nl")
  FILTER(REGEX(?label, "^([A-Z][.]?)+ "))
}
