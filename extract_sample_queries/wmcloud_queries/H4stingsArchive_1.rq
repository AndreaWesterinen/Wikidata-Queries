SELECT ?item ?itemLabel ?teamLabel (count(*) as ?count)
WHERE {  	
	?item p:P54 ?teams .
	?teams ps:P54 ?team .
  	?team wdt:P31 wd:Q6979593 .
	SERVICE wikibase:label {
		bd:serviceParam wikibase:language "fr,en" .
	}
} 
GROUP BY ?item ?itemLabel ?teamLabel 
HAVING (?count >= 2)
ORDER BY DESC(?count)
