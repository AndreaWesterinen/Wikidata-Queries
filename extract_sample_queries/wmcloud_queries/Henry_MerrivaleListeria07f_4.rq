SELECT ?item ?itemLabel ?sl
{
  {
       SELECT *
       {
          ?item wdt:P1343 wd:Q602358; wdt:P21 wd:Q6581072; wdt:P31 wd:Q5; wikibase:sitelinks ?sl .
                # wdt:P1343 wd:Q602358; wdt:P21 wd:Q6581097; wdt:P31 wd:Q5; wikibase:sitelinks ?sl .
                # wdt:P1343 wd:Q602358; wdt:P27 wd:Q34266; wikibase:sitelinks ?sl .
                # wdt:P1343 wd:Q602358; wdt:P106 wd:Q1028181 ; wikibase:sitelinks ?sl .
          FILTER NOT EXISTS { [] schema:about ?item ; schema:isPartOf <https://ru.wikipedia.org/> }
       }
  }
  FILTER ( ?sl = 3 ).
  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru, en". }
}
