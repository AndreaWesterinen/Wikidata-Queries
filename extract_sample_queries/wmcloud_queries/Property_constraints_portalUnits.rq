SELECT ?Property_ ?Property_Label ?Property_Description ?unit_ ?unit_Label ?constraint_status_ ?constraint_status_Label
WHERE {
  
	?Property_ p:P2302 ?Unit_statement .
	?Unit_statement ps:P2302 wd:Q21514353 .
	OPTIONAL {?Unit_statement pq:P2305 ?unit_ .}
	OPTIONAL {?Unit_statement pq:P2316 ?constraint_status_ .}

	SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }

} 
