#multi-value constraint report for Was a bee/ConstraintTemplate
SELECT ?item ?itemLabel ?sample ?sampleLabel
{
	{
		SELECT ?item (COUNT(?value) AS ?count) (SAMPLE(?value) AS ?sample) {
			?item wdt:Was a bee/ConstraintTemplate ?value .
		}
		GROUP BY ?item
		HAVING (?count=1)
	}
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en,en" } .
} LIMIT 1000
