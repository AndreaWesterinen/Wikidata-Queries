#title: Individuals with instances and/or subclasses
# Complex constraint from [[Property talk:Q23958946]]
# Individuals with items which are instances (P31) or subclasses (P279) of it.
SELECT distinct ?item WHERE {
  ?item wdt:P31 / wdt:P279? / wdt:P279? / wdt:P279? wd:Q23958946 . # Only 3 levels, for performance reasons.
    [] wdt:P31 | wdt:P279 ?item .
    # Limit, again because performance.
  } LIMIT 400
