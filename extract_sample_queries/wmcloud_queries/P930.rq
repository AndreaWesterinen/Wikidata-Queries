SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P930 [] .
			MINUS {
				VALUES ?classes { wd:Q728937 wd:Q1311958 wd:Q3491904 wd:Q639030 wd:Q870 wd:Q1414135 wd:Q2678338 wd:Q15141321 wd:Q18199879 wd:Q5639 wd:Q19832486 wd:Q811704 wd:Q2516436 wd:Q211382 wd:Q3565868 wd:Q1067164 wd:Q357685 wd:Q1210334 wd:Q29048322 wd:Q22667 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
