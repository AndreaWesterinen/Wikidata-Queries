SELECT ?item ?itemLabel ?value ?valueLabel ?snak ?rank ?statement
WHERE
{
  {
    SELECT ?item ?value ?result ?snak ?rank ?statement WHERE {
      {
        ?item p:P400 ?statement .
        ?statement ps:P400 ?value; wikibase:rank ?rank .
        BIND("mainsnak" AS ?snak) .
      } UNION {
        ?statement pq:P400 ?value; wikibase:rank ?rank .
        ?item ?p1 ?statement .
        BIND("qualifier" AS ?snak) .
      } UNION {
        ?ref pr:P400 ?value .
        ?statement prov:wasDerivedFrom ?ref; wikibase:rank ?rank .
        ?item ?p2 ?statement .
        BIND("reference" AS ?snak) .
      } .
      FILTER( ?value  IN ( wd:Q16991786, wd:Q456078, wd:Q368215, wd:Q725130, wd:Q22907849, wd:Q59510068, wd:Q5520058, wd:Q5519774, wd:Q28444637, wd:Q79576, wd:Q1486288, wd:Q5602848, wd:Q42328566, wd:Q22905933, wd:Q932688, wd:Q135288, wd:Q3070866, wd:Q58379130, wd:Q31708, wd:Q17238705, wd:Q1052025, wd:Q7208667, wd:Q337535, wd:Q7898372, wd:Q94582474, wd:Q49612, wd:Q1204827, wd:Q719629, wd:Q68307628, wd:Q97855206, wd:Q89733596, wd:Q85637878, wd:Q28057499, wd:Q22079967 ) ) .
    } LIMIT 100
  } .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
