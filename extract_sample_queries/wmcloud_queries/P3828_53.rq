SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P3828 [] .
			MINUS {
				VALUES ?classes { wd:Q215627 wd:Q95074 wd:Q4271324 wd:Q4164871 wd:Q28640 wd:Q43229 wd:Q636497 wd:Q14514600 wd:Q10832 wd:Q16334295 wd:Q8473 wd:Q264965 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
