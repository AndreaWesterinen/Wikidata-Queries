SELECT (SAMPLE(DISTINCT ?x) AS ?item) ?w (COUNT(DISTINCT ?x) AS ?c) (STRLEN(?w) AS ?l) WHERE {
  {
    SELECT DISTINCT ?x ?title WHERE {
      ?x wdt:P1476 ?title ; wdt:P50 ?author .
      {?author ?property1 wd:Q213439 .} UNION {?author ?property2 [?property3 wd:Q213439] .}
      FILTER(STRLEN(?title) >= 13)
    }
    LIMIT 100000
  }
  FILTER NOT EXISTS {?x wdt:P921 ?topic}
  BIND(LCASE(?title) AS ?ltitle)
  BIND(REPLACE(?ltitle, "^.*?(\\b\\w{13,}\\b).*$", "$1") AS ?w1)
  BIND(REPLACE(STRAFTER(?ltitle, ?w1), "^.*?(\\b\\w{13,}\\b).*$", "$1") AS ?w2)
  BIND(REPLACE(STRAFTER(?ltitle, ?w2), "^.*?(\\b\\w{13,}\\b).*$", "$1") AS ?w3)
  VALUES ?w_ { 1 2 3 }
  BIND(IF(?w_ = 1, ?w1, IF(?w_ = 2, ?w2, ?w3)) AS ?w)
  FILTER(REGEX(?w, "^\\w+$")) # since ?w may evaluate to en empty string, e.g. for one-word titles
}
GROUP BY ?item ?w
ORDER BY DESC(?c) DESC(?l)
LIMIT 2000
