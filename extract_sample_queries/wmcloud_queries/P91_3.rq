#title: Claims without source
# Complex constraint from [[Property talk:P91]]
# Each P91 claim needs to have at least one (non Wikipedia) source
SELECT DISTINCT ?item { ?item p:P91 ?claim; wdt:P31 wd:Q5 . OPTIONAL { ?claim prov:wasDerivedFrom ?source . ?source ?p ?v . FILTER NOT EXISTS { ?v wdt:P31 wd:Q10876391 } } FILTER(!bound(?source)) }
