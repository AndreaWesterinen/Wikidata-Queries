#title: Check the prize 'Prix du Jockey Club'
# Complex constraint from [[Property talk:P166]]
# Prize for a 3+ years old horse
SELECT ?item ?date ?diff WHERE {
     ?item p:P166 ?statement.
     ?statement ps:P166 wd:Q1129942.
     ?statement pq:P585 ?date.
     ?item wdt:P569 ?born.
     BIND((?date - ?born)/365 AS ?diff).
     FILTER (?diff < 3)
} ORDER BY ?diff
