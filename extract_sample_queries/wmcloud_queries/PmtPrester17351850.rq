#Norske prester født mellom 1734 og 1805 
SELECT ?item ?linkcount WHERE {
  ?item wdt:P106 wd:Q42603;   # occupation: prest
               wdt:P27 wd:Q20;
        wdt:P569 ?birth ;
       wikibase:sitelinks ?linkcount.
  SERVICE wikibase:label { bd:serviceParam wikibase:language "nb,en,nn" }  # labels in bokmål,English
  FILTER("1850-00-00"^^xsd:dateTime > ?birth &&
        "1710-00-00"^^xsd:dateTime <= ?birth )
  FILTER(?linkcount > 1)
}
