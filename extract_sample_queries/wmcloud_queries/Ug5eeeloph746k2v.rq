#defaultView:Map{"layer":"?rankLabel"}
SELECT ?person ?personLabel ?taxon ?taxonLabel ?rank ?rankLabel ?geoloc ?personimage ?taxonimage ?pob ?pobLabel WHERE {
  ?person wdt:P31 wd:Q5 ;
          wdt:P19 ?pob .
  ?taxon wdt:P31 wd:Q16521 ; 
         wdt:P225 ?taxonname ;
         wdt:P105 ?rank ;
         wdt:P138 ?person .
  ?pob wdt:P625 ?geoloc .
  OPTIONAL { ?person wdt:P18 ?personimage }
  OPTIONAL { ?taxon wdt:P18 ?taxonimage }

  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
