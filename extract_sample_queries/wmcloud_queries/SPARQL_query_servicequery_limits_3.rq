PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX p: <http://www.wikidata.org/prop/>
PREFIX v: <http://www.wikidata.org/prop/statement/>
PREFIX q: <http://www.wikidata.org/prop/qualifier/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ps: <http://www.wikidata.org/prop/statement/>
PREFIX psv: <http://www.wikidata.org/prop/statement/value/>

  # Query to return latitudes and longitudes
  # for places with lat/long within 3 degrees of the Arc de Triomphe

    SELECT (COUNT(?a) AS ?count) WHERE {
      
       ?a p:P625 ?statement . # coordinate-location statement
       ?statement psv:P625 ?coordinate_node .
       ?coordinate_node wikibase:geoLatitude ?lat .
       ?coordinate_node wikibase:geoLongitude ?long .
      
       FILTER (ABS(?lat - 48.8738) < 3)
       FILTER (ABS(?long - 2.2950) < 3)
      

       SERVICE wikibase:label {
          bd:serviceParam wikibase:language "en" .
       }
    } ORDER BY DESC(?lat) LIMIT 100
