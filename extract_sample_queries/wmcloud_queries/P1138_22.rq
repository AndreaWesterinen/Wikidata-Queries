#title: Works with creator missing link
# Complex constraint from [[Property talk:P1138]]
# List of works that have [[Property:P2108|Kunstindeks Danmark artwork ID&#32;<small dir="ltr">(P2108)</small>]] set, but that creator doesn't have a [[Property:P1138|Kunstindeks Danmark Artist ID&#32;<small dir="ltr">(P1138)</small>]] link
SELECT ?item ?creator
{
	?item wdt:P2108 [] .
    ?item wdt:P170 ?creator .
	MINUS { ?creator wdt:P1138 [] } .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en,da" }
} ORDER BY ?creatorLabel
