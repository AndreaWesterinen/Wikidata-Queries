SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity wdt:P31 ?grouping.
VALUES ?grouping { wd:Q113025511 wd:Q113015553 } . 
  MINUS { ?entity wdt:P31 []; wdt:P31 ?grouping.
VALUES ?grouping { wd:Q113025511 wd:Q113015553 }  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
