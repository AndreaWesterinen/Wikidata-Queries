#title: Can't be instance of both fictional character and literary work.
# Complex constraint from [[Property talk:P31]]
# Should not be an [[Property:P31|instance of&#32;<small dir="ltr">(P31)</small>]] both a [[d:Q95074|fictional character <small>(Q95074)</small>]] and an [[d:Q7725634|literary work <small>(Q7725634)</small>]]. This is usually caused by conflation between a literary work and the main character that it is named after.
SELECT ?item WHERE { 
  ?item (wdt:P31/(wdt:P279*)) wd:Q95074, wd:Q7725634.
} GROUP BY ?item
