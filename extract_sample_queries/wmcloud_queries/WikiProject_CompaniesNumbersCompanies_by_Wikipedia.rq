SELECT ?wikipediaLabel ?comcount WHERE {
  ?wikipedia wdt:P31 wd:Q10876391 .
  ?wikipedia wdt:P424 ?lang .
  ?wikipedia rdfs:label ?wikipediaLabel 
  FILTER(lang(?wikipediaLabel) = "en") 
  { SELECT ?lang (COUNT(DISTINCT ?company) as ?comcount) WHERE {
    	?company wdt:P31/wdt:P279* wd:Q4830453 .
    	?article schema:about ?company . 
    	?article schema:inLanguage ?lang
    } GROUP BY ?lang 
  }                                       
} ORDER BY DESC (?comcount) LIMIT 15
