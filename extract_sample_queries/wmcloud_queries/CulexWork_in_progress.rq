  ?item wikibase:sitelinks 0; wikibase:identifiers 0 . # no sitelinks, no external identifiers
  OPTIONAL { ?otheritem ?backlink ?item . MINUS { ?otheritem owl:sameAs [] } } FILTER(!BOUND(?backlink)) . # no backlinks from other items
  OPTIONAL { ?item ?p [ prov:wasDerivedFrom [ ?pr [] ] ] . FILTER(?pr NOT IN (pr:P143, pr:P3452)) } FILTER(!BOUND(?p)) . # no references in any claim
  MINUS { ?item wdt:P973|wdt:P1343 [] } # no claims P973 (described by URL) or P1343 (described by source)
