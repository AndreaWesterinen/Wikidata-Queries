#title: Works with creator missing link
# Complex constraint from [[Property talk:P3421]]
# List of works that are in [[Property:P195|collection&#32;<small dir="ltr">(P195)</small>]] [[d:Q303139|Belvedere <small>(Q303139)</small>]] and have [[Property:P170|creator&#32;<small dir="ltr">(P170)</small>]] set, but that creator doesn't have a [[Property:P3421|Belvedere artist ID&#32;<small dir="ltr">(P3421)</small>]] link
SELECT ?item ?url ?creator
{
	?item wdt:P195 wd:Q303139 .
	?item wdt:P170 ?creator .
	MINUS { ?creator wdt:P3421 [] } .
	MINUS { ?item wdt:P170 wd:Q4233718 } . # Filter out anonymous
	OPTIONAL {?item wdt:P973 ?url } .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en,en" }
} ORDER BY ?creatorLabel
