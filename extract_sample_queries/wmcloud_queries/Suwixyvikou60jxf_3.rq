# A list of instance of painting with collection Museu d'Art Jaume Morera, but no inventory number
SELECT ?item ?itemLabel ?creatorLabel WHERE {
  ?item wdt:P31 wd:Q3305213.
  ?item wdt:P195 wd:Q5476145.
  MINUS { ?item wdt:P217 _:b3. }
  OPTIONAL { ?item wdt:P170 ?creator. }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "ca". }
}
  ORDER BY ?creatorLabel
