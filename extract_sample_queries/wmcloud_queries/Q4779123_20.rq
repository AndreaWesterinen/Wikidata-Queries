embed.html##title: films with Aparajita Mohanty missing "original language of film or TV show" (P364)
SELECT DISTINCT ?film ?filmLabel ?filmDescription 
{
  	hint:Query hint:optimizer "None" .
  	?film ?wdt wd:Q4779123 .
  	?property wikibase:directClaim ?wdt ; wikibase:claim ?p ; wikibase:statementProperty ?ps
  	{ ?film wdt:P31/wdt:P279* wd:Q11424 } UNION { ?film wdt:P31 wd:Q5398426 }
    FILTER NOT EXISTS { ?film wdt:P364 [] }   
    SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
