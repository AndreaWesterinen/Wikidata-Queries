SELECT ?item (COUNT(?collection) AS ?count) WHERE {
  ?item wdt:P6379 ?collection.
   wd:Q2717461 wdt:P767 ?collection . #bijgedragen aan een collectie binnen collectiegelderland
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE]". }
}
GROUP BY ?item HAVING ( ?count > 6 )
ORDER BY DESC(?count)
