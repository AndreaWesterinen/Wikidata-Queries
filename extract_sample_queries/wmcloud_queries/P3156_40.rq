SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P3156 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P580, wd:P2676, wd:P400, wd:P582, wd:P2241, wd:P7452, wd:P7367, wd:P1810, wd:P4970, wd:P437, wd:P3803, wd:P518, wd:P1319, wd:P8554, wd:P1326, wd:P10602, wd:P2047 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
