#defaultView:Map
SELECT ?item ?itemLabel ?placeLabel ?departmentLabel ?coords ?image WHERE {
  ?item wdt:P31/wdt:P279* wd:Q493694 ;
        wdt:P17 wd:Q142 ;
        wdt:P131 ?place .
  ?place wdt:P131* ?department .
  ?department wdt:P31 wd:Q6465 .
  ?item wdt:P625 ?coords .
  OPTIONAL { ?item wdt:P18 ?image . }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "fr" . }
} ORDER BY ?departmentLabel ?placeLabel ?itemLabel
