SELECT ?item ?itemLabel ?value ?valueLabel ?instance ?instanceLabel ?snak 
WHERE
{
	{
		SELECT DISTINCT ?item ?value ?instance ?snak {
			{
				?item wdt:P17 ?value .
				BIND("mainsnak" AS ?snak) .
			} UNION {
				?statement0 pq:P17 ?value .
				?item ?p0 ?statement0 .
				BIND("qualifier" AS ?snak) .
			} UNION {
				?ref pr:P17 ?value .
				?statement1 prov:wasDerivedFrom ?ref .
				?item ?p1 ?statement1 .
				BIND("reference" AS ?snak) .
			} .
			MINUS {
				VALUES ?classes { wd:Q3624078 wd:Q1151405 wd:Q2577883 wd:Q15239622 wd:Q26830017 wd:Q148837 wd:Q836688 wd:Q1250464 wd:Q3895768 wd:Q28171280 wd:Q59281 wd:Q6256 wd:Q161243 wd:Q170156 wd:Q3024240 wd:Q7275 wd:Q1145276 wd:Q43702 wd:Q182547 wd:Q48349 wd:Q1896989 wd:Q15304003 wd:Q3238337 } .			
				?value wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?value wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
