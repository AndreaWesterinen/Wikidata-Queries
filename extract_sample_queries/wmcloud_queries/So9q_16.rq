#Lexeme nouns in Swedish that is missing P5137
select ?lexemeId ?lemma WHERE {
  ?lexemeId <http://purl.org/dc/terms/language> wd:Q9027;
            wikibase:lexicalCategory wd:Q1084;
            wikibase:lemma ?lemma;
            ontolex:sense ?sense.
  filter not exists {?sense wdt:P5137 []}.
  filter not exists {?sense wdt:P9970 []}.
}
