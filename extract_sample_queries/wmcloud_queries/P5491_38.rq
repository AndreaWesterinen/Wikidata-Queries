#title: People who died on January 1
# Complex constraint from [[Property talk:P5491]]
#
SELECT ?item ?b ?rank (COALESCE(?url, "") as ?refurl)
WHERE 
{ 
    ?item wdt:P5491 [] .
    OPTIONAL { ?st prov:wasDerivedFrom / pr:P854 ?url }.
    ?item p:P570 ?st .
    ?st psv:P570 [ wikibase:timeValue ?b; wikibase:timePrecision 11 ] . 
    ?st wikibase:rank ?rank .
    FILTER( MONTH(?b) = 1 && DAY(?b) = 1 ) 
    FILTER( wikibase:DeprecatedRank != ?rank )
}
