embed.html#SELECT ?item ?itemLabel ( COUNT(?iedvien) as ?iedv1 ) ( COUNT(?iedvien) - COUNT(DISTINCT ?iedvien) AS ?iedv)
WHERE
{
	?item p:P625/ps:P625 ?iedvien .
	?item wdt:P17 wd:Q668 .
    ?item wdt:P31 wd:Q55488 .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" }
}
GROUP BY ?item ?itemLabel
HAVING (?iedv1 > 1) # for testing
# HAVING (?iedv > 1) # to find actual duplicates
ORDER BY DESC(?iedv) ?itemLabel
