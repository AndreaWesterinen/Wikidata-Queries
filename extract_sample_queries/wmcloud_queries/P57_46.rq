SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P57 [] .
			MINUS {
				VALUES ?classes { wd:Q43099500 wd:Q11424 wd:Q15416 wd:Q24856 wd:Q7889 wd:Q25379 wd:Q2431196 wd:Q26204053 wd:Q14623351 wd:Q106046707 wd:Q58483083 wd:Q15306849 wd:Q35140 wd:Q10688145 wd:Q116779426 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
