SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P1071 [] .
			MINUS {
				VALUES ?classes { wd:Q8205328 wd:Q3231690 wd:Q559026 wd:Q17489659 wd:Q3407658 wd:Q2095 wd:Q10929058 wd:Q17334923 wd:Q386724 wd:Q2031291 wd:Q98142361 wd:Q15306849 wd:Q978 wd:Q43229 wd:Q9779 wd:Q17537576 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
