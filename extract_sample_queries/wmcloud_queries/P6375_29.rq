SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value (LANG(?value) AS ?lang)
WHERE
{
	?item p:P6375 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P580, wd:P582, wd:P585, wd:P7452, wd:P2241, wd:P3831, wd:P669, wd:P670, wd:P1534, wd:P518, wd:P281, wd:P5423, wd:P7532, wd:P8554, wd:P3680, wd:P1310, wd:P1706, wd:P1329, wd:P276, wd:P706, wd:P795, wd:P206, wd:P4595, wd:P9660, wd:P282, wd:P4856, wd:P1814, wd:P2125, wd:P2918 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
