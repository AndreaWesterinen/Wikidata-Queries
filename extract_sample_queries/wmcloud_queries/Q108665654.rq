SELECT ?item ?named ?pages ?auth ?auth_name WHERE {
  ?item wdt:P31 wd:Q5.
  ?item wdt:P1343 wd:Q108665654.
  ?item p:P1343 ?statement.
  OPTIONAL {?statement pq:P1810 ?named ; ps:P1343 wd:Q108665654.}
  OPTIONAL {?statement pq:P304 ?pages ; ps:P1343 wd:Q108665654.}
  OPTIONAL {?statement pq:P50 ?auth ; ps:P1343 wd:Q108665654.}
  OPTIONAL {?statement pq:P2093 ?auth_name ; ps:P1343 wd:Q108665654.}
  }
