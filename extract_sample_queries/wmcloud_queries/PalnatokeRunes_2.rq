SELECT ?grouping (SAMPLE(?_higher_grouping) as ?higher_grouping) (COUNT(DISTINCT ?entity) as ?count) (SAMPLE(?entity) as ?sample) WHERE { ?entity wdt:P31 ?sub0 . ?sub0 wdt:P279* wd:Q7379880. ?entity wdt:P17 ?grouping. OPTIONAL { ?grouping wdt:P276/wdt:P298  ?_higher_grouping } } GROUP BY ?grouping HAVING (?count > 20) ORDER BY DESC(?count) LIMIT 1000
