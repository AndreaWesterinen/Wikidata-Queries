SELECT DISTINCT ?item (sample(?object) as ?art) ?collection
  WITH {
  SELECT ?item ?object ?collection WHERE {
  ?item wdt:P31 wd:Q5.
#  ?item wdt:P106 wd:Q1028181 .
  ?object wdt:P170 ?item.#maker
  ?object wdt:P195 ?collection.
  ?collection wdt:P31/wdt:P279* wd:Q33506.
  } 
  } AS %results
  WHERE {
    INCLUDE %results.
  FILTER NOT EXISTS {?item wdt:P6379 ?collection.}.  
#  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
group by ?item ?collection
LIMIT 100
