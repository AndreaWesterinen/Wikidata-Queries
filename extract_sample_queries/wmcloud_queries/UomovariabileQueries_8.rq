SELECT DISTINCT ?item ?itemLabel ?ISSN ?languageLabel 
WHERE
{
  ?item wdt:P31/wdt:P279* wd:Q5633421.
  ?item wdt:P236 ?ISSN.
  OPTIONAL{?item wdt:P1476 ?title.}
  OPTIONAL{?item wdt:P407 ?language.} 
  FILTER(!bound(?title)) 
  FILTER(!bound(?language)) 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en,fr,de,es". }
  }
ORDER BY ?item 
LIMIT 100
