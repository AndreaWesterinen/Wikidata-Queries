SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity wdt:P31/wdt:P279* wd:Q7075; wdt:P31/wdt:P279* wd:Q811979 . 
  MINUS { ?entity wdt:P17 []; wdt:P31/wdt:P279* wd:Q7075; wdt:P31/wdt:P279* wd:Q811979  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
