SELECT ?item ?itemLabel ?collection ?pages ?creator (GROUP_CONCAT(DISTINCT ?img; SEPARATOR = ",") AS ?images) ?lastUpdate ?versionNo ?image WHERE { ?item wdt:P31 wd:Q109525730; wdt:P361 wd:Q105268778; wdt:P195 ?collection; wdt:P304 ?pages; wdt:P170 ?creator. OPTIONAL { ?item wdt:P6500 ?img. } OPTIONAL { ?item wdt:P18 ?image. } ?item schema:dateModified ?lastUpdate; schema:version ?versionNo. SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". } } GROUP BY ?item ?itemLabel ?collection ?pages ?creator ?lastUpdate ?versionNo ?image ORDER BY DESC (?itemLabel)
