embed.html##defaultView:Map{"hide":["?geo", "?rgb", "?layer"],"markercluster": true}
SELECT DISTINCT ?geo ?xLabel (SAMPLE(?x) AS ?x) (MAX(?population) AS ?population) (SAMPLE(?layer) AS ?layer) WHERE {
  ?x wdt:P31 wd:Q6256 ;
     wdt:P30 wd:Q46 ;
     wdt:P3896 ?geo ;
     wdt:P1082 ?population.
  BIND(
    IF(?population < 5000000, "<5M",
    IF(?population < 10000000, "5M-10M",
    IF(?population < 20000000, "10M-20M",
    IF(?population < 40000000, "20M-40M",
    IF(?population < 80000000, "40M-80M",
    ">80M")))))
    AS ?layer).
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
GROUP BY ?geo ?xLabel
