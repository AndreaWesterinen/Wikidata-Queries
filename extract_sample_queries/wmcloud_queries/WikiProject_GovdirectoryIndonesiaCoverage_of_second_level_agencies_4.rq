SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity wdt:P31 ?type .
  VALUES ?type { wd:Q3199141 wd:Q3191695 wd:Q4272761 }
  MINUS { 
  ?entity p:P31 ?inStatement .
  ?inStatement ps:P31 wd:Q3199141 ; pq:P582 [] .
    }
  MINUS { ?entity wdt:P576 [] . }
  MINUS { ?entity wdt:P1366 [] . } . 
  MINUS { ?entity wdt:P31 []; wdt:P31 ?type .
  VALUES ?type { wd:Q3199141 wd:Q3191695 wd:Q4272761 }
  MINUS { 
  ?entity p:P31 ?inStatement .
  ?inStatement ps:P31 wd:Q3199141 ; pq:P582 [] .
    }
  MINUS { ?entity wdt:P576 [] . }
  MINUS { ?entity wdt:P1366 [] . }  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
