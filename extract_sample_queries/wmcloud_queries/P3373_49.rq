SELECT ?item ?itemLabel ?value ?valueLabel ?instance ?instanceLabel ?snak 
WHERE
{
	{
		SELECT DISTINCT ?item ?value ?instance ?snak {
			{
				?item wdt:P3373 ?value .
				BIND("mainsnak" AS ?snak) .
			} UNION {
				?statement0 pq:P3373 ?value .
				?item ?p0 ?statement0 .
				BIND("qualifier" AS ?snak) .
			} UNION {
				?ref pr:P3373 ?value .
				?statement1 prov:wasDerivedFrom ?ref .
				?item ?p1 ?statement1 .
				BIND("reference" AS ?snak) .
			} .
			MINUS {
				VALUES ?classes { wd:Q215627 wd:Q95074 wd:Q21070598 wd:Q4271324 wd:Q178885 wd:Q26843 wd:Q57812611 wd:Q876500 wd:Q36341 wd:Q144 wd:Q726 wd:Q839769 wd:Q301676 wd:Q26401003 wd:Q26513 wd:Q24577840 } .			
				?value wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?value wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
