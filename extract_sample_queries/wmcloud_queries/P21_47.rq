#title: Unsourced notname gender
# Complex constraint from [[Property talk:P21]]
# People with [[Property:P31|instance of&#32;<small dir="ltr">(P31)</small>]] set to [[d:Q1747829|notname <small>(Q1747829)</small>]] with an unsourced [[Property:P21|sex or gender&#32;<small dir="ltr">(P21)</small>]] set to [[d:Q6581097|male <small>(Q6581097)</small>]]
SELECT ?item WHERE {
  ?item wdt:P31 wd:Q1747829 .
  ?item p:P21 ?genderstatement .
  ?genderstatement ps:P21 wd:Q6581097 .
  MINUS { ?genderstatement prov:wasDerivedFrom ?source }.
} LIMIT 1000
