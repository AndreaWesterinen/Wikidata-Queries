#title: In the Museum without a link
# Complex constraint from [[Property talk:P4674]]
# Items that have [[Property:P195|collection&#32;<small dir="ltr">(P195)</small>]] -> [[d:Q1117704|Indianapolis Museum of Art <small>(Q1117704)</small>]], but that don't have a [[Property:P4674|Indianapolis Museum of Art artwork ID&#32;<small dir="ltr">(P4674)</small>]] link
SELECT DISTINCT ?item ?url WHERE {
  ?item wdt:P195 wd:Q1117704 .
  OPTIONAL { ?item wdt:P973 ?url } . 
  MINUS { ?item wdt:P4674 [] } .
}  LIMIT 500
