#by CamelCaseNick
prefix commons:<http://commons.wikimedia.org/wiki/Special:FilePath/>

select (?stolperstein as ?item) ?nameImage ?addressImage ?quarterImage
with {
  select distinct ?stolperstein ?nameImage ?addressImage ?quarterImage where {
    ?stolperstein wdt:P31 wd:Q26703203;
                  wdt:P131+ wd:Q1055;
                  wdt:P18 ?image.

    bind(wikibase:decodeUri(replace(str(?image), str(commons:), "")) as ?title)

    values (?nameGroup ?addressGroup ?quarterGroup ?regex) {
      ("$1" "$2" "$3" "^((?:[\\p{L}\\d\\.]+[\\- ]|'\\p{L}+' )*[\\p{L}\\d]+)(?: \\(Jg\\. 1\\d{3}\\))? ?[\\-–] ((?:\\p{L}+\\.?[ \\-/])*\\p{L}+\\.?(?: \\d+(?:[a-z](?: ?[–-] ?[a-z])?| ?[\\-–] ?\\d+| Ecke \\p{L}+)?)?) \\(([\\p{L}\\- \\.]+)\\)(?:\\.| )Stolperstein(e| 20\\d{2}|\\-\\d{4}\\-\\d{2}\\-\\d{2})?(\\.\\d+)?(\\.(nnw|(crop\\.)?ajb|ccn))?\\.jpg$")
      ("$2" "$1" "$3" "^(?:Stolpersteine? )?((?:(?:\\p{L}+\\.?[ \\-/])*\\p{L}+\\.?(?: ?\\d+(?: ?[a-zA-Z]|[\\-–]\\d+)?)?))(?: \\(\\d\\)| HH)?[ -]\\( *((?:[\\p{L}\\d]+[\\-\\.,]? ?)*[\\p{L}\\d]+) *\\)(?: ?[Ii]n)? ([\\p{L}\\. \\-]+?)(?: ?\\((?:\\d+|neu)\\)| ?\\d+)?(?: ShiftN)?\\.(jpg|JPG|jpeg)$")
      ("$1" "$2" "$3" "^Stolperstein für ((?:\\p{L}+ )*\\p{L}+) (?:in der|im) ((?:(?:\\p{L}+\\.?[ \\-/])*\\p{L}+\\.?(?: ?\\d+(?: ?[a-zA-Z]|[\\-–]\\d+)?)?)) in ([\\p{L}\\. \\-]+?)\\.(jpg|JPG|jpeg)$")
    }

    filter(regex(?title, ?regex))

    bind(replace(?title, ?regex, ?nameGroup) as ?nameImage)
    bind(replace(?title, ?regex, ?addressGroup) as ?addressImage)
    bind(replace(?title, ?regex, ?quarterGroup) as ?quarterImage)
  }
} as %matches
with {
  select ?stolperstein ?nameImage ?addressImage ?quarterImage where {
    include %matches.

    filter(exists {
      ?stolperstein skos:altLabel|rdfs:label ?alias.
      filter(lang(?alias) = "de")
      filter(regex(?alias, "^Stolperstein für (?!den|die|das)"))

      filter(replace(replace(replace(replace(replace(replace(replace(?alias, "ß", "ss"), "Ü", "Ue"), "Ö", "Oe"), "Ä", "Ae"), "ü", "ue"), "ö", "oe"), "ä", "ae")
             = strlang(replace(replace(replace(replace(replace(replace(replace(concat("Stolperstein für ", ?nameImage), "ß", "ss"), "Ü", "Ue"), "Ö", "Oe"), "Ä", "Ae"), "ü", "ue"), "ö", "oe"), "ä", "ae"), "de")
            || replace(replace(replace(replace(replace(replace(replace(replace(?alias, "^.+ ([^ ]+)$", "$1"), "ß", "ss"), "Ü", "Ue"), "Ö", "Oe"), "Ä", "Ae"), "ü", "ue"), "ö", "oe"), "ä", "ae")
             = strlang(replace(replace(replace(replace(replace(replace(replace(?nameImage, "ß", "ss"), "Ü", "Ue"), "Ö", "Oe"), "Ä", "Ae"), "ü", "ue"), "ö", "oe"), "ä", "ae"), "de"))
    } || not exists {
      ?stolperstein skos:altLabel|rdfs:label ?alias.
      filter(lang(?alias) = "de")
      filter(regex(?alias, "^Stolperstein für (?!den|die|das)"))
    } || regex(?nameImage, "^I(V|I{0,2})$"))

    filter(exists {
      ?stolperstein p:P6375/ps:P6375 ?address.
      filter(regex(?address, "^((\\p{L}+\\.?[ \\-/])*\\p{L}+\\.?( \\d+( ?[a-z](?:( – |–|/)[a-z])?)?(( – |–|/)\\d+( [a-z])?)?)?), \\d{5} Hamburg$"))

      bind(replace(?address, "^((\\p{L}+\\.?[ \\-/])*\\p{L}+\\.?( \\d+( ?[a-z](?:( – |–|/)[a-z])?)?(( – |–|/)\\d+( [a-z])?)?)?), \\d{5} Hamburg$", "$1") as ?addr)
      filter(strstarts(replace(replace(replace(replace(replace(replace(replace(replace(lcase(?addr), "ß", "ss"), "ü", "ue"), "ö", "oe"), "ä", "ae"), "\\s", ""), "str(asse|\\.)", "str"), "(ggue\\.?|gegenueber)", "ggue"), "[–\\-]", ""), 
             strlang(replace(replace(replace(replace(replace(replace(replace(replace(lcase(?addressImage), "ß", "ss"), "ü", "ue"), "ö", "oe"), "ä", "ae"), "\\s", ""), "str(asse|\\.)", "str"), "(ggue\\.?|gegenueber)", "ggue"), "[–\\-]", ""), "de")))
    } || not exists {
      ?stolperstein p:P6375/ps:P6375 ?address.
      filter(!contains(?address, " Ecke "))
    })

    filter exists {
      ?stolperstein p:P276/ps:P276 ?quarter.
      ?quarter wdt:P31 wd:Q15830667;
               skos:altLabel|rdfs:label ?alias.
      filter(lang(?alias) = "de")
      filter(?alias = strlang(replace(replace(replace(replace(?quarterImage, "Hamburg |hamburg-|HH-", "Hamburg-"), "Groß-Borstel", "Groß Borstel"), "St Pauli|St\\.Pauli|St\\. pauli", "St. Pauli"), "Rothenbaum", "Rotherbaum"), "de"))
    }
  }
} as %perfect
where {
  include %matches.
  minus {
    include %perfect.
  }
}
