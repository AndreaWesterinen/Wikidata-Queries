SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P3721 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P580, wd:P582, wd:P459, wd:P2241, wd:P1476, wd:P7452, wd:P1534, wd:P366, wd:P1319, wd:P8555, wd:P8554, wd:P1326, wd:P968, wd:P3575 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
