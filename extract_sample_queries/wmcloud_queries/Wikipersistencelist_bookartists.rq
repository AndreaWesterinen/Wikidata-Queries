SELECT ?item ?itemLabel ?occupationLabel ?viaf ?lcn ?employerLabel ?edLabel
WHERE
{
  ?item wdt:P106 wd:Q56884373 . 
  OPTIONAL {?item wdt:P106 ?occupation .}
  OPTIONAL {?item wdt:P214 ?viaf}
  OPTIONAL {?item wdt:P244 ?lcn}
  OPTIONAL {?item wdt:P108 ?employer}
  OPTIONAL {?item wdt:P69 ?ed}

    SERVICE wikibase:label { bd:serviceParam wikibase:language "en" }
}
ORDER BY ?itemLabel
