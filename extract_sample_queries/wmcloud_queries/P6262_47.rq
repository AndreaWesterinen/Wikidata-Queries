SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P6262 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P407, wd:P1810, wd:P1433, wd:P958, wd:P580, wd:P582, wd:P4241, wd:P1319, wd:P8554, wd:P8555, wd:P1326, wd:P1932, wd:P5102, wd:P805, wd:P3680, wd:P1310, wd:P1480, wd:P459, wd:P9675, wd:P6833, wd:P1065, wd:P2960, wd:P2241, wd:P7452, wd:P1534, wd:P7528, wd:P1476 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
