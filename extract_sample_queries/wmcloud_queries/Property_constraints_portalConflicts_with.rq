SELECT ?Property_ ?Property_Label ?Property_Description ?property_ ?property_Label ?conflicting_ ?conflicting_Label ?constraint_status_ ?constraint_status_Label
WHERE {
  
	?Property_ p:P2302 ?Conflicts_with_statement .
	?Conflicts_with_statement ps:P2302 wd:Q21502838 .
	OPTIONAL {?Conflicts_with_statement pq:P2306 ?property_ .}
	OPTIONAL {?Conflicts_with_statement pq:P2305 ?conflicting_ .}
	OPTIONAL {?Conflicts_with_statement pq:P2316 ?constraint_status_ .}

	SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }

} 
