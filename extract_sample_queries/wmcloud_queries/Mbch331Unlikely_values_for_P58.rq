select distinct ?item ?itemLabel ?person ?personLabel ?humancheck ?humancheckLabel WHERE
{
  ?item wdt:P58 ?person .
  OPTIONAL {?person wdt:P31 ?humancheck .}
  FILTER(?humancheck NOT IN (wd:Q5,wd:Q159979,wd:Q2985549,wd:Q10648343,wd:Q6934877,wd:Q16017119,wd:Q61002,wd:Q3046146,wd:Q14073567,wd:Q14756018,wd:Q127843))
  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "nl,en" . 
   } 
} 
ORDER BY ?person
