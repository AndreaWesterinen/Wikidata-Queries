SELECT DISTINCT ?season ?seasonLabel (URI(CONCAT("https://www.metacritic.com/", ?metacritic, "/season-", ?number)) as ?metacriticSeason)
WHERE {
  BIND(wd:Q147235 AS ?series)
  ?season wdt:P31 wd:Q3464665 ;
          p:P179 [
            ps:P179 ?series ;
            pq:P1545 ?number
          ] .
  ?series wdt:P1712 ?metacritic .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
ORDER BY ?number
