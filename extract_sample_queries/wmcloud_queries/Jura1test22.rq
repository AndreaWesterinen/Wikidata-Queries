SELECT ?item (GROUP_CONCAT(CONCAT("[",str(?sitelink)," ", ?lang,"]"); separator=", ") as ?t)  WHERE {  { ?item wdt:P31 wd:Q506240 . } UNION { ?item wdt:P31 wd:Q20667187 . } UNION { ?item wdt:P31 wd:Q226730 . } UNION { ?item wdt:P31 wd:Q11424 . } UNION { ?item wdt:P31 wd:Q24869 . } . ?item wdt:P364 wd:Q150 . ?sitelink schema:about ?item . ?sitelink schema:inLanguage ?lang . BIND(xsd:integer(STRAFTER(str(?item), "Q")) AS ?qid) . FILTER NOT EXISTS { ?wfr <http://schema.org/about> ?item . ?wfr <http://schema.org/inLanguage> "fr" }   } 
GROUP BY ?item ORDER BY DESC(?qid) LIMIT 450
