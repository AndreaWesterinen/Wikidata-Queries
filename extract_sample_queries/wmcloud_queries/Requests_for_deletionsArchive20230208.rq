SELECT DISTINCT ?s ?sLabel ?badClassLabel (COUNT(?sLink) AS ?sitelinks)
WHERE {
  # STARTING ITEMS
  VALUES ?s { wd:Q35314258 wd:Q50712073 wd:Q50713296 wd:Q104916342 wd:Q107264148 wd:Q107264621 wd:Q107268622 wd:Q107273780 wd:Q107273850 wd:Q107553043 wd:Q107640472 wd:Q107640634 wd:Q107640835 wd:Q107646681 wd:Q107985930 wd:Q107989421 wd:Q108121173 wd:Q108129807 wd:Q108129836 wd:Q108191383 wd:Q108220439 wd:Q108220516 wd:Q108220574 wd:Q108226138 wd:Q108226197 wd:Q108263139 wd:Q108263600 wd:Q108333657 wd:Q108335148 wd:Q108421990 wd:Q108422035 wd:Q108422056 wd:Q110761752 wd:Q111035047 wd:Q111035368 wd:Q111073109 wd:Q111194968 wd:Q111203299 wd:Q113358938 wd:Q114960598 wd:Q114960660 wd:Q114968007 wd:Q115974452 wd:Q115974498 wd:Q115974603 wd:Q116267333 wd:Q116267737 wd:Q116457527 }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
  OPTIONAL { ?sLink schema:about ?s ; schema:isPartOf ?project . }
  
  ?s wdt:P31 ?badClass . # by adding "/wdt:P79" it will crash
  values ?badClass { wd:Q187456 wd:Q11707 wd:Q570116 wd:Q194195 wd:Q1021711 wd:Q1757063 wd:Q96622175 wd:Q5643 wd:Q654772 wd:Q11410 wd:Q27686 wd:Q35872 }

  filter not exists {
    ?s ?propOK ?any. values ?propOK { wdt:P3503 wdt:P2186 }
  }
}
GROUP BY ?s ?sLabel ?badClassLabel
ORDER BY DESC(?numLink) ?badClassLabel
