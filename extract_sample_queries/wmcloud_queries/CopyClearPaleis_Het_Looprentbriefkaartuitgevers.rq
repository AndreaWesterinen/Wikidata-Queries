SELECT DISTINCT ?item ?objectsoort ?titel WHERE {
  ?item rdfs:label ?label.
  ?item wdt:P6379 wd:Q99349995.
  ?item wdt:P31 wd:Q5.
  FILTER NOT EXISTS {?item wdt:P7763 [].}
   ?item p:P6379 [ ps:P6379 wd:Q99349995;
                    prov:wasDerivedFrom 
                    [ pr:P3865 wd:Q569843; #prentbriefkaart
                      pr:P1476 ?titel;
                    ]
                  ].
}
