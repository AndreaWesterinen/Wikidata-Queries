SELECT DISTINCT ?item ?first ?count ?gn
WITH
{
SELECT ?first (COUNT(?item0) as ?count) (SAMPLE(?item0) as ?item)
{
    hint:Query hint:optimizer "None".
    VALUES ?c { wd:Q38 wd:Q172579 wd:Q238 wd:Q4948 wd:Q174306 wd:Q170174 wd:Q173065 wd:Q188586 wd:Q153529 wd:Q148540 wd:Q736727   } 
    ?item0 wdt:P27 ?c .
    FILTER NOT EXISTS { ?item0 p:P735 [] } 
    ?item0 rdfs:label ?l . 
    FILTER( lang(?l) = "it" ) 
    BIND( strbefore( ?l, " ") as ?first) 
}
GROUP BY ?first 
HAVING ( ?count > 2)          
} as %a         
WHERE
{
  INCLUDE %a
  FILTER NOT EXISTS { [] rdfs:label ?first ; wdt:P31/wdt:P279? wd:Q202444 ; wdt:P407 wd:Q652 }
  OPTIONAL { ?gn rdfs:label ?first ; wdt:P31/wdt:P279? wd:Q202444  }
  FILTER( ?first != "") 
}
ORDER BY DESC(?count)
