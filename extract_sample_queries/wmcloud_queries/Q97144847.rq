SELECT ?item ?named ?pages ?vol ?section WHERE {
  ?item wdt:P31 wd:Q5.
  ?item wdt:P1343 wd:Q97144847.
  ?item p:P1343 ?statement.
OPTIONAL{  ?statement pq:P1810 ?named ; ps:P1343 wd:Q97144847.}
OPTIONAL{    ?statement pq:P304 ?pages ; ps:P1343 wd:Q97144847.}
OPTIONAL{    ?statement pq:P478 ?vol ; ps:P1343 wd:Q97144847.}
OPTIONAL{    ?statement pq:P958 ?section ; ps:P1343 wd:Q97144847.}

  }
