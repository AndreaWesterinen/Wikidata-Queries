# Map of branches services by the 8 POIs in The Netherlands, layered by POI
#defaultView:Map
SELECT ?Qvestiging ?QvestigingLabel ?coor ?partof ?partofLabel ?image ?layer WHERE {
#SELECT ?s ?sLabel ?coor ?image ?layer WHERE { 
  
       ?Qvestiging wdt:P31/wdt:P279* wd:Q28564 ;
          wdt:P17 wd:Q55 ;
          wdt:P625 ?coor ;
          wdt:P361 ?partof ;
          OPTIONAL {?Qvestiging wdt:P18 ?image .}
  
VALUES ?partof {

wd:Q59940713 #Biblionet Groningen
wd:Q620739	#Stichting ZB Planbureau en Bibliotheek van Zeeland

#wd:Q #ProBiblio (Noord- en Zuid-Holland)
#wd:Q #Rijnbrink Groep (Overijssel en Gelderland)
#wd:Q #Cubiss (Noord-Brabant en Limburg)
#wd:Q #Bibliotheekservice Fryslân
#wd:Q #Biblionet Drenthe
#wd:Q #BiSC (Utrecht)
                }
BIND( 
IF(?partof = wd:Q59940713, "Biblionet Groningen",
IF(?partof = wd:Q620739,   "Stichting ZB Planbureau en Bibliotheek van Zeeland",
              "")) AS ?layer).  
  
SERVICE wikibase:label { bd:serviceParam wikibase:language "nl" }
}
ORDER BY ?layer ?partofLabel ?QvestigingLabel
