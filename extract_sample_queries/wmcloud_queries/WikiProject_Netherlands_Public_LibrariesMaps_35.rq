#Flevoland
wd:Q59961895 #St. OB Almere
wd:Q59962143 #St. FlevoMeer Bieb
# Utrecht  
wd:Q59962322 #St. de Bieb Utrecht
wd:Q59962182 #St. Bieb Nieuwegein
wd:Q24040756 #St.Bibliotheken Eemland
wd:Q59962328 #St. OB Veenendaal
# Noord-Holland 
wd:Q2105660 #St. OBs Amsterdam
wd:Q59961890 #St. Bieb Zuid-Kennemerlnd
wd:Q59962072 #St. OB Heiloo
wd:Q59961947 #St. Westfriese Biebs
wd:Q57591817 #St.OB Haarlemmermeer
wd:Q59962110 #St.OB Huizen-Laren-Blaricum
wd:Q59962125 #St.OB Langedijk
wd:Q59961935 #St OB IJmond Noord
wd:Q59962113 #St. Bieb Velsen
wd:Q59961887 # St. OB Kennemerwaard
wd:Q59961900 #St.Amstellnd Bieb
                 }
BIND(
#Overijssel
IF(?partof = wd:Q59961892, "Almelo", 
IF(?partof = wd:Q59961993, "Hengelo",
IF(?partof = wd:Q59962018, "Enschede",
IF(?partof = wd:Q59961944, "Borne",
IF(?partof = wd:Q59962201, "Ommen",
IF(?partof = wd:Q59962070, "Hardenberg",
IF(?partof = wd:Q59962197, "Oldenzaal",
IF(?partof = wd:Q59962068, "Haaksbergen",
IF(?partof = wd:Q59962149, "Losser",
IF(?partof = wd:Q59962232, "Rijssen en Holten",
IF(?partof = wd:Q59962279, "Staphorst",
IF(?partof = wd:Q59962395, "Wierden",
IF(?partof = wd:Q59962228, "Raalte en Olst-Wijhe",
IF(?partof = wd:Q59962190, "Hellendoorn-Nijverdal",
