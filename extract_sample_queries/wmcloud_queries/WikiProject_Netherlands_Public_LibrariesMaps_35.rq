#Flevoland
IF(?partof = wd:Q59961895, "Almere",
IF(?partof = wd:Q59962143, "Dronten, Lelystad, Noordoostpolder, Urk en Zeewolde",
# Utrecht  
IF(?partof = wd:Q59962322, "Utrecht",
