#defaultView:Map
SELECT DISTINCT ?item ?itemlabel ?coor ?image ?r
{
	?item wdt:P31 wd:Q39715 . 
	?item wdt:P131/wdt:P131* wd:Q25 .
	OPTIONAL { ?item wdt:P625 ?coor }
	OPTIONAL { ?item wdt:P18 ?image }  
	OPTIONAL { ?item rdfs:label ?itemlabel . FILTER(lang(?itemlabel)="cy")  }  
	OPTIONAL { ?item wdt:P131/wdt:P131* ?r . ?r wdt:P31 wd:Q15979307 }
}
