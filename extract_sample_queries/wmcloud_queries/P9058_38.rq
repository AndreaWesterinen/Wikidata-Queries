#title: Related to France
# Complex constraint from [[Property talk:P9058]]
#
SELECT ?item ?lieu ?born {
  ?item p:P9058 [];
        wdt:P19 ?born;
        wdt:P20 ?lieu.
  FILTER (?lieu = wd:Q142)
  MINUS { ?lieu wdt:P131/wdt:P17 wd:Q142 }. # mort en France
  #MINUS { ?born wdt:P131 wd:Q142 }
  MINUS { ?born wdt:P131/wdt:P17 wd:Q142 }
  #FILTER (?item NOT IN (wd:Q1978366, wd:Q3169439)) # exception : dont Maroc
  MINUS { ?item wdt:P27 wd:Q142 }
}
