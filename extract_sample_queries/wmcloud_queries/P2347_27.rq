SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P2347 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P1810, wd:P4970, wd:P585, wd:P580, wd:P582, wd:P131, wd:P518, wd:P3831, wd:P2241, wd:P1932, wd:P4390, wd:P9570, wd:P8327, wd:P4070, wd:P7452, wd:P1365, wd:P1366, wd:P5017, wd:P9729, wd:P6607, wd:P2668 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
