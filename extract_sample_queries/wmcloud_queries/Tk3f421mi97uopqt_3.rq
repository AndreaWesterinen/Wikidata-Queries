SELECT DISTINCT ?actorLabel ?characterLabel WHERE {
  { [] p:P161 [
      ps:P161 ?actor;
      pq:P453 ?character
    ].
  } UNION {
    ?character wdt:P175 ?actor.
  }
  ?character wdt:P31/wdt:P279* wd:Q95074.
  ?actor wdt:P570 ?died.
  FILTER(?died >= NOW()-"P50D"^^xsd:duration).
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
ORDER BY ?actor
