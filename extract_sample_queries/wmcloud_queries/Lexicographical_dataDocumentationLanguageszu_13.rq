select ?lexemeId ?lemma WHERE {
  ?lexemeId <http://purl.org/dc/terms/language> wd:Q10179.
  {
  SELECT DISTINCT ?lexemeId WHERE {
      {
        ?lexemeId p:P31 ?statement0.
        ?statement0 (ps:P31/(wdt:P279*)) wd:Q489168.
      }
      UNION
      {
        ?lexemeId p:P5713 ?statement1.
        ?statement1 (ps:P5713/(wdt:P279*)) wd:Q489168.
      }
	UNION
	{
	  ?lexemeId  wikibase:lexicalCategory wd:Q489168;
	}
    } 
  }
  ?lexemeId wikibase:lemma ?lemma.
}
