select distinct (?l as ?item) (concat(replace(str(?l),str(wd:),"{{L|"),"}}") as ?l_) ?lemma ?aux {
  ?l dct:language wd:Q7737;
     wikibase:lexicalCategory wd:Q24905;
     wikibase:lemma ?lemma.
  minus { ?l wdt:P31 wd:Q60655 }
  minus { ?l wdt:P31 wd:Q4129241 }
  minus { ?l wdt:P31 wd:Q70235 }
} order by ?lemma
