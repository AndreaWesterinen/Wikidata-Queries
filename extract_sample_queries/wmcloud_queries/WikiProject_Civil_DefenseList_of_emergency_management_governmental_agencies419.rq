SELECT DISTINCT ?item WHERE {
  VALUES ?in_latam {
    wd:Q77
    wd:Q96
    wd:Q155
    wd:Q241
    wd:Q298
    wd:Q414
    wd:Q419
    wd:Q717
    wd:Q733
    wd:Q736
    wd:Q739
    wd:Q750
    wd:Q774
    wd:Q783
    wd:Q786
    wd:Q790
    wd:Q792
    wd:Q800
    wd:Q804
    wd:Q811
    wd:Q1183
    wd:Q25228
    wd:Q781
    wd:Q244
    wd:Q242
    wd:Q25305
    wd:Q784
    wd:Q769
    wd:Q766
    wd:Q13353
    wd:Q13353
    wd:Q763
    wd:Q760
    wd:Q757
    wd:Q730
    wd:Q778
    wd:Q754
    wd:Q18221
    wd:Q734
  }
  ?item wdt:P101 wd:Q1460420;
    (p:P31/ps:P31/(wdt:P279*)) wd:Q327333;
    wdt:P17 ?in_latam.
  OPTIONAL { ?item wdt:P17 ?country. }
  OPTIONAL { ?item wdt:P2541 ?operating_area. }
  OPTIONAL { ?item wdt:P856 ?official_website. }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en,de,fr,ru,es,ja,zh,ar". }
}
LIMIT 2000
