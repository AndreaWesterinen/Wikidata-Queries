#title: The Czech Republic is used as country of citizenship for people dead before 1969-01-01
# Complex constraint from [[Property talk:Q213]]
# Items with [[Property:P27|country of citizenship&#32;<small dir="ltr">(P27)</small>]] equal to [[d:Q213|Czech Republic <small>(Q213)</small>]] and [[Property:P570|date of death&#32;<small dir="ltr">(P570)</small>]] before 1969-01-01
SELECT DISTINCT ?item WHERE {
  ?item wdt:P27 wd:Q213 .
  ?item p:P570 [ psv:P570 ?node; wikibase:rank ?rank ] .
  FILTER(?rank != wikibase:DeprecatedRank) .
  ?node wikibase:timeValue ?born .
  ?node wikibase:timePrecision ?precision .
  FILTER (?born < "1969-01-01T00:00:00Z"^^xsd:dateTime)
  FILTER (?precision >= "9"^^xsd:integer)
}
