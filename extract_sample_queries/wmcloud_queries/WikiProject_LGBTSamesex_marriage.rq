SELECT DISTINCT ?item ?time ?image
{
  {
    SELECT ?item ?time {
      ?item (wdt:P31 | wdt:P279) wd:Q17422;
                wdt:P580 ?time.
    }
  }
  UNION {
    SELECT ?item ?time {
      ?item wdt:P31 |wdt:P279 wd:Q17422;
            wdt:P585 ?time.
    }
  }
  OPTIONAL{
    ?item wdt:P18 ?image.
  }
}
