SELECT DISTINCT ?item ?itemlabel
 (CONCAT("{","{subst:Urltowiki\u007Curl=", str(?itemart), "}","}") As ?wp) ?instance ?instancelabel ?field ?fieldlabel ?wpfieldarticle ?malelabel
 WHERE { BIND("ar" as ?lang) . 
?item wdt:P3321 ?malelabel . 
FILTER(lang(?malelabel)= ?lang )
 ?item wdt:P31 ?instance . 
OPTIONAL { ?itemart <http://schema.org/about> ?item . FILTER(SUBSTR(str(?itemart), 1, 30) = "https://ar.wikipedia.org/wiki/") } 
OPTIONAL { ?item wdt:P425 ?field  . SERVICE wikibase:label { bd:serviceParam wikibase:language "ar" . ?field rdfs:label ?fieldlabel } 
OPTIONAL { ?fieldarticle <http://schema.org/about> ?field . FILTER(SUBSTR(str(?fieldarticle), 1, 30) = "https://ar.wikipedia.org/wiki/") 
BIND(CONCAT("{","{subst:Urltowiki\u007Curl=", str(?fieldarticle), "}","}") As ?wpfieldarticle) } } 
SERVICE wikibase:label { bd:serviceParam wikibase:language "ar" .
 ?item rdfs:label ?itemlabel.
?instance rdfs:label ?instancelabel
 } . }
 ORDER BY ?malelabel
