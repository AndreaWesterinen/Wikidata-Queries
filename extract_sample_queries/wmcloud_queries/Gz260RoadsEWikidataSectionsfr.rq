SELECT DISTINCT ?item ?itemLabel ?article (IF(bound(?article),CONCAT("{","{subst:Urltowiki\u007Curl=", str(?article), "\u007Cdisplay=", str(?itemLabel), "}","}"),str(?itemLabel)) As ?wparticle) WHERE { { ?item wdt:P16 wd:Q106123 . } UNION { ?item wdt:P31 wd:Q106123 . } . ?item wdt:P361 ?part . ?part wdt:P16 wd:Q106123 . OPTIONAL { ?item wdt:P1824 ?p1824 } BIND(REPLACE(REPLACE(str(?p1824),"-","")," ","") as ?p1824r) BIND(STRLEN(str(?p1824r)) as ?longp1824) BIND(SUBSTR(str(?p1824r),1,1) as ?statut) BIND(SUBSTR(str(?p1824r),2,(?longp1824 - 1)) as ?numero) BIND(REPLACE(SUBSTR(str(?numero),1,4),"[A-Za-z]","") as ?num) BIND(STRLEN(str(?num)) as ?longnum) BIND(CONCAT(IF(?longnum=1,"000",IF(?longnum=2,"00",IF(?longnum=3,"0",""))), str(?num)) as ?numz) BIND(CONCAT(str(?statut),str(?num)) as ?numsp) BIND(STRLEN(str(?numsp)) as ?longnumsp) BIND((?longp1824 - ?longnumsp) as ?longprefixe) BIND(SUBSTR(str(?p1824r),(?longnumsp + 1),?longprefixe) as ?prefixe) BIND(CONCAT(str(?statut),str(?numz),str(?prefixe)) as ?cledetri) .  OPTIONAL { SELECT DISTINCT ?item (COUNT(?pays) as ?count) WHERE { { ?item wdt:P16 wd:Q106123 . } UNION { ?item wdt:P31 wd:Q106123 . } . ?item wdt:P17 ?pays . } GROUP BY ?item } . OPTIONAL { ?article schema:about ?item ; schema:inLanguage "fr" ; schema:isPartOf <https://fr.wikipedia.org/> } SERVICE wikibase:label { bd:serviceParam wikibase:language "fr" . } } ORDER BY ?cledetri ?longnum DESC(?count)
