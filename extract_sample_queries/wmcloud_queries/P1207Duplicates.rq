SELECT ?item ?item2 (REPLACE(CONCAT('[', ?formatter, ' $1]'), '\\$1', ?nukat) AS ?url) WITH {
  SELECT * {
    ?item wdt:P1207/^wdt:P1207 ?item2 .
    FILTER( STR( ?item ) < STR( ?item2 ) ) .
  }
} AS %duplicates WITH {
  SELECT * { wd:P1207 wdt:P1630 ?formatter } LIMIT 1
} AS %formatter WHERE {
  INCLUDE %duplicates .
  INCLUDE %formatter .
  ?item wdt:P1207 ?nukat .
  ?item2 wdt:P1207 ?nukat .
} ORDER BY ?nukat
