SELECT DISTINCT ?item ?itemLabel ?geboortedatum WHERE {
  ?item wdt:P31 wd:Q5.
  ?item (wdt:P106/wdt:P279*) wd:Q3391743.
   ?item wdt:P569 ?geboortedatum.
   OPTIONAL { ?item wdt:P570 ?sterfdatum. }
  {
    ?item wdt:P19 ?pob.
    ?pob wdt:P17 wd:Q55.
  }
  UNION
  {
    ?item wdt:P937 ?pow.
    ?pow wdt:P17 wd:Q55.
  }
  UNION
  {
    ?item wdt:P551 ?por.
    ?por wdt:P17 wd:Q55.
  }
  UNION
  {
    ?item wdt:P937 ?pod.
    ?pod wdt:P17 wd:Q55.
  }
  FILTER (?geboortedatum > "1970-01-01T10:20:13+05:30"^^xsd:dateTime)
  FILTER NOT EXISTS{ ?item wdt:P856 ?website. }
}
