#title: Labels in English would generally be different from Catalan (ca)
# Complex constraint from [[Property talk:P2358]]
# output: item with English label, English label, Catalan label
SELECT ?item ?en ?ca
{
  ?item wdt:P2358 [ ] ; wdt:P31 wd:Q5 .
  ?item rdfs:label ?en . FILTER( lang(?en) = "en" ) 
  ?item rdfs:label ?ca . FILTER( lang(?ca) = "ca" ) 
  FILTER( str(?en) = str(?ca) )
}
LIMIT 1000
