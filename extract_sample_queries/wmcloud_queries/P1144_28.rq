SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P1144 [] .
			MINUS {
				VALUES ?classes { wd:Q3331189 wd:Q2217301 wd:Q11424 wd:Q24862 wd:Q34508 wd:Q571 wd:Q87167 wd:Q1641020 wd:Q732577 wd:Q7094076 wd:Q35127 wd:Q162827 wd:Q4006 wd:Q187947 wd:Q3302947 wd:Q482994 wd:Q169930 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
