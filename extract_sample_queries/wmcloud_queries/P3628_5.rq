embed.html#SELECT ?prop ?propLabel ?count ?sample ?sampleLabel ?sample_value WHERE {
    {
        SELECT ?prop (COUNT(DISTINCT ?item) AS ?count) (SAMPLE(?item) AS ?sample) (SAMPLE(?p) AS ?p) WHERE {
           
           hint:Query hint:optimizer "None" .
           ?item wdt:P3628 [] .
           ?item ?p ?id .
           ?prop wikibase:directClaim ?p .
#           {?prop wdt:P31 wd:Q19847637}  # Wikidata property representing a unique identifier 
#             UNION
#           {?prop wdt:P31 wd:Q19595382}  # Wikidata property for authority control for people
           
          
        }  GROUP BY ?prop
    }
  
    ?sample ?p ?sample_value
           
    SERVICE wikibase:label {
        bd:serviceParam wikibase:language "en" .
    }

} ORDER BY DESC (?count)
