embed.html#SELECT ?movie ?order ?movieLabel ?locationLabel ?premiereDate WHERE {
  ?movie p:P179 [ps:P179 wd:Q2732470; pq:P1545 ?order] .
  ?movie p:P793 [ps:P793 wd:Q204854; pq:P276 ?location; pq:P585 ?premiereDate] .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
} ORDER BY ?premiereDate
