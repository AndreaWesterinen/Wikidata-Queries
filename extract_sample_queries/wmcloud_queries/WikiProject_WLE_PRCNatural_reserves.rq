SELECT ?item ?itemLabelEn ?itemLabelZh ?province ?provinceLabelEn ?provinceLabelZh WHERE {   ?item wdt:P31 wd:Q179049;         wdt:P17 wd:Q148 .   ?item rdfs:label ?itemLabelEn, ?itemLabelZh         FILTER(LANG(?itemLabelEn) = 'en' && LANG(?itemLabelZh) = 'zh').      ?item wdt:P131* ?province .     ?province wdt:P31/wdt:P279* wd:Q13396669               FILTER NOT EXISTS {?province wdt:P31 wd:Q779415}     FILTER (?province != wd:Q57251).      ?province rdfs:label ?provinceLabelEn, ?provinceLabelZh               FILTER(LANG(?provinceLabelEn) = 'en' && LANG(?provinceLabelZh) = 'zh'). }
