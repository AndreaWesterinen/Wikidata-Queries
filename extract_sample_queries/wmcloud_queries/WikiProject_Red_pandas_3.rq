#Red pandas

SELECT ?itemLabel ?item
WHERE 
{
  ?item wdt:P31 wd:Q41960. 
  MINUS {?item wdt:P551 []}
 # OPTIONAL {?item wdt:P20 ?pod}.
#  OPTIONAL {?item wdt:P551 ?por}.
 # OPTIONAL {?pob wdt:P625 ?coord}.
  #OPTIONAL {?pod wdt:P625 ?coord}.
  #OPTIONAL {?por wdt:P625 ?coord}.
  SERVICE wikibase:label { bd:serviceParam wikibase:language "fr, en". }
}
