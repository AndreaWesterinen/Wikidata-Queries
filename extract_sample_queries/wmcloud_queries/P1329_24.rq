SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P1329 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P585, wd:P580, wd:P582, wd:P366, wd:P3005, wd:P518, wd:P6001, wd:P2241, wd:P7452, wd:P1319, wd:P8555, wd:P8554, wd:P1326, wd:P642, wd:P1552, wd:P1810, wd:P2936, wd:P3025, wd:P3026, wd:P3831, wd:P2360 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
