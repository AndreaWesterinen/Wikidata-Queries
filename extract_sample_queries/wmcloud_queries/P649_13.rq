#title: Items who don't have a ressource type
# Complex constraint from [[Property talk:P649]]
# Items that do have [[d:Q19558910|National Register of Historic Places listed place <small>(Q19558910)</small>]] in [[Property:P1435|heritage designation&#32;<small dir="ltr">(P1435)</small>]], but not the qualifier [[Property:P2868|subject has role&#32;<small dir="ltr">(P2868)</small>]] with [[d:Q47162123|NRHP building <small>(Q47162123)</small>]], [[d:Q20856087|NRHP district <small>(Q20856087)</small>]], [[d:Q47162146|NRHP structure <small>(Q47162146)</small>]],  [[d:Q47162186|NRHP site <small>(Q47162186)</small>]] or [[d:Q47162172|NRHP object <small>(Q47162172)</small>]].
SELECT ?item WHERE { ?item wdt:P1435 wd:Q19558910 . MINUS { ?item p:P1435 [ ps:P1435 wd:Q19558910 ; pq:P2868 [] ] } } LIMIT 1000
