SELECT ?item ?named ?pages ?auth (CONCAT("[[:w:de:",?lemma,"]]") AS ?wikipedia) WHERE {
  ?item wdt:P31 wd:Q5.
  ?item wdt:P1343 wd:Q101064178.
  ?item p:P1343 ?statement.
  OPTIONAL {?statement pq:P1810 ?named ; ps:P1343 wd:Q101064178.}
  OPTIONAL {?statement pq:P304 ?pages ; ps:P1343 wd:Q101064178.}
  OPTIONAL {?statement pq:P50 ?auth ; ps:P1343 wd:Q101064178.}  
  OPTIONAL {?sitelink schema:about ?item;
    schema:isPartOf <https://de.wikipedia.org/>;
    schema:name ?lemma.  }
  }
