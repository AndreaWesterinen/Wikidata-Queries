embed.html##TEMPLATE={ "template": { "en": "streets in ?city with gender of the person they’re named after", "de": "Straßen in ?city mit Geschlecht der Person, nach der sie benannt sind" }, "variables": { "?city": { "query": "SELECT DISTINCT ?id WHERE { ?id wdt:P31/wdt:P279* wd:Q1549591; wdt:P1082 ?population. } ORDER BY DESC(?population) LIMIT 100" } } }
#defaultView:Map{"layer": "?genderLabel", "hide": ["?coordinates", "?genderLabel"]}
SELECT DISTINCT ?street ?streetLabel ?coordinates ?image ?eponym ?eponymLabel ?genderLabel WHERE {
  hint:Query hint:optimizer "None".
  BIND(wd:Q64 AS ?city)
  ?street wdt:P131+ ?city;
          wdt:P31/wdt:P279* wd:Q83620.
  OPTIONAL { ?street wdt:P625 ?coordinates. }
  OPTIONAL { ?street wdt:P18 ?image. }
  OPTIONAL { ?street wdt:P138 ?eponym. ?eponym wdt:P21 ?gender. }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],de,en". }
}
