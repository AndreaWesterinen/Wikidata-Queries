SELECT DISTINCT ?cities ?population ?item WHERE { 
  ?cities wdt:P31/wdt:P279* wd:Q515 .
  ?cities wdt:P17 wd:Q733 .
  MINUS {?cities wdt:P31/wdt:P279* wd:Q10864048 }
  ?cities wdt:P1082 ?population .
  FILTER (?population > 250000) .
  OPTIONAL {?cities wdt:P194 ?council .
  OPTIONAL { ?council wdt:P527 ?item
  MINUS { ?item wdt:P576 [] } }
  }
}
