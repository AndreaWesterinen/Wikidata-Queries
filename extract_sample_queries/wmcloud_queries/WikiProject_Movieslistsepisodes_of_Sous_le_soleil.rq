SELECT ?item ?nr_s ?nr_e ?nr_all (GROUP_CONCAT(DISTINCT ?frlabel) AS ?frlabels) ?release WHERE {
  ?item wdt:P31/wdt:P279* wd:Q21191270.
  ?season p:P179 ?season_statement.
  ?season_statement ps:P179 wd:Q942954.
  ?season_statement pq:P1545 ?nr_s.
  ?item p:P4908 ?episode_statement.
  ?episode_statement ps:P4908 ?season.
  ?episode_statement pq:P1545 ?nr_e.
OPTIONAL {
?item p:P577 ?release_statement.
  ?release_statement ps:P577 ?release.
  ?release_statement pq:P291 wd:Q142.
}
  OPTIONAL {
    ?item p:P179 ?series_statement.
    ?series_statement pq:P1545 ?nr_all.
  }
  OPTIONAL {
    ?item rdfs:label ?frlabel.
    FILTER((LANG(?frlabel)) = "fr")
  }
}
GROUP BY ?item ?nr_s ?nr_e ?nr_all ?release
ORDER BY xsd:integer(?nr_s) xsd:integer(?nr_e)
