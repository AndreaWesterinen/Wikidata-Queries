embed.html##defaultView:Map
SELECT DISTINCT ?item ?date ?geo ?image ?itemLabel ?type ?typeLabel
WHERE
{
	# find items of some type
    ?item wdt:P31 ?type .
    # where the type is a subclass of disaster
    ?type wdt:P279* wd:Q3839081 .
	# with a point in time or start date
	 { ?item wdt:P585 ?date .} UNION { ?item wdt:P580 ?date. }
	# not more than 1 day in the future
    # (allowing for time zone differences)
    # and not more than 90 days ago
	BIND(NOW() - ?date AS ?distance).
	FILTER(-1 <= ?distance && ?distance < 90).
    ?item wdt:P625 ?geo .
     SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
     OPTIONAL { ?item wdt:P18 ?image }
    
}
# newest first
ORDER BY DESC(?date) 
# limit to 100 results in case there are more
LIMIT 100
