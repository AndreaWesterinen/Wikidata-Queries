#title: Value "Sudan" and place of birth in "South Sudan"
# Complex constraint from [[Property talk:P27]]
# Possible, but likely an error. TODO: double-check, then add a reference to the P27 statement or fix P27=[[d:Q1049|Sudan <small>(Q1049)</small>]] -> [[d:Q958|South Sudan <small>(Q958)</small>]]
SELECT DISTINCT ?item 
{ 
  ?item wdt:P27 wd:Q1049 .
  ?item wdt:P19/wdt:P17? wd:Q958 .
  FILTER NOT EXISTS { ?item wdt:P27 wd:Q1049 }
  ?item wdt:P31 wd:Q5.
  ?item p:P27 ?claim .
  ?claim ps:P27 wd:Q1049 .
  OPTIONAL { ?claim prov:wasDerivedFrom ?source . ?source ?p ?v . FILTER NOT EXISTS { ?v wdt:P31 wd:Q10876391 } } 
  FILTER(!bound(?source)) 
}
