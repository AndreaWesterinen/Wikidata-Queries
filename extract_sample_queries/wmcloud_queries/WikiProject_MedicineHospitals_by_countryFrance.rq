SELECT DISTINCT ?item ?dep ?status ?fr ?eu ?idFINESS ?idAmeli ?idFHFest ?idFHFgroup WHERE 
{ ?item wdt:P31/wdt:P279* wd:Q16917; wdt:P17 wd:Q142
OPTIONAL { ?item p:P31/ps:P31 wd:Q64578911 . BIND(wd:Q64578911 as ?status1) } BIND(COALESCE(?status1,wd:Q64624840) as ?status)
OPTIONAL { ?item rdfs:label ?fr . FILTER(lang(?fr)="fr") }
OPTIONAL { ?item rdfs:label ?eu . FILTER(lang(?eu)="eu") }
OPTIONAL { ?item wdt:P131/wdt:P131* ?dep . ?dep wdt:P31 wd:Q6465 }
OPTIONAL { ?item wdt:P4058 ?idFINESS }
OPTIONAL { ?item wdt:P8062 ?idAmeli }
OPTIONAL { ?item wdt:P8077 ?idFHFest }
OPTIONAL { ?item wdt:P8078 ?idFHFgroup }
}
