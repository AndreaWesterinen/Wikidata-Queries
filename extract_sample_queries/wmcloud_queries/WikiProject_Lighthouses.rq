#defaultView:ImageGrid
SELECT ?item ?itemLabel ?itemDescription ?c ?descLabel ?icon 
{
    ?item wdt:P31 wd:Q39715 .
    ?item wdt:P1030 ?c .
    ?desc wdt:P1030 ?c .
    ?desc wdt:P31 wd:Q1738955 .
    OPTIONAL { ?desc wdt:P2910 ?icon }
    SERVICE wikibase:label { bd:serviceParam wikibase:language "en" }
}  
