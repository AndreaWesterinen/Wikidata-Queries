SELECT ?item ?country ?legislature ?position ?positiontype ?electoraldistrict ?edtype ?starttime ?endtime ?parliametarygroup ?fbid WHERE { 
    BIND (wd:Q884 as ?country) .
    BIND (wd:Q494162 as ?legislature) .
    ?country wdt:P1313 ?head .
    ?member wdt:P361 ?legislature ;
            wdt:P279* wd:Q4175034 .
    MINUS {?member wdt:P576 [] }
    MINUS { ?legislature wdt:P576 [] }
    { ?node ps:P39 ?member ;
          pq:P4100 ?parliametarygroup }
    UNION {
      ?node ps:P39 ?head ;
          pq:P4100 ?parliametarygroup 
    }
    OPTIONAL { ?node pq:P580 ?starttime }
    OPTIONAL { ?node pq:P768 ?electoraldistrict .
      OPTIONAL { ?electoraldistrict wdt:P31 ?edtype }
    }
    OPTIONAL { ?node pq:P582 ?endtime }
    ?node ps:P39 ?position .
    ?position wdt:P31 ?positiontype .
    ?item p:P39 ?node .
    OPTIONAL { ?item wdt:P2013 ?fbid }
}
ORDER BY ?item
