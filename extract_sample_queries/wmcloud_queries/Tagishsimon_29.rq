SELECT ?item ?itemLabel ?_image  ?countryLabel ?locatedLabel  with {
  select ?item where
         {
  ?item wdt:P31 wd:Q16970.
  filter not exists { ?item schema:description ?itemDescripton  . filter(lang(?itemDescripton)="en") }
} } as %i

with {
select ?item (count(?located) as ?count) where {
  include %i
  ?item wdt:P131 ?located .
} group by ?item having (?count=1) } as %j

WHERE {
include %j
  SERVICE wikibase:label {bd:serviceParam wikibase:language "en" .  }
  ?item wdt:P17 ?country .
  ?item wdt:P131 ?located .
  ?country wdt:P463 wd:Q1065 .
}
