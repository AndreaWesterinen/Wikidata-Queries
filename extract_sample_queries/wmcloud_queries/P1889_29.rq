SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P1889 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P1013, wd:P3831, wd:P1310, wd:P805, wd:P5102, wd:P1480, wd:P1810, wd:P3680, wd:P2241, wd:P2868, wd:P8338, wd:P5168 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
