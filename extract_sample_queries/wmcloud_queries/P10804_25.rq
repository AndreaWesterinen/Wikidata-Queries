SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P10804 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P123, wd:P50, wd:P2093, wd:P2124, wd:P3744, wd:P585, wd:P407, wd:P1476, wd:P518, wd:P1001, wd:P580, wd:P5017 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
