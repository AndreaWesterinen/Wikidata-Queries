embed.html##defaultView:Map
SELECT ?item ?itemLabel ?c ?layer { ?item wdt:P6513 ?code . ?item wdt:P625 ?c .  OPTIONAL { ?item rdfs:label ?il. FILTER(LANG(?il)="gom-latn") } BIND(IF(BOUND(?il),"with","without") as ?layer) SERVICE wikibase:label { bd:serviceParam wikibase:language "gom-latn,en". } } #
