SELECT ?Wikidata ?NT_Flora_ID ?taxon_name WHERE {
  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en".
    ?Wikidata wdt:P5953 ?NT_Flora_ID.
    ?item wdt:P5953 ?NT_Flora_ID.
  }
  OPTIONAL { ?Wikidata wdt:P5953 ?NT_Flora_ID. }
  OPTIONAL { ?Wikidata wdt:P225 ?taxon_name. }
}
ORDER BY ?taxon_name
