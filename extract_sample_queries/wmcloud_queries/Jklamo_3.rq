SELECT 
?item (COUNT(DISTINCT(?film)) AS ?ct) ?itemLabel
WHERE 
{ VALUES ?filmtype {wd:Q11424 wd:Q24862 wd:Q20667187 wd:Q226730} . 
 ?film wdt:P31 ?filmtype . 
 ?film wdt:P161 ?item .
 {?item wdt:P27 wd:Q213} UNION {?item wdt:P27 wd:Q33946}.
SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
} 
GROUP BY ?item ?itemLabel
ORDER BY DESC(?ct) LIMIT 50
