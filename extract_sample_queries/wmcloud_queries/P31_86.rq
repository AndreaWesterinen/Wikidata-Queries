#title: use [[Property:P10241|is an individual of taxon&#32;<small dir="ltr">(P10241)</small>]] to identify taxon
# Complex constraint from [[Property talk:P31]]
# Where the item is an individual organism, [[Property:P10241|is an individual of taxon&#32;<small dir="ltr">(P10241)</small>]] should be used to identify its taxon, e.g. species.
SELECT DISTINCT ?item ?itemLabel WHERE {
  ?item wdt:P31/wdt:P279* wd:Q110224119 .
  ?item wdt:P31 ?taxon .
  ?taxon wdt:P31 wd:Q16521 .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en" . }
}
