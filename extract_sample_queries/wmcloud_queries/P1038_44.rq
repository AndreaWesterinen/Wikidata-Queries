SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P1038 [] .
			MINUS {
				VALUES ?classes { wd:Q5 wd:Q21070598 wd:Q95074 wd:Q178885 wd:Q15632617 wd:Q1569167 wd:Q15711870 wd:Q15773347 wd:Q8436 wd:Q16979650 wd:Q1313923 wd:Q26401003 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
