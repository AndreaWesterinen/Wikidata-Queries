SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P15 [] .
			MINUS {
				VALUES ?classes { wd:Q376799 wd:Q1292279 wd:Q15640053 wd:Q18199879 wd:Q34442 wd:Q728937 wd:Q1067164 wd:Q355304 wd:Q1784293 wd:Q506572 wd:Q831663 wd:Q3679502 wd:Q2401485 wd:Q16858238 wd:Q249556 wd:Q852190 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
