SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P108 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P580, wd:P582, wd:P1534, wd:P585, wd:P2047, wd:P1264, wd:P39, wd:P361, wd:P1365, wd:P1366, wd:P748, wd:P5168, wd:P3831, wd:P2868, wd:P4626, wd:P4649, wd:P1552, wd:P828, wd:P101, wd:P937, wd:P276, wd:P355, wd:P1810, wd:P1932, wd:P5102, wd:P805, wd:P3680, wd:P1310, wd:P1480, wd:P459, wd:P4241, wd:P1319, wd:P8555, wd:P8554, wd:P1326, wd:P1317, wd:P4550, wd:P6424, wd:P1065, wd:P2960, wd:P2241, wd:P7452, wd:P8338, wd:P642, wd:P1416, wd:P10663 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
