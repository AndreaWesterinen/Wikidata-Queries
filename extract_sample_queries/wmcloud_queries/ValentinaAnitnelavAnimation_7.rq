embed.html##Haircolors in Disney's traditonally animated films

SELECT ?haircolorLabel (COUNT(DISTINCT ?character) AS ?number)  
WHERE
{
  #constraining hair color
  ?haircolor wdt:P31/wdt:P279* wd:Q1048314.
  
  #getting the films
  ?film wdt:P179 wd:Q56070713;
        wdt:P136 wd:Q28968511;
        wdt:P527* ?film1.
  
  #getting characters and haircolor
  ?character wdt:P1441 ?film1;
             wdt:P1884/wdt:P279* ?haircolor.
  
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en" }
}
GROUP BY ?haircolorLabel
ORDER BY DESC(?number)
