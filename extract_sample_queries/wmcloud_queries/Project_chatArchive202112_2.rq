SELECT ?city ?label (max(?population) as ?pop) (sample(?coords) as ?coord) WHERE {
  ?city wdt:P17 wd:Q668.
  ?city wdt:P31/wdt:P279? wd:Q486972 .
  OPTIONAL { ?city wdt:P1082 ?population. }
  OPTIONAL { ?city wdt:P625 ?coords . }
  ?city rdfs:label ?label .
  FILTER(LANG(?label) = "en")
} GROUP BY ?city ?label  ORDER BY DESC(max(?population))
  LIMIT 12000
