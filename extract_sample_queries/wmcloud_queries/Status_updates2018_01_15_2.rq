SELECT ?label (COUNT(?street) AS ?count) (GROUP_CONCAT(?street) AS ?streets) WHERE {
  ?street wdt:P31/wdt:P279* wd:Q79007;
          wdt:P17 wd:Q183;
          wdt:P131+ wd:Q64. hint:Prior hint:gearing "forward".
  ?street rdfs:label ?label.
  FILTER(LANG(?label) = "de")
}
GROUP BY ?label
HAVING(?count > 1)
