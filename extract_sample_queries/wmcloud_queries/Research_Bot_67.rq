SELECT DISTINCT ?title ?authorstring ?date_time ?item
WHERE {
  hint:Query hint:optimizer "None".
  SERVICE wikibase:mwapi {
    bd:serviceParam wikibase:api "Search";
                    wikibase:endpoint "www.wikidata.org";
                    mwapi:srsearch "A new genus and species of atelecyclid crab from New Zealand haswbstatement:P31=Q13442814".
    ?page_title wikibase:apiOutput mwapi:title.
  }
  BIND(IRI(CONCAT(STR(wd:), ?page_title)) AS ?item)

  VALUES (?earliest) {("1972-01-01T00:00:00Z"^^xsd:dateTime)}
  VALUES (?latest) {("1972-12-31T00:00:00Z"^^xsd:dateTime)}
  ?item wdt:P577 ?date_time .
  hint:Prior hint:rangeSafe true .
  FILTER (?date_time >= ?earliest)
  FILTER (?date_time <= ?latest)
    
{  
  ?item wdt:P2093 ?authorstring . 
  FILTER(CONTAINS(LCASE(?authorstring), "dell"))
}
UNION
{  
  ?item wdt:P50 ?author . 
  ?author rdfs:label ?authorlabel
  FILTER(CONTAINS(LCASE(?authorlabel), "dell"))
}
    
  ?item wdt:P1476 ?title.
#  FILTER CONTAINS(LCASE(?title), "a new genus and species of atelecyclid crab from new zealand").
}
# LIMIT 10000
