embed.html##Karte der Fachwerkhäuser
#added 2019-02
#defaultView:Map{"markercluster": {}}
SELECT * WHERE {
  ?item (wdt:P31*/wdt:P279*) wd:Q12020836.
  ?item wdt:P625 ?geo.
  OPTIONAL { ?item wdt:P6375 ?Adresse. filter(lang(?Adresse)="de")}
  OPTIONAL { ?item wdt:P18 ?Bild. filter(lang(?Bild)="de")}
}
