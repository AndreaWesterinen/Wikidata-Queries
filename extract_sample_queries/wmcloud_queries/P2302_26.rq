SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P2302 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P2303, wd:P2304, wd:P2305, wd:P2306, wd:P2307, wd:P2308, wd:P2309, wd:P2310, wd:P2311, wd:P2312, wd:P2313, wd:P2316, wd:P1793, wd:P2916, wd:P4155, wd:P4680, wd:P5314, wd:P6607, wd:P6824, wd:P2241, wd:P7452, wd:P4240, wd:P9729, wd:P6104, wd:P424 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
