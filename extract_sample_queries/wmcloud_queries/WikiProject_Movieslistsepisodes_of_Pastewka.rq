SELECT ?item ?nr_s ?nr_e ?nr_all ?release (GROUP_CONCAT(DISTINCT(?delabel)) as ?delabels) WHERE 
{  
  ?item wdt:P31 wd:Q21191270 .
  ?item wdt:P179 wd:Q1540515 .   
  ?item wdt:P4908 ?season .
  ?season p:P179 ?season_statement .
  ?season_statement pq:P1545 ?nr_s  .
  ?item p:P4908 ?episode_statement .
  ?episode_statement pq:P1545 ?nr_e  .
OPTIONAL {
  ?item p:P179 ?series_statement .
  ?series_statement pq:P1545 ?nr_all  .
}
  OPTIONAL { ?item rdfs:label ?delabel . FILTER(lang(?delabel)="de")  } 
} GROUP BY ?item ?nr_s ?nr_e ?nr_all ?release ORDER BY xsd:integer(?nr_s) xsd:integer(?nr_e)
