#10 religious holidays that have WP articles in English AND French, but not in Italian, ranked by total number of WP articles.

SELECT ?item ?itemLabel ?article (COUNT(?sitelink) AS ?count)
WHERE {
  ?item wdt:P31/wdt:P279* wd:Q375011. 
  ?article schema:about ?item ;
           schema:isPartOf <https://en.wikipedia.org/>.
  ?article2 schema:about ?item ;
           schema:isPartOf <https://fr.wikipedia.org/>.
MINUS { ?article3 schema:about ?item ;
                  schema:isPartOf <https://it.wikipedia.org/>.}
  ?sitelink schema:about ?item .

SERVICE wikibase:label {bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
GROUP BY ?item ?itemLabel ?article 
ORDER BY DESC (?count)
LIMIT 10
