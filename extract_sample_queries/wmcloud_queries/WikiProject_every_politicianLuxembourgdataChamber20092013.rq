SELECT ?item ?party ?district ?start ?end ?cause ?replacedBy
WHERE 
{
  ?item p:P39 ?statement .
  ?statement ps:P39 wd:Q21328592 ; pq:P2937 wd:Q60846380 .
  OPTIONAL { ?statement pq:P768 ?district }
  OPTIONAL { ?statement pq:P4100 ?party }
  OPTIONAL { ?statement pq:P580 ?start }
  OPTIONAL { ?statement pq:P582 ?end }
  OPTIONAL { ?statement pq:P1534 ?cause }
  OPTIONAL { ?statement pq:P1366 ?replacedBy }
}
