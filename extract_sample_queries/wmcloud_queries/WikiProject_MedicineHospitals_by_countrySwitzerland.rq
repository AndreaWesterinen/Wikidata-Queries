SELECT DISTINCT ?item ?status ?la ?la2 ?la3 ?adm1 WHERE 
{ ?item wdt:P31/wdt:P279* wd:Q16917; wdt:P17 wd:Q39
OPTIONAL { ?item p:P31/ps:P31 wd:Q64578911 . BIND(wd:Q64578911 as ?status1) } BIND(COALESCE(?status1,wd:Q64624840) as ?status)
OPTIONAL { ?item wdt:P131/wdt:P131* ?adm1 . ?adm1 wdt:P31 wd:Q23058 }
OPTIONAL { ?item rdfs:label ?la . FILTER(lang(?la)="fr") }
OPTIONAL { ?item rdfs:label ?la2 . FILTER(lang(?la2)="de") }
OPTIONAL { ?item rdfs:label ?la3 . FILTER(lang(?la3)="it") }
}
