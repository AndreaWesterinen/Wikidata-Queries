SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity wdt:P195 ?collection. ?collection wdt:P749+ wd:Q131626 . 
  MINUS { ?entity wdt:P195 []; wdt:P195 ?collection. ?collection wdt:P749+ wd:Q131626  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
