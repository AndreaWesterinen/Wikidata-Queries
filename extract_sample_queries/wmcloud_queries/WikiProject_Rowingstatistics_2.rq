embed.html#SELECT ?age_in_years (COUNT(?age_in_years) AS ?cnt) WITH {
  SELECT DISTINCT ?item WHERE {
    ?item p:P106/ps:P106/wdt:P279* wd:Q26270618 .
  }
} AS %subquery WHERE {
  INCLUDE %subquery .
  ?item p:P569 [ psv:P569 [ wikibase:timeValue ?date_of_birth; wikibase:timePrecision ?precision_birth ]; wikibase:rank ?rank_birth ] .
  ?item p:P570 [ psv:P570 [ wikibase:timeValue ?date_of_death; wikibase:timePrecision ?precision_death ]; wikibase:rank ?rank_death ] .
  FILTER(?precision_birth >= 9 && ?precision_death >= 9) .
  FILTER(?rank_birth != wikibase:DeprecatedRank && ?rank_death != wikibase:DeprecatedRank) .
  BIND(ROUND((?date_of_death - ?date_of_birth)/365) AS ?age_in_years)
} GROUP BY ?age_in_years
