SELECT ?author ?authorLabel ?work ?workLabel ?year {
  ?author p:P166 ?prizestmt.
  ?prizestmt ps:P166 wd:Q172582.
  OPTIONAL { ?prizestmt pq:P585 ?date. }
  ?prizestmt pq:P1686 ?work.
  ?work wdt:P407 wd:Q33965.
  BIND(YEAR(?date) as ?year).
  SERVICE wikibase:label { bd:serviceParam wikibase:language "sat,en". }
} ORDER BY ?year
