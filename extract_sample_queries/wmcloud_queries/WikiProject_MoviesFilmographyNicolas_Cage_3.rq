SELECT
	(?film as ?item)
	(group_concat(DISTINCT concat("\u007B\u007BP\u007C",strafter(str(?property),"/entity/"),"\u007D\u007D");separator="<br>") as ?part) 
	(SAMPLE(?role) as ?role_)
	(SAMPLE(?as) as ?as_)
	(MIN(?year) as ?year_)
	(SAMPLE(?sitelinks) as ?sitelinks_)
	((SAMPLE(?statements)-SAMPLE(?ids)-COUNT(DISTINCT ?cast)-COUNT(DISTINCT ?va)) as ?statements_)
	(COUNT(DISTINCT ?cast) as ?castlisted)
	(COUNT(DISTINCT ?va) as ?valisted)
	(SAMPLE(?ids) as ?ids_)
	(SAMPLE(?article) as ?en) 
{
  	hint:Query hint:optimizer "None" .
  	?film ?wdt wd:Q42869 .
  	?property wikibase:directClaim ?wdt ; wikibase:claim ?p ; wikibase:statementProperty ?ps
  	OPTIONAL { ?film ?p ?statement . ?statement ?ps wd:Q42869 . ?statement pq:P453 ?role . OPTIONAL {?statement pq:P3831 ?as} }
  	OPTIONAL { ?film wdt:P577 ?pub BIND(YEAR(?pub) as ?year) }
  	{ ?film wdt:P31/wdt:P279* wd:Q11424 } UNION { ?film wdt:P31 wd:Q5398426 }
  	OPTIONAL { ?film wikibase:sitelinks ?sitelinks; wikibase:statements ?statements ; wikibase:identifiers ?ids }
  	OPTIONAL { ?film wdt:P161 ?cast } .
  	OPTIONAL { ?film wdt:P725 ?va } .
	OPTIONAL { [] schema:about ?film ; schema:isPartOf <https://en.wikipedia.org/> ; schema:name ?articletitle .
             BIND(CONCAT("[[w:",str(?articletitle),"|",str(?articletitle),"]]") as ?article) 
             }    
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" . ?property rdfs:label ?propertylabel }
}
GROUP BY ?film
ORDER BY DESC(?year_) ?item
