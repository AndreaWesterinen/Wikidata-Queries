SELECT DISTINCT ?l ?lemma WHERE {
  ?l a ontolex:LexicalEntry ; 
       dct:language wd:Q1860 ; 
       wikibase:lexicalCategory wd:Q24905 ; 
       wikibase:lemma ?lemma ; 
       ontolex:lexicalForm ?form .
    ?form ontolex:representation ?word ; 
    #FILTER(LANG(?word) = "en"). # don't consider en-gb forms
    minus {
      {?l a ontolex:LexicalEntry ; ontolex:lexicalForm/wikibase:grammaticalFeature wd:Q10345583 .}UNION
      {
      # duplicate present participle that was merged but is still present in forms waiting to be cleaned up by somebody
      ?l a ontolex:LexicalEntry ; ontolex:lexicalForm/wikibase:grammaticalFeature wd:Q24133704. }
    }.
}
