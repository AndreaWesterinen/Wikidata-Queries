SELECT ?place ?placeLabel ?placeDescription ?instanceLabel ?location ?dist_km
WHERE
{
  wd:Q96254761 wdt:P625 ?loc .
  SERVICE wikibase:around {
      ?place wdt:P625 ?location .
      bd:serviceParam wikibase:center ?loc .
      bd:serviceParam wikibase:radius "60" .
  }
  OPTIONAL { ?place wdt:P31 ?instance  }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en" }
  BIND(ROUND(geof:distance(?loc, ?location)) as ?dist_km)
} 
ORDER BY (?place != wd:Q96254761) ?dist_km ?place
