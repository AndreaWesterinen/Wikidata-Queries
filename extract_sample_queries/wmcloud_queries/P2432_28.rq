#title: Works with creator missing link
# Complex constraint from [[Property talk:P2432]]
# List of works that are in [[Property:P195|collection&#32;<small dir="ltr">(P195)</small>]] [[d:Q731126|J. Paul Getty Museum <small>(Q731126)</small>]] and have [[Property:P170|creator&#32;<small dir="ltr">(P170)</small>]] set, but that creator doesn't have a [[Property:P2432|J. Paul Getty Museum artist ID&#32;<small dir="ltr">(P2432)</small>]] link
SELECT ?item ?creator
{
	?item wdt:P195 wd:Q731126 .
    ?item wdt:P170 ?creator .
	MINUS { ?creator wdt:P2432 [] } .
	MINUS { ?item wdt:P170 wd:Q4233718 } . # Filter out anonymous
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en,en" }
} ORDER BY ?creatorLabel
