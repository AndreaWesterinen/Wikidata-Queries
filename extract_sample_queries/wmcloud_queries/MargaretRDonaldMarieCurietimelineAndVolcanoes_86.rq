# Plantlist species taxa without taxon authors 
SELECT ?item ?taxon_name ?apni_id ?APNILink   WHERE {
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
  ?item p:P225 ?stat . 
  ?stat ps:P225 ?taxon_name.
  ?item wdt:P1070 ?apni_id. # PlantList ID
  ?item wdt:P105 wd:Q7432. # taxon rank is species
  bind(uri(concat("http://www.theplantlist.org/tpl1.1/record/",?apni_id)) as ?APNILink)  
  MINUS {?stat pq:P405 ?taxon_author.} 
}
