SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P1596 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P585, wd:P7452, wd:P2241, wd:P5102, wd:P642, wd:P2047, wd:P1114, wd:P580, wd:P582, wd:P7588, wd:P3014, wd:P797, wd:P1319, wd:P8554, wd:P8555, wd:P1326, wd:P9680, wd:P518, wd:P828, wd:P1534, wd:P2555, wd:P958 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
