SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity wdt:P108 wd:Q309350.  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". } . 
  MINUS { ?entity wdt:P21 []; wdt:P108 wd:Q309350.  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
