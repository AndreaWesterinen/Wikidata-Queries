PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX p: <http://www.wikidata.org/prop/>
PREFIX ps: <http://www.wikidata.org/prop/statement/>
PREFIX pq: <http://www.wikidata.org/prop/qualifier/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
#Sample query to start a list of values for property P2810
#Remove some of the "#" below to see if it helps you

SELECT ?item ?itemLabel ?value ?valueLabel
#sample variables defined below (but commented out)
?dob ?dod ?country
WHERE
{
  ?item wdt:P2810 ?value .
#  ?item wdt:P569 ?dob .
#  OPTIONAL {?item wdt:P570 ?dod } .
#  ?item wdt:P17 ?country .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en,en"  }
}
LIMIT 10
