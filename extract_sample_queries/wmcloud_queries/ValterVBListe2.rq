SELECT DISTINCT ?item ?itemLabel ?typeLabel ?artistaDescription ?anno
WHERE
{
    ?item wdt:P31/wdt:P279* wd:Q482994.
    ?item wdt:P175 ?artista .
    ?artista wdt:P31 ?type.
    ?item wdt:P577 ?date .
    BIND (YEAR(?date) as ?anno).
	OPTIONAL { ?item schema:description ?itemDescription  }
	FILTER (!BOUND(?itemDescription))
  
	SERVICE wikibase:label { bd:serviceParam wikibase:language "it"}
}
