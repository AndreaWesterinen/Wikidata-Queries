#defaultView:ImageGrid
SELECT DISTINCT ?person ?personLabel ?painting ?paintingLabel ?pic ?depicts
WHERE
{
  ?painting wdt:P18 ?pic .
  ?painting wdt:P31/wdt:P279* wd:Q3305213 .
  FILTER (NOT EXISTS {?painting wdt:P180 ?depicts.
                      ?depicts wdt:P31 wd:Q5.
                     }).
  
  {
    ?person wdt:P31 wd:Q5 .
    ?person wdt:P18 ?pic .
    #?painting wdt:P136 wd:Q134307 .
    #OPTIONAL { ?painting wdt:P180 ?depicts } .
    #FILTER (!BOUND(?depicts))
  }
  UNION
  {
    #selfportraits without P180
    ?painting wdt:P136 wd:Q192110.
    ?painting wdt:P170 ?person.
  }
  
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
ORDER BY ?pic
