SELECT ?item ?itemLabel ?value ?result (STRLEN(STR(?value)) AS ?stringlength)  ?snak ?rank
WHERE
{
	{
		SELECT ?item ?value ?result ?snak ?rank
		WHERE
		{
			{
				?item p:P3570 [ ps:P3570 ?value; wikibase:rank ?rank ] .
				BIND("mainsnak" AS ?snak) .
			} UNION {
				?statement1 pq:P3570 ?value;
					wikibase:rank ?rank .
				?item ?p1 ?statement1 .
				BIND("qualifier" AS ?snak) .
			} UNION {
				?ref pr:P3570 ?value .
				?statement2 prov:wasDerivedFrom ?ref;
					wikibase:rank ?rank .
				?item ?p2 ?statement2 .
				BIND("reference" AS ?snak) .
			} .
			BIND( REGEX( STR( ?value ), "^(ECLI:(NL:(AGAMS|AGARN|AGGRO|AGHAA|AGROE|AGROT|AGSGR|AGSHE|AGUTR|AGZWO|CBB|CRVB|CVBSTUF|DETARCO|GHAMS|GHARL|GHARN|GHDHA|GHLEE|GHSGR|GHSHE|HR|KTGAAR|KTGALK|KTGALM|KTGAMF|KTGAMS|KTGAPD|KTGARN|KTGASS|KTGBEE|KTGBOX|KTGBOZ|KTGBRE|KTGBRI|KTGDEL|KTGDEV|KTGDHD|KTGDOR|KTGEIN|KTGEMM|KTGENS|KTGGNL|KTGGOU|KTGGRC|KTGGRO|KTGHAA|KTGHAR|KTGHFD|KTGHIL|KTGHMD|KTGHRL|KTGHRN|KTGHRV|KTGLDN|KTGLEE|KTGLLY|KTGMAA|KTGMEP|KTGMID|KTGNMG|KTGOBL|KTGOOS|KTGPAR|KTGROE|KTGROT|KTGSCH|KTGSGR|KTGSHE|KTGSIT|KTGSNK|KTGSOM|KTGSTW|KTGTIE|KTGTIL|KTGTRB|KTGTRN|KTGUTR|KTGVEE|KTGVEN|KTGWAG|KTGWIN|KTGZAA|KTGZEV|KTGZIE|KTGZUI|KTGZUT|KTGZWO|OCHM|OGAACMB|OGANA|OGEAA|OGEAB|OGEABES|OGEAC|OGEAM|OGEANA|OGHACMB|OGHNAA|OHJNA|ORBAACM|ORBANAA|ORBBACM|ORBBNAA|PHR|RBALK|RBALM|RBAMS|RBARN|RBASS|RBBRE|RBDHA|RBDOR|RBGL|RBGRO|RBHAA|RBLEE|RBLIM|RBMAA|RBMID|RBMNE|RBNHO|RBNNE|RBOBR|RBONE|RBOVE|RBROE|RBROT|RBSGR|RBSHE|RBUTR|RBZLY|RBZUT|RBZWB|RBZWO|RVBALK|RVBAMS|RVBARN|RVBBRE|RVBGRO|RVBHAA|RVBLDN|RVBLEE|RVBMID|RVBROE|RVBROT|RVBSGR|RVBSHE|RVBTIL|RVBUTR|RVBZWO|RVS|TACAKN|TADRAMS|TADRARL|TADRARN|TADRLEE|TADRSGR|TADRSHE|TAHVD|TAKTPA|TBBBKD|TBPSKAL|TDIVBC|TDIVTC|TGDKG|TGFKCB|TGZCTG|TGZRAMS|TGZREIN|TGZRGRO|TGZRSGR|TGZRZWO|TNOKALK|TNOKALM|TNOKAMS|TNOKARN|TNOKASS|TNOKBRE|TNOKDOR|TNOKGRO|TNOKHAA|TNOKLEE|TNOKMAA|TNOKMID|TNOKROE|TNOKROT|TNOKSGR|TNOKSHE|TNOKUTR|TNOKZLY|TNOKZUT|TNORAMS|TNORARL|TNORDHA|TNORSHE|TPETPVE|TSCTS|TVSTPV|TVVTPVV|XX):\\d{4}.+|(?!NL).+))$" ) AS ?regexresult ) .
			FILTER( ?regexresult = false ) .
			BIND( IF( ?regexresult = true, "pass", "fail" ) AS ?result ) .
			FILTER( ?item NOT IN ( wd:Q4115189, wd:Q13406268, wd:Q15397819 ) ) .
		} 
		LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
#ORDER BY ?rank ?snak ?value
#PLEASE NOTE: This is experimental and may only work for simple patterns.
#Tests may fail due to:
#(1) differences in regex format between SPARQL (https://www.w3.org/TR/xpath-functions/#regex-syntax) and PCRE (used by constraint reports). Don't change the regex to work with SPARQL!
#(2) some bug in the link that brought you here
#Known to fail: P227 (multiple curly braces), P274, P281
