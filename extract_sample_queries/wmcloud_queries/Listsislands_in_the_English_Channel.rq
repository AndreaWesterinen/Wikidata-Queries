#defaultView:Map
SELECT DISTINCT ?item ?itemlabel ?coor ?image ?c (IF(BOUND(?coor),"✓","") as ?c1) ?areakm
{
	{ ?item wdt:P31/wdt:P279* wd:Q23442 } UNION { ?item wdt:P31 wd:Q1404150 } UNION { ?item wdt:P31 wd:Q184358 } UNION { ?item wdt:P31 wd:Q33837 }
	{ ?item wdt:P206 wd:Q34640 } UNION { ?item wdt:P706 wd:Q34640 } .
	OPTIONAL { ?item wdt:P625 ?coor }
	OPTIONAL { ?item wdt:P18 ?image }  
	OPTIONAL { ?item wdt:P17 ?c }  
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
  	OPTIONAL { 	?item p:P2046/psv:P2046 [ wikibase:quantityAmount ?area ; wikibase:quantityUnit ?unit ] . 
              	OPTIONAL { ?unit p:P558 [ ps:P558 ?s; pq:P282 wd:Q8229 ] . }
              	?unit wdt:P2370 ?siu . BIND(str(round(?siu * ?area/1000)/1000) as ?si)
              	BIND(CONCAT('align=right  data-sort-value="',?si,'" | ', ?si , '&nbsp;km²&nbsp;&nbsp;<','ref>' ,str(?area), " ", ?s, "</","ref>") as ?areakm )
  	}
}
ORDER BY DESC(?c) ?itemlabel
