#title: Works with creator missing link
# Complex constraint from [[Property talk:P6295]]
# List of works that are in [[Property:P195|collection&#32;<small dir="ltr">(P195)</small>]] [[d:Q239303|Art Institute of Chicago <small>(Q239303)</small>]] and have [[Property:P170|creator&#32;<small dir="ltr">(P170)</small>]] set, but that creator doesn't have a [[Property:P6295|ARTIC artist ID&#32;<small dir="ltr">(P6295)</small>]] link
SELECT ?item ?creator
{
	?item wdt:P195 wd:Q239303 .
    ?item wdt:P170 ?creator .
	MINUS { ?creator wdt:P6295 [] } .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en,en" }
} ORDER BY ?creatorLabel
