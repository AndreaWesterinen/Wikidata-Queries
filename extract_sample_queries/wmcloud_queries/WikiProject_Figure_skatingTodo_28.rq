SELECT ?item ?itemLabel
WHERE {
  ?item wdt:P641 ?sport ;
        wdt:P279 ?competition.
  FILTER (?sport IN (wd:Q1682809, wd:Q926191, wd:Q4179462, wd:Q4305887, wd:Q1482312, wd:Q38108))
  FILTER (?competition IN (wd:Q57305027, wd:Q2990963))
  MINUS { ?item wdt:P373 ?category .}
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
  }
