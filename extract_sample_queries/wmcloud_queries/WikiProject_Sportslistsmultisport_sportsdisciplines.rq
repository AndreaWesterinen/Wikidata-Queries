SELECT  ?item ?itemLabel
  (GROUP_CONCAT(DISTINCT CONCAT("[[",strafter(str(?it),"y/"),"|",?itLabel,"]]"); separator=", ") as ?inmultisport)
  (COUNT(DISTINCT ?it) as ?ct)
WHERE
{ 
    ?it wdt:P279+ wd:Q43767805 . 
    ?it wdt:P527 ?item .
    SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en".
                           ?item rdfs:label ?itemLabel .
                           ?it rdfs:label ?itLabel 
                           }
}
GROUP BY ?item ?itemLabel
ORDER BY DESC(?ct) ?itemLabel
