SELECT DISTINCT ?item ?objectsoort ?titel WHERE {
  ?item rdfs:label ?label.
  ?item wdt:P6379 wd:Q2098586.
  ?item wdt:P31 wd:Q5.
  ?item wdt:P106 ?beroep.
  FILTER NOT EXISTS {?item wdt:P7763 [].}
  FILTER NOT EXISTS {
   ?item p:P6379 [ ps:P6379 wd:Q2098586;
                    prov:wasDerivedFrom 
                    [ pr:P1476 ?titel;
                    ]
                  ].
  }
}
