SELECT DISTINCT ?item ?itemLabel ?population ?area ?density
WHERE
{
  ?item wdt:P31/wdt:P279* wd:Q23442.
  ?item wdt:P1082 ?population.
  FILTER(?population >= "999999"^^xsd:integer)
  MINUS{?item wdt:P31/wdt:P279* wd:Q1402592 .}
  OPTIONAL{?item wdt:P2046 ?area.}
  BIND(ROUND((?population / ?area)*10)/10 AS ?density)
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
ORDER BY DESC(?population)
