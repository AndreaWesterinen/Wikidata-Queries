#title: //
# Complex constraint from [[Property talk:P6720]]
# https is generally preferred. You may want to suggest an update at [[m:Talk:Interwiki_map#Requests_for_updates]]. Once the interwiki table updated, add "https:" to the formatter
SELECT ?item ?iw (CONCAT("[[",?iw,":]]") as ?iwlinked) ?f
{
  ?item p:P6720 ?st . 
  ?st ps:P6720 ?iw . 
  ?st pq:P1630 ?f . 
  ?st a wikibase:BestRank .
  FILTER( strstarts( ?f, "//") )
}
