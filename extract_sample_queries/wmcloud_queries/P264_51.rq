SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P264 [] .
			MINUS {
				VALUES ?classes { wd:Q2088357 wd:Q5 wd:Q7725310 wd:Q115669410 wd:Q193977 wd:Q106833 wd:Q3331189 wd:Q234870 wd:Q11664239 wd:Q215380 wd:Q105815710 wd:Q108346082 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
