SELECT DISTINCT ?item ?itemLabel ?parclassLabel ?ofLabel
WHERE
{
  ?item p:P31 ?inst_stm .
  ?inst_stm ps:P31 wd:Q12139612 .
  ?inst_stm pq:P642 ?of .
  #?of wdt:P31 / wdt:P279* wd:Q47461344 .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". } # Helps get the label in your language, if not, then en language
}
