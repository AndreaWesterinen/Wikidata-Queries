SELECT ?item ?itemLabel ?catcode
WHERE 
{
  ?item p:P528 [ pq:P972 wd:Q17280421 ; ps:P528 ?catcode].
  BIND(xsd:decimal(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE
                     (?catcode, "F", ""),
                     "a", ".01"), "b", ".02"), "c", ".03"), "d", ".04"), "e", ".05"),
                     "f", ".06"), "g", ".07"), "h", ".08"), "i", ".09"), "j", ".10"),
                     "k", ".11"), "l", ".12"), "m", ".13"), "n", ".14"), "o", ".15"),
                     "p", ".16"), "q", ".17"), "r", ".18"), "s", ".19"), "t", ".20"),
                     "u", ".21"), "v", ".22"), "w", ".23"), "x", ".24"), "y", ".25"),
                     "z", ".26")
                  ) as ?catnum)
  
}
ORDER BY ?catnum
