SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P2596 [] .
			MINUS {
				VALUES ?classes { wd:Q1778821 wd:Q32880 wd:Q223557 wd:Q11921029 wd:Q132241 wd:Q11639 wd:Q12132 wd:Q7832362 wd:Q1792644 wd:Q2207288 wd:Q1165905 wd:Q48264 wd:Q589656 wd:Q11894636 wd:Q60733114 wd:Q61961344 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
