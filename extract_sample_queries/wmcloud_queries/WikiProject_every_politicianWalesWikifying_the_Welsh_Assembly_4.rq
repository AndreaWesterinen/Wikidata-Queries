SELECT ?person ?personLabel ?dob ?occLabel ?universityLabel
WHERE {
  ?person wdt:P31 wd:Q5.
  ?person wdt:P69 ?university .
  #?university wdt:P31 wd:Q3918 .
  ?university wdt:P131* wd:Q25 .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
 ?person wdt:P569 ?dob. 
  OPTIONAL { ?person wdt:P106 ?occ. }
  FILTER("1954-01-01"^^xsd:dateTime <= ?dob && ?dob < "1955-01-01"^^xsd:dateTime).
  
}
