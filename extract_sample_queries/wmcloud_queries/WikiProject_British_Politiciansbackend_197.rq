# members of the 1992-97 Parliament - 651 members.
SELECT ?item ?itemLabel ?nameLabel ?genderLabel ?born ?birthplaceLabel ?died ?deathplaceLabel {
 ?item wdt:P39 wd:Q41582627 . 
 OPTIONAL { ?item wdt:P569 ?born . }
 OPTIONAL { ?item wdt:P570 ?died . }
 OPTIONAL { ?item wdt:P735 ?name . }
 OPTIONAL { ?item wdt:P21 ?gender . }
 OPTIONAL { ?item wdt:P19 ?birthplace . }
 OPTIONAL { ?item wdt:P20 ?deathplace . }
 SERVICE wikibase:label { bd:serviceParam wikibase:language 'en' }
}
ORDER BY ?start
