SELECT ?item ?qid (COUNT(distinct ?sitelink) as ?count) WHERE { VALUES ?fiction {wd:Q14897293} . ?item wdt:P31/wdt:P279* ?fiction . BIND (xsd:integer(STRAFTER(str(?item), "Q")) AS ?qid) FILTER (?qid > 104000000) . OPTIONAL { ?sitelink <http://schema.org/about> ?item }  } GROUP BY ?item ?qid ORDER BY DESC(?qid) LIMIT 150
