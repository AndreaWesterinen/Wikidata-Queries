SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P1258 [] .
			MINUS {
				VALUES ?classes { wd:Q5 wd:Q729 wd:Q11424 wd:Q15416 wd:Q3464665 wd:Q196600 wd:Q35127 wd:Q1002697 wd:Q526877 wd:Q21191270 wd:Q215380 wd:Q559618 wd:Q209939 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
