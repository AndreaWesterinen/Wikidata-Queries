#defaultView:Map
SELECT ?item ?itemLabel ?location ?pic WHERE {
  ?item wdt:P1435/wdt:P279* wd:Q11691318;  # "Schutzstatus" ist "Kulturdenkmal" oder eine Unterklasse von "Kulturdenkmal"
    wdt:P131 wd:Q3150.                     # "Liegt in der Verwaltungseinheit" ist "Jena"
  ?item wdt:P625 ?location
  OPTIONAL {?item wdt:P18 ?pic}
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],de". } # Label in Deutscher Sprache
}
