#Locations of settlements in Iraq, with images.
#defaultView:Map
SELECT ?siteLabel ?coord ?image ?site 
WHERE {
   ?site wdt:P31/wdt:P279* wd:Q3957;
         wdt:P17 wd:Q796 ;
      wdt:P625 ?coord ;
      wdt:P18 ?image ;
    
  FILTER NOT EXISTS { ?site wdt:P31 wd:Q515 }
SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en".}
  
}
