#title: Items without ID
# Complex constraint from [[Property talk:P8177]]
# Items in [[d:Q824|Oregon <small>(Q824)</small>]] that do have [[d:Q19558910|National Register of Historic Places listed place <small>(Q19558910)</small>]]  in [[Property:P1435|heritage designation&#32;<small dir="ltr">(P1435)</small>]], but not [[Property:P8177|Oregon Historic Sites Database ID&#32;<small dir="ltr">(P8177)</small>]]
SELECT ?item WHERE { ?item wdt:P131* wd:Q824 . { ?item wdt:P1435 wd:Q19558910 . } UNION { ?item wdt:P1435 wd:Q1129142 . } MINUS { ?item wdt:P8177 [] . } }
