SELECT DISTINCT ?item ?itemLabel ?werkgeverLabel ?geboortedatum ?sterfdatum WHERE {
  ?item wdt:P31 wd:Q5.
  { ?item (wdt:P106/wdt:P279*) wd:Q19361459. }
  UNION
  { ?item (wdt:P106/wdt:P279*) wd:Q1350189. }
  UNION
  { ?item (wdt:P106/wdt:P279*) wd:Q4529715. }
  OPTIONAL { ?item wdt:P108 ?werkgever. }
  OPTIONAL { ?item wdt:P569 ?geboortedatum. }
  OPTIONAL { ?item wdt:P570 ?sterfdatum. }
  { ?item wdt:P27 wd:Q31. }
  UNION
  {
    ?item wdt:P19 ?pob.
    ?pob wdt:P17 wd:Q31.
  }
  UNION
  {
    ?item wdt:P937 ?pow.
    ?pow wdt:P17 wd:Q31.
  }
  UNION
  {
    ?item wdt:P551 ?por.
    ?por wdt:P17 wd:Q31.
  }
  UNION
  {
    ?item wdt:P20 ?pod.
    ?pod wdt:P17 wd:Q31.
  }
  UNION
  {
    ?item wdt:P108 ?bewerkgever.
    ?bewerkgever wdt:P17 wd:Q31.
  }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "nl, en". }
}
