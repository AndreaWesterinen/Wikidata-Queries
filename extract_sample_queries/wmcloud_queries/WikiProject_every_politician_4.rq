embed.html##defaultView:BubbleChart
  SELECT ?occupationLabel (count(?pol) as ?cnt) WHERE {

     ?pol wdt:P39 wd:Q21100241 .
     ?pol p:P106/ps:P106 ?occupation .

	 FILTER (?occupation != wd:Q82955)
     SERVICE wikibase:label {
      bd:serviceParam wikibase:language "de" .
     }

  }
  GROUP BY ?occupationLabel
