SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity wdt:P31/wdt:P279* wd:Q43229; wdt:P5008 wd:Q13382529 . 
  MINUS { ?entity wdt:P17 []; wdt:P31/wdt:P279* wd:Q43229; wdt:P5008 wd:Q13382529  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
