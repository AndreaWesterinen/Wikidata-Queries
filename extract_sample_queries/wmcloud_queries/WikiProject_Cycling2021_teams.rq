SELECT ?item ?category ?date ?month WHERE {
  # find cycling teams 
  ?item wdt:P31 ?category .
  ?category wdt:P279 wd:Q20639847 .
  # with a point in time or start date
  OPTIONAL { ?item wdt:P585 ?date. }
  OPTIONAL { ?item wdt:P580 ?date. }
  BIND(MONTH(?date) AS ?month)
  # but at least one of those
  FILTER(BOUND(?date) && DATATYPE(?date) = xsd:dateTime).
  FILTER (?date >= "2021-00-00T00:00:00Z"^^xsd:dateTime && ?date < "2022-00-00T00:00:00Z"^^xsd:dateTime) .
}
ORDER BY ?date ?item
