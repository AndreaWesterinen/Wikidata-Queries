SELECT ?entity ?entityLabel ?entityDescription ?st ?sl ?ids
WHERE
{
  ?entity wdt:P31/wdt:P279* wd:Q2879 .
  MINUS { ?entity wdt:P576 ?abolished }
  OPTIONAL { 
    ?entity p:P131 ?inStatement .
    ?inStatement a wikibase:BestRank ; ps:P131 ?in .
    FILTER NOT EXISTS { ?inStatement wdt:P582 [] }
  }
  OPTIONAL { 
    ?entity p:P17 ?countryStatement .
    ?countryStatement a wikibase:BestRank ; ps:P17 ?country .
    FILTER NOT EXISTS { ?countryStatement wdt:P582 [] }
  }. 
  # MINUS { ?entity wdt:   [] }
  OPTIONAL { ?entity wikibase:statements ?st ; wikibase:sitelinks ?sl ; wikibase:identifiers ?ids } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" } 
}
