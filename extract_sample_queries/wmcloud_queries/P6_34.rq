SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P6 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P580, wd:P582, wd:P585, wd:P459, wd:P1534, wd:P805, wd:P1365, wd:P1366, wd:P1545, wd:P102, wd:P2868, wd:P2241, wd:P7452, wd:P39, wd:P8555, wd:P8554, wd:P1319, wd:P1326, wd:P2715, wd:P3415, wd:P3416 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
