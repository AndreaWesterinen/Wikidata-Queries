#title: Poland is used as nationality for people dead before 1918-11-11
# Complex constraint from [[Property talk:Q36]]
# Items with [[Property:P27|country of citizenship&#32;<small dir="ltr">(P27)</small>]] equal to [[d:Q36|Poland <small>(Q36)</small>]] and [[Property:P570|date of death&#32;<small dir="ltr">(P570)</small>]] before 1918-11-11
SELECT DISTINCT ?item WHERE {
  ?item wdt:P27 wd:Q36 .
  ?item p:P570/psv:P570 ?node .
  ?node wikibase:timeValue ?dead.
  ?node wikibase:timePrecision ?precision .
  FILTER (
    ?dead < "1918-11-11T00:00:00Z"^^xsd:dateTime && ?precision >= "11"^^xsd:integer ||
    ?dead < "1918-11-11T00:00:00Z"^^xsd:dateTime && ?precision >= "10"^^xsd:integer ||
    ?dead < "1918-11-11T00:00:00Z"^^xsd:dateTime && ?precision >= "9"^^xsd:integer )
  }
