#defaultView:Table
SELECT ?count ?topic ?topicLabel
WITH {
  SELECT (count(?work) as ?count) ?topic WHERE {
    ?work wdt:P921 ?topic ;
          wdt:P31 wd:Q13442814 .
  }
  GROUP BY ?topic
} AS %result
WHERE {
  INCLUDE %result
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en,da,de,es,fr,jp,nl,no,ru,sv,zh" . } 
}
ORDER BY DESC(?count)
