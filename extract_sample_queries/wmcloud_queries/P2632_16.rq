SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P2632 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P580, wd:P582, wd:P1264, wd:P3415, wd:P3416, wd:P1534, wd:P1480, wd:P1319, wd:P2047, wd:P1545, wd:P2868, wd:P131, wd:P528, wd:P585, wd:P2241, wd:P7452, wd:P8555, wd:P8554, wd:P1326, wd:P217 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
