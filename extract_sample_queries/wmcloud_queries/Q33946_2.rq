#title: Czechoslovakia is used as country of citizenship for people born after 1993-01-01
# Complex constraint from [[Property talk:Q33946]]
# Items with [[Property:P27|country of citizenship&#32;<small dir="ltr">(P27)</small>]] equal to [[d:Q33946|Czechoslovakia <small>(Q33946)</small>]] and [[Property:P569|date of birth&#32;<small dir="ltr">(P569)</small>]] after 1918-10-28
SELECT DISTINCT ?item WHERE {
  ?item wdt:P27 wd:Q33946 .
  ?item p:P569 [ psv:P569 ?node; wikibase:rank ?rank ] .
  FILTER(?rank != wikibase:DeprecatedRank) .
  ?node wikibase:timeValue ?born .
  ?node wikibase:timePrecision ?precision .
  FILTER (?born > "1993-01-01T00:00:00Z"^^xsd:dateTime)
  FILTER (?precision >= "9"^^xsd:integer)
}
