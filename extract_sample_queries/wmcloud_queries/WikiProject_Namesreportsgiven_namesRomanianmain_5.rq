SELECT ?item (SAMPLE(?p0) as ?sample) ?count (SAMPLE(?audio) as ?hasaudio)
WITH
{
  SELECT ?item
  (COUNT(DISTINCT ?p) as ?count)
  {
    ?item wdt:P407 wd:Q7913 ;
          wdt:P31 wd:Q11879590 .
    ?p wdt:P735 ?item .
  }
  GROUP BY ?item
  ORDER BY DESC(?count) ?item
  LIMIT 100
} as %a
WHERE
{
  INCLUDE %a 
  OPTIONAL { ?p0 wdt:P735 ?item ; wdt:P27 wd:Q218 ; wdt:P569 [] ; wdt:P570 [] ; wdt:P19 [] ; wdt:P20 []  }    
  OPTIONAL { ?item p:P443 [ pq:P407 wd:Q7913 ; ps:P443 ?audio ] }
}
GROUP BY ?item ?count
ORDER BY DESC(?count) ?item
