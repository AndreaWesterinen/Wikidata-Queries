SELECT DISTINCT ?item ?video ?st ?sl ?ids (CONCAT(REPLACE(str(?video),"http://commons.wikimedia.org/wiki/Special:FilePath/","[[c:File:"),"|","c:]]") as ?vstr) ?col
WHERE
{
  # BIND( wd:Q69063653 as ?item )
  ?item wdt:P10 ?video.
  ?item wdt:P31/wdt:P279* wd:Q11424.
  MINUS { ?item p:P10 [pq:P3831 wd:Q622550] }
  OPTIONAL { ?item wdt:P462 / p:P1813 [ pq:P3831 wd:Q102786; ps:P1813 ?col] }
  ?item wikibase:statements ?st; wikibase:sitelinks ?sl; wikibase:identifiers ?ids.
}
ORDER BY DESC(xsd:integer(strafter(str(?item),"Q")))
LIMIT 1000
