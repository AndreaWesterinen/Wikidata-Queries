SELECT ?item
WHERE { 
  ?item wdt:P1343 wd:Q602358; wdt:P31 wd:Q5 .
  ?enlink schema:about ?item ; schema:isPartOf <https://en.wikipedia.org/> . 
  ?delink schema:about ?item ; schema:isPartOf <https://de.wikipedia.org/> . 
  ?frlink schema:about ?item ; schema:isPartOf <https://fr.wikipedia.org/> . 
  ?eslink schema:about ?item ; schema:isPartOf <https://nl.wikipedia.org/> .
  ?zhlink schema:about ?item ; schema:isPartOf <https://zh.wikipedia.org/> . 
MINUS { ?wru schema:about ?item ; schema:isPartOf <https://ru.wikipedia.org/> . }
}
