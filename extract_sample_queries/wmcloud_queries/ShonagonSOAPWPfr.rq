SELECT ?item WHERE {
{
    ?item wdt:P31 ?sub0 .
    ?sub0 (wdt:P279)* wd:Q3305213 .
    ?wiki0 <http://schema.org/about> ?item .
    ?wiki0 <http://schema.org/isPartOf> <https://fr.wikipedia.org/> .
    OPTIONAL { ?item wdt:P170 ?dummy1 }
    FILTER(!bound(?dummy1))
} UNION {
    ?item wdt:P31 ?sub2 .
    ?sub2 (wdt:P279)* wd:Q3305213 .
    ?wiki1 <http://schema.org/about> ?item .
    ?wiki1 <http://schema.org/isPartOf> <https://fr.wikipedia.org/> .
    OPTIONAL { ?item wdt:P195 ?dummy3 }
    FILTER(!bound(?dummy3))
    ?item wdt:P18 ?dummy4 .
} UNION {
    ?item wdt:P31 ?sub5 .
    ?sub5 (wdt:P279)* wd:Q3305213 .
    ?wiki2 <http://schema.org/about> ?item .
    ?wiki2 <http://schema.org/isPartOf> <https://fr.wikipedia.org/> .
    OPTIONAL { ?item wdt:P18 ?dummy6 }
    FILTER(!bound(?dummy6))
}
}
