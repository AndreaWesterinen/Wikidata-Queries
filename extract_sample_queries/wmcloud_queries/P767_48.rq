SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P767 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P1545, wd:P1932, wd:P9687, wd:P9688, wd:P3831, wd:P518, wd:P580, wd:P582, wd:P10663, wd:P1310, wd:P3680, wd:P1303 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
