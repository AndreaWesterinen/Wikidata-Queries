SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P2032 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P1480, wd:P1326, wd:P4241, wd:P642, wd:P276, wd:P1319, wd:P2868, wd:P2241, wd:P3629, wd:P805, wd:P136, wd:P828, wd:P1478, wd:P5102 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
