SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P457 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P958, wd:P2868, wd:P3831, wd:P1480, wd:P2567, wd:P585, wd:P2241, wd:P7452, wd:P1545, wd:P407, wd:P50, wd:P2093, wd:P1476, wd:P123, wd:P98, wd:P291, wd:P179, wd:P433, wd:P304, wd:P1104, wd:P1433, wd:P577, wd:P953 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
