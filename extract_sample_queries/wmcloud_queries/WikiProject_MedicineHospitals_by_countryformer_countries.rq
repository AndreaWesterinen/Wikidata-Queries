SELECT DISTINCT ?item ?status 
WHERE 
{ VALUES ?c { wd:Q43287 wd:Q153963 wd:Q34266 wd:Q1206012 wd:Q165008 wd:Q7318 wd:Q41304 wd:Q193714 }
?item wdt:P31/wdt:P279* wd:Q16917; wdt:P17 ?c
OPTIONAL { ?item p:P31/ps:P31 wd:Q64578911 . BIND(wd:Q64578911 as ?status1) } BIND(COALESCE(?status1,wd:Q64624840) as ?status)
}
