SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P996 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P4714, wd:P7668, wd:P1104, wd:P304, wd:P577, wd:P478, wd:P3831, wd:P2241, wd:P7452, wd:P8330, wd:P407, wd:P275 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
