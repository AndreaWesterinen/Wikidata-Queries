#title: Items with incomplete location and/or collection provenance
# Complex constraint from [[Property talk:P10760]]
# All items should have [[Property:P276|location&#32;<small dir="ltr">(P276)</small>]] and [[Property:P195|collection&#32;<small dir="ltr">(P195)</small>]] set to [[d:Q1053735|Munich Central Collecting Point <small>(Q1053735)</small>]], but that shouldn't be the current (preferred) value
SELECT ?item ?id WHERE {
  ?item wdt:P10760 ?id .
  MINUS { ?item p:P276/ps:P276 wd:Q1053735 ;
                p:P195/ps:P195 wd:Q1053735 .
         MINUS { ?item wdt:P276 wd:Q1053735 . ?item wdt:P195 wd:Q1053735 }
         }
  }
