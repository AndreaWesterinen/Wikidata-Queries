SELECT ?title_en ?title_bn ?link_en ?link_bn
WHERE
{
  ?link_bn schema:isPartOf <https://bn.wikipedia.org/> .
  ?link_bn schema:name ?title_bn .
  ?link_bn schema:about ?item .
  MINUS { ?item wdt:P31/wdt:P279* wd:Q17379835. }
  ?link_en schema:about ?item .
  ?link_en schema:isPartOf <https://en.wikipedia.org/> .
  ?link_en schema:name ?title_en .
}
