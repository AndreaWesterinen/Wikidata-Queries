SELECT ?item ?itemLabel ?value ?valueLabel ?class ?classLabel ?snak 
WHERE
{
	{
		SELECT DISTINCT ?item ?value ?class ?snak {
			{
				?item wdt:P8411 ?value .
				BIND("mainsnak" AS ?snak) .
			} UNION {
				?statement0 pq:P8411 ?value .
				?item ?p0 ?statement0 .
				BIND("qualifier" AS ?snak) .
			} UNION {
				?ref pr:P8411 ?value .
				?statement1 prov:wasDerivedFrom ?ref .
				?item ?p1 ?statement1 .
				BIND("reference" AS ?snak) .
			} .
			MINUS {
				VALUES ?classes { wd:Q271669 wd:Q107425 wd:Q811430 wd:Q42889 wd:Q3895768 wd:Q11410 wd:Q30126005 wd:Q20871196 wd:Q17334923 wd:Q107 wd:Q2249676 wd:Q15710813 wd:Q192851 wd:Q653928 wd:Q559618 wd:Q1431026 wd:Q4830453 wd:Q2221906 wd:Q3238337 } .			
				?value wdt:P279* ?classes .
			} .
			OPTIONAL {
				?value wdt:P279 ?class .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
