embed.html##500 most used classes (according to SQID) with less than 5 model items
SELECT ?class ?classLabel ?model_item_statement_count ?query_top_ten_items
WHERE {
  {
    SELECT DISTINCT ?class (COUNT(?modelItem) as ?model_item_statement_count)
    WHERE {
