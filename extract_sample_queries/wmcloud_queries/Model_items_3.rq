      OPTIONAL { ?class wdt:P5869 ?modelItem } #with model items if present
     
    } GROUP BY ?class
  }
  
  FILTER (?model_item_statement_count < 5) #only show properties with 5 or less Model Item statements
  BIND (xsd:integer( SUBSTR(STR(?class), 33) ) as ?itemNumber) #use item number as a basic rank for 'top' classes 
  BIND ("https://query.wikidata.org/embed.html#SELECT%20%3Fitem%20%3FitemLabel%20%3Fstatement_count%0AWHERE%20%7B%0A%20%20%3Fitem%20wdt%3AP31%20wd%3AQitemNumber%20.%0A%20%20%3Fitem%20wikibase%3Astatements%20%3Fstatement_count%20.%0A%20%20SERVICE%20wikibase%3Alabel%20%7B%20bd%3AserviceParam%20wikibase%3Alanguage%20\"%5BAUTO_LANGUAGE%5D%2Cen\".%20%7D%0A%7D%0AORDER%20BY%20DESC%20%28%3Fstatement_count%29%0ALIMIT%2010"
        as ?query_template)       
  BIND (URI(REPLACE(?query_template,"itemNumber", STR(?itemNumber))) as ?query_top_ten_items) #generate query URL by inserting property number into template
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
ORDER BY (?itemNumber)
