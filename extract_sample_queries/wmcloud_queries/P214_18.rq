SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P214 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P813, wd:P742, wd:P2562, wd:P1477, wd:P1810, wd:P2241, wd:P1448, wd:P1889, wd:P5168, wd:P4070, wd:P518, wd:P8327, wd:P7452, wd:P4970, wd:P580, wd:P582 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
