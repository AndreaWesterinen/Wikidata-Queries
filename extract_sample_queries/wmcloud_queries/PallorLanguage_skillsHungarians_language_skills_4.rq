SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity wdt:P27 wd:Q28; wdt:P31 wd:Q5; wdt:P103 wd:Q9067 . 
  MINUS { ?entity wdt:P1412 []; wdt:P27 wd:Q28; wdt:P31 wd:Q5; wdt:P103 wd:Q9067  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
