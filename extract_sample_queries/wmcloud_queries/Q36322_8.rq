embed.html##title: films with Jane Austen missing "director" (P57)
SELECT DISTINCT ?film ?filmLabel ?filmDescription 
{
  	hint:Query hint:optimizer "None" .
  	?film ?wdt wd:Q36322 .
  	?property wikibase:directClaim ?wdt ; wikibase:claim ?p ; wikibase:statementProperty ?ps
  	{ ?film wdt:P31/wdt:P279* wd:Q11424 } UNION { ?film wdt:P31 wd:Q5398426 }
    FILTER NOT EXISTS { ?film wdt:P57 [] }   
    SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
