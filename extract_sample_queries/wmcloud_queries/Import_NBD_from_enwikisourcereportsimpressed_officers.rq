SELECT ?item ?itemLabel ?itemDescription ?dob ?start ?age ?entry
{
	?entry		wdt:P1433 wd:Q16055052 .
	?entry		wdt:P31 wd:Q19389637 .
  	?entry 		wdt:P921 ?item .
	?item wdt:P1343 wd:Q16055052 . 
	?item wdt:P793 wd:Q2566803 . 
    ?item wdt:P31 wd:Q5 . 
    OPTIONAL { ?item p:P241 [ ps:P241 wd:Q172771 ; pq:P580 ?start ] } 
    OPTIONAL { ?item wdt:P569 ?dob }
    BIND(YEAR(?start) - YEAR(?dob) as ?age)
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" }
}
ORDER BY DESC(?start)
