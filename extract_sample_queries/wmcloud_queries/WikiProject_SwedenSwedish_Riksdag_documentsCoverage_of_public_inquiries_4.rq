SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity p:P31 ?ps .  ?ps ps:P31 wd:Q20669447 . ?ps pq:P361 wd:Q7604015 . 
  MINUS { ?entity wdt:P179 []; p:P31 ?ps .  ?ps ps:P31 wd:Q20669447 . ?ps pq:P361 wd:Q7604015  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
