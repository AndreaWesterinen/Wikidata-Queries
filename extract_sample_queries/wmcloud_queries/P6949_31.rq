SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P6949 [] .
			MINUS {
				VALUES ?classes { wd:Q386724 wd:Q17737 wd:Q1151067 wd:Q17489659 wd:Q3331189 wd:Q15306849 wd:Q850270 wd:Q22811462 wd:Q16103215 wd:Q170584 wd:Q43229 wd:Q376799 wd:Q58778 wd:Q1656682 wd:Q431289 wd:Q10929058 wd:Q811701 wd:Q179550 wd:Q4485156 wd:Q3591867 wd:Q88392887 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
