SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity wdt:P495 ?countries FILTER (?countries IN (wd:Q40, wd:Q183, wd:Q39)). FILTER EXISTS {?entity (wdt:P31/(wdt:P279*)) wd:Q11424. } . 
  MINUS { ?entity wdt:P495 []; wdt:P495 ?countries FILTER (?countries IN (wd:Q40, wd:Q183, wd:Q39)). FILTER EXISTS {?entity (wdt:P31/(wdt:P279*)) wd:Q11424. }  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
