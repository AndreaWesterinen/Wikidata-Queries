SELECT ?item ?item2 (REPLACE(CONCAT('[', ?formatter, ' $1]'), '\\$1', ?de663) AS ?url) WITH {
  SELECT * {
    ?item wdt:P5504/^wdt:P5504 ?item2 .
    FILTER( STR( ?item ) < STR( ?item2 ) ) .
  }
} AS %duplicates WITH {
  SELECT * { wd:P5504 wdt:P1630 ?formatter } LIMIT 1
} AS %formatter WHERE {
  INCLUDE %duplicates .
  INCLUDE %formatter .
  ?item wdt:P5504 ?de663 .
  ?item2 wdt:P5504 ?de663 .
} ORDER BY ?de663
