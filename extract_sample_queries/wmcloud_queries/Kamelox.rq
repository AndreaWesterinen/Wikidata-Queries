SELECT ?property ?propertyLabel ?propertyType (COUNT(*) AS ?cnt) WITH {
  SELECT DISTINCT ?item WHERE {
    ?item wdt:P106/wdt:P279* wd:Q26270618 .
  }
} AS %subquery WHERE {
  INCLUDE %subquery .
  ?item ?prop [] .
  ?property wikibase:claim ?prop; wikibase:propertyType ?propertyType .
  SERVICE wikibase:label { bd:serviceParam wikibase:language 'en' }
} GROUP BY ?property ?propertyLabel ?propertyType ORDER BY DESC(?cnt)
