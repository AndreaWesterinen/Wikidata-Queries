#types of Christmas decoration.
#Requesting EITHER wdt:P31 or wdt:P279* properties gives different sets of 3 results. 
#Having both [ wdt:P31/wdt:P279* ] gives the same result as just wdt:P31.
#Shouldn't all 6 results be visible when I query for wdt:P31/wdt:P279* ?

SELECT ?item ?itemLabel ?article
WHERE {
  ?item wdt:P31/wdt:P279* wd:Q641364.

SERVICE wikibase:label {bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
