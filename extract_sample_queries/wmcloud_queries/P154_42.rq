SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P154 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P407, wd:P17, wd:P580, wd:P582, wd:P585, wd:P7452, wd:P2241, wd:P805, wd:P2868, wd:P3831, wd:P518, wd:P1001, wd:P5102, wd:P2096, wd:P282, wd:P5168, wd:P642, wd:P287, wd:P366, wd:P8555, wd:P1319, wd:P8554, wd:P1326, wd:P8798, wd:P462, wd:P6216, wd:P527, wd:P2739, wd:P1810, wd:P180, wd:P6802, wd:P6500 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
