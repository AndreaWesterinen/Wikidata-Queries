SELECT DISTINCT ?item ?itemLabel WHERE {
  ?item wdt:P31 wd:Q5.
  ?item wdt:P6379 wd:Q17153751.
  {
    ?item wdt:P19 ?pob.
    ?pob wdt:P17 wd:Q17.
  }
  UNION
  {
    ?item wdt:P937 ?pow.
    ?pow wdt:P17 wd:Q17.
  }
  UNION
  {
    ?item wdt:P551 ?por.
    ?por wdt:P17 wd:Q17.
  }
  UNION
  {
    ?item wdt:P20 ?pod.
    ?pod wdt:P17 wd:Q17.
  }
  UNION
  {
    ?item wdt:P27 wd:Q17.
  }
  FILTER NOT EXISTS {?item wdt:P7763 []}.  
}
