embed.html#SELECT ?lang ?count (100 * (?count / ?total) as ?percent) WITH { SELECT (COUNT(?item) as ?total) { ?item wdt:P7151 ?code } } AS %tc WITH { SELECT ?lang (COUNT(?il) AS ?count) WHERE { ?item wdt:P7151 ?code . ?item rdfs:label ?il. BIND(LANG(?il) as ?lang) FILTER(?lang in ("as", "bn", "gu", "hi", "kn", "ks-arab", "ks-deva", "gom-deva", "gom-latn", "mai", "ml", "mni", "mr", "ne", "or", "pa", "pnb", "sa", "sat", "sd", "ta", "te", "ur", "anp", "awa", "bho", "lus", "pi", "tcy")) } GROUP BY ?lang } AS %lc { INCLUDE %tc. INCLUDE %lc. }
