SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P1581 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P407, wd:P813, wd:P1019, wd:P580, wd:P582, wd:P1065, wd:P2960, wd:P577, wd:P1476, wd:P2241, wd:P5102, wd:P7101, wd:P7014, wd:P7452, wd:P1319, wd:P8554, wd:P8555, wd:P1326, wd:P6954, wd:P805, wd:P2868, wd:P123, wd:P1932, wd:P921 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
