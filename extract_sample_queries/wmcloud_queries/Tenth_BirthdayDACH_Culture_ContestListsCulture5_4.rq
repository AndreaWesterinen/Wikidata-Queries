SELECT ?grouping (COUNT(DISTINCT ?entity) as ?count) (SAMPLE(?entity) as ?sample) WHERE { ?entity wdt:P31 wd:Q7725634.
  {
    ?entity wdt:P50 ?author.
    ?author wdt:P19 ?place.
    ?place wdt:P17 ?country.
  }
  UNION
  {
    ?entity wdt:P50 ?author.
    ?author wdt:P27 ?country.
  }
  UNION
  {
    ?entity wdt:P4647 ?firstperformance.
    ?firstperformance wdt:P17 ?country.
  }
FILTER (?country IN (wd:Q40, wd:Q183, wd:Q39)). ?entity wdt:P4647/wdt:P17|wdt:P50/(wdt:P27|wdt:P19/wdt:P17) ?grouping .} GROUP BY ?grouping HAVING (?count >= 600) ORDER BY DESC(?count) LIMIT 1000
