SELECT ?item ?itemLabel ?value ?valueLabel ?instance ?instanceLabel ?snak 
WHERE
{
	{
		SELECT DISTINCT ?item ?value ?instance ?snak {
			{
				?item wdt:P812 ?value .
				BIND("mainsnak" AS ?snak) .
			} UNION {
				?statement0 pq:P812 ?value .
				?item ?p0 ?statement0 .
				BIND("qualifier" AS ?snak) .
			} UNION {
				?ref pr:P812 ?value .
				?statement1 prov:wasDerivedFrom ?ref .
				?item ?p1 ?statement1 .
				BIND("reference" AS ?snak) .
			} .
			MINUS {
				VALUES ?classes { wd:Q11862829 wd:Q1047113 wd:Q336 wd:Q17376908 wd:Q8434 wd:Q223393 wd:Q1792379 wd:Q34379 wd:Q629206 wd:Q56055944 wd:Q62302889 wd:Q22684100 wd:Q1665984 wd:Q2465832 wd:Q2267705 } .			
				?value wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?value wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
