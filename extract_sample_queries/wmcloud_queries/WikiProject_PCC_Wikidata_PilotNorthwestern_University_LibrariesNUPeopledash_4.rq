SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity wdt:P5008 wd:Q104665671; wdt:P31 wd:Q5  SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } . 
  MINUS { ?entity wdt:P21 []; wdt:P5008 wd:Q104665671; wdt:P31 wd:Q5  SERVICE wikibase:label { bd:serviceParam wikibase:language "en" }  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
