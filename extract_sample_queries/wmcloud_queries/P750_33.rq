SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P750 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P400, wd:P580, wd:P582, wd:P17, wd:P291, wd:P2699, wd:P1810, wd:P2241, wd:P437, wd:P1932, wd:P5102, wd:P2541 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
