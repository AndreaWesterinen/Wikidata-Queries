SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P460 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P1013, wd:P1480, wd:P828, wd:P459, wd:P1310, wd:P3680, wd:P3005, wd:P7528, wd:P2241, wd:P7452, wd:P3831, wd:P805, wd:P1810, wd:P5102, wd:P580, wd:P582, wd:P1552, wd:P585, wd:P2868, wd:P4649 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
