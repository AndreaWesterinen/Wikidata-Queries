SELECT DISTINCT ?itemLabel ?item  ?origineleNaam  ?naam ?genderLabel ?auteursrechtenstatusLabel ?RKD ?geboortedatum ?overlijdensdatum ?gelijk 
{
	?item wdt:P6379 wd:Q2114028 .
    ?item wdt:P31 wd:Q5.
    ?item rdfs:label ?label.
   ?item p:P6379 [ ps:P6379 wd:Q2114028;
                    prov:wasDerivedFrom 
                    [ pr:P1810 ?origineleNaam; 
                    ]
                  ].
    BIND (CONCAT (STRAFTER(?origineleNaam, ', '), ' ', (STRBEFORE(?origineleNaam, ', '))) AS ?origineleNaamReversed).
    BIND ( IF (CONTAINS (?origineleNaam, ", "), ?origineleNaamReversed, ?origineleNaam ) AS ?naam )

    BIND (CONTAINS(?label, ?naam) AS ?gelijk)
    FILTER((LANG(?label)) = "nl")

          OPTIONAL { ?item p:P569/psv:P569 [wikibase:timePrecision ?birth_precision; wikibase:timeValue ?birth]
          BIND(if(?birth_precision=11,concat(str(year(?birth)),"-",str(month(?birth)),"-",str(day(?birth))),if(?birth_precision=10,concat(str(year(?birth)),"-",str(month(?birth))),if(?birth_precision=9,year(?birth),""))) as ?geboortedatum) }
          OPTIONAL { ?item p:P570/psv:P570 [wikibase:timePrecision ?death_precision; wikibase:timeValue ?death]
          BIND(if(?death_precision=11,concat(str(year(?death)),"-",str(month(?death)),"-",str(day(?death))),if(?death_precision=10,concat(month(?death)," ",year(?death)),year(?death))) as ?overlijdensdatum) }

  ?item wdt:P7763 ?auteursrechtenstatus.
    OPTIONAL {
       ?item wdt:P650 ?RKD.
    }
    OPTIONAL {
       ?item wdt:P21 ?gender.
    }
    SERVICE wikibase:label { bd:serviceParam wikibase:language "nl,en" } .
}
ORDER BY ?itemLabel 
