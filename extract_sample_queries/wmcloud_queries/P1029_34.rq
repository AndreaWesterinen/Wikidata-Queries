#Target required claim report for P1029: report listing each item and value

SELECT ?item ?itemLabel ?value ?valueLabel ?target ?targetLabel ?snak
WHERE
{
	{
		SELECT DISTINCT ?item ?value ?target ?snak
		WHERE
		{
			{
				?item p:P1029/ps:P1029 ?value .
				BIND("mainsnak" AS ?snak) .
			} UNION {
				?statement0 pq:P1029 ?value .
				?item ?p0 ?statement0 .
				BIND("qualifier" AS ?snak) .
			} UNION {
				?ref pr:P1029 ?value .
				?statement1 prov:wasDerivedFrom ?ref .
				?item ?p1 ?statement1 .
				BIND("reference" AS ?snak) .
			} .
			VALUES ?values { wd:Q11631 wd:Q45199 wd:Q2095549 wd:Q47064 wd:Q3492027 wd:Q475604 wd:Q849424 wd:Q60319535 wd:Q23640580 wd:Q70597531 wd:Q10669499 wd:Q408832 wd:Q20623701 wd:Q12634815 wd:Q186360 wd:Q1436517 wd:Q87265645 wd:Q78158126 wd:Q115099231 } .
			MINUS {
				?value p:P106/ps:P106 ?values .
			} .
			OPTIONAL {
				?value p:P106/ps:P106 ?target .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
