SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P742 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P3831, wd:P407, wd:P898, wd:P580, wd:P582, wd:P282, wd:P642, wd:P805, wd:P2241, wd:P7452, wd:P2440, wd:P1706, wd:P1814, wd:P2125, wd:P8555, wd:P1319, wd:P8554, wd:P1326, wd:P3005, wd:P138, wd:P10663, wd:P7528, wd:P2183, wd:P5886, wd:P4970, wd:P1721, wd:P527 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
