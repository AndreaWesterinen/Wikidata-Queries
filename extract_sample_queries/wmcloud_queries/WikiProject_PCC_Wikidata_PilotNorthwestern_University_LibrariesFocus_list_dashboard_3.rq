SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity wdt:P5008 wd:Q104665671  SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } . 
  MINUS { ?entity wdt:P31 []; wdt:P5008 wd:Q104665671  SERVICE wikibase:label { bd:serviceParam wikibase:language "en" }  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
