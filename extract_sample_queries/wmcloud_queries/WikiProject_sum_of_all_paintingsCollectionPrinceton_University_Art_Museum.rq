SELECT ?item WHERE {
  ?item p:P195/ps:P195 wd:Q2603905 .
  ?item wdt:P31 wd:Q3305213 .
  MINUS { ?item wdt:P170/wdt:P570 ?dod .
          FILTER(YEAR(?dod) < 1925 ) .                
         { ?item wdt:P1071/wdt:P17*/wdt:P30* [] } UNION { ?item wdt:P170/wdt:P27/wdt:P30 [] }
        #MINUS { ?item wdt:P4765 [] } 
        } 
    MINUS { ?item wdt:P170 [] ;
                  wdt:P571 [] .          
         { ?item wdt:P1071/wdt:P17*/wdt:P30* [] } UNION { ?item wdt:P170/wdt:P27/wdt:P30 [] }
        #MINUS { ?item wdt:P4765 [] } 
        }   
  } LIMIT 1500
