#title: Works with creator missing link
# Complex constraint from [[Property talk:P2174]]
# List of works that are in [[Property:P195|collection&#32;<small dir="ltr">(P195)</small>]] [[d:Q188740|Museum of Modern Art <small>(Q188740)</small>]] or have [[Property:P2014|Museum of Modern Art work ID&#32;<small dir="ltr">(P2014)</small>]] and have [[Property:P170|creator&#32;<small dir="ltr">(P170)</small>]] set, but that creator doesn't have a [[Property:P21741|P21741&#32;<small dir="ltr">(P21741)</small>]] link
SELECT DISTINCT ?item ?creator
{
	{ ?item wdt:P195 wd:Q188740 } UNION
    { ?item wdt:P2014 [] } . 
    ?item wdt:P170 ?creator .
	MINUS { ?creator wdt:P2174 [] } .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" }
} ORDER BY ?creatorLabel
