embed.html##defaultView:Map{"hide": "?coor"}
SELECT DISTINCT ?item ?itemLabel ?itemDescription ?coor ?layerLabel (SAMPLE(?img) as ?image) (GROUP_CONCAT(DISTINCT ?title; separator="; ") as ?episodetitles)
{
    BIND( wd:Q2632294 as ?series )
    hint:Query hint:optimizer "None".
    { { ?series wdt:P915 ?item }
      UNION
      { ?ep wdt:P179 ?series ; wdt:P915 ?item ; wdt:P1476 ?title }
      BIND (wd:Q1045481 as ?layer) 
    }
    UNION
    { { ?series wdt:P840 ?item }
      UNION
      { ?ep wdt:P179 ?series ; wdt:P840 ?item ; wdt:P1476 ?title }
      BIND (wd:Q105115142 as ?layer)
    }
    ?item wdt:P625 ?coor.
    OPTIONAL { ?item wdt:P18 ?img }
    SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
GROUP BY  ?item ?itemLabel ?itemDescription ?coor ?layerLabel
