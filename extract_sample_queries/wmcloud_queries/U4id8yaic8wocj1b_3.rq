SELECT ?country ?entity ?countryLabel ?entityLabel ?area WHERE {
  {
    SELECT ?country (MAX(?a) AS ?a) WHERE {
      ?entity wdt:P31/wdt:P279* wd:Q10864048 ;
             p:P2046/psn:P2046/wikibase:quantityAmount ?a ;
             wdt:P17 ?country .
      ?country wdt:P31 wd:Q3624078 .
      FILTER NOT EXISTS { ?entity wdt:P31/wdt:P279* wd:Q15042037 }
    }
    GROUP BY ?country
  }
  ?entity wdt:P31/wdt:P279* wd:Q10864048 ;
         p:P2046/psn:P2046/wikibase:quantityAmount ?a ;
         wdt:P17 ?country .
  ?country wdt:P31 wd:Q3624078 .
  FILTER NOT EXISTS { ?entity wdt:P31/wdt:P279* wd:Q15042037 }
  BIND(ROUND(?a / 1000000) AS ?area)
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". } 
} 
ORDER BY ?countryLabel
