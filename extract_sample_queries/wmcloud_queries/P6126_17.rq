  MINUS { ?item wdt:P411 [] }
  MINUS { ?item wdt:P841 [] }
  MINUS { ?item wdt:P1441 [] }
  MINUS { ?item wdt:P4286 [] }
  MINUS { ?item wdt:P8366 [] }
}
