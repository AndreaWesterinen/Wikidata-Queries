SELECT ?item ?itmlbl ?wardno ?muncipality ?mulbl WHERE {
  ?item wdt:P31 wd:Q1195098;
    wdt:P131 wd:Q1142979;
    p:P361 ?id.
  ?id pq:P1545 ?wardno.
  ?item wdt:P361 ?muncipality.
  ?muncipality wdt:P31 wd:Q15284.
  OPTIONAL {
    ?item rdfs:label ?itmlbl.
    ?muncipality rdfs:label ?mulbl.
    FILTER((LANG(?itmlbl)) = "ml")
    FILTER((LANG(?mulbl)) = "ml")
  }
}
