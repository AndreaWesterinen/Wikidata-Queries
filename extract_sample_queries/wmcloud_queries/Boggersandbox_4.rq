SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity SELECT ?entity ?entityLabel ?entityDescription ?st ?sl ?ids WHERE {
  ?entity (wdt:P31/(wdt:P279*)) wd:Q163740.
  VALUES ?exclude {
      wd:Q7278
      wd:Q4438121
      wd:Q1030034
  }
  MINUS {
    ?entity (wdt:P31/(wdt:P279*)) ?exclude.
  }
} . 
  MINUS { ?entity wdt:P17 []; SELECT ?entity ?entityLabel ?entityDescription ?st ?sl ?ids WHERE {
  ?entity (wdt:P31/(wdt:P279*)) wd:Q163740.
  VALUES ?exclude {
      wd:Q7278
      wd:Q4438121
      wd:Q1030034
  }
  MINUS {
    ?entity (wdt:P31/(wdt:P279*)) ?exclude.
  }
}  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
