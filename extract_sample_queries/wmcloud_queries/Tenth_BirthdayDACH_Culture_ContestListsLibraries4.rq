SELECT ?entity ?entityLabel ?entityDescription ?st ?sl ?ids
WHERE
{
  ?entity wdt:P108 [(wdt:P31/(wdt:P279*)) wd:Q33506; wdt:P17 ?country];  wdt:P21 ?gender FILTER (?gender IN (wd:Q6581072, wd:Q6581097, wd:Q1097630, wd:Q1052281, wd:Q2449503, wd:Q48270)). VALUES ?country {wd:Q40 wd:Q39 wd:Q183 }. 
  # MINUS { ?entity wdt:   [] }
  OPTIONAL { ?entity wikibase:statements ?st ; wikibase:sitelinks ?sl ; wikibase:identifiers ?ids } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" } 
}
