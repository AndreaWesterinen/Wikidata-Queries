SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P9214 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P1476, wd:P407, wd:P577, wd:P7588, wd:P5017, wd:P2701, wd:P3575, wd:P1065, wd:P2241, wd:P582, wd:P7452, wd:P958, wd:P921, wd:P2960, wd:P813 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
