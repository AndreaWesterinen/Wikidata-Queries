SELECT DISTINCT ?item ?count 
WHERE
{
	{ 	SELECT ?item (count(?work) as ?count) 
      	WHERE
		{
      		?work wdt:P50 ?item .
            ?item wdt:P496 [].
    	}
    	GROUP BY ?item
		ORDER BY DESC(?count)
		LIMIT 1000                 
	}
  	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" . }
}
ORDER BY DESC(?count)
