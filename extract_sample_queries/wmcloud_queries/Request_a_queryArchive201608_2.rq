#Scientific authors known to Wikidata, who do not have an ORCID iD listed there
SELECT ?author ?authorLabel ?instit ?institLabel (COUNT(DISTINCT ?publication) AS ?count) WHERE {
  ?publication wdt:P31 wd:Q13442814.
  ?publication wdt:P50 ?author.
  ?author wdt:P108 ?instit .
  values ?instit { wd:Q34433 }
  #you can place as many items as you need in, for example - { wd:Q1 wd:Q2 wd:Q3 }
  MINUS { ?author wdt:P496 ?orcid. }
  MINUS {
    ?author wdt:P570 ?dod.
    FILTER((YEAR(?dod)) < 2012)
  }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
GROUP BY ?author ?authorLabel ?instit ?institLabel
ORDER BY DESC(?count)
