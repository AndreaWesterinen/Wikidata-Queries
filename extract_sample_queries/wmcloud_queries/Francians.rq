SELECT ?item ?comune ?comuneLabel
WHERE {
  ?item wdt:P31 wd:Q16970 .
  ?item wdt:P17 wd:Q38 .
  ?item wdt:P131 ?comune .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE]". }
  FILTER NOT EXISTS { ?comune wdt:P31 wd:Q747074 }
  FILTER NOT EXISTS { ?comune wdt:P31 wd:Q954172 }
}
