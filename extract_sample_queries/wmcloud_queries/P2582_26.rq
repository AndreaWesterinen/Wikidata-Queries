#title: In the museum without a link
# Complex constraint from [[Property talk:P2582]]
# Items that have [[Property:P195|collection&#32;<small dir="ltr">(P195)</small>]] → [[d:Q731126|J. Paul Getty Museum <small>(Q731126)</small>]], but that don't have a [[Property:P2582|J. Paul Getty Museum object ID&#32;<small dir="ltr">(P2582)</small>]] link
SELECT DISTINCT ?item ?url WHERE {
  ?item wdt:P195 wd:Q731126 .
  OPTIONAL { ?item wdt:P973 ?url } . 
  MINUS { ?item wdt:P2582 [] } .
}  LIMIT 500
