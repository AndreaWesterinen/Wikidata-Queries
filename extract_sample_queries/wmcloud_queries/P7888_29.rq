SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P7888 [] .
			MINUS {
				VALUES ?classes { wd:Q43229 wd:Q14623646 wd:Q35127 wd:Q1002697 wd:Q15642541 wd:Q121359 wd:Q2668072 wd:Q57662985 wd:Q15900616 wd:Q56061 wd:Q15042037 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
