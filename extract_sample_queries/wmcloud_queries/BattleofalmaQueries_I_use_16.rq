#Locations of settlements in Iraq, with images.
SELECT ?locationLabel (COUNT(?site) AS ?count)
WHERE {
   ?site wdt:P31/wdt:P279* wd:Q3957;
         wdt:P17 wd:Q796 ;
      wdt:P625 ?coord ;
      wdt:P18 ?image ;
      wdt:P131 ?location . 
  FILTER NOT EXISTS { ?site wdt:P31 wd:Q515 }
  MINUS {
    ?s wdt:P18 []  # exclude if there is an image
  }
SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en".}
  
}
Group by ?locationLabel
