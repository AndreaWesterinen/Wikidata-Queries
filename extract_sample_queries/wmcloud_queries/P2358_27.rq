#title: Labels in Spanish would generally be different from Latin
# Complex constraint from [[Property talk:P2358]]
# output: item with English label, Spanish label, Latin label
SELECT ?item ?es ?la
{
  ?item wdt:P2358 [ ] ; wdt:P31 wd:Q5 .
  ?item rdfs:label ?la . FILTER( lang(?la) = "la" ) 
  ?item rdfs:label ?es . FILTER( lang(?es) = "es" ) 
  FILTER( str(?es) = str(?la)  && !REGEX(?la, "^[^ ]+a( [^ ]+a)?$" ) )
}
LIMIT 1000
