select ?team ?teamLabel ?rider ?riderLabel ?occup ?occupLabel  where {
  ?team wdt:P31/wdt:P279* wd:Q1785271 .
  ?team wdt:P527 ?rider .
  ?rider wdt:P106 ?occup .
  MINUS { ?rider wdt:P106/wdt:P279* wd:Q2309784 . }
  
    SERVICE wikibase:label {
        bd:serviceParam wikibase:language "de,fr,en" .
    }

  }
