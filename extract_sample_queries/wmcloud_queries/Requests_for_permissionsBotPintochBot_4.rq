SELECT ?item ?itemLabel (COUNT(*) AS ?cnt) WITH {
  SELECT DISTINCT ?item WHERE { [] pr:P143 ?item }
} AS %subquery1 WITH {
  SELECT DISTINCT ?item ?itemLabel WHERE {
    INCLUDE %subquery1 .
    MINUS { ?item wdt:P31/wdt:P279* wd:Q14827288 }
    MINUS { ?item wdt:P31/wdt:P279* wd:Q63144794 }
    SERVICE wikibase:label { bd:serviceParam wikibase:language 'en' }
  }
} AS %subquery2 WHERE {
  INCLUDE %subquery2 .
  [] prov:wasDerivedFrom/pr:P143 ?item .
} GROUP BY ?item ?itemLabel ORDER BY DESC(?cnt)
