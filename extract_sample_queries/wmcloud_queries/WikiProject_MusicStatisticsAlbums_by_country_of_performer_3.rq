SELECT ?grouping (SAMPLE(?_higher_grouping) as ?higher_grouping) (COUNT(DISTINCT ?entity) as ?count) (SAMPLE(?entity) as ?sample) WHERE { ?entity wdt:P31 wd:Q482994. ?entity wdt:P175/(wdt:P495|wdt:P27) ?grouping. OPTIONAL { ?grouping wdt:P41  ?_higher_grouping } } GROUP BY ?grouping HAVING (?count > 0) ORDER BY DESC(?count) LIMIT 1000
