SELECT DISTINCT ?item ?itemlabelfr ?fr ?itemlabelhe ?he ?field ?fieldlabel { ?item wdt:P2521 ?he . FILTER(lang(?he)="he") OPTIONAL {	?item wdt:P2521 ?fr . 	FILTER(lang(?fr)="fr") } OPTIONAL { 	?item wdt:P425 ?field   SERVICE wikibase:label { bd:serviceParam wikibase:language "he" . ?field rdfs:label ?fieldlabel } } SERVICE wikibase:label { bd:serviceParam wikibase:language "he" . ?item rdfs:label ?itemlabelhe } SERVICE wikibase:label { bd:serviceParam wikibase:language "fr" . ?item rdfs:label ?itemlabelfr } }
