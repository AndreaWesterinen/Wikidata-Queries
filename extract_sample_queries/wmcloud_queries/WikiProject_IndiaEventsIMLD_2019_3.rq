SELECT DISTINCT ?item ?itemLabel ?constituency ?constituencyLabel ?start ?end ?replaces ?replacesLabel ?replaced_by ?replaced_byLabel WHERE {
  ?item p:P39 ?term.
  ?term ps:P39 wd:Q42509248.
  OPTIONAL { ?term pq:P768 ?constituency. }
  OPTIONAL { ?term pq:P580 ?start. }
  OPTIONAL { ?term pq:P582 ?end. }
  OPTIONAL { ?term pq:P1365 ?replaces. }
  OPTIONAL { ?term pq:P1366 ?replaced_by. }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
