#Target required claim report for P10254: report listing each item and value

SELECT ?item ?itemLabel ?value ?valueLabel ?target ?targetLabel ?snak
WHERE
{
	{
		SELECT DISTINCT ?item ?value ?target ?snak
		WHERE
		{
			{
				?item p:P10254/ps:P10254 ?value .
				BIND("mainsnak" AS ?snak) .
			} UNION {
				?statement0 pq:P10254 ?value .
				?item ?p0 ?statement0 .
				BIND("qualifier" AS ?snak) .
			} UNION {
				?ref pr:P10254 ?value .
				?statement1 prov:wasDerivedFrom ?ref .
				?item ?p1 ?statement1 .
				BIND("reference" AS ?snak) .
			} .
			VALUES ?values { wd:Q40 wd:Q213 } .
			MINUS {
				?value p:P17/ps:P17 ?values .
			} .
			OPTIONAL {
				?value p:P17/ps:P17 ?target .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
