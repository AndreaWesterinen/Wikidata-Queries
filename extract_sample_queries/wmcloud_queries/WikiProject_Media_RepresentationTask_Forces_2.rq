SELECT 
?item ?itemLabel (GROUP_CONCAT(DISTINCT ?title; separator=", ") AS ?titles) (MIN(YEAR(?date)) AS ?year)
  (GROUP_CONCAT(DISTINCT ?cinematographer_label; separator=", ") AS ?cinematographers)
   (GROUP_CONCAT(DISTINCT ?editor_label; separator=", ") AS ?editors)
      (GROUP_CONCAT(DISTINCT ?composer_label; separator=", ") AS ?composers)
       (GROUP_CONCAT(DISTINCT ?costume_designer_label; separator=", ") AS ?costume_designers)
        (GROUP_CONCAT(DISTINCT ?production_designer_label; separator=", ") AS ?production_designers)
         (GROUP_CONCAT(DISTINCT ?sound_designer_label; separator=", ") AS ?sound_designers)
          (GROUP_CONCAT(DISTINCT ?makeup_artist_label; separator=", ") AS ?makup_artists)
          (GROUP_CONCAT(DISTINCT ?exec_producer_label; separator=", ") AS ?exec_producers)
                                                                    
WHERE {
    VALUES ?list {wd:Q105406968 wd:Q95415779 wd:Q77855044}
    ?item wdt:P1343 ?list; wdt:P31/wdt:P279* wd:Q2431196.
    OPTIONAL{?item wdt:P1476 ?title}
    OPTIONAL{{?item wdt:P577 ?date} UNION {?item wdt:P580 ?date}}
    OPTIONAL{?item wdt:P344 ?cinematographer. ?cinematographer rdfs:label ?cinematographer_label. FILTER(LANG(?cinematographer_label)="en")}
    OPTIONAL{?item wdt:P1040 ?editor. ?editor rdfs:label ?editor_label. FILTER(LANG(?editor_label)="en")}
    OPTIONAL{?item wdt:P86 ?composer. ?composer rdfs:label ?composer_label. FILTER(LANG(?composer_label)="en")}
    OPTIONAL{?item wdt:P2515 ?costume_designer. ?costume_designer rdfs:label ?costume_designer_label. FILTER(LANG(?costume_designer_label)="en")}
    OPTIONAL{?item wdt:P2554 ?production_designer. ?production_designer rdfs:label ?production_designer_label. FILTER(LANG(?production_designer_label)="en")}
    OPTIONAL{?item wdt:P5028 ?sound_designer. ?sound_designer rdfs:label ?sound_designer_label. FILTER(LANG(?sound_designer_label)="en")}
    OPTIONAL{?item wdt:P4805 ?makeup_artist. ?makeup_artist rdfs:label ?makeup_artist_label. FILTER(LANG(?makeup_artist_label)="en")}
    OPTIONAL{?item wdt:P1431 ?exec_producer. ?exec_producer rdfs:label ?exec_producer_label. FILTER(LANG(?exec_producer_label)="en")}
    SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
GROUP BY ?item ?itemLabel
ORDER BY ?year
