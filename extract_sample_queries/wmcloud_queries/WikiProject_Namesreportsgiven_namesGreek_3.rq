SELECT DISTINCT ?item ?first ?count ?sample ?u
WITH
{
SELECT ?first (COUNT(?item0) as ?count) (SAMPLE(?item0) as ?sample)
{
    hint:Query hint:optimizer "None".
    VALUES ?c { wd:Q41 wd:Q229 }.
    ?item0 wdt:P27 ?c .
    FILTER NOT EXISTS { ?item0 p:P735 [] . } 
    ?item0 rdfs:label ?l . 
    FILTER( lang(?l) = "el" ) 
    BIND( strbefore( ?l, " ") as ?first) 
}
GROUP BY ?first 
HAVING ( ?count > 10)          
} as %a         
WHERE
{
  INCLUDE %a
  FILTER( ?first != "") 
  ?item rdfs:label ?first ; wdt:P31/wdt:P279? wd:Q202444 ; wdt:P407 wd:Q9129 .
  ?item wdt:P282 wd:Q8216 .
  OPTIONAL { ?item wdt:P2559 ?u . FILTER( lang(?u) = "en") }          
}
ORDER BY DESC(?count)
