#title: Russian Empire is used as nationality for people dead before 1721-10-22
# Complex constraint from [[Property talk:Q34266]]
# Items with [[Property:P27|country of citizenship&#32;<small dir="ltr">(P27)</small>]] equal to [[d:Q34266|Russian Empire <small>(Q34266)</small>]] and [[Property:P570|date of death&#32;<small dir="ltr">(P570)</small>]] before 1721-10-22
SELECT DISTINCT ?item WHERE {
  ?item wdt:P27 wd:Q34266 .
  ?item p:P570/psv:P570 ?node .
  ?node wikibase:timeValue ?born .
  ?node wikibase:timePrecision ?precision .
  FILTER (?born < "1721-10-22T00:00:00Z"^^xsd:dateTime)
  FILTER (?precision >= "9"^^xsd:integer)
}
