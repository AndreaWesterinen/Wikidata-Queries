#title: Check USA images
# Complex constraint from [[Property talk:P14]]
# Check if a USA road image is reused on a no-USA road
SELECT ?item ?value ?country WHERE {
  ?item wdt:P14 ?value.
  ?item wdt:P17 ?country.
  FILTER(REGEX(STR(?value), "(AK|AL|AR|AS|AZ|CA|CO|CT|DC|DE|FL|FM|GA|GU|HI|IA|ID|IL|IN|KS|KY|LA|MA|MD|ME|MH|MI|MN|MO|MP|MS|MT|NC|ND|NE|NH|NJ|NM|NV|NY|OH|OK|OR|PA|PR|PW|RI|SC|SD|TN|TX|UM|UT|VA|VI|VT|WA|WI|WV|WY)\-\d+\.(svg|png)")) .
  FILTER NOT EXISTS {
    ?item wdt:P17 wd:Q30.
  }
  FILTER( ?item NOT IN ( wd:Q5736742, wd:Q10343098 ) ) .
}
