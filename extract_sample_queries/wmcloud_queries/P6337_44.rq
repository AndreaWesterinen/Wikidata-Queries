SELECT ?item ?value WHERE
{
  ?item p:P6337/ps:P6337 ?value .
  
  FILTER( REGEX(REPLACE(STR(?value), "%20", " "), "^(([^\\ ]+)\\ ([^\\ ]+)\\ ([^\\ ]+)\\ ([^\\ ]+)\\ ([^\\ ]+)\\ ([^\\ ]+)\\ ([^\\ ]+)\\ ([^\\ ]+)\\ ([^\\ ]+)\\ ([^\\ ]+)\\ ([^\\ ]+)\\ ([^\\ ]+)\\ ([^\\ ]+)\\ ([^\\ ]+)\\ ([^\\ ]+)\\ ([^\\ ]+)\\ ([^\\ ]+)\\ ([^\\ ]+))$") )
}
