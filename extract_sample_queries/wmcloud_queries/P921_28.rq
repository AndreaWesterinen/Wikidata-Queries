SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P921 [] .
			MINUS {
				VALUES ?classes { wd:Q386724 wd:Q16334295 wd:Q1302249 wd:Q483394 wd:Q1656682 wd:Q600134 wd:Q131257 wd:Q1406161 wd:Q676586 wd:Q230788 wd:Q30612 wd:Q1964968 wd:Q23649976 wd:Q192909 wd:Q2904148 wd:Q9388534 wd:Q2668072 wd:Q178059 wd:Q379833 wd:Q21004260 wd:Q278485 wd:Q1298668 wd:Q101965 wd:Q17524420 wd:Q305178 wd:Q170584 wd:Q4503831 wd:Q62090711 wd:Q4915012 wd:Q955824 wd:Q978 wd:Q134995 wd:Q362165 wd:Q3239681 wd:Q151885 wd:Q2416723 wd:Q18593264 wd:Q21484471 wd:Q3689704 wd:Q12139612 wd:Q13406463 wd:Q14204246 wd:Q98144857 wd:Q18812548 wd:Q3026787 wd:Q108163 wd:Q16695773 wd:Q451967 wd:Q309 wd:Q131714 wd:Q20669447 wd:Q4406616 wd:Q190539 wd:Q853614 wd:Q6576792 wd:Q1151067 wd:Q17558136 wd:Q102345381 wd:Q110832782 wd:Q11862829 wd:Q55421512 wd:Q177634 wd:Q2800000 wd:Q10737 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
