# Query to find the most connected-to items in class ?c = Q13406463
  # pointed to by property ?prop = P196
  # Query generated by [[Template:MostConnectedToInstances]]

SELECT ?b ?bLabel ?count WHERE {
  {
    SELECT ?b (COUNT(*) AS ?count) WHERE {
       ?a ?prop ?b .
       ?b wdt:P31 ?c .
       BIND (wd:Q13406463 AS ?c) .
       BIND (wdt:P196 AS ?prop)
    } GROUP BY ?b
  } . 
  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "en" .
  }
}
# HAVING (?count > 1)
ORDER BY DESC(?count) ?bLabel
LIMIT 100
