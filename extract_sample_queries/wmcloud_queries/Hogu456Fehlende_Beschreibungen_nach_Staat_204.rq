PREFIX schema: <http://schema.org/>

#Missing description for a target language
#Search for missing descriptions in a target language.
#Can be input for Q29032512
SELECT ?item ?itemDescription ?itemLabel ?countryLabel ?instanceofLabel WITH {
  SELECT ?item ?country ?instanceof WHERE {
    VALUES ?instanceof { wd:Q644371 wd:Q1248784 wd:Q502074 }
    ?item wdt:P31 ?instanceof.
    ?item wdt:P17 ?country.
    FILTER(NOT EXISTS {
      ?item schema:description ?itemdesc.
      FILTER((LANG(?itemdesc)) = "de")
    })
  }
} AS %results WHERE {
  INCLUDE %results.
  SERVICE wikibase:label { bd:serviceParam wikibase:language "de". }
}
ORDER BY ?itemLabel
