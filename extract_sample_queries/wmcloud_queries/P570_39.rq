#title: Probably died
# Complex constraint from [[Property talk:P570]]
# People born before the year 1900, but no [[Property:P570|date of death&#32;<small dir="ltr">(P570)</small>]]
SELECT DISTINCT ?item WHERE {
  ?item p:P569 ?birthclaim .
  MINUS { ?item p:P570 [] }
  ?birthclaim ps:P569 ?birth .
  FILTER(?birth < "+1900-00-15T00:00:00Z"^^xsd:dateTime) .
} LIMIT 1000
