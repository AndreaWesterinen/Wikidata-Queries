SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity wdt:P31/wdt:P279* wd:Q43229; wdt:P485 wd:Q7060392 . 
  MINUS { ?entity wdt:P31 []; wdt:P31/wdt:P279* wd:Q43229; wdt:P485 wd:Q7060392  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
