SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity wdt:P31 / wdt:P279* wd:Q12819564 ; wdt:P127 wd:Q1122564 ; . 
  MINUS { ?entity wdt:P131 []; wdt:P31 / wdt:P279* wd:Q12819564 ; wdt:P127 wd:Q1122564 ;  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
