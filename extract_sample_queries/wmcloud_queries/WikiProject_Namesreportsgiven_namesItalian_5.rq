SELECT ?item ?l ?l_it 
  (COUNT(DISTINCT ?p) as ?count)
  (SAMPLE(?p) as ?sample_p)
{
    ?item wdt:P407 wd:Q652 ;
          wdt:P31/wdt:P279? wd:Q202444 . 
    ?item rdfs:label ?l. FILTER (lang(?l) = "en") 
    ?item rdfs:label ?l_it. FILTER (lang(?l_it) = "it"  && str(?l_it) != str(?l) ) 
    OPTIONAL { ?p wdt:P735 ?item }
}
GROUP BY ?item ?l ?l_it
ORDER BY DESC(?count) ?item
