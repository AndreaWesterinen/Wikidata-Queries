#title: Works with creator missing link
# Complex constraint from [[Property talk:P3544]]
# List of works that are in [[Property:P195|collection&#32;<small dir="ltr">(P195)</small>]] [[d:Q915603|Museum of New Zealand Te Papa Tongarewa <small>(Q915603)</small>]] and have [[Property:P170|creator&#32;<small dir="ltr">(P170)</small>]] set, but that creator doesn't have a [[Property:P3544|Te Papa agent ID&#32;<small dir="ltr">(P3544)</small>]] link
SELECT ?item ?url ?creator
{
	?item wdt:P195 wd:Q915603 .
	?item wdt:P170 ?creator .
	MINUS { ?creator wdt:P3544 [] } .
	MINUS { ?item wdt:P170 wd:Q4233718 } . # Filter out anonymous
	OPTIONAL {?item wdt:P973 ?url } .
}
