SELECT ?item 
#?itemLabel 
WITH {
  SELECT DISTINCT ?item WHERE {
  ?item wdt:P31 wd:Q13442814 ;
        wdt:P356 [] ;
        wdt:P921 [];
        wdt:P932 [];
        wdt:P2093 ?author.
  FILTER NOT EXISTS { ?item wdt:P50 [] .}
  }
  LIMIT 10000
} AS %papers
WHERE {
  INCLUDE %papers .
  		?item rdfs:label ?itemLabel.
		FILTER(LANG(?itemLabel) = "en").
 }
LIMIT 10000
