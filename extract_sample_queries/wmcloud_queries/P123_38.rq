SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P123 [] .
			MINUS {
				VALUES ?classes { wd:Q1151067 wd:Q80793969 wd:Q79509036 wd:Q95107111 wd:Q374814 wd:Q7397 wd:Q286583 wd:Q17538690 wd:Q7725634 wd:Q571 wd:Q11410 wd:Q105543609 wd:Q47461344 wd:Q7058673 wd:Q115473170 wd:Q116779426 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
