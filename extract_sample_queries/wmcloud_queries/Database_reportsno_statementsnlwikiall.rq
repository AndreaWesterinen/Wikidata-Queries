{
  hint:Query hint:optimizer "None".
  {
    SELECT (CONCAT("[[",strafter(str(?i),"y/"),"|",?n,"]]") as ?l)
    {
      ?i wikibase:statements 0 . [ ] schema:about ?i ; schema:isPartOf <https://nl.wikipedia.org/>; schema:name ?n
    }
  }
}
