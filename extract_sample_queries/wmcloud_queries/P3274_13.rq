SELECT ?item ?itemLabel ?value ?valueLabel ?snak ?rank ?statement
WHERE
{
  {
    SELECT ?item ?value ?result ?snak ?rank ?statement WHERE {
      {
        ?item p:P3274 ?statement .
        ?statement ps:P3274 ?value; wikibase:rank ?rank .
        BIND("mainsnak" AS ?snak) .
      } UNION {
        ?statement pq:P3274 ?value; wikibase:rank ?rank .
        ?item ?p1 ?statement .
        BIND("qualifier" AS ?snak) .
      } UNION {
        ?ref pr:P3274 ?value .
        ?statement prov:wasDerivedFrom ?ref; wikibase:rank ?rank .
        ?item ?p2 ?statement .
        BIND("reference" AS ?snak) .
      } .
      FILTER( ?value  IN ( wd:Q70487275, wd:Q52, wd:Q17459, wd:Q37312, wd:Q2537428, wd:Q1145963, wd:Q58013292, wd:Q16985801, wd:Q689141, wd:Q602243, wd:Q14005, wd:Q66429487, wd:Q31181, wd:Q4044680, wd:Q56193019, wd:Q220509, wd:Q504063, wd:Q5366830, wd:Q85132595, wd:Q693730, wd:Q104417646 ) ) .
    } LIMIT 100
  } .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
