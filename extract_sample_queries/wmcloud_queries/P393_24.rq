SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P393 [] .
			MINUS {
				VALUES ?classes { wd:Q3331189 wd:Q27968055 wd:Q13219666 wd:Q13406554 wd:Q1656682 wd:Q732577 wd:Q20826013 wd:Q1364556 wd:Q79719 wd:Q10688145 wd:Q13136 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
