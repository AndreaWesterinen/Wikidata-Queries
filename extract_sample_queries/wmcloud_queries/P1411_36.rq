SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P1411 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P1810, wd:P1686, wd:P585, wd:P805, wd:P4353, wd:P6949, wd:P1706, wd:P155, wd:P156, wd:P1552, wd:P1932, wd:P453, wd:P4633, wd:P674, wd:P1480, wd:P1319, wd:P8555, wd:P8554, wd:P1326, wd:P642, wd:P2453, wd:P1065, wd:P2960, wd:P2241, wd:P7452, wd:P1545, wd:P2553, wd:P1476 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
