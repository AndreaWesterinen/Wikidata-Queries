SELECT ?item ?itemLabel ?count WHERE {
  {
    SELECT ?item (COUNT(DISTINCT ?imo) AS ?count) WHERE {
      ?item wdt:P31 wd:Q11446;
        wdt:P458 ?imo.
    }
    GROUP BY ?item
  }
  FILTER(?count > 1 )
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
ORDER BY DESC (?count) (?itemL)
