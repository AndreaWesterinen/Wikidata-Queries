SELECT ?item ?itemLabel ?value ?valueLabel ?instance ?instanceLabel ?snak 
WHERE
{
	{
		SELECT DISTINCT ?item ?value ?instance ?snak {
			{
				?item wdt:P1056 ?value .
				BIND("mainsnak" AS ?snak) .
			} UNION {
				?statement0 pq:P1056 ?value .
				?item ?p0 ?statement0 .
				BIND("qualifier" AS ?snak) .
			} UNION {
				?ref pr:P1056 ?value .
				?statement1 prov:wasDerivedFrom ?ref .
				?item ?p1 ?statement1 .
				BIND("reference" AS ?snak) .
			} .
			MINUS {
				VALUES ?classes { wd:Q53617407 wd:Q15401930 wd:Q7079603 wd:Q11651 wd:Q11379 wd:Q13226383 wd:Q2424752 wd:Q11028 wd:Q1172284 wd:Q1408286 wd:Q1371819 wd:Q1310239 wd:Q3566043 wd:Q1799072 wd:Q28877 wd:Q110832782 wd:Q7406919 wd:Q192276 wd:Q14897293 wd:Q8187769 } .			
				?value wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?value wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
