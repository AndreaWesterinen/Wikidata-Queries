SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P1038 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P1039, wd:P1480, wd:P580, wd:P582, wd:P2241, wd:P7452, wd:P1319, wd:P8554, wd:P8555, wd:P1326, wd:P1545, wd:P2868, wd:P805, wd:P3680, wd:P1310, wd:P7528 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
