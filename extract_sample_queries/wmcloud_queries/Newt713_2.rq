SELECT ?grouping (COUNT(DISTINCT ?entity) as ?count) (SAMPLE(?entity) as ?sample) WHERE { ?entity wdt:P31/wdt:P279* wd:Q163740 MINUS { ?entity p:P31 ?statement1. ?statement1 (ps:P31/(wdt:P279*)) wd:Q7278. } MINUS { ?entity p:P31 ?statement2. ?statement2 (ps:P31/(wdt:P279*)) wd:Q4438121. } MINUS { ?entity p:P31 ?statement3. ?statement3 (ps:P31/(wdt:P279*)) wd:Q1030034. }. ?entity wdt:P17 ?grouping .} GROUP BY ?grouping HAVING (?count < 20) ORDER BY DESC(?count) LIMIT 1000
