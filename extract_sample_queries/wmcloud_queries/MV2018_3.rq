embed.html## Karte deutscher Brauereien
#defaultView:Map
SELECT ?brewery ?breweryLabel ?breweryDescription ?coord WHERE {
  ?brewery wdt:P31/wdt:P279* wd:Q131734;
           wdt:P17 wd:Q183;
           wdt:P625 ?coord.
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
