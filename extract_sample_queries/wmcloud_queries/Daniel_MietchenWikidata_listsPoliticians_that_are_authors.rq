SELECT DISTINCT ?item ?count
(REPLACE(STR(?item), ".*Q", "Q") AS ?qid) 
(CONCAT("[https://scholia.toolforge.org/author/", ENCODE_FOR_URI(?qid), " 🙋]") AS ?ScholiaURL) 

WITH {
  SELECT ?item WHERE {
    ?item wdt:P106 wd:Q82955 . # politicians
  }
}
AS %politicians
WITH {
  SELECT ?item (COUNT(DISTINCT ?publication) AS ?count) WHERE {
    INCLUDE %politicians
            ?publication wdt:P50 ?item . #authors
  }
  GROUP BY ?item ?count
  HAVING (?count > 200)
}
AS %publications
WHERE {
  INCLUDE %publications
          SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
GROUP BY ?item ?count ?qid ?ScholiaURL
ORDER BY DESC(?count)
LIMIT 300
