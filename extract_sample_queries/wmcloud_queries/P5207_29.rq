#title: Streets in the Netherlands without BAG link
# Complex constraint from [[Property talk:P5207]]
# [[d:Q79007|street <small>(Q79007)</small>]] (and subclasses) with [[Property:P17|country&#32;<small dir="ltr">(P17)</small>]] [[d:Q55|Netherlands <small>(Q55)</small>]] that don't have a [[Property:P5207|BAG public space ID&#32;<small dir="ltr">(P5207)</small>]] link and don't have [[Property:P576|dissolved, abolished or demolished date&#32;<small dir="ltr">(P576)</small>]]
SELECT DISTINCT ?item WHERE { 
  ?item wdt:P31/wdt:P279* wd:Q79007 ;
        wdt:P17 wd:Q55 .
    MINUS { ?item wdt:P5207 [] } . 
    MINUS { ?item wdt:P576 [] } .
    MINUS { ?item wdt:P527/wdt:P5207 [] } .
  } LIMIT 2000
