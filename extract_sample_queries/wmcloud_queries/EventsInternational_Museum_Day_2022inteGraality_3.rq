SELECT ?grouping (COUNT(DISTINCT ?entity) as ?count) (SAMPLE(?entity) as ?sample) WHERE { ?entity (wdt:P31/(wdt:P279*)) wd:Q33506;  wdt:P17 ?countries FILTER (?countries IN (wd:Q40, wd:Q183, wd:Q142, wd:Q39, wd:Q38, wd:Q29999, wd:Q298, wd:Q36, wd:Q298, wd:Q414)). ?entity wdt:P17 ?grouping .} GROUP BY ?grouping HAVING (?count >= 5) ORDER BY DESC(?count) LIMIT 1000
