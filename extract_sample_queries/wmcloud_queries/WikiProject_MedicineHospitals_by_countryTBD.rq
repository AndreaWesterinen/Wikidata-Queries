SELECT ?item ?st ?sl ?coor ?itemLabel ?itemDescription ?img ?c1 ?l
WHERE 
{ 
    ?item wdt:P31/wdt:P279* wd:Q16917 . 
    FILTER NOT EXISTS { ?item p:P17 [] } 
    ?item wikibase:statements ?st ; wikibase:sitelinks ?sl
    OPTIONAL { ?item wdt:P625 ?coor }
    OPTIONAL { ?item wdt:P18 ?img }
    OPTIONAL { ?item wdt:P131/wdt:P17 ?c1 }
    OPTIONAL { ?item wikibase:sitelinks 1 . [] schema:about ?item ; schema:inLanguage ?l } 
    SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
