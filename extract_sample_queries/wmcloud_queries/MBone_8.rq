SELECT ?qid ("Dfr" AS ?pid) (CONCAT('"quartier de ', ?label, '"') AS ?value) WHERE {
  ?item p:P31/ps:P31/wdt:P279* wd:Q19658107.
  ?item p:P131/ps:P131/wdt:P131* ?city.
  ?city p:P31/ps:P31/wdt:P279* wd:Q3184121;
        rdfs:label ?label.
  FILTER(LANG(?label) = "pt")
  BIND(SUBSTR(STR(?item), (STRLEN(STR(<http://www.wikidata.org/entity/>))) + 1) AS ?qid)
  MINUS {?item schema:description ?desc FILTER (LANG (?desc) = "fr") .}
}
LIMIT 5000
