SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P35 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P1319, wd:P580, wd:P582, wd:P805, wd:P1393, wd:P459, wd:P39, wd:P2868, wd:P2241, wd:P7452, wd:P4895, wd:P8555, wd:P8554, wd:P1326, wd:P1706, wd:P3831, wd:P1365, wd:P1366 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
