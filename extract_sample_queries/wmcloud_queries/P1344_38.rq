SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P1344 [] .
			MINUS {
				VALUES ?classes { wd:Q5 wd:Q16334295 wd:Q16391167 wd:Q26887428 wd:Q12973014 wd:Q7397 wd:Q68 wd:Q95074 wd:Q14514600 wd:Q17537576 wd:Q26401003 wd:Q215627 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
