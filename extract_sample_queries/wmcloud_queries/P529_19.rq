SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P529 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P2043, wd:P2049, wd:P186, wd:P585, wd:P582, wd:P2044, wd:P18, wd:P805, wd:P625, wd:P580, wd:P571, wd:P912, wd:P242, wd:P366, wd:P5817, wd:P2241, wd:P7452, wd:P8555, wd:P1319, wd:P8554, wd:P1326, wd:P1810, wd:P276 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
