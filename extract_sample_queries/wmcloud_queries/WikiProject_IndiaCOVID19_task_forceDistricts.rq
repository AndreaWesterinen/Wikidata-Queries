SELECT DISTINCT ?item ?dist ?state ?start_time ?cases ?cases_time ?recs ?recs_time ?deaths ?deaths_time 
WITH {
  SELECT ?item ?dist ?cases ?cases_time {
    wd:Q84055514 wdt:P527/wdt:P527 ?item. ?item wdt:P276 ?dist.
    OPTIONAL { ?item p:P1603 ?casestmt. ?casestmt ps:P1603 ?cases. OPTIONAL { ?casestmt pq:P585 ?cases_time } }
    FILTER NOT EXISTS { ?item p:P1603/pq:P585 ?cases_time_ . FILTER(?cases_time_ > ?cases_time) }
  }
}
AS %cases
WITH {
  SELECT ?item ?dist ?deaths ?deaths_time {
    wd:Q84055514 wdt:P527/wdt:P527 ?item. ?item wdt:P276 ?dist.
    OPTIONAL { ?item p:P1120 ?deathstmt. ?deathstmt ps:P1120 ?deaths. OPTIONAL { ?deathstmt pq:P585 ?deaths_time } }
    FILTER NOT EXISTS { ?item p:P1120/pq:P585 ?deaths_time_ . FILTER(?deaths_time_ > ?deaths_time) }
  }
}
AS %deaths
WITH {
  SELECT ?item ?dist ?recs ?recs_time {
    wd:Q84055514 wdt:P527/wdt:P527 ?item. ?item wdt:P276 ?dist.
    OPTIONAL { ?item p:P8010 ?recstmt. ?recstmt ps:P8010 ?recs. OPTIONAL { ?recstmt pq:P585 ?recs_time } }
    FILTER NOT EXISTS { ?item p:P8010/pq:P585 ?recs_time_ . FILTER(?recs_time_ > ?recs_time) }
  }
}
AS %recs
WHERE {
  INCLUDE %cases. INCLUDE %deaths. INCLUDE %recs. 
  ?dist wdt:P31 wd:Q1149652 ; wdt:P131* ?state.
  {?state wdt:P31 wd:Q13390680.} UNION {?state wdt:P31 wd:Q467745.}
  OPTIONAL { ?item wdt:P580 ?start_time. }
}
ORDER BY DESC (?cases)
