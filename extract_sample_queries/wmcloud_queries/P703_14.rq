SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P703 [] .
			MINUS {
				VALUES ?classes { wd:Q8047 wd:Q37748 wd:Q27043950 wd:Q11173 wd:Q7020 wd:Q7868 wd:Q514 wd:Q420927 wd:Q4915012 wd:Q36496 wd:Q81163 wd:Q2996394 wd:Q898273 wd:Q417841 wd:Q22325163 wd:Q17339814 wd:Q189118 wd:Q7187 wd:Q2656896 wd:Q79529 wd:Q59199015 wd:Q56656227 wd:Q27493024 wd:Q224107 wd:Q17147 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
