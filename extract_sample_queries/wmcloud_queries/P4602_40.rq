SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P4602 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P276, wd:P1480, wd:P3629, wd:P1319, wd:P1326, wd:P2241, wd:P459, wd:P4241, wd:P4895, wd:P5102, wd:P421, wd:P7452, wd:P805, wd:P518, wd:P1932, wd:P5997 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
