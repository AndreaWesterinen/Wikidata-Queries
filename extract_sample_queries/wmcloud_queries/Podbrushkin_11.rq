# literary genres and it's subclasses
#defaultView:Tree
SELECT ?parent ?parentLabel ?type ?typeLabel ?subtype ?subtypeLabel 
WHERE {
  VALUES ?parent { wd:Q223393 }.
    ?type wdt:P31 ?parent .
   OPTIONAL {?subtype wdt:P279 ?type .}
    SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
ORDER BY ?typeLabel ?subtypeLabel
