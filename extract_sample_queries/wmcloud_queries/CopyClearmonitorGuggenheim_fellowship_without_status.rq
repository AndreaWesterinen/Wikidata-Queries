SELECT DISTINCT ?item (COUNT(?collectie) AS ?collectieCount)
WHERE 
{
  ?item wdt:P31 wd:Q5.
  ?item wdt:P166 wd:Q1316544.
  ?item wdt:P6379 ?collectie.
  FILTER NOT EXISTS {
  ?item wdt:P7763 [].
  }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}

GROUP BY ?item
HAVING (?collectieCount > 1)
ORDER BY DESC (?collectieCount)
