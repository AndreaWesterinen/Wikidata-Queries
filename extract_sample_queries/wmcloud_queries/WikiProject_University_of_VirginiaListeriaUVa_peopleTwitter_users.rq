SELECT DISTINCT ?twitter ?item ?item_label ?sl ?st
(CONCAT("[https://tools.wmflabs.org/author-disambiguator/?name=", ENCODE_FOR_URI(?item_label), "&filter=wdt%3AP2093+%22", ENCODE_FOR_URI(?item_label), "%22 '''''", ?item_label, "''''']") AS ?item_string_resolver) 
WHERE {
  { ?item ?property wd:Q213439. }
  UNION
  {
    ?item ?property2 _:b9.
    _:b9 wdt:P361 wd:Q213439.
  }
  ?item wdt:P31 wd:Q5.
  ?item wdt:P2002 ?twitter .
  ?item wikibase:statements ?st.
  ?item wikibase:sitelinks ?sl.
  ?item rdfs:label ?item_label.
  FILTER((LANG(?item_label)) = "en")
}
ORDER BY DESC(?sl) ?twitter ?item ?item_label ?st 
LIMIT 4000
