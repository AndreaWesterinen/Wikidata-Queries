SELECT DISTINCT ?item ?itemlabel (CONCAT("{","{subst:Urltowiki\u007Curl=", str(?itemart), "}","}") As ?wp) ?instance ?instancelabel ?field ?fieldlabel ?wpfieldarticle ?femalelabel WHERE { BIND("ca" as ?lang) . ?item wdt:P2521 ?femalelabel . FILTER(lang(?femalelabel)= ?lang ) ?item wdt:P31 ?instance . OPTIONAL { ?itemart <http://schema.org/about> ?item . FILTER(SUBSTR(str(?itemart), 1, 30) = "https://ca.wikipedia.org/wiki/") } OPTIONAL { ?item wdt:P425 ?field  . SERVICE wikibase:label { bd:serviceParam wikibase:language "ca" . ?field rdfs:label ?fieldlabel } OPTIONAL { ?fieldarticle <http://schema.org/about> ?field . FILTER(SUBSTR(str(?fieldarticle), 1, 30) = "https://ca.wikipedia.org/wiki/") BIND(CONCAT("{","{subst:Urltowiki\u007Curl=", str(?fieldarticle), "}","}") As ?wpfieldarticle) } } SERVICE wikibase:label { bd:serviceParam wikibase:language "ca" . ?item rdfs:label ?itemlabel } . SERVICE wikibase:label { bd:serviceParam wikibase:language "ca" . ?instance rdfs:label ?instancelabel } . } ORDER BY ?femalelabel
