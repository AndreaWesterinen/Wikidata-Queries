SELECT DISTINCT ?item ?itemLabel
WHERE
{
	VALUES ?instanceof  { wd:Q476028 wd:Q15944511 } 
  	?item wdt:P31 ?instanceof .
  	?item wdt:P17 wd:Q29 .
	FILTER NOT EXISTS { ?item wdt:P1448 [] . }
	?article schema:about ?item . ?article schema:isPartOf <https://el.wikipedia.org/>
  	SERVICE wikibase:label { bd:serviceParam wikibase:language "el" }
}
