SELECT
  (wd:Q2481549 as ?item) 
  ("year of publication" as ?xAxisTitle) 
  ("total pages published" as ?yAxisTitle)
  (GROUP_CONCAT(?year;separator=",") as ?x)
  (GROUP_CONCAT(?yeartotal;separator=",") as ?y)
  ("area" as ?type)
  ("200" as ?height) 
  ("600" as ?width) 
WHERE
{
  { select ?year (max(?pagestotal) as ?yeartotal)
{              
  SELECT ?vol ?year (SUM(?pages) as ?pagestotal)
  {
    ?volitem wdt:P179 wd:Q665807 . 
    ?volitem wdt:P577 ?pub .
    ?volitem wdt:P478 ?vol .
    BIND(YEAR(?pub) as ?year)
    OPTIONAL { 
      ?volitem2 wdt:P179 wd:Q665807 . 
      ?volitem2 wdt:P1104 ?pages . 
      ?volitem2 wdt:P478 ?vol2 .
      FILTER( xsd:integer(?vol2) <= xsd:integer(?vol) )
    }      
  }
  GROUP BY ?vol ?year
}                
GROUP BY ?year
ORDER BY DESC(?year)
  }
}
