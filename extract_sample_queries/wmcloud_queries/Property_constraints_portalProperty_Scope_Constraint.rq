SELECT ?Property_ ?Property_Label ?Property_Description ?scope_ ?scope_Label ?constraint_status_ ?constraint_status_Label
WHERE {
  
	?Property_ p:P2302 ?qualifiers_statement .
	?qualifiers_statement ps:P2302 wd:Q53869507 .
	OPTIONAL {?qualifiers_statement pq:P5314 ?scope_ .}
	OPTIONAL {?qualifiers_statement pq:P2316 ?constraint_status_ .}

	SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }

} 
