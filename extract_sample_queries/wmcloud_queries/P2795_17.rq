SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P2795 [] .
			MINUS {
				VALUES ?classes { wd:Q17350442 wd:Q13406554 wd:Q868557 wd:Q83620 wd:Q175331 wd:Q484170 wd:Q33506 wd:Q16970 wd:Q213441 wd:Q41176 wd:Q811430 wd:Q657449 wd:Q494829 wd:Q17334923 wd:Q1190554 wd:Q11446 wd:Q16686448 wd:Q618123 wd:Q5358913 wd:Q55521176 wd:Q4830453 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
