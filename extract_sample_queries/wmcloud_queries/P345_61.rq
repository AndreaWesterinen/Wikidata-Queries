SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P345 [] .
			MINUS {
				VALUES ?classes { wd:Q2431196 wd:Q5 wd:Q16334295 wd:Q1656682 wd:Q52688389 wd:Q95074 wd:Q24634210 wd:Q3464665 wd:Q622550 wd:Q618779 wd:Q7697093 wd:Q116741534 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
