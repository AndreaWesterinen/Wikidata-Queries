SELECT DISTINCT ?item ?itemLabel ?date WHERE { 
  ?item wdt:P31/wdt:P279* wd:Q40231 ; wdt:P585 ?date ; wdt:P541/wdt:P279* wd:Q30461 .
  MINUS { ?item wdt:P31/wdt:P279* wd:Q858439 }
  MINUS { ?item wdt:P31 wd:Q24097670; wdt:P361/wdt:P31/wdt:P279* wd:Q858439 }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
ORDER BY DESC(?date)
