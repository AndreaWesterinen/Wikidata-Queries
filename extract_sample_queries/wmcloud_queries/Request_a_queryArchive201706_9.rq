SELECT ?item ?sitelink_label ?label {
  ?wiki_sitelink schema:about ?item; schema:isPartOf <https://he.wikipedia.org/>; schema:name ?sitelink_label .
  ?item rdfs:label ?label .
  FILTER(LANG(?label) = 'he') .
  FILTER(false = (LCASE(?sitelink_label) = LCASE(?label)) ) .
  FILTER(false = CONTAINS(?sitelink_label, ')') ) .
} LIMIT 100
