embed.html##items based on humans
SELECT DISTINCT ?item ?itemLabel 
WHERE 
{
  ?item wdt:P144 ?value. ?value wdt:P31 wd:Q5.
  MINUS{?value wdt:P31 wd:Q4271324.}
  MINUS{?value wdt:P31 wd:Q12405827.}
  MINUS{?item wdt:P31/wdt:P279* wd:Q202444.}
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
