#title: P735 value should have P282
# Complex constraint from [[Property talk:P7338]]
# given name item should have [[Property:P282|writing system&#32;<small dir="ltr">(P282)</small>]]
SELECT DISTINCT ?item ?itemLabel 
{
	?prop p:P735 [ pq:P7338 ?ro; ps:P735 ?item ]
	MINUS { ?item p:P282 [] }
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" }  
}
ORDER BY ?itemLabel
