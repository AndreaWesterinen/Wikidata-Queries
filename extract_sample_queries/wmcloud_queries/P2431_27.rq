#title: Works with creator missing link
# Complex constraint from [[Property talk:P2431]]
# List of works that are in [[Property:P195|collection&#32;<small dir="ltr">(P195)</small>]] [[d:Q176251|Thyssen-Bornemisza Museum <small>(Q176251)</small>]] and have [[Property:P170|creator&#32;<small dir="ltr">(P170)</small>]] set, but that creator doesn't have a [[Property:P2431|Thyssen-Bornemisza artist ID&#32;<small dir="ltr">(P2431)</small>]] link
SELECT ?item ?creator 
{
	?item wdt:P195 wd:Q176251 .
    ?item wdt:P170 ?creator .
	MINUS { ?creator wdt:P2431 [] } .
	MINUS { ?item wdt:P170 wd:Q4233718 } . # Filter out anonymous
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en,en" }
} ORDER BY ?creatorLabel
