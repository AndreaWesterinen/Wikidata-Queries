embed.html#SELECT ?item ?name ?idcount ?sitelinks ?paintingcount WHERE {
    ?item wdt:P106 wd:Q1028181 .
    ?item wdt:P31 wd:Q5 .
    ?item wikibase:identifiers ?idcount .
    ?item wikibase:sitelinks ?sitelinks . 
   MINUS { ?item wdt:P3782 [] } 
  { # To filter out the painting dictators
    SELECT ?item (COUNT(?item) as ?paintingcount) WHERE {
    ?painting wdt:P31 wd:Q3305213 .  
    ?painting wdt:P170 ?item . 
     } GROUP BY ?item 
      HAVING (?paintingcount > 5)
  }
      SERVICE wikibase:label {
    bd:serviceParam wikibase:language "en" .
    ?item rdfs:label ?name .
   }
  }
ORDER BY DESC(?idcount )
LIMIT 501
