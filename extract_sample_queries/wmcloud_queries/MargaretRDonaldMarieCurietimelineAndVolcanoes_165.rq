# articles in the lichonologist
# the query also finds their article


SELECT DISTINCT ?item ?itemLabel ?volume ?author ?authorLabel WHERE {
  ?item wdt:P31 wd:Q13442814 ;         # is a scholarly article
    wdt:P478  ?volume;                 # volume
    wdt:P1433 wd:Q15755501 ;      # in The Lichenologist
    wdt:P50 ?author.
    SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". } 
  }
 ORDER BY  ?volume ?authorLabel
 LIMIT 4000    
