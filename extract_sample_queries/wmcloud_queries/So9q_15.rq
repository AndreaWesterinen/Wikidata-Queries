#Lexemes in Danish with a sense but no P5137
select distinct ?lexemeId ?lemma WHERE {
  ?lexemeId <http://purl.org/dc/terms/language> wd:Q9035;
            wikibase:lemma ?lemma;
            ontolex:sense ?sense.
  filter not exists {?sense wdt:P5137 []}.
  filter not exists {?sense wdt:P9970 []}.
}
