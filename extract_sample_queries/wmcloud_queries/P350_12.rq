#title: Items to split up
# Complex constraint from [[Property talk:P350]]
# Single value constraint and [[d:Q15727816|painting series <small>(Q15727816)</small>]] or [[d:Q79218|triptych <small>(Q79218)</small>]]. New items probably need to be created and some of the id's moved there.
SELECT DISTINCT ?item ?count ?sample
{
	{
		SELECT ?item (COUNT(?value) AS ?count) (SAMPLE(?value) AS ?sample) {
			?item wdt:P350 ?value .
            {?item wdt:P31 wd:Q15727816  } UNION {
            ?item wdt:P31 wd:Q79218 } .
		} GROUP BY ?item
	} .
	FILTER(?count > 1) .
} ORDER BY DESC(?count) LIMIT 500
