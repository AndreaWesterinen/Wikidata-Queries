#defaultView:Map
SELECT ?place ?placeLabel ?location ?article WHERE {
  wd:Q1885049 wdt:P625 ?loc . #ZDE NAHRADTE PRVNI WIKIDATA POLOZKU POLOZKOU MISTA, KOLEM NEHOZ CHCETE HLEDAT
  SERVICE wikibase:around { 
      ?place wdt:P625 ?location . 
      bd:serviceParam wikibase:center ?loc . 
      bd:serviceParam wikibase:radius "25" . #ZDE NAHRADTE CISLO POCTEM KILOMETRU, KTERE MAJI BYT POUZITY JAKO RADIUS KOLEM VASEHO MISTA
  } 
  MINUS {?place wdt:P18 ?img . } #VECI S OBRAZKEM
  MINUS {?article schema:about ?place .
    ?article schema:isPartOf <https://ceb.wikipedia.org/>.} #VECI Z CEBUANSKE WIKI
  MINUS {?place wdt:P4533 ?img . } #CESKE ULICE
  MINUS {?place wdt:P4352 ?img . } #KATOLICKE HRBITOVY
  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "cs,en" . 
  }
}
