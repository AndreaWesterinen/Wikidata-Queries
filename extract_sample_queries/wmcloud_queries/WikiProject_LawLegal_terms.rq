SELECT ?item  ?itemLabel ?lemma ?article WHERE { {select ?item ?article where {
 { ?item wdt:P31 wd:Q2135465} union { ?item wdt:P31 wd:Q16874643} union { ?item wdt:P31 wd:Q2608811} optional {?article schema:about ?item} } }
SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en"}
 OPTIONAL {?lexeme wikibase:lemma ?itemLabel.} 
 }
