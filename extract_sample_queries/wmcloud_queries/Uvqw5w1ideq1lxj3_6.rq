#defaultView:Timeline
SELECT ?item ?itemLabel ?image (MIN(?release) AS ?release) {
  ?item wdt:P31/wdt:P279* wd:Q7889 ; wdt:P577 ?release .
  ?article schema:about ?item .
  FILTER (SUBSTR(str(?article), 11, 15) = ".wikipedia.org/") .
  OPTIONAL { ?item wdt:P18 ?image . }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" . }
}
GROUP BY ?item ?itemLabel ?image
HAVING (COUNT(DISTINCT ?article) >= 42)
ORDER BY ?year
