SELECT ?item ?inv WHERE {
  ?item wdt:P31 wd:Q3305213 .
  ?item p:P217 ?invstatement .
  ?invstatement ps:P217 ?inv .
  ?invstatement pq:P195 wd:Q430682 .
  MINUS { ?item wdt:P195  wd:Q180788 .
           ?item p:P217 ?invstatement2 .
           ?invstatement2 ps:P217 ?inv2 .
  		?invstatement2 pq:P195 wd:Q180788 .
        }
  FILTER regex(?inv, "^N\\d+$") 
  } ORDER BY ?inv LIMIT 200
