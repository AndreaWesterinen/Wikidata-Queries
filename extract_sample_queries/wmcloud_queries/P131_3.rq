SELECT ?item ?itemLabel ?property ?propertyLabel ?value ?valueLabel ?localisation_administrative ?localisation_administrativeLabel WHERE {
  {
    SELECT DISTINCT ?item ?property ?value WHERE {
      ?item wdt:P131 _:b1.
      ?item wdt:P159 ?value.
      BIND(wd:P159 AS ?property)
    }
    LIMIT 1000
  }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "fr,en". }
  OPTIONAL { ?item wdt:P131 ?localisation_administrative. }
}
