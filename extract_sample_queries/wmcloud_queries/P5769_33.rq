SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P5769 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P1545, wd:P1932, wd:P9687, wd:P9688, wd:P3831, wd:P580, wd:P582, wd:P7452, wd:P1706, wd:P1534, wd:P1365, wd:P1366 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
