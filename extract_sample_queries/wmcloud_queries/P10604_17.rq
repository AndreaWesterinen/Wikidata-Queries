#title: values of property P10604 with most identifiers
SELECT ?item ?itemLabel ?itemDescription ?ids
WHERE
{
	?p wdt:P10604 ?item . 
    ?item wikibase:identifiers ?ids
    SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }      
}
ORDER BY DESC(?ids) ?item
LIMIT 100
