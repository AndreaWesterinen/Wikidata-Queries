SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity p:P39 [ ps:P39 [ wdt:P279 wd:Q16707842 ] ] . 
  MINUS { ?entity wdt:P39 ?grouping . wd:Q16707842 ^wdt:P279 []; p:P39 [ ps:P39 [ wdt:P279 wd:Q16707842 ] ]  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
