#title: Works with creator missing link
# Complex constraint from [[Property talk:P2252]]
# List of works that are in [[Property:P195|collection&#32;<small dir="ltr">(P195)</small>]] [[d:Q214867|National Gallery of Art <small>(Q214867)</small>]] and have [[Property:P170|creator&#32;<small dir="ltr">(P170)</small>]] set, but that creator doesn't have a [[Property:P2252|National Gallery of Art artist ID&#32;<small dir="ltr">(P2252)</small>]] link
SELECT ?item ?creator
{
	?item wdt:P195 wd:Q214867 .
    ?item wdt:P170 ?creator .
	MINUS { ?creator wdt:P2252 [] } .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en,en" }
} ORDER BY ?creatorLabel
