SELECT ?item ?itemLabel ?Legacies_of_British_Slave_ownership_person_ID ?UK_National_Archives_ID WHERE {
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
  OPTIONAL { ?item wdt:P3023 ?Legacies_of_British_Slave_ownership_person_ID. }
  OPTIONAL { ?item wdt:P3029 ?UK_National_Archives_ID. }
}
