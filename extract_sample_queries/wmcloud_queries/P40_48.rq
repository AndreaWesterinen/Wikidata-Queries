SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P40 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P1039, wd:P1545, wd:P1706, wd:P3831, wd:P25, wd:P22, wd:P3373, wd:P1441, wd:P1480, wd:P5102, wd:P805, wd:P3680, wd:P1310, wd:P7452, wd:P2241, wd:P10663 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
