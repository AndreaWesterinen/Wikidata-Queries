SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity wdt:P31/wdt:P279* wd:Q40080; wdt:P17 wd:Q408 . 
  MINUS { ?entity wdt:P131/wdt:P131* []; wdt:P31/wdt:P279* wd:Q40080; wdt:P17 wd:Q408  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
