#Museums in Scotland, if they have an en.wikipedia page, where they are, and an image if we have one
#added subclass of museums, hopefully this will pick up art galleries
SELECT DISTINCT ?Museum ?MuseumLabel ?place ?placeLabel ?image ?coord WITH { 
  SELECT ?Museum ?place WHERE
  {
  ?Museum wdt:P131* wd:Q22 . hint:Prior hint:gearing "forward".
  ?Museum wdt:P31/wdt:P279* wd:Q33506 . hint:Prior hint:gearing "forward".
  OPTIONAL {?Museum wdt:P276 ?place .}
  } } as %i
WHERE
{
  INCLUDE %i
  OPTIONAL {?Museum wdt:P625 ?coord }
  OPTIONAL {?article schema:about ?Museum .
  ?article schema:isPartOf <https://en.wikipedia.org/>}
  OPTIONAL { ?Museum wdt:P18 ?image }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
