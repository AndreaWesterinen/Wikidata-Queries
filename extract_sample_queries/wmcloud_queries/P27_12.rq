#title: Value "Niger" and place of birth in "Nigeria"
# Complex constraint from [[Property talk:P27]]
# Possible, but likely an error. TODO: double-check, then add a reference to the P27 statement or fix P27=[[d:Q1032|Niger <small>(Q1032)</small>]] -> [[d:Q1033|Nigeria <small>(Q1033)</small>]]
SELECT DISTINCT ?item 
{ 
  ?item wdt:P27 wd:Q1032 .
  ?item wdt:P19/wdt:P17? wd:Q1033 .
  FILTER NOT EXISTS { ?item wdt:P27 wd:Q1033 }
  ?item wdt:P31 wd:Q5.
  ?item p:P27 ?claim .
  ?claim ps:P27 wd:Q1032 .
  OPTIONAL { ?claim prov:wasDerivedFrom ?source . ?source ?p ?v . FILTER NOT EXISTS { ?v wdt:P31 wd:Q10876391 } } 
  FILTER(!bound(?source)) 
}
