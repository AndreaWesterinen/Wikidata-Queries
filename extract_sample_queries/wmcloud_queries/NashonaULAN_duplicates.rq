SELECT ?item ?item2 (REPLACE(CONCAT('[', ?formatter, ' $1]'), '\\$1', ?ulan) AS ?url) WITH {
  SELECT * {
    ?item wdt:P245/^wdt:P245 ?item2 .
    FILTER( STR( ?item ) < STR( ?item2 ) ) .
  }
} AS %duplicates WITH {
  SELECT * { wd:P245 wdt:P1630 ?formatter } LIMIT 1
} AS %formatter WHERE {
  INCLUDE %duplicates .
  INCLUDE %formatter .
  ?item wdt:P245 ?ulan .
  ?item2 wdt:P245 ?ulan .
} ORDER BY ?ulan
