SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P4791 [] .
			MINUS {
				VALUES ?classes { wd:Q176799 wd:Q17149090 wd:Q42889 wd:Q6619802 wd:Q645883 wd:Q18691599 wd:Q939616 wd:Q18011131 wd:Q18011141 wd:Q48900561 wd:Q178561 wd:Q65562770 wd:Q2811 wd:Q3114762 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
