SELECT ?grouping (SAMPLE(?_higher_grouping) as ?higher_grouping) (COUNT(DISTINCT ?entity) as ?count) (SAMPLE(?entity) as ?sample) WHERE { ?entity wdt:P31 ?type; wdt:P17 wd:Q34. FILTER(?type in (wd:Q14659, wd:Q2532754)). ?entity wdt:P31 ?grouping. OPTIONAL { ?grouping wdt:P31  ?_higher_grouping } } GROUP BY ?grouping HAVING (?count > 0) ORDER BY DESC(?count) LIMIT 1000
