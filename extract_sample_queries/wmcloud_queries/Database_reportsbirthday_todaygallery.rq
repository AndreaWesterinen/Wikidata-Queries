SELECT ?item (SAMPLE(?date) as ?date) (SAMPLE(?img) as ?img) (SAMPLE(?rank) as ?rank)
{
	SELECT ?item ?stct ?slct (?stct + ?slct*2 as ?rank) ?img ?date
	{
		?date_node wikibase:timePrecision "11"^^xsd:integer . 
		?date_node wikibase:timeValue ?date . 
		FILTER (year(?date) > 1898 && day(?date) = day(now()) && month(?date) = month(now())) 
		?item p:P569/psv:P569 ?date_node . 
		OPTIONAL {?item wdt:P570 ?dod} FILTER (!bound(?dod)) 
		OPTIONAL {?item wdt:P1087 ?e} FILTER (!bound(?e)) #saturates ranking
		?item wdt:P18 ?img .
		?item wdt:P31 wd:Q5 . 
		?item wikibase:statements ?stct .
		?item wikibase:sitelinks ?slct
	}
	ORDER BY DESC(?rank) ?item
	LIMIT 15
}
GROUP BY ?item
ORDER BY ?date
LIMIT 8
