SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity (wdt:P106/wdt:P279*) wd:Q1622272; wdt:P108/wdt:P17 wd:Q55 . 
  MINUS { ?entity wdt:P108 []; (wdt:P106/wdt:P279*) wd:Q1622272; wdt:P108/wdt:P17 wd:Q55  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
