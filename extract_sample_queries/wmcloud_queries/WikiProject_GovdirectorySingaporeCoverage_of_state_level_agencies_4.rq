SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity wdt:P31 ?grouping.
VALUES ?grouping {wd:Q112818479 wd:Q3507268} 
?entity wdt:P17 wd:Q334 .
  MINUS { ?entity wdt:P576 [] } . 
  MINUS { ?entity wdt:P31 []; wdt:P31 ?grouping.
VALUES ?grouping {wd:Q112818479 wd:Q3507268} 
?entity wdt:P17 wd:Q334 .
  MINUS { ?entity wdt:P576 [] }  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
