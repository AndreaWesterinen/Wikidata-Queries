SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P7153 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P3831, wd:P2868, wd:P1932, wd:P1810, wd:P585, wd:P366, wd:P1552, wd:P1766, wd:P1435, wd:P793, wd:P2795, wd:P276, wd:P625, wd:P6375, wd:P669, wd:P3018, wd:P8138, wd:P131, wd:P137, wd:P127, wd:P518, wd:P7452, wd:P2241 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
