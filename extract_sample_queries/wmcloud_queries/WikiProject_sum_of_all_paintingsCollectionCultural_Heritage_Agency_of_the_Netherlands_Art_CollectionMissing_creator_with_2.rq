SELECT DISTINCT ?item ?creator ?description ?itemwith ?addlink
  WITH {
    SELECT ?itemwith ?creator ?description WHERE {
      ?itemwith p:P195/ps:P195 wd:Q18600731 .
      ?itemwith wdt:P31 wd:Q3305213 .
      MINUS { ?itemwith wdt:P170 wd:Q4233718 } .
      ?itemwith wdt:P170 ?creator .  
      ?itemwith schema:description ?description . 
      FILTER(LANG(?description)="en")
    } 
  } AS %withcreator
  WITH {
    SELECT ?item ?creator ?description WHERE {
      ?item p:P195/ps:P195 wd:Q18600731 .
      ?item wdt:P31 wd:Q3305213 .
      MINUS { ?item wdt:P170 [] } .
      ?item schema:description ?description . 
      FILTER(LANG(?description)="en")
    } 
  } AS %withoutcreator
WHERE {
  INCLUDE %withcreator .
  INCLUDE %withoutcreator .
  BIND(CONCAT("[https://www.wikidata.org/w/index.php?title=", REPLACE(STR(?item), "http://www.wikidata.org/entity/", ""), "&action=edit&withJS=MediaWiki:AddQuickClaim.js&propertyid=P170&entityid=", REPLACE(STR(?creator), "http://www.wikidata.org/entity/", ""), " Add]") AS ?addlink)
} ORDER BY ?description
