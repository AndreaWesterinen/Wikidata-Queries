SELECT DISTINCT ?item (CONCAT("\u007b\u007bWikidata translate|", STR(?itemId), "|lang=sq\u007d\u007d") as ?translate) ?artist WHERE { 
  ?item wdt:P170 ?artist ; wdt:P195 wd:Q160236.
  ?artist wdt:P21 wd:Q6581072.
  ?article schema:about ?item. FILTER CONTAINS(STR(?article), ".wikipedia.org/wiki/")
  MINUS { ?wsq schema:about ?item. ?wsq schema:inLanguage "sq". ?wsq schema:isPartOf <https://sq.wikipedia.org/>. }
  BIND(CONCAT("[http://www.metmuseum.org/art/collection/search/", ?METobjID, " ", ?num, "]") as ?METurl)
  BIND(REPLACE(STR(?item), STR(wd:), "", "i") as ?itemId)
  SERVICE wikibase:label { bd:serviceParam wikibase:language "sq". }
}
