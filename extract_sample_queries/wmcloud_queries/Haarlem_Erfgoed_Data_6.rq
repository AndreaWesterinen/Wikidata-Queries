embed.html##defaultView:Map
SELECT ?street ?streetLabel ?namedafter ?namedafterLabel ?coords
WHERE 
{
  ?street wdt:P31 wd:Q79007.
  ?street wdt:P131 wd:Q9920 .
  ?street wdt:P138 ?namedafter .
  ?street wdt:P625 ?coords .
  ?namedafter wdt:P27 ?nationaliteit .
  FILTER (?nationaliteit NOT IN( wd:Q29999, wd:Q55, wd:Q170072)) .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
