#expeditions with participants with a NMVW-id
#expeditions with participants with a NMVW-id
SELECT ?participant ?participantLabel ?idnummer ?item ?itemLabel 
WHERE 
{
  ?item (wdt:P31/wdt:P279*) wd:Q2401485.
  ?item wdt:P710 ?participant .
  ?participant wdt:P7831 ?idnummer .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "nl,en". }
}
order by ASC(?participantLabel)
