SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P1957 [] .
			MINUS {
				VALUES ?classes { wd:Q3331189 wd:Q10870555 wd:Q820655 wd:Q133492 wd:Q13442814 wd:Q18918145 wd:Q87167 wd:Q47461344 wd:Q105543609 wd:Q11424 wd:Q16363676 wd:Q49848 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
