SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P655 [] .
			MINUS {
				VALUES ?classes { wd:Q3331189 wd:Q2635894 wd:Q25372 wd:Q26160672 wd:Q63141557 wd:Q7889 wd:Q17776219 wd:Q191067 wd:Q7725634 wd:Q234460 wd:Q105543609 wd:Q5 wd:Q47461344 wd:Q3750478 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
