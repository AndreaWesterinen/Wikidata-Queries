SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value (LANG(?value) AS ?lang)
WHERE
{
	?item p:P1448 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P580, wd:P582, wd:P1814, wd:P2440, wd:P2125, wd:P1942, wd:P2001, wd:P1721, wd:P4649, wd:P3831, wd:P138, wd:P2441, wd:P2241, wd:P1001, wd:P3680, wd:P5139, wd:P518, wd:P282, wd:P7452, wd:P2378, wd:P805, wd:P3938, wd:P1534, wd:P1269, wd:P2868, wd:P898, wd:P5102, wd:P407, wd:P1319, wd:P8554, wd:P8555, wd:P1326, wd:P459, wd:P1545, wd:P1264, wd:P4970, wd:P6254, wd:P8991, wd:P443, wd:P1480, wd:P2567, wd:P4187, wd:P276, wd:P4239, wd:P1535, wd:P4626, wd:P585, wd:P7018, wd:P790, wd:P7008, wd:P859, wd:P828 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
