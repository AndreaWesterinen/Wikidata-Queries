embed.html#
SELECT ?item ?itemLabel ?value ?valueLabel ?st WHERE {
  {
    SELECT * WHERE {
      ?item ?property wd:Q1622507.
      ?item wikibase:statements ?st.
    }
    ORDER BY ?st ?item
    LIMIT 100
  }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
ORDER BY ?st ?item
