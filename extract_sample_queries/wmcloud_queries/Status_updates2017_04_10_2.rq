SELECT DISTINCT ?street ?streetLabel ?length
{
  hint:Query hint:optimizer 'None' .
  ?street wdt:P131* wd:Q649 .
  ?street wdt:P31/wdt:P279* wd:Q79007 .
  ?street p:P2043/psn:P2043/wikibase:quantityAmount ?length .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "ru" }
}
ORDER BY DESC(?length) ?street
LIMIT 100
