SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity wdt:P106 [wdt:P279/wdt:P279* wd:Q36180]; wdt:P31 wd:Q5 . 
  MINUS { ?entity wdt:P1412 []; wdt:P106 [wdt:P279/wdt:P279* wd:Q36180]; wdt:P31 wd:Q5  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
