# AusFungi taxa without taxon authors 
  SELECT ?taxon_name (COUNT(DISTINCT ?item) AS ?count) WHERE {
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
  ?item wdt:P9076 ?ausFungiID.
  ?item p:P225 ?stat . 
  ?stat ps:P225 ?taxon_name.
  {?stat pq:P405 ?taxon_author.} 
}
GROUP BY  ?taxon_name
