SELECT ?item ?itemLabel ?property ?propertyLabel ?amount ?unit ?unitLabel WHERE {
  ?unit wdt:P31 wd:Q22302160 .
  ?item ?p [ ?psv [ wikibase:quantityAmount ?amount; wikibase:quantityUnit ?unit  ] ] .
  ?property wikibase:claim ?p .
  SERVICE wikibase:label { bd:serviceParam wikibase:language 'en' }
}
