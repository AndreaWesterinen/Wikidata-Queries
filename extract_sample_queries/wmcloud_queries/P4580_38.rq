#title: Works with creator missing link
# Complex constraint from [[Property talk:P4580]]
# List of works that are in [[Property:P195|collection&#32;<small dir="ltr">(P195)</small>]] [[d:Q700222|Berlinische Galerie <small>(Q700222)</small>]] and have [[Property:P170|creator&#32;<small dir="ltr">(P170)</small>]] set, but that creator doesn't have a [[Property:P4580|Berlinische Galerie artist ID&#32;<small dir="ltr">(P4580)</small>]] link
SELECT DISTINCT ?item ?creator
{
	{ ?item wdt:P195 wd:Q700222 } . 
    ?item wdt:P170 ?creator .
	MINUS { ?creator wdt:P4580 [] } .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en,de" }
} ORDER BY ?creatorLabel
