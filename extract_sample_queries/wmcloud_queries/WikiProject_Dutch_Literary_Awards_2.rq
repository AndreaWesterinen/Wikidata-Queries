OPTIONAL{?p wdt:P31 ?isA} #human
OPTIONAL{?p wdt:P21 ?gender} #male/female
OPTIONAL{?p wdt:P18 ?photo}  
  
OPTIONAL{?p wdt:P27 ?country.}
OPTIONAL{?p p:P27 [prov:wasDerivedFrom [pr:P854 ?countrySourceURL  ]].} 
OPTIONAL{?p p:P27 [prov:wasDerivedFrom [pr:P813 ?countrySourceDate]].} 
           
#OPTIONAL{?p wdt:P569 ?birthdate}
#OPTIONAL{?p p:P569 [prov:wasDerivedFrom [pr:P854 ?birthdateSourceURL  ]].} 
#OPTIONAL{?p p:P569 [prov:wasDerivedFrom [pr:P813 ?birthdateSourceDate]].} 
  
#OPTIONAL{?p wdt:P19 ?birthplace} 
