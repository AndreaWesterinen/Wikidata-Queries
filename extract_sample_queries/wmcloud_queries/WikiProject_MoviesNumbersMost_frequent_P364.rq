SELECT ?item  (COUNT(DISTINCT(?film)) AS ?ct) (SAMPLE(?sample) as ?sample)  
WHERE
{
  VALUES ?filmtype {wd:Q11424 wd:Q24862 wd:Q20667187 wd:Q226730} . 
  ?film wdt:P31 ?filmtype  . 
  ?film wdt:P364 ?item . 
  OPTIONAL { ?film wdt:P577 ?d . FILTER(YEAR(?d)=YEAR( Now() ))  BIND(?film as ?sample) }     
} 
GROUP BY ?item 
ORDER BY DESC(?ct) 
LIMIT 75
