embed.html#SELECT DISTINCT ?item ?itemLabel ?itemDescription ?place ?placeLabel ?sitelinks WHERE {
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
  ?item wikibase:sitelinks ?sitelinks.
  ?item wdt:P19 ?place. 
  ?place wdt:P131* wd:Q234735.
}
ORDER BY DESC (?sitelinks)
LIMIT 200
