SELECT DISTINCT ?item ?itemLabel (SAMPLE(?refURL) AS ?url) WHERE {
  ?item p:P69 ?statement .
  ?statement ps:P69 wd:Q523926 .
  ?statement pq:P582 ?date .
  FILTER NOT EXISTS { ?statement pq:P812 ?nothing . }
  OPTIONAL { 
    ?statement prov:wasDerivedFrom ?ref . 
    ?ref pr:P854 ?refURL .
  }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en" }
} GROUP BY ?item ?itemLabel
