SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P1476 [] .
			MINUS {
				VALUES ?classes { wd:Q386724 wd:Q1302249 wd:Q567696 wd:Q2668072 wd:Q1190554 wd:Q18593264 wd:Q3052382 wd:Q58778 wd:Q216200 wd:Q43229 wd:Q7748 wd:Q17489659 wd:Q115668308 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
