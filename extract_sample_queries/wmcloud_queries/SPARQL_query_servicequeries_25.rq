#Women born in the area of current Finland without articles in Finnish Wikipedia ranked by the number of articles in other Wikipedias

PREFIX schema: <http://schema.org/>

SELECT ?item ?itemLabel (COUNT(DISTINCT ?sitelink) AS ?count) WHERE {
  ?item wdt:P21 wd:Q6581072.
  ?item wdt:P19/wdt:P131* wd:Q33 .
  ?sitelink schema:about ?item.
  SERVICE wikibase:label { bd:serviceParam wikibase:language "fi,sv,en,de,fr". }
  FILTER(NOT EXISTS {
    ?wfr schema:about ?item.
    ?wfr schema:inLanguage "fi".
  })
}
GROUP BY ?item ?itemLabel
ORDER BY DESC(?count)
