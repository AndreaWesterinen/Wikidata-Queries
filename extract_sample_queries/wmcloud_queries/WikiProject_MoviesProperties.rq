embed.html#SELECT ?movie ?ord ?movieLabel ?locationLabel ?premieredate WHERE {
  ?movie p:P179 [ps:P179 wd:Q2732470; pq:P1545 ?ord] .
  ?movie p:P793 [ps:P793 wd:Q204854; pq:P276 ?location; pq:P585 ?premieredate] .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
} ORDER BY ?premieredate
