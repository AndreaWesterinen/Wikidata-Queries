SELECT ?item ?headofgov (GROUP_CONCAT(?headofgovinstanceof; SEPARATOR = "<br />")  AS ?hoginstancelist) ?council ?member (GROUP_CONCAT(?memberinstanceof; SEPARATOR = "<br />")  AS ?memberinstancelist) ?numberconstituencies (COUNT(?constituency) AS ?countconstituencies) (GROUP_CONCAT(?constituencyLab; SEPARATOR = "<br />") AS ?constituencyList) ?constype WHERE { 
  VALUES ?item   {wd:Q4663117 wd:Q3509517 wd:Q4670480 wd:Q28468899 wd:Q359955 wd:Q3510345 wd:Q3509545 wd:Q4694513 wd:Q3509013 wd:Q3510455 wd:Q4701504 wd:Q4701571 wd:Q4701976 wd:Q3509580 wd:Q4727632 wd:Q3509621 wd:Q4751505 wd:Q4766098 wd:Q3331583 wd:Q811144 wd:Q4903607 wd:Q865828 wd:Q4916902 wd:Q13140400 wd:Q4997683 wd:Q5097501 wd:Q5210142 wd:Q5252818 wd:Q1023713 wd:Q5347703 wd:Q5348227 wd:Q5350399 wd:Q5380873 wd:Q5404527 wd:Q5509089 wd:Q5519589 wd:Q5521392 wd:Q2425179 wd:Q5555061 wd:Q5565892 wd:Q591598 wd:Q600405 wd:Q5623248 wd:Q5623339 wd:Q5623719 wd:Q5983595 wd:Q5983592 wd:Q11058510 wd:Q5983608 wd:Q11058846 wd:Q5991116 wd:Q5991216 wd:Q5991414 wd:Q5991578 wd:Q3056230 wd:Q5995160 wd:Q1024647 wd:Q1658159 wd:Q5996228 wd:Q5996946 wd:Q6001104 wd:Q49104874 wd:Q6177061 wd:Q10967141 wd:Q6279136 wd:Q6344670 wd:Q13140547 wd:Q6345763 wd:Q218744 wd:Q10313749 wd:Q6375000 wd:Q937487 wd:Q6378876 wd:Q11008655 wd:Q6416264 wd:Q6433326 wd:Q6441191 wd:Q6443769 wd:Q1023721 wd:Q6472602 wd:Q6528787 wd:Q49106133 wd:Q994096 wd:Q6749158 wd:Q6777871 wd:Q2078475 wd:Q3139881 wd:Q6966608 wd:Q7038694 wd:Q681198 wd:Q7074973 wd:Q7079867 wd:Q623249 wd:Q2017187 wd:Q11275966 wd:Q7092211 wd:Q7101001 wd:Q7106648 wd:Q3511323 wd:Q20614811 wd:Q7396283 wd:Q7402971 wd:Q2276423 wd:Q280585 wd:Q7549885 wd:Q11058325 wd:Q7636917 wd:Q994119 wd:Q11058424 wd:Q255961 wd:Q15043628 wd:Q3510251 wd:Q1999000 wd:Q7970687 wd:Q7971327 wd:Q3510505 wd:Q648749 wd:Q8066201 wd:Q147975 wd:Q8075410}.
  MINUS {?item p:P31 ?node .
         ?node ps:P31 ?citytypes ;
               pq:P582 []}
  OPTIONAL {?item wdt:P1313 ?headofgov .
            ?headofgov wdt:P31 ?headofgovinstanceof
            MINUS { ?headofgov wdt:P576 [] } 
           } 
  OPTIONAL {?item wdt:P194 ?council 
                  OPTIONAL { ?council wdt:P4253 ?numberconstituencies } 
            OPTIONAL {?member wdt:P361 ?council .
                      ?member wdt:P279 wd:Q708492 . 
                      ?member wdt:P31 ?memberinstanceof
                      MINUS {?member wdt:P576 [] } 
           } 
            OPTIONAL { ?statement ps:P279 wd:Q192611 ;
                                  pq:P642 ?council.
                      ?constype p:P279 ?statement .
                      ?constituency wdt:P31/wdt:P279* ?constype ;
                                    rdfs:label ?constituencyLab . 
                      FILTER(lang(?constituencyLab) = 'en') 
                      MINUS { ?constituency wdt:P576 [] }
                     }
            MINUS { ?council wdt:P576 [] } 
            }
  MINUS { ?item wdt:P576 [] }
} 
GROUP BY ?item ?headofgov ?headofgovinstanceof ?council ?member ?memberinstanceof ?numberconstituencies ?constype 
ORDER BY ?item ?constituency
