SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P937 [] .
			MINUS {
				VALUES ?classes { wd:Q5 wd:Q95074 wd:Q16334295 wd:Q1747829 wd:Q21070568 wd:Q14514600 wd:Q4271324 wd:Q192581 wd:Q13002315 wd:Q4164871 wd:Q1047113 wd:Q28640 wd:Q228534 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
