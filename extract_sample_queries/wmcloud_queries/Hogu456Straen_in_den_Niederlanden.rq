#Missing description for a target language
#Search for missing descriptions in a target language.
#Can be input for Q29032512
SELECT ?item ?itemDescription ?itemLabel ?liegt_in_der_Verwaltungseinheit ?liegt_in_der_VerwaltungseinheitLabel WHERE {
  ?item (wdt:P131/wdt:P131) wd:Q694;
    wdt:P31 wd:Q79007.
  SERVICE wikibase:label { bd:serviceParam wikibase:language "de". }
  FILTER(EXISTS {
    ?item schema:description ?itemdesc.
    FILTER((LANG(?itemdesc)) = "de")
  })
  OPTIONAL { ?item wdt:P131 ?liegt_in_der_Verwaltungseinheit. }
}
ORDER BY (?itemLabel)
LIMIT 50000
