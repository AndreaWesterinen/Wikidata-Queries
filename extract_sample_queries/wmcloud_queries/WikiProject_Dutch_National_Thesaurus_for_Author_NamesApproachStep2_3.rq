#Items with statements where property P1006 uses the novalue special value
#by Jura1, 2015-02-27
SELECT
  ?item ?itemLabel
  (GROUP_CONCAT(?instanceLabel; separator=", ") as ?instanceLabels)
WHERE
{
  ?item p:P1006/a wdno:P1006
  OPTIONAL {?item wdt:P31 ?instance}
  SERVICE wikibase:label {   bd:serviceParam wikibase:language "nl,en,ru,ja,zh" .
                               ?item rdfs:label ?itemLabel . ?instance rdfs:label ?instanceLabel }
}
GROUP BY ?item ?itemLabel
LIMIT 100
