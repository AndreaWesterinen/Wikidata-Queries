SELECT ?item (COUNT(DISTINCT ?p) as ?count) (COUNT(DISTINCT ?p0) as ?with)  (?count - ?with as ?todo) ( ROUND(?with / ?count * 100 ) as ?percentage) 
{
  VALUES ?item { wd:Q213 wd:Q33946 wd:Q533534} 
  ?p wdt:P27 ?item .
  ?p wdt:P31 wd:Q5 .
  OPTIONAL { ?p p:P734 [] . BIND( ?p as ?p0) }
}
GROUP BY ?item 
ORDER BY DESC(?count)
