SELECT ?ceremony (xsd:integer(?number) AS ?edition) ?count ((COUNT(?item) - ?count) AS ?diff)
WITH {
    SELECT DISTINCT ?item ?ceremony ?st ?number WHERE {
    ?ceremony wdt:P31 wd:Q4504495; wdt:P1269 wd:Q223740; wdt:P393 ?number.
    ?st pq:P805 ?ceremony.
    ?item p:P166 ?st; wdt:P31/wdt:P279* wd:Q2431196.
    }
} AS %winners
WHERE {
    VALUES (?ed ?count) {
    (1 12) #1988
    (2 16) #1989
    (3 15) #1990
    (4 14) #1991
    (5 14) #1992
    (6 9) #1993
    (7 4) #1994
    (8 3) #1995
    (9 7) #1996
    (10 11) #1997
    (11 15) #1998
    (12 14) #1999
    (13 14) #2000
    (14 14) #2001
    (15 15) #2002
    (16 16) #2003
    (17 15) #2004
    (18 17) #2005
    (19 14) #2006
    (20 13) #2007
    (21 14) #2008
    (22 15) #2009
    (23 14) #2010
    (24 14) #2011
    (25 15) #2012
    (26 18) #2013
    (27 18) #2014
    (28 18) #2015
    (29 20) #2016
    (30 20) #2017
    (31 21) #2018
    (32 22) #2019
    (33 21) #2020
    (34 22) #2021
    (35 22) #2022
    }
  
   INCLUDE %winners
   FILTER(?ed = xsd:integer(?number))
    
}
GROUP BY ?ceremony ?number ?count
ORDER BY ?edition #?item
