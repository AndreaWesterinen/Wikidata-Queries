#defaultView:Map
SELECT DISTINCT ?item ?itemLabel ?communityLabel ?image ?coords WHERE {
  ?item wdt:P31/wdt:P279* wd:Q164240 ;
        wdt:P17 wd:Q29 ;
        wdt:P131+ ?community .
  ?community wdt:P31 wd:Q10742 .
  OPTIONAL { ?item wdt:P18 ?image . }
  OPTIONAL { ?item wdt:P625 ?coords . }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en" . }
} ORDER BY ?itemLabel
