SELECT DISTINCT ?item ?dep ?status ?da WHERE 
{ ?item wdt:P31/wdt:P279* wd:Q16917; wdt:P17 wd:Q35
OPTIONAL { ?item p:P31/ps:P31 wd:Q64578911 . BIND(wd:Q64578911 as ?status1) } BIND(COALESCE(?status1,wd:Q64624840) as ?status)
OPTIONAL { ?item rdfs:label ?da . FILTER(lang(?da)="da") }
OPTIONAL { ?item wdt:P131/wdt:P131* ?dep . ?dep wdt:P31 wd:Q62326 }
}
