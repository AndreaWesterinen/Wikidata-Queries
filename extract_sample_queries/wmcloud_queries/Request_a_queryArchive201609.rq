#Populated places in Nigeria
SELECT ?place ?placeLabel ?location
WHERE
{
  ?place wdt:P31/wdt:P279* wd:Q486972; # human settlement or subclass therof
         wdt:P17 wd:Q1033 . # in Nigeria
  OPTIONAL { ?place wdt:P625 ?location. } # optionally has coordinates
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
