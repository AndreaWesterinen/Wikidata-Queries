SELECT ?gene ?gtLabel ?protein ?ptLabel WHERE {
  ?gene wdt:P688 ?protein .
  ?gene wdt:P351 ?entrez .
  ?protein wdt:P352 ?uni .
  ?gene wdt:P703 ?gt .
  ?protein wdt:P703 ?pt .
  FILTER (?gt != ?pt)
  ?gt rdfs:label ?gtLabel; FILTER(LANG(?gtLabel) = "en").
  ?pt rdfs:label ?ptLabel; FILTER(LANG(?ptLabel) = "en").
}
