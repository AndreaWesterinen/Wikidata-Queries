#title: Items without ID
# Complex constraint from [[Property talk:P8616]]
# Items in [[d:Q1558|Kansas <small>(Q1558)</small>]] that do have [[d:Q19558910|National Register of Historic Places listed place <small>(Q19558910)</small>]]  in [[Property:P1435|heritage designation&#32;<small dir="ltr">(P1435)</small>]], but not [[Property:P8616|Kansas Historic Resources Inventory ID&#32;<small dir="ltr">(P8616)</small>]]
SELECT ?item WHERE { ?item wdt:P131* wd:Q1558 . ?item wdt:P1435 wd:Q19558910 . MINUS { ?item wdt:P8616 [] . } } LIMIT 1000
