embed.html##Provincie Noord-Holland
#defaultView:Map
SELECT ?Qvestiging ?QvestigingLabel ?coor ?partof ?partofLabel ?image ?layer WHERE {
#SELECT ?s ?sLabel ?coor ?image ?layer WHERE { 
  
       ?Qvestiging (p:P31/ps:P31) wd:Q28564;wdt:P17 wd:Q55;
          wdt:P625 ?coor ;
          wdt:P361 ?partof ;
          OPTIONAL {?Qvestiging wdt:P18 ?image .}
  
VALUES ?partof {
# Noord-Holland 
wd:Q2105660 #St. OBs Amsterdam
wd:Q59961890 #St. Bieb Zuid-Kennemerlnd
wd:Q59962072 #St. OB Heiloo
wd:Q59961947 #St. Westfriese Biebs
wd:Q57591817 #St.OB Haarlemmermeer
wd:Q59962110 #St.OB Huizen-Laren-Blaricum
wd:Q59962125 #St.OB Langedijk
wd:Q59961935 #St OB IJmond Noord
wd:Q59962113 #St. Bieb Velsen
wd:Q59961887 # St. OB Kennemerwaard
wd:Q59961900 #St.Amstellnd Bieb
                 }
BIND(
# Noord-Holland 
IF(?partof = wd:Q2105660,  "Amsterdam",
IF(?partof = wd:Q59961890, "Haarlem, Heemstede, Bloemendaal, Hillegom en Zandvoort",   
IF(?partof = wd:Q59961900, "Amstelveen, Aalsmeer en Uithoorn",    
IF(?partof = wd:Q57591817, "Haarlemmermeer",
IF(?partof = wd:Q59962110, "Huizen, Laren en Blaricum", 
IF(?partof = wd:Q59962113, "Velsen",
IF(?partof = wd:Q59961887, "Alkmaar, Bergen, Castricum en Heerhugowaard",
IF(?partof = wd:Q59961935, "Beverwijk, Wijk aan Zee en Heemskerk",   
IF(?partof = wd:Q59961947, "Enkhuizen, Medemblik, e.o.",    
IF(?partof = wd:Q59962125, "Langedijk",    
IF(?partof = wd:Q59962072, "Heiloo",
   "")))))))))))AS ?layer).  
 
SERVICE wikibase:label { bd:serviceParam wikibase:language "nl" }
}
ORDER BY ?layer ?partofLabel ?QvestigingLabel
