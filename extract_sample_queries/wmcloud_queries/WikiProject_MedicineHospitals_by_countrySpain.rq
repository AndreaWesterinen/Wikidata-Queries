SELECT DISTINCT ?item ?ac ?status ?es ?ca ?eu ?gl
WHERE 
{ ?item wdt:P31/wdt:P279* wd:Q16917; wdt:P17 wd:Q29
OPTIONAL { ?item p:P31/ps:P31 wd:Q64578911 . BIND(wd:Q64578911 as ?status1) } BIND(COALESCE(?status1,wd:Q64624840) as ?status)
OPTIONAL { ?item rdfs:label ?es . FILTER(lang(?es)="es") }
OPTIONAL { ?item rdfs:label ?ca . FILTER(lang(?ca)="ca") }
OPTIONAL { ?item rdfs:label ?eu . FILTER(lang(?eu)="eu") }
OPTIONAL { ?item rdfs:label ?gl . FILTER(lang(?gl)="gl") }
OPTIONAL { ?item wdt:P131/wdt:P131* ?ac . ?ac wdt:P31 wd:Q10742 }
}
