#title: Qualifier only valid to use with "range constraint"
# Complex constraint from [[Property talk:P2310]]
# This property must only be used as a qualifier for [[Property:P2302|property constraint&#32;<small dir="ltr">(P2302)</small>]] value of [[d:Q21510860|range constraint <small>(Q21510860)</small>]].
SELECT ?item ?itemLabel ?constraint ?constraintLabel ?min WHERE {
  ?item p:P2302 [ps:P2302 ?constraint; pq:P2310 ?min].
  FILTER (?constraint != wd:Q21510860).
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
