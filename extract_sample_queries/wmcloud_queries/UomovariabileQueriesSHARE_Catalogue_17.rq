PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX schema: <http://schema.org/>

SELECT ?item ?itemLabel ?dateOfDeath ?SHAREid (COUNT(DISTINCT ?sitelink) AS ?sites) ?immagine WHERE {
  ?item wdt:P31 wd:Q5.
  ?item (wdt:P106/wdt:P279*) wd:Q4964182.
  ?item wdt:P3987 ?SHAREid.
  ?item wdt:P570 ?dateOfDeath.
  ?sitelink schema:about ?item.
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
  FILTER((?dateOfDeath >= "1947-01-01T00:00:00"^^xsd:dateTime) && (?dateOfDeath <= "1947-12-31T23:59:59"^^xsd:dateTime))
  OPTIONAL { ?item wdt:P18 ?immagine. }
}
GROUP BY ?item ?itemLabel ?dateOfDeath ?SHAREid ?immagine
ORDER BY DESC(?sites)
