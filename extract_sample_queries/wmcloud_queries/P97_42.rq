SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P97 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P580, wd:P582, wd:P155, wd:P156, wd:P1545, wd:P1027, wd:P642, wd:P1706, wd:P2241, wd:P7452, wd:P1365, wd:P1366, wd:P790, wd:P8555, wd:P1319, wd:P8554, wd:P1326, wd:P2121, wd:P828, wd:P276, wd:P1810, wd:P805, wd:P1552, wd:P1932, wd:P3680, wd:P1534, wd:P585 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
