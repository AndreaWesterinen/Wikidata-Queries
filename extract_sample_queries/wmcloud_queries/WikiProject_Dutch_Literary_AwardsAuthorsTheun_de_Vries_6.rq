# Awards won by a given author, with year and winning work
SELECT DISTINCT ?author ?authorLabel ?role ?roleLabel ?item ?itemLabel ?year ?itemDescription 
WHERE
{
  VALUES (?author) {(wd:Q2143934)} #Theun de Vries
  ?item wdt:P3342 ?author. #Items for which TdV (Q2143934) was a relevant person (P3342)
    FILTER(?item != wd:Q65926940 && ?item != wd:Q65926922) #minus the 1948 and 1962 individual instances of the PCHooftprijs
  ?item p:P3342 ?s. #Relevant person for specific award
  ?s ps:P3342 ?author. #Only for TdVries
  ?s pq:P3831 ?role 
    FILTER(?role = wd:Q1275330) #role=laureate
  OPTIONAL { ?s pq:P585 ?year1
  BIND(YEAR(?year1) AS ?year)}
                        
  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "nl" .
  }
} ORDER BY ?year 
