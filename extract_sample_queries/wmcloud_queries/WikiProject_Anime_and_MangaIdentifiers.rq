SELECT DISTINCT ?property ?propid
?shortprop  ?item ?constraintreport ?editgroups ?completeness ?records
?templates ?catalogs ?constraints ?subjects
(COUNT(?propertyclaim) AS ?usage) (ROUND(100*?usage/?records) AS ?percent)
WITH {
  SELECT DISTINCT ?property
  WHERE {
    VALUES ?type {
      wikibase:ExternalId
      wikibase:Url
    }
    ?property wikibase:propertyType ?type;
      (wdt:P31/(wdt:P279*)) wd:Q63871467.
  }
} AS %properties
WITH {
  SELECT DISTINCT ?item ?property ?propid
                  ?shortprop ?constraintreport ?editgroups ?completeness ?records
                  (GROUP_CONCAT(DISTINCT ?subject) as ?subjects)
                  (GROUP_CONCAT(DISTINCT ?template) as ?templates)
                  (GROUP_CONCAT(DISTINCT ?catalog) as ?catalogs)
                  (GROUP_CONCAT(DISTINCT ?constraint) as ?constraints) 
  WHERE {
    INCLUDE %properties.
    BIND(xsd:integer(REPLACE(STR(?property), "http://www.wikidata.org/entity/P", "")) AS ?propid)
    BIND(CONCAT("{", "{P
