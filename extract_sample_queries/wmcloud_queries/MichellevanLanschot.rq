#Monuments and memorials in the Netherlands
SELECT ?item ?typeLabel ?itemLabel  ?countryLabel ?gemeenteLabel ?pic ?coordinate 
WHERE
{
	?item wdt:P31 ?type .
    FILTER(?type IN ( wd:Q4989906 , wd:Q5003624)).
  	?item wdt:P17 wd:Q55 . 
    ?item wdt:P131 ?gemeente .
  	?item wdt:P625 ?coordinate  . 
   	?item wdt:P17 ?country 
  	OPTIONAL {
		?item wdt:P18 ?pic
	}
	SERVICE wikibase:label { bd:serviceParam wikibase:language "nl,en" }
}
