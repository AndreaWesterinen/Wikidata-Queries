#defaultView:Map
SELECT ?item ?itemLabel ?coordinates WHERE {
  { ?item wdt:P131 wd:Q15899. }
  UNION
  { ?item wdt:P131 wd:Q9273677. }
  MINUS { ?item wdt:P18 _:b6. }
  MINUS { ?item wdt:P2716 _:b7. }
  MINUS { ?item wdt:P576 ?dissolved. }
  ?item wdt:P625 ?coordinates.
  SERVICE wikibase:label { bd:serviceParam wikibase:language "hu". }
}
