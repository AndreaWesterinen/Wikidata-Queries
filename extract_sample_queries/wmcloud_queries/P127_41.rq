SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P127 [] .
			MINUS {
				VALUES ?classes { wd:Q43229 wd:Q6671777 wd:Q4406616 wd:Q15401930 wd:Q26401003 wd:Q473972 wd:Q167270 wd:Q1656682 wd:Q95074 wd:Q15706911 wd:Q19913602 wd:Q39201 wd:Q5 wd:Q4835091 wd:Q431289 wd:Q340169 wd:Q853614 wd:Q3604202 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
