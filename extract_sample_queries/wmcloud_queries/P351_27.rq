#title: Items with statements where property P351 uses the novalue special value
SELECT ?item ?itemLabel (GROUP_CONCAT(?instanceLabel; separator=", ") as ?instanceLabels)
{
  ?item p:P351 [a wdno:P351; a wikibase:BestRank] .

  OPTIONAL {?item wdt:P31 ?instance}
  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "en,en,ru,ja,zh" .
    ?item rdfs:label ?itemLabel .
    ?instance rdfs:label ?instanceLabel
  }
}
GROUP BY ?item ?itemLabel
LIMIT 100
