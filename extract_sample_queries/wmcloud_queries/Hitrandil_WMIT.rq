SELECT ?item ?comune ?comuneLabel ?location ?locationLabel ?coords ?location_coords ?distNum
WHERE {
  ?item wdt:P31 wd:Q16970 .
  ?item wdt:P17 wd:Q38 .
  ?item wdt:P131 ?comune .
  ?item wdt:P276 ?location .
  ?item wdt:P3503 ?lombardia .
  ?item wdt:P625 ?coords .
  ?location wdt:P625 ?location_coords . 
  BIND(geof:distance(?coords, ?location_coords) AS ?distNum).
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE]". }
}
