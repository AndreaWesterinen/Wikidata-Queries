#title: Latitude should be south of 60 S
# Complex constraint from [[Property talk:P3230]]
# The most northerly latitude in the SCAR dataset is 60 S, so items should not be further north than that.
select distinct ?item { ?item wdt:P3230 [] . ?item p:P625/psv:P625/wikibase:geoLatitude ?lat filter (?lat > -60) . }
