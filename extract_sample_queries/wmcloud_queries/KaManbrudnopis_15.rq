SELECT ?l ?lemma ?form ?ipa WHERE {
   ?l a ontolex:LexicalEntry ; dct:language ?language ;
        wikibase:lemma ?lemma ; ontolex:lexicalForm ?form.
  ?language wdt:P218 'pl'.
  ?form wdt:P898 ?ipa .
  FILTER( (!(STRSTARTS( ?ipa , "[" )||STRSTARTS( ?ipa , "/" )))
          ||
          (!(STRENDS( ?ipa , "]" )||STRENDS( ?ipa , "/" ))) )
} ORDER BY ?lemma
