#title: Works with creator missing link
# Complex constraint from [[Property talk:P4177]]
# List of works that are in [[Property:P195|collection&#32;<small dir="ltr">(P195)</small>]] [[d:Q2983474|Finnish National Gallery <small>(Q2983474)</small>]] and have [[Property:P170|creator&#32;<small dir="ltr">(P170)</small>]] set, but that creator doesn't have a [[Property:P4177|Finnish National Gallery artist ID&#32;<small dir="ltr">(P4177)</small>]] link
SELECT ?item ?url ?creator ?creatorurl ?creatorid
{
	?item wdt:P195 wd:Q2983474 .
	?item wdt:P170 ?creator .
	MINUS { ?creator wdt:P4177 [] } .
	MINUS { ?item wdt:P170 wd:Q4233718 } . # Filter out anonymous
	OPTIONAL {?item wdt:P973 ?url } .
}
LIMIT 1000
