SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity wdt:P1435 wd:Q811165; wdt:P131* wd:Q1715; FILTER NOT EXISTS{ ?entity wdt:P5816 wd:Q63065035; wdt:P31 wd:Q1516079; } . 
  MINUS { ?entity wdt:P131 []; wdt:P1435 wd:Q811165; wdt:P131* wd:Q1715; FILTER NOT EXISTS{ ?entity wdt:P5816 wd:Q63065035; wdt:P31 wd:Q1516079; }  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
