SELECT DISTINCT ?l ?word ?len WHERE {
 {
   ?l a ontolex:LexicalEntry ; dct:language wd:Q188 ; wikibase:lemma ?word
   BIND(strlen(?word) as ?len)  
  } UNION {
   ?l a ontolex:LexicalEntry ; dct:language wd:Q188 ; ontolex:lexicalForm/ontolex:representation ?word
   BIND(strlen(?word) as ?len)  
  }
} 
order by DESC(?len) 
LIMIT 20
