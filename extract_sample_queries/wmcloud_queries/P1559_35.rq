SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value (LANG(?value) AS ?lang)
WHERE
{
	?item p:P1559 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P2440, wd:P2125, wd:P1721, wd:P1942, wd:P1814, wd:P898, wd:P2183, wd:P2719, wd:P4187, wd:P2001, wd:P1552, wd:P580, wd:P582, wd:P585, wd:P1480, wd:P282, wd:P5139, wd:P4970, wd:P4189, wd:P3831, wd:P642, wd:P443, wd:P2241, wd:P828, wd:P8017, wd:P1534, wd:P7452, wd:P5276, wd:P138, wd:P1319, wd:P8554, wd:P8555, wd:P1326, wd:P3938, wd:P407, wd:P4188, wd:P8991, wd:P9311, wd:P10663, wd:P10694, wd:P5997, wd:P4239 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
