SELECT DISTINCT ?item (CONCAT("[https://tools.wmflabs.org/scholia/topic/", ENCODE_FOR_URI(?qid), "/missing ", "curate]") AS ?disambiguator) ?sitelinks WHERE {
  {
    SELECT DISTINCT ?item (REPLACE(STR(?item), ".*Q", "Q") AS ?qid) ?sitelinks WHERE {
      ?work wdt:P921 ?item.
      ?work wdt:P2093 ?coauthor.
      ?item wikibase:sitelinks ?sitelinks .
    }
    LIMIT 400
  }
}
ORDER BY DESC(?sitelinks)
LIMIT 400
