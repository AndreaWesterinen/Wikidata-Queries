SELECT ?item ?item2 (REPLACE(CONCAT('[', ?formatter, ' $1]'), '\\$1', ?sudoc) AS ?url) WITH {
  SELECT * {
    ?item wdt:P269/^wdt:P269 ?item2 .
    FILTER( STR( ?item ) < STR( ?item2 ) ) .
  }
} AS %duplicates WITH {
  SELECT * { wd:P269 wdt:P1630 ?formatter } LIMIT 1
} AS %formatter WHERE {
  INCLUDE %duplicates .
  INCLUDE %formatter .
  ?item wdt:P269 ?sudoc .
  ?item2 wdt:P269 ?sudoc .
} ORDER BY ?sudoc
