SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P582 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P1534, wd:P1319, wd:P1326, wd:P276, wd:P518, wd:P1480, wd:P3005, wd:P4241, wd:P421, wd:P1013, wd:P582, wd:P291, wd:P805, wd:P5102, wd:P2241, wd:P7452, wd:P1545, wd:P1932, wd:P3831, wd:P828 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
