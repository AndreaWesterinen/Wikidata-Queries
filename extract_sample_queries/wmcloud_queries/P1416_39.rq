SELECT ?item ?itemLabel ?value ?valueLabel ?instance ?instanceLabel ?snak 
WHERE
{
	{
		SELECT DISTINCT ?item ?value ?instance ?snak {
			{
				?item wdt:P1416 ?value .
				BIND("mainsnak" AS ?snak) .
			} UNION {
				?statement0 pq:P1416 ?value .
				?item ?p0 ?statement0 .
				BIND("qualifier" AS ?snak) .
			} UNION {
				?ref pr:P1416 ?value .
				?statement1 prov:wasDerivedFrom ?ref .
				?item ?p1 ?statement1 .
				BIND("reference" AS ?snak) .
			} .
			MINUS {
				VALUES ?classes { wd:Q43229 wd:Q14623646 wd:Q170584 wd:Q56670043 wd:Q56561355 wd:Q178706 wd:Q1664720 wd:Q1729207 wd:Q16970 wd:Q1370598 wd:Q62662717 wd:Q995347 wd:Q13414953 wd:Q24577840 wd:Q16334295 wd:Q15911314 wd:Q334453 } .			
				?value wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?value wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
