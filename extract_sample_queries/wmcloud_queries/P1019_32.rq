SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P1019 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P407, wd:P1476, wd:P7588, wd:P5017, wd:P1065, wd:P2960, wd:P577, wd:P805, wd:P2701, wd:P3575, wd:P8525, wd:P1480, wd:P580, wd:P582, wd:P1319, wd:P8554, wd:P8555, wd:P1326, wd:P2241, wd:P7452, wd:P518, wd:P1680, wd:P50, wd:P1932, wd:P813 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
