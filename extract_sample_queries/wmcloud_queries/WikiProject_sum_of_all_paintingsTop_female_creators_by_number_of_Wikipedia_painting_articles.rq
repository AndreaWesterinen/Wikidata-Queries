SELECT ?item (CONCAT("[[Wikidata:WikiProject sum of all paintings/Creator/",?name, "|list]]") AS ?listlink) (COUNT(?item) as ?count) WHERE {
  ?painting wdt:P31 wd:Q3305213 .  
  ?painting wdt:P170 ?item . 
  ?item wdt:P21 wd:Q6581072 . 
  ?article schema:about ?painting .
  ?article schema:isPartOf ?sitelink .
   FILTER REGEX(STR(?sitelink), ".+wikipedia.org.+") .
  MINUS { ?painting wdt:P170 wd:Q4233718 } .
    SERVICE wikibase:label {
    bd:serviceParam wikibase:language "en" .
    ?item rdfs:label ?name .
   }
} GROUP BY ?item ?name ?listlink 
HAVING (?count > 3)
ORDER BY DESC(?count) 
LIMIT 100
