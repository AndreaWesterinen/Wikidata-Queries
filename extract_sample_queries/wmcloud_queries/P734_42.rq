SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P734 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P1545, wd:P580, wd:P582, wd:P3831, wd:P828, wd:P1534, wd:P5102, wd:P1013, wd:P407, wd:P5168, wd:P518, wd:P2241, wd:P7452, wd:P1480, wd:P8555, wd:P1319, wd:P8554, wd:P1326, wd:P3938, wd:P138, wd:P1552, wd:P1810, wd:P3680, wd:P1310, wd:P1932, wd:P10663, wd:P5548, wd:P443, wd:P898 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
