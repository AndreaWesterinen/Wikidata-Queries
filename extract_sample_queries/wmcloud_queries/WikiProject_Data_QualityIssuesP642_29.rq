SELECT DISTINCT ?item ?itemLabel ?ofLabel
WHERE
{
  ?item p:P31 ?inst_stm .
  {?inst_stm ps:P31/ps:P279* wd:Q1207505 .}
  UNION
  {?inst_stm ps:P31/ps:P279* wd:Q937228 .}
  UNION
  {?inst_stm ps:P31/ps:P279* wd:Q3505845 .}
  UNION
  {?inst_stm ps:P31/ps:P279* wd:Q930933 .}
  ?inst_stm pq:P642 ?of .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". } # Helps get the label in your language, if not, then en language
}
