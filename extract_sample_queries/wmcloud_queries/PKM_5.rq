SELECT ?exhibition ?image ?instance_of ?instance_ofLabel ?exhibitionLabel ?culture ?cultureLabel ?part_of ?part_ofLabel WHERE {
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
  ?exhibition wdt:P608 wd:Q59591760.
  OPTIONAL { ?exhibition wdt:P18 ?image. }
  OPTIONAL { ?exhibition wdt:P31 ?instance_of. }
  OPTIONAL { ?exhibition wdt:P2596 ?culture. }
  OPTIONAL { ?exhibition wdt:P361 ?part_of. }
}
LIMIT 100
