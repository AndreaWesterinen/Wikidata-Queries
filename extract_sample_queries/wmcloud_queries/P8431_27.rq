SELECT ?item ?itemLabel ?value ?valueLabel ?snak ?rank ?statement
WHERE
{
  {
    SELECT ?item ?value ?result ?snak ?rank ?statement WHERE {
      {
        ?item p:P8431 ?statement .
        ?statement ps:P8431 ?value; wikibase:rank ?rank .
        BIND("mainsnak" AS ?snak) .
      } UNION {
        ?statement pq:P8431 ?value; wikibase:rank ?rank .
        ?item ?p1 ?statement .
        BIND("qualifier" AS ?snak) .
      } UNION {
        ?ref pr:P8431 ?value .
        ?statement prov:wasDerivedFrom ?ref; wikibase:rank ?rank .
        ?item ?p2 ?statement .
        BIND("reference" AS ?snak) .
      } .
      FILTER( ?value NOT IN ( wd:Q96749544, wd:Q481774, wd:Q11942732, wd:Q41415, wd:Q1628963, wd:Q9266, wd:Q600396, wd:Q772630, wd:Q16911615, wd:Q182940, wd:Q622440, wd:Q1344463, wd:Q303956, wd:Q818674, wd:Q6545590, wd:Q178359, wd:Q80973, wd:Q13360264, wd:Q12105883 ) ) .
    } LIMIT 100
  } .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
