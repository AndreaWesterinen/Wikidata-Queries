SELECT DISTINCT ?item ?itemLabel ?articleEN ?articleDE WHERE {

  ?item wdt:P31 wd:Q5.
  ?item wdt:P6379 wd:Q191228.
  ?item wdt:P6379 wd:Q106058221.
#  ?item wdt:P6379 wd:Q1782422.
#  ?item wdt:P6379 wd:Q924335.
OPTIONAL {
    ?articleDE schema:about ?item.
    ?articleDE schema:isPartOf <https://de.wikipedia.org/>.
  }
OPTIONAL {
  ?articleEN schema:about ?item.
   ?articleEN schema:isPartOf <https://en.wikipedia.org/>.
  }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en,de". }
}
