SELECT ?item ?itemLabel ?value ?valueLabel ?snak ?rank ?statement
WHERE
{
  {
    SELECT ?item ?value ?result ?snak ?rank ?statement WHERE {
      {
        ?item p:P3823 ?statement .
        ?statement ps:P3823 ?value; wikibase:rank ?rank .
        BIND("mainsnak" AS ?snak) .
      } UNION {
        ?statement pq:P3823 ?value; wikibase:rank ?rank .
        ?item ?p1 ?statement .
        BIND("qualifier" AS ?snak) .
      } UNION {
        ?ref pr:P3823 ?value .
        ?statement prov:wasDerivedFrom ?ref; wikibase:rank ?rank .
        ?item ?p2 ?statement .
        BIND("reference" AS ?snak) .
      } .
      FILTER( ?value NOT IN ( wd:Q29051543, wd:Q29051546, wd:Q29051547, wd:Q29051549, wd:Q29051550, wd:Q29051551, wd:Q29051552, wd:Q29051554, wd:Q29051555, wd:Q29051556, wd:Q29051558, wd:Q29051560, wd:Q61954960, wd:Q61954942, wd:Q29051561, wd:Q63671741, wd:novalue ) ) .
    } LIMIT 100
  } .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
