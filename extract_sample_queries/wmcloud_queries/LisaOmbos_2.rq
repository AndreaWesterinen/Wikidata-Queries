SELECT DISTINCT ?item ?territory ?country WHERE {
  VALUES ?country {
    wd:Q40
    wd:Q184
    wd:Q31
    wd:Q219
    wd:Q224
    wd:Q213
    wd:Q35
    wd:Q191
    wd:Q33
    wd:Q142
    wd:Q183
    wd:Q41
    wd:Q28
    wd:Q27
    wd:Q38
    wd:Q211
    wd:Q347
    wd:Q37
    wd:Q32
    wd:Q236
    wd:Q55
    wd:Q221
    wd:Q20
    wd:Q36
    wd:Q45
    wd:Q218
    wd:Q159
    wd:Q403
    wd:Q214
    wd:Q215
    wd:Q29
    wd:Q34
    wd:Q39
    wd:Q212
    wd:Q145
  }
  ?item (wdt:P31/(wdt:P279*)) wd:Q55488;
    wdt:P131 ?territory;
    wdt:P17 ?country.
  MINUS {
    ?item p:P625 ?statement1.
    ?statement1 ps:P625 _:anyValueP625.
  }
  MINUS { ?item wdt:P576 _:anyDisolvedDate. }
  MINUS { ?item wdt:P3999 _:anyClosureDate. }
  MINUS { ?item wdt:P730 _:anyRetirmentDate. }
  MINUS { ?item wdt:P582 _:anyEndDate. }
  MINUS { ?item (wdt:P31/(wdt:P279*)) wd:Q96084375. }
  MINUS { ?item (wdt:P31/(wdt:P279*)) wd:Q28043022. }
  MINUS { ?item (wdt:P31/(wdt:P279*)) wd:Q55493. }
  MINUS { ?item (wdt:P31/(wdt:P279*)) wd:Q2175765. }
  MINUS { ?item (wdt:P31/(wdt:P279*)) wd:Q928830. }
  MINUS { ?item wdt:P5817 wd:Q11639308. }
  MINUS { ?item p:P31 ?statement0. ?statement0 pq:P580 _:anyEndPeriod. }
  MINUS { ?item p:P31 ?statement0. ?statement0 pq:P1264 _:anyValidPeriod. }

} LIMIT 200
