SELECT ?item ?ancestor ?ed WITH {
SELECT ?item ?ancestor ?ed
{
    ?item wdt:P31 wd:Q5; wdt:P39 wd:Q14211.
    ?item (wdt:P22|wdt:P25)+ ?ancestor .
  {
   { ?ancestor p:P39 ?as.
    ?as ps:P39 ?pos; pq:P582 ?ed.
  FILTER(?pos IN (wd:Q18810062,wd:Q18810063))
   }
  UNION
   { ?ancestor p:P39 ?as.
    ?as ps:P39 ?pos; pq:P582 ?ed; pq:P642 ?of.
  FILTER(?pos IN (wd:Q12097,wd:Q116))
  FILTER(?of IN (wd:Q161885,wd:Q215530,wd:Q174193))
   }
  }
} 
} AS %sq WITH {
  SELECT (?item as ?item2) (MAX(?ed) as ?ed2) {
    INCLUDE %sq .
  } GROUP BY ?item
} AS %sq2 WHERE {
  INCLUDE %sq .
  INCLUDE %sq2 .
  FILTER ((?item=?item2) && (?ed=?ed2))
}
