PREFIX schema: <http://schema.org/>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX wd: <http://www.wikidata.org/entity/> 
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX p: <http://www.wikidata.org/prop/>
PREFIX v: <http://www.wikidata.org/prop/statement/>

SELECT ?item ?itemLabel WHERE {
   ?item wdt:P31 wd:Q486972 .
   ?item wdt:P17 wd:Q217 .
   FILTER EXISTS { ?wro schema:about ?item . ?wro schema:inLanguage "ro" }
   FILTER NOT EXISTS { ?wen schema:about ?item . ?wen schema:inLanguage "en" }
  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "ro" .
  }
 }
