embed.html#SELECT DISTINCT ?film ?filmLabel ?filmDescription ?it (str(?it) = str(?filmLabel) as ?same) ?it_date ?it_article
{
  	hint:Query hint:optimizer "None" .
  	?film ?wdt wd:Q106418.
  	?property wikibase:directClaim ?wdt ; wikibase:claim ?p ; wikibase:statementProperty ?ps
  	OPTIONAL { ?film ?p ?statement . ?statement ?ps wd:Q106418 . ?statement pq:P453 ?role . OPTIONAL { ?statement pq:P794 ?as} }
  	OPTIONAL { ?film wdt:P577 ?pub BIND(YEAR(?pub) as ?year) }
  	{ ?film wdt:P31/wdt:P279* wd:Q11424 } UNION { ?film wdt:P31 wd:Q5398426 }
  	?film wikibase:sitelinks ?sitelinks; wikibase:statements ?statements ; wikibase:sitelinks ?ids .
    SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
    OPTIONAL { ?film rdfs:label ?it . FILTER(lang(?it)="it") } 
    OPTIONAL { ?film p:P577 [ pq:P291 wd:Q38 ; ps:P577 ?it_date ] }
    OPTIONAL { ?it_article schema:about ?film ; schema:isPartOf <https://it.wikipedia.org/> }
}
ORDER BY ?filmDescription ?item
