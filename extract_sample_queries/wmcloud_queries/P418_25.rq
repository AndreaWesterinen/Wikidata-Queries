#title: most linked wikis on values of property P418
SELECT ?wiki (COUNT( DISTINCT ?item ) as ?count) (SAMPLE(?item) as ?sample)
{
	?p wdt:P418 ?item . 
    [] schema:about ?item ; schema:isPartOf ?wiki . 
    SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }      
}
GROUP BY ?wiki 
ORDER BY DESC(?count) ?wiki
