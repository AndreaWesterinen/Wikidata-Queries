PREFIX schema: <http://schema.org/>

#Missing description for a target language
#Search for missing descriptions in a target language.
#Can be input for Q29032512
SELECT ?item ?itemDescription ?Sternbild WITH {
  SELECT ?item ?Sternbild ?ist_ein_e_ ?ist_ein_e_Label WHERE {
    VALUES ?Sternbild { wd:Q8667 wd:Q8675 }
    ?item wdt:P59 ?Sternbild.
    ?item wdt:P31 wd:Q523
    FILTER(NOT EXISTS {
      ?item schema:description ?itemdesc.
      FILTER((LANG(?itemdesc)) = "de")
    })
  }
} AS %results WHERE {
  INCLUDE %results.
  OPTIONAL { ?Sternbild wdt:P59 ?Sternbild. }
}
ORDER BY ?itemLabel  
Limit 100000      
