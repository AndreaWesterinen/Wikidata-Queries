embed.html#SELECT *
WITH
{ SELECT ("qualifier" as ?type)         (MIN(?q) as ?min)  (MAX(?q) as ?max)    WHERE  { [] pq:P2660 ?q } } as %pq
WITH
{ SELECT ("statement value" as ?type)   (MIN(?q) as ?min)  (MAX(?q) as ?max)    WHERE  { [] wdt:P2660 ?q } } as %wdt
WHERE
{
  { INCLUDE %pq } UNION { INCLUDE %wdt }
}
