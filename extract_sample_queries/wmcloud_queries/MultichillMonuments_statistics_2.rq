SELECT ?grouping (SAMPLE(?_higher_grouping) as ?higher_grouping) (COUNT(DISTINCT ?entity) as ?count) (SAMPLE(?entity) as ?sample) WHERE { ?entity wdt:P1435 ?something. ?entity wdt:P1435 ?grouping. OPTIONAL { ?grouping wdt:P17/wdt:P298  ?_higher_grouping } } GROUP BY ?grouping HAVING (?count > 50) ORDER BY DESC(?count) LIMIT 1000
