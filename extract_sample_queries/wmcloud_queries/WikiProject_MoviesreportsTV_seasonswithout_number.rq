SELECT ?item ?itemLabel ?itemDescription ?series ?seriesLabel ?seasons
{
	?item wdt:P31 wd:Q3464665 . 
    ?item wdt:P179 ?series . 
    OPTIONAL { ?series wdt:P2437 ?seasons }
    FILTER NOT EXISTS { ?item p:P179 [ ps:P179 ?series ; pq:P1545 ?ord ]  } 
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en,es,it" }
}
