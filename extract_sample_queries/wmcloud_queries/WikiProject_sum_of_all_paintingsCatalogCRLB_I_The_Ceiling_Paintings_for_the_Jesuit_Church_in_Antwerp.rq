SELECT ?item ?catalogcode WHERE { 
?item p:P528 [ pq:P972 wd:Q56085443 ; ps:P528 ?catalogcode].  
  BIND( xsd:decimal(REPLACE(?catalogcode, "[a-z-]", "")) AS ?catnum) 
  BIND( STRBEFORE(?catalogcode, "(") AS ?catcode)
  BIND( xsd:decimal(REPLACE(?catcode, "[a-z-]", "")) AS ?catnum) 
} ORDER BY ?catnum ?catalogcode
