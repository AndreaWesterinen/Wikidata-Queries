SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P241 [] .
			MINUS {
				VALUES ?classes { wd:Q176799 wd:Q5 wd:Q18691599 wd:Q26401003 wd:Q95074 wd:Q62934160 wd:Q16334295 wd:Q64353859 wd:Q56019 wd:Q1196123 wd:Q329864 wd:Q728 wd:Q91197994 wd:Q6857706 wd:Q18643213 wd:Q16631188 wd:Q2668072 wd:Q732717 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
