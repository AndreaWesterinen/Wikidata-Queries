#Unique value constraint report for Property proposal/Archive/30: report listing each item
SELECT DISTINCT ?item1 ?item1Label ?item2 ?item2Label ?value
{
	?item1 wdt:Property proposal/Archive/30 ?value .
	?item2 wdt:Property proposal/Archive/30 ?value .
	FILTER(?item1 != ?item2  && str(?item1)<str(?item2)) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en,en" } .
} LIMIT 500
