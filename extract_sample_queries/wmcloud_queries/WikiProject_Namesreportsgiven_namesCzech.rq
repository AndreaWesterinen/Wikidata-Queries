SELECT (wd:Q5 as ?item) (GROUP_CONCAT(?t; separator=", ") as ?names) 
{
SELECT ?gn ?nl (CONCAT( "[[", strafter(str(sample(?p)),"y/") , "|", ?nl , "]]") as ?t) 
  (COUNT(DISTINCT ?p) as ?count)
{
    ?gn wdt:P407 wd:Q9056 ;
          wdt:P31 wd:Q12308941 ;
          wdt:P1705 ?nl . 
    ?p wdt:P735 ?gn .
}
GROUP BY ?gn ?nl
HAVING ( ?count < 3 )
ORDER BY DESC(str(?nl))
}
