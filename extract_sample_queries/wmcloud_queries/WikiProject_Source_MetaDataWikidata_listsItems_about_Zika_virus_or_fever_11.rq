##defaultView:BubbleChart
#Most cited journals that have published articles on Zika virus or Zika fever
SELECT ?journal ?journalLabel (COUNT(DISTINCT ?paper) AS ?count)
WHERE
{
    ?item wdt:P2860 ?paper .
  { ?paper wdt:P921 wd:Q202864 . } UNION { ?paper wdt:P921 wd:Q8071861 . }  
    ?paper wdt:P31 wd:Q13442814 .
    ?paper wdt:P1433 ?journal .
    SERVICE wikibase:label {
        bd:serviceParam wikibase:language "en" .
    }
}
GROUP BY ?journal ?journalLabel
ORDER BY DESC(?count)
