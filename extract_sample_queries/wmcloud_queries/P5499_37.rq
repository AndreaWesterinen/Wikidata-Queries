#title: Artworks in the Boijmans collection without a link
# Complex constraint from [[Property talk:P5499]]
# Items that have [[Property:P195|collection&#32;<small dir="ltr">(P195)</small>]] set to [[d:Q679527|Museum Boijmans Van Beuningen <small>(Q679527)</small>]] (without the ones with an [[Property:P582|end time&#32;<small dir="ltr">(P582)</small>]]), but that item doesn't have [[Property:P5499|Boijmans work ID&#32;<small dir="ltr">(P5499)</small>]]. Missing link can probably be added
SELECT ?item WHERE {
  ?item p:P195 ?collectionstatement .
  ?collectionstatement ps:P195 wd:Q679527 .
  MINUS { ?collectionstatement pq:P582 [] } 
  FILTER NOT EXISTS {?item wdt:P5499 ?value . }
}
LIMIT 1000
