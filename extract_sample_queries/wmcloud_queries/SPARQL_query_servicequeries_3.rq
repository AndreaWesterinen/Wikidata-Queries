SELECT ?qual ?qualLabel (COUNT(DISTINCT ?item) AS ?count) WHERE {

     hint:Query hint:optimizer "None" .
     ?statement ps:P166 wd:Q10855212 .  # need 'wd:' to specify value
     ?item p:P166 ?statement .
     ?statement ?pq_qual ?pq_obj . # a triple involving the award statement ...     
     ?qual wikibase:qualifier ?pq_qual . # ... with a predicate ?pq_pred that is a qualifier

     SERVICE wikibase:label {
         bd:serviceParam wikibase:language "en" .
     }

}  GROUP BY ?qual ?qualLabel
ORDER BY DESC (?count)
