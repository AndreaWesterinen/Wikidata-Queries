SELECT ?item ?articurl WHERE {
  wd:P4738 wdt:P1630 ?formatterurl .
  ?item p:P195 ?collectionstatement .
  ?collectionstatement ps:P195 wd:Q6352575 .
  ?item wdt:P31 wd:Q3305213 .
  OPTIONAL { ?item wdt:P4738 ?articid }.
  BIND(REPLACE(?articid, '^(\\d+)$', CONCAT("[", ?formatterurl, " $1]")) AS ?articurl)  .
  } 
LIMIT 4000
