#added before 2016-10
 SELECT DISTINCT ?item ?Titre ?instanceof ?instanceofLabel (year(?date) as ?AnneeCreation) ?image ?coord 
WHERE
{
   ?item wdt:P31/wdt:P279* wd:Q159719.                    # power station
   {?item wdt:P131 wd:Q408.}                               # ... situated in Australia
   UNION
   {?item wdt:P131 ?arr.                                  # ... or in the administrative territory of Australia
   ?arr wdt:P131 wd:Q408. } 
   ?item rdfs:label ?Titre filter (lang(?Titre) = "en").  # Title
  
   OPTIONAL {?item wdt:P31 ?instanceof .
             FILTER (?instanceof!=wd:Q159719) .
            }  # Instance of
   OPTIONAL {?item wdt:P571 ?date.}                       # date of creation (option)
   OPTIONAL {?item wdt:P18  ?image.}                      # image (option)
   OPTIONAL {?item wdt:P625 ?coord.}                      # geographic coordinates (option)
   SERVICE wikibase:label {
    bd:serviceParam wikibase:language "en" .
   }
}
