SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P268 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P585, wd:P2241, wd:P1810, wd:P4970, wd:P7452, wd:P580, wd:P582, wd:P1476, wd:P195, wd:P407, wd:P8555, wd:P1319, wd:P8554, wd:P1326, wd:P2868, wd:P9570, wd:P4390, wd:P3831 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
