SELECT DISTINCT ?item WHERE 
{
  BIND (wd:Q131626 AS ?institution)
  ?item rdf:type wikibase:Property .
  ?item wdt:P31/wdt:P279* wd:Q19847637 .
  { ?item wdt:P2378/wdt:P749* ?institution . } 
  UNION
  { ?item wdt:P2378/wdt:P2652* ?institution . } 
  UNION 
  { ?item wdt:P361/wdt:P279* ?institution . }
}
