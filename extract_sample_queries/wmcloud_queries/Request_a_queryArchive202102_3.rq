#defaultView:Map
# kulturarv i Helsingfors
SELECT DISTINCT ?item ?itemLabel ?itemDescription ?år_skapad ?år_publicerad ?motivLabel ?tillminnetavLabel ?tillägnadLabel ?image ?coords
  
WHERE 
{ 
  ?item wdt:P31/wdt:P279* wd:Q210272.
  ?item wdt:P131 wd:Q1757. 
  
  OPTIONAL{?item wdt:P571 ?p571. BIND(SUBSTR(STR(COALESCE(?p571,"")),1,4) AS ?år_skapad)}
  OPTIONAL{?item wdt:P577 ?p577. BIND(SUBSTR(STR(COALESCE(?p577,"")),1,4) AS ?år_publicerad)}
  OPTIONAL{?item wdt:P180 ?motiv} 
  OPTIONAL{?item wdt:P547 ?tillminnetav} 
  OPTIONAL{?item wdt:P825 ?tillägnad} 
  OPTIONAL{?item wdt:P18 ?image}
  OPTIONAL{?item wdt:P625 ?coords}
 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "sv". }
}ORDER BY ?itemLabel
