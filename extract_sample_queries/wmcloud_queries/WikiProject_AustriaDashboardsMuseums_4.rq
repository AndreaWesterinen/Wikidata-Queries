SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity (wdt:P31/(wdt:P279*)) wd:Q33506;wdt:P17 wd:Q40 . 
  MINUS { ?entity wdt:P131+ ?grouping.?grouping wdt:P31 wd:Q261543. # []; (wdt:P31/(wdt:P279*)) wd:Q33506;wdt:P17 wd:Q40  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
