SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P417 [] .
			MINUS {
				VALUES ?classes { wd:Q2221906 wd:Q12737077 wd:Q200334 wd:Q391009 wd:Q1826286 wd:Q17149090 wd:Q16970 wd:Q51041800 wd:Q24398318 wd:Q56061 wd:Q170161 wd:Q43229 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
