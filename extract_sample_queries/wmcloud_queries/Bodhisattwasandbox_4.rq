SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity (wdt:P31/(wdt:P279*)) wd:Q33506;  wdt:P131+ ?states FILTER (?states IN (wd:Q1356)) . 
  MINUS { ?entity wdt:P17 []; (wdt:P31/(wdt:P279*)) wd:Q33506;  wdt:P131+ ?states FILTER (?states IN (wd:Q1356))  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
