SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P674 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P5800, wd:P3831, wd:P1932, wd:P1810, wd:P792, wd:P2241, wd:P7452, wd:P412, wd:P1545, wd:P2868, wd:P6249, wd:P793, wd:P518, wd:P5102, wd:P4292, wd:P4675, wd:P10663, wd:P175, wd:P1268 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
