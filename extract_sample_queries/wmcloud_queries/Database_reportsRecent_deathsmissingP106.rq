SELECT ?item ?dod ?stct ?slct
{
	?item wdt:P570 ?dod
	FILTER ( ?dod > "2016-07-30T00:00:00Z"^^xsd:dateTime)
	FILTER ( ?dod > (now()-"P32D"^^xsd:duration) && ?dod < now() )
	?item wdt:P31 wd:Q5 .
  	OPTIONAL { ?item wdt:P106 ?q } . FILTER(!BOUND(?q))
  	OPTIONAL { ?item wikibase:statements ?stct }
  	OPTIONAL { ?item wikibase:sitelinks ?slct }
  	MINUS { ?item wdt:P106 wd:Q937857 }
}
ORDER BY DESC(?slct) DESC(?dod) ?item
