SELECT DISTINCT ?term ?instanceof ?legislature ?ordinal ?inception ?dissolved ?follows ?followedby ?item WHERE {
  VALUES ?flacs {wd:Q2225003 wd:Q83020 wd:Q706447} #three types of FLACS in Taiwan, but only one of these subclassed from Q10864048 
  ?region wdt:P31/wdt:P279* ?flacs ; 
          wdt:P17 wd:Q865.
  ?item wdt:P1001 ?region ;
           wdt:P31 wd:Q11204 .
  OPTIONAL { 
    ?statement ps:P31/wdt:279* wd:Q15238777 ;
               pq:P642 ?item .
    ?term p:P31 ?statement .
    ?term wdt:P31 ?instanceof .
    OPTIONAL { ?statement pq:P642 ?legislature }
    OPTIONAL { ?statement pq:P1545 ?ordinal }
    OPTIONAL { ?term wdt:P571 ?inception }
    OPTIONAL { ?term wdt:P576 ?dissolved }
    OPTIONAL { ?term wdt:P156 ?followedby }
    OPTIONAL { ?term wdt:P155 ?follows }
  }
}
