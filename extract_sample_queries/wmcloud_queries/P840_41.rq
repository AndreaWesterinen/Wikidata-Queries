SELECT ?item ?itemLabel ?value ?valueLabel ?instance ?instanceLabel ?snak 
WHERE
{
	{
		SELECT DISTINCT ?item ?value ?instance ?snak {
			{
				?item wdt:P840 ?value .
				BIND("mainsnak" AS ?snak) .
			} UNION {
				?statement0 pq:P840 ?value .
				?item ?p0 ?statement0 .
				BIND("qualifier" AS ?snak) .
			} UNION {
				?ref pr:P840 ?value .
				?statement1 prov:wasDerivedFrom ?ref .
				?item ?p1 ?statement1 .
				BIND("reference" AS ?snak) .
			} .
			MINUS {
				VALUES ?classes { wd:Q17334923 wd:Q618123 wd:Q82794 wd:Q3895768 wd:Q1656682 wd:Q47495022 wd:Q20203388 wd:Q18670171 wd:Q4169 wd:Q14637321 wd:Q13226383 wd:Q4835091 wd:Q111547268 wd:Q100706037 wd:Q47306921 wd:Q39916781 wd:Q4418079 wd:Q3238337 } .			
				?value wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?value wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
