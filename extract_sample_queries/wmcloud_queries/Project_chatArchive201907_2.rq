SELECT ?item ?itemLabel ?value ?result (STRLEN(STR(?value)) AS ?stringlength)  ?snak ?rank
WHERE
{
	{
		SELECT ?item ?value ?result ?snak ?rank
		WHERE
		{
			{
				?item p:P1065 [ ps:P1065 ?value; wikibase:rank ?rank ] .
				BIND("mainsnak" AS ?snak) .
			} UNION {
				?statement1 pq:P1065 ?value;
					wikibase:rank ?rank .
				?item ?p1 ?statement1 .
				BIND("qualifier" AS ?snak) .
			} UNION {
				?ref pr:P1065 ?value .
				?statement2 prov:wasDerivedFrom ?ref;
					wikibase:rank ?rank .
				?item ?p2 ?statement2 .
				BIND("reference" AS ?snak) .
			} .
			BIND( REGEX( STR( ?value ), "^(https?:\\/\\/(web\\.archive\\.org\\/web\\/[0-9]{14}|archive\\.org\\/(details|download)|archive\\.(today|is|fo|li|ph|vn)\\/[0-9]{4}[\\-\\.]?[0-9]{2}[\\-\\.]?[0-9]{2}[\\-\\.]?[0-9]{2}[\\-\\.]?[0-9]{2}[\\-\\.]?[0-9]{2}|webrecorder\\.io|(www\\.)?webcitation\\.org|perma\\.cc|perma\\-archives\\.org|([^\\/]+\\.)?megalodon\\.jp|archive\\.wikiwix\\.com)\\/.+|https?:\\/\\/archive\\.(today|is|fo|li|ph|vn)\\/[a-zA-Z0-9]{4,})$" ) AS ?regexresult ) .
			FILTER( ?regexresult = false ) .
			BIND( IF( ?regexresult = true, "pass", "fail" ) AS ?result ) .
			FILTER( ?item NOT IN ( wd:Q4115189, wd:Q13406268, wd:Q15397819 ) ) .
		} 
		LIMIT 20000
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en-gb,en" } .
}
