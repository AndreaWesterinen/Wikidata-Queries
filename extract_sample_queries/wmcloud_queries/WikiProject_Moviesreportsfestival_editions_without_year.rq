SELECT DISTINCT ?item ?or1 ?or2 ?inceptionyear
{ 	{ ?item wdt:P31 wd:Q27787439 }
 	UNION
 	{ ?festival wdt:P279 wd:Q220505 . ?item wdt:P31 ?festival }
 	UNION
 	{ ?festival wdt:P31 wd:Q220505 . ?item wdt:P31 ?festival }
 	UNION
 	{ ?festival wdt:P31 wd:Q220505 . ?item wdt:P179 ?festival }
	OPTIONAL { ?item wdt:P585 ?dummy0 } FILTER(!bound(?dummy0))
	OPTIONAL { ?item wdt:P393 ?or2 }
	OPTIONAL { ?item wdt:P179 ?or1 }
	OPTIONAL { ?item wdt:P179 / wdt:P571 ?y1 . BIND(YEAR(?y1) as ?inceptionyear) } 
}
ORDER BY ?or1 (xsd:integer(?or2)) ?item
