SELECT ?occup ?occupLabel ?count
WHERE
{
	{
		SELECT ?occup (COUNT(?person) as ?count)
		WHERE
		{
			?person wdt:P106 ?occup
		}
		GROUP BY ?occup
		ORDER BY DESC(?count)
		LIMIT 1000
	}
  	OPTIONAL {?occup rdfs:label ?label1 	filter(lang(?label1) = "crh")}
	FILTER(!BOUND(?label1))
  
    SERVICE wikibase:label { bd:serviceParam wikibase:language "en,ru,tr" }
}
ORDER BY DESC(?count)
LIMIT 50
