SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value (LANG(?value) AS ?lang)
WHERE
{
	?item p:P1477 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P2440, wd:P2125, wd:P1721, wd:P1942, wd:P1814, wd:P898, wd:P2183, wd:P2719, wd:P4187, wd:P1480, wd:P282, wd:P1552, wd:P5139, wd:P2001, wd:P3680, wd:P1310, wd:P828, wd:P407, wd:P8017, wd:P2241, wd:P7452, wd:P5276, wd:P580, wd:P582, wd:P8991, wd:P10663 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
