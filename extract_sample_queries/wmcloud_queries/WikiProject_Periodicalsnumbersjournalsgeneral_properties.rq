SELECT DISTINCT ?item ?itemLabel ?count
WITH
{
  SELECT ?wdt (COUNT(DISTINCT ?s) as ?count)
  {
    VALUES ?wdt { wdt:P31 wdt:P1813 wdt:P1476 wdt:P407 wdt:P571 wdt:P576 }
    { ?s wdt:P31 wd:Q737498 } UNION { ?s wdt:P31 wd:Q5633421 }     
    ?s ?wdt []
  }
  GROUP BY ?wdt
} as %test
WHERE
{
  hint:Query hint:optimizer "None".
  INCLUDE %test
  ?item wikibase:directClaim ?wdt .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
ORDER BY DESC(?count)
