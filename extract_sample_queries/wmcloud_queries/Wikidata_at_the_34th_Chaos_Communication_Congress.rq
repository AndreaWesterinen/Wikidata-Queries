embed.html## All popes with number of children
SELECT  ?father ?fatherLabel  (SAMPLE(?picture) as ?picture) (COUNT(?child) as ?children) WHERE {
  ?child wdt:P22 ?father.
  ?father wdt:P31 wd:Q5;
          wdt:P39 wd:Q19546.
  OPTIONAL { ?father wdt:P18 ?picture. }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en" }
}
GROUP BY ?father ?fatherLabel
ORDER BY DESC(?children)
