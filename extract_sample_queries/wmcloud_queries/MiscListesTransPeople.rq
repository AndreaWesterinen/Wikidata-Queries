SELECT ?item ?p
{
  ?item wdt:P21 ?gender; 
        wdt:P31 wd:Q5 .

        
  FILTER (?gender != wd:Q6581072 ).
  FILTER (?gender != wd:Q6581097 ).
  FILTER ( ! isBLANK(?gender) ).
  OPTIONAL {
      ?item wdt:P6553 ?pronoun . 
      ?pronoun wikibase:lemma ?label .
      BIND(STR(?label) AS ?p) 
  }
}
