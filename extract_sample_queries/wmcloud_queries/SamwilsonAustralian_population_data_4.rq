SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity wdt:P17 wd:Q408 . { ?entity  wdt:P31 wd:Q188509 } union { ?entity  wdt:P31 wd:Q3957 } . 
  MINUS { ?entity wdt:P131 []; wdt:P17 wd:Q408 . { ?entity  wdt:P31 wd:Q188509 } union { ?entity  wdt:P31 wd:Q3957 }  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
