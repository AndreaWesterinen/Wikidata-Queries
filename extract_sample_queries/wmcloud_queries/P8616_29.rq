#title: Items without the Register of Historic Kansas Places
# Complex constraint from [[Property talk:P8616]]
# Items in [[d:Q1558|Kansas <small>(Q1558)</small>]] that do have [[d:Q19558910|National Register of Historic Places listed place <small>(Q19558910)</small>]]  in [[Property:P1435|heritage designation&#32;<small dir="ltr">(P1435)</small>]], but not [[d:Q104587249|listed on the Register of Historic Kansas Places <small>(Q104587249)</small>]] .
SELECT ?item WHERE { ?item wdt:P131* wd:Q1558 . ?item wdt:P1435 wd:Q19558910 . MINUS { ?item wdt:P1435 wd:Q104587249 . } } LIMIT 1000
