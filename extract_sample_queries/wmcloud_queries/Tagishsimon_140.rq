#defaultView:Map
SELECT ?item ?itemLabel ?itemDescription ?HSID ?coord ?lat ?long  WHERE {
  ?item wdt:P31 wd:Q16970.
  ?item wdt:P131/wdt:P131 wd:Q22.  
  ?item p:P625 ?stat . 
  ?stat ps:P625 ?coord. 
  ?stat psv:P625/wikibase:geoLongitude ?long.
  ?stat psv:P625/wikibase:geoLatitude ?lat.

  
  filter not exists { ?item a wdno:P718 . }  
  filter not exists { ?item wdt:P718 ?canmore. }
  OPTIONAL { ?item wdt:P709 ?HSID. }
  
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en" . }
}
