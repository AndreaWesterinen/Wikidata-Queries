#title: Works with creator missing link
# Complex constraint from [[Property talk:P8317]]
# List of works that are in [[Property:P195|collection&#32;<small dir="ltr">(P195)</small>]] [[d:Q510324|Philadelphia Museum of Art <small>(Q510324)</small>]] and have [[Property:P170|creator&#32;<small dir="ltr">(P170)</small>]] set, but that creator doesn't have a [[Property:P8317|Philadelphia Museum of Art entity ID&#32;<small dir="ltr">(P8317)</small>]] link
SELECT ?item ?url ?creator
{
	?item wdt:P195 wd:Q510324 .
	?item wdt:P170 ?creator .
	MINUS { ?creator wdt:P8317 [] } .
	MINUS { ?item wdt:P170 wd:Q4233718 } . # Filter out anonymous
	OPTIONAL {?item wdt:P973 ?url } .
}
