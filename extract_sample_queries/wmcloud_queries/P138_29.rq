SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P138 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P5168, wd:P8338, wd:P1545, wd:P1810, wd:P1932, wd:P1683, wd:P1480, wd:P407, wd:P1559, wd:P3938, wd:P585, wd:P580, wd:P582, wd:P642, wd:P1557, wd:P805, wd:P1310, wd:P3680, wd:P5102, wd:P5886, wd:P6254, wd:P6072, wd:P5830, wd:P276, wd:P495, wd:P1114, wd:P1013, wd:P518, wd:P2283, wd:P828, wd:P3113, wd:P1319, wd:P8554, wd:P8555, wd:P1326, wd:P2868, wd:P3831, wd:P1706, wd:P50, wd:P2093, wd:P2241, wd:P7452 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
