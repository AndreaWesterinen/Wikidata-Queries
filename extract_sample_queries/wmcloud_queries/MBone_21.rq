SELECT (CONCAT('-', ?qid) AS ?str) ("P131" AS ?pid) ?value ("/* remove wrong P131 statement */" AS ?comment) WHERE {
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
  ?item wdt:P131 ?admin.
  ?admin wdt:P31 wd:Q35034452.
  MINUS {?admin wdt:P31 wd:Q821435.}  
  ?item wdt:P276 ?admin.
  MINUS {?item wdt:P582 ?end.}
  MINUS {?item wdt:P3999 ?close.}
  BIND(SUBSTR(STR(?item), (STRLEN(STR(<http://www.wikidata.org/entity/>))) + 1) AS ?qid)
  BIND(SUBSTR(STR(?admin), (STRLEN(STR(<http://www.wikidata.org/entity/>))) + 1) AS ?value)

}
LIMIT 1000
