SELECT ?item (COUNT(DISTINCT ?prop) AS ?count) WHERE { hint:Query hint:optimizer "None" . {?item wdt:P31 wd:Q11424} UNION {?item wdt:P31 wd:Q24862} UNION {?item wdt:P31 wd:Q20667187}  UNION {?item wdt:P31 wd:Q226730} ?item ?p ?id . ?prop wikibase:directClaim ?p . ?prop wikibase:propertyType ?ptype FILTER(?ptype != wikibase:String) . FILTER(?ptype != wikibase:ExternalId) } GROUP BY ?item ORDER BY DESC (?count) LIMIT 12
