SELECT DISTINCT ?item ?itemLabel ?cities ?position ?electoraldistrict ?edtype ?starttime ?parliametarygroup ?parliametaryterm ?fbid WHERE { 
    VALUES ?cities { wd:Q8660 wd:Q11739 wd:Q173985 wd:Q93230 wd:Q24440 wd:Q243322 wd:Q549467 wd:Q185453 wd:Q1640079 wd:Q848613 wd:Q185458 wd:Q318156 wd:Q855997 wd:Q643883 wd:Q868631 wd:Q696605 wd:Q2503836 wd:Q2639823 wd:Q936703 wd:Q999076 wd:Q929062 wd:Q523778 wd:Q2379056 wd:Q2503839 wd:Q46785 wd:Q389161 wd:Q64170 wd:Q2503822 wd:Q74192 } .
    ?cities wdt:P1313 ?head ;
            wdt:P194 ?council .
    ?council wdt:P1001 ?cities .
    ?member wdt:P361 ?council ;
            wdt:P279* wd:Q708492 .
    MINUS {?member wdt:P576 [] }
    MINUS { ?region wdt:P576 [] }
    MINUS { ?council wdt:P576 [] }
    ?node ps:P39 ?member .
    OPTIONAL { ?node pq:P4100 ?parliametarygroup }
    OPTIONAL { ?node pq:P2937 ?parliametaryterm }
    OPTIONAL { ?node pq:P580 ?starttime }
    OPTIONAL { ?node pq:P768 ?electoraldistrict .
               ?electoraldistrict wdt:P31 ?edtype }
    MINUS { ?node pq:P582 []}
    ?node ps:P39 ?position .
    ?item p:P39 ?node .
    OPTIONAL { ?item wdt:P2013 ?fbid }
    SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
ORDER BY ?item
