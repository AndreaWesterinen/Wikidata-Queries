# places in Scotland according to P131, having a single P131

select ?item ?itemLabel ?P31 ?P31Label  where {
  ?item wdt:P131* wd:Q22  .
  
#  filter not exists {?item wdt:P625 ?coords .}
  optional {?item wdt:P31 ?P31 .} 
  optional {?item wdt:P279 ?P279 .} 
    
  filter not exists {?item wdt:P31/wdt:P279* wd:Q192611 .}  # constituencies
  filter not exists {?item wdt:P31 wd:Q78366914 . } # Heald's parish thang 
  filter not exists {?item wdt:P31 wd:Q78923961 . } # Heald's parish thang 
SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". 
                        ?item rdfs:label ?itemLabel .
                       ?P31 rdfs:label ?P31Label .} 
filter(contains(?itemLabel,"stone circle"))
} order by lcase(?P31Label) ?itemLabel
