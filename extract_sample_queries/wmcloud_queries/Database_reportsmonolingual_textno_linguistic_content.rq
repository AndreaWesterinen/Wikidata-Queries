SELECT ?item ?itemLabel ?prop (CONCAT("[[Property:",REPLACE(str(?prop),"http://www.wikidata.org/entity/",""),"]]") as ?propid) ?propLabel ?id WITH { SELECT ?prop ?wdt { ?prop wikibase:propertyType wikibase:Monolingualtext . ?prop wikibase:directClaim ?wdt . FILTER( ?prop != wd:P1813 ) } } as %bla WHERE { INCLUDE %bla ?item ?wdt ?id . FILTER(lang(?id)="zxx") FILTER(?item != wd:Q22282939 ) SERVICE wikibase:label {bd:serviceParam wikibase:language "en"} } LIMIT 4999
