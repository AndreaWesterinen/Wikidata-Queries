embed.html##defaultView:Map
SELECT ?place ?coord
WHERE
{
  wd:Q213154 wdt:P625 ?centerLocation . # coordinates of the center, replace Q213154 by the place you want
  SERVICE wikibase:around {
    ?place wdt:P625 ?coord .
    bd:serviceParam wikibase:center ?centerLocation .
    bd:serviceParam wikibase:radius "5" .
  } .
  OPTIONAL { ?place schema:description ?itemDescription  }
  FILTER (!BOUND(?itemDescription))
  SERVICE wikibase:label { bd:serviceParam wikibase:language "cy"} #language without description
}
