#Target required claim report for P406: report listing each item and value

SELECT ?item ?itemLabel ?value ?valueLabel ?target ?targetLabel ?snak
WHERE
{
	{
		SELECT DISTINCT ?item ?value ?target ?snak
		WHERE
		{
			{
				?item p:P406/ps:P406 ?value .
				BIND("mainsnak" AS ?snak) .
			} UNION {
				?statement0 pq:P406 ?value .
				?item ?p0 ?statement0 .
				BIND("qualifier" AS ?snak) .
			} UNION {
				?ref pr:P406 ?value .
				?statement1 prov:wasDerivedFrom ?ref .
				?item ?p1 ?statement1 .
				BIND("reference" AS ?snak) .
			} .
			VALUES ?values { wd:Q4176708 wd:Q65091986 wd:Q66049140 wd:Q60030240 wd:Q108064011 wd:Q64547452 } .
			MINUS {
				?value p:P7937/ps:P7937 ?values .
			} .
			OPTIONAL {
				?value p:P7937/ps:P7937 ?target .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
