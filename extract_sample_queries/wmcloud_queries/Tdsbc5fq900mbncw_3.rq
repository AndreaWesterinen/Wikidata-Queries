SELECT (CONCAT('"', ?language, '":') as ?lang) (CONCAT("{",GROUP_CONCAT(?a; separator=","),"},") as ?occupations)
{
	{ 	SELECT DISTINCT (lang(?label) as ?language) ( CONCAT( '"', ?label, '": ', strafter(str(?occup),"y/")) as ?a)
		{
			VALUES ?occup { wd:Q3501317 wd:Q13382519 wd:Q2664701 wd:Q2727289 wd:Q11481802 wd:Q13382608 wd:Q16287483 wd:Q384593 wd:Q876864 wd:Q5322166 wd:Q205375 wd:Q805221 wd:Q266569 wd:Q1114448 wd:Q12334852 wd:Q846750 wd:Q901402 wd:Q3357567 wd:Q13582652 wd:Q29182 wd:Q1662561 wd:Q13590141 wd:Q2059704 wd:Q329439 wd:Q635734 wd:Q1225716 wd:Q2259532 wd:Q18199024 wd:Q3246315 wd:Q386854 wd:Q17524364 wd:Q16267607 wd:Q520549 wd:Q11607585 wd:Q1259917 wd:Q10866633 wd:Q1607826 wd:Q18814623 wd:Q15296811 wd:Q13382603 wd:Q486839 wd:Q215536 wd:Q627325 wd:Q500097 wd:Q4205432 wd:Q970153 wd:Q2095549 wd:Q11774202 wd:Q13418253 wd:Q219477 wd:Q765778 wd:Q378622 wd:Q2252262 wd:Q774306 wd:Q578109 wd:Q3014296 wd:Q901 wd:Q17486376 wd:Q488111 wd:Q822146 wd:Q245068 wd:Q16029547 wd:Q13474373 wd:Q12800682 wd:Q130857 wd:Q7042855 wd:Q4144610 wd:Q5716684 wd:Q3455803 wd:Q1079215 wd:Q10843263 wd:Q1238570 wd:Q4009406 wd:Q3387717 wd:Q864503 wd:Q860918 wd:Q864380 wd:Q350979 wd:Q715301 wd:Q211346 wd:Q18581305 wd:Q4991371 wd:Q182436 wd:Q859528 wd:Q13219587 wd:Q2705098 wd:Q133485 wd:Q13381572 wd:Q15980158 wd:Q13382566 wd:Q6665249 wd:Q11303721 wd:Q222344 wd:Q2490358 wd:Q13381863 wd:Q2516866 wd:Q18844224 wd:Q15958185 wd:Q11900058 wd:Q5137571 wd:Q11063 wd:Q2066131 wd:Q183945 wd:Q10873124 wd:Q1371925 wd:Q2306091 wd:Q1792450 wd:Q82594 wd:Q2405480 wd:Q191633 wd:Q4773904 wd:Q131512 wd:Q19595175 wd:Q2722764 wd:Q121594 wd:Q14915627 wd:Q13365117 wd:Q13141064 wd:Q212980 wd:Q3621491 wd:Q644687 wd:Q13382576 wd:Q1231865 wd:Q806798 wd:Q4263842 wd:Q15627169 wd:Q16145150 wd:Q14373094 wd:Q622807 wd:Q10833314 wd:Q14467526 wd:Q2865819 wd:Q593644 wd:Q855091 wd:Q15981151 wd:Q10843402 wd:Q214917 wd:Q3055126 wd:Q169470 wd:Q131524 wd:Q488205 wd:Q947873 wd:Q37226 wd:Q11338576 wd:Q15117302 wd:Q3282637 wd:Q4964182 wd:Q483501 wd:Q170790 wd:Q1234713 wd:Q158852 wd:Q185351 wd:Q2374149 wd:Q14089670 wd:Q13414980 wd:Q33231 wd:Q333634 wd:Q486748 wd:Q250867 wd:Q43845 wd:Q753110 wd:Q4610556 wd:Q42603 wd:Q39631 wd:Q6625963 wd:Q189290 wd:Q2259451 wd:Q230