  			{ ?occup rdfs:label ?label }
      		UNION { ?occup wdt:P2521 ?label }           
		}
     	ORDER BY DESC(strlen(?label))
  	}
    FILTER ( ?language in ('en', 'fr', 'de', 'ru', 'pl', 'es', 'it', 'ja', 'fi', 'tr', 'sv', 'pt', 'zh', 'uk', 'cs', 'hu', 'hu', 'ar', 'no', 'la', 'et', 'da', 'ko', 'id', 'eo', 'bg', 'ro', 'eu', 'eu', 'sk', 'sl', 'sco', 'el', 'az', 'az', 'az', 'az', 'lb', 'gl', 'cy', 'ta', 'sr', 'vi', 'nn', 'hy', 'sh', 'mk', 'kk', 'ca', 'ms', 'ur', 'be', 'zh-min-nan', 'ka' ) )
}
