SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P2101 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P2077, wd:P459, wd:P1013, wd:P2571, wd:P2241, wd:P7452, wd:P1480, wd:P5102, wd:P1683, wd:P5447, wd:P5448 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
