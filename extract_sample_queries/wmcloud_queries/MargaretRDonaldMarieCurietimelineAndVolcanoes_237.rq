SELECT DISTINCT  ?taxon ?taxonLabel ?namedAfter ?type ?typeLabel ?article WHERE {
  ?taxon wdt:P31 wd:Q16521.
  ?taxon wdt:P138 ?namedAfter. # named after
  ?namedAfter wdt:P31 ?type. # Type
  OPTIONAL {
     ?article schema:about ?taxon. # and have an article about them
     ?article schema:isPartOf <https://en.wikipedia.org/> . # on *English* Wikipedia}
    }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
ORDER BY ?typeLabel
#LIMIT 500
