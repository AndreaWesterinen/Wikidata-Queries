PREFIX schema: <http://schema.org/>

SELECT DISTINCT ?item ?itemLabel ?occLabel ?linkcount WHERE {
  ?item wdt:P106 ?occ.
  VALUES (?occ) {
    (wd:Q2468727)
    (wd:Q16267607)
    (wd:Q17598791)
    (wd:Q26700841)
    (wd:Q18916625)
    (wd:Q3332711)
    (wd:Q13570226)
    (wd:Q26132815)
    (wd:Q19361459)
    (wd:Q15976341)
    (wd:Q17132038)
    (wd:Q18524037)
    (wd:Q17167049)
    (wd:Q15255771)
    (wd:Q15991218)
    (wd:Q1731155)
    (wd:Q5121550)
    (wd:Q2599593)
    (wd:Q16334453)
    (wd:Q13636225)
  }
  ?item wdt:P21 wd:Q6581072.
  ?item p:P570 ?statement.
  OPTIONAL { ?item wikibase:sitelinks ?linkcount. }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
  FILTER(NOT EXISTS {
    ?wfr schema:about ?item.
    ?wfr schema:isPartOf <https://en.wikipedia.org/>.
  })
}
ORDER BY DESC(?linkcount)
LIMIT 100
