SELECT ?item ?itemLabel ?fl ?main ?mainLabel
{
    ?item wdt:P1433 wd:Q665807 ; wdt:P1922 ?fl . 
    FILTER( CONTAINS( ?fl, "siehe" ) ) 
    ?item wdt:P31 wd:Q19389637 . 
    OPTIONAL { ?item wdt:P921 ?main }
    SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
ORDER BY (strlen(?fl))
