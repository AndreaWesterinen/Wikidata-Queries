SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P1366 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P585, wd:P518, wd:P828, wd:P2241, wd:P7452, wd:P790, wd:P3005, wd:P805, wd:P5102, wd:P1552, wd:P1011, wd:P1480, wd:P1706, wd:P3831, wd:P1810, wd:P9680, wd:P5168, wd:P958 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
