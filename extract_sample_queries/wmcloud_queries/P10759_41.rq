#title: Items with Linz location or collection missing identifier
# Complex constraint from [[Property talk:P10759]]
# Items that have an [[Property:P276|location&#32;<small dir="ltr">(P276)</small>]] or [[Property:P195|collection&#32;<small dir="ltr">(P195)</small>]] set to [[d:Q475667|Führermuseum <small>(Q475667)</small>]], but [[Property:P10759|Linz DB ID&#32;<small dir="ltr">(P10759)</small>]] is missing
SELECT DISTINCT ?item WHERE {
  { ?item p:P276/ps:P276 wd:Q475667 } UNION
  { ?item p:P195/ps:P195 wd:Q475667 } 
  MINUS { ?item wdt:P10759 [] } .
  }
