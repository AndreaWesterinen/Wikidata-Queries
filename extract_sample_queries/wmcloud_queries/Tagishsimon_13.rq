  ?item wdt:P27 ?c.
} group by ?item} as %i
where {include %i
  values (?c ?d) {(wd:Q1007 "Guinea-Bissauan") (wd:Q1008 "Ivorian") (wd:Q1011 "Cape Verdean") (wd:Q1013 "Lesotho") (wd:Q1037 "Rwandan") (wd:Q1039 "São Tomé and Príncipe") (wd:Q1042 "Seychellois") (wd:Q215 "Slovenian") (wd:Q217 "Moldovan") (wd:Q225 "Bosnia and Herzegovina") (wd:Q227 "Azerbaijani") (wd:Q232 "Kazakhstani") (wd:Q235 "Monacan") (wd:Q265 "Uzbekistani") (wd:Q32 "Luxembourgish") (wd:Q33 "Finnish") (wd:Q35 "Danish") (wd:Q36704 "Yugoslavian") (wd:Q414 "Argentinian") (wd:Q664 "New Zealand") (wd:Q685 "Solomon Islands") (wd:Q686 "Vanuatuan") (wd:Q711 "Mongolian") (wd:Q736 "Ecuadorian") (wd:Q757 "Saint Vincent and the Grenadines") (wd:Q763 "Saint Kitts and Nevis") (wd:Q781 "Antigua and Barbuda") (wd:Q783 "Honduran") (wd:Q794 "Iranian") (wd:Q801 "Israeli") (wd:Q813 "Kyrgyzstani") (wd:Q819 "Laotian") (wd:Q836 "Myanma") (wd:Q837 "Nepalese") (wd:Q851 "Saudi Arabian") (wd:Q865 "Taiwanese") (wd:Q878 "Emirati") (wd:Q928 "Philippine") (wd:Q963 "Botswanan") (wd:Q965 "Burkinabe") (wd:Q983 "Equatorial Guinean") (wd:Q1000 "Gabonese") (wd:Q1005 "Gambian") (wd:Q1006 "Guinean") (wd:Q1009 "Cameroonian") (wd:Q1014 "Liberian") (wd:Q1016 "Libyan") (wd:Q1019 "Malagasy") (wd:Q1020 "Malawian") (wd:Q1025 "Mauritanian") (wd:Q1027 "Mauritian") (wd:Q1028 "Moroccan") (wd:Q1029 "Mozambican") (wd:Q1030 "Namibian") (wd:Q1032 "Nigerien") (wd:Q1033 "Nigerian") (wd:Q1036 "Ugandan") (wd:Q1041 "Senegalese") (wd:Q1044 "Sierra Leonean") (wd:Q1049 "Sudanese") (wd:Q1050 "Swazi") (wd:Q114 "Kenyan") (wd:Q115 "Ethiopian") (wd:Q117 "Ghanaian") (wd:Q142 "French") (wd:Q145 "British") (wd:Q148 "Chinese") (wd:Q15180 "Soviet") (wd:Q155 "Brazilian") (wd:Q159 "Russian") (wd:Q16 "Canadian") (wd:Q16957 "East German") (wd:Q17 "Japanese") (wd:Q183 "German") (wd:Q184 "Belarusian") (wd:Q189 "Icelandic") (wd:Q191 "Estonian") (wd:Q20 "Norwegian") (wd:Q211 "Latvian") (wd:Q212 "Ukrainian") (wd:Q213 "Czech") (wd:Q214 "Slovak") (wd:Q218 "Romanian") (wd:Q219 "Bulgarian") (wd:Q221 "Macedonian") (wd:Q222 "Albanian") (wd:Q224 "