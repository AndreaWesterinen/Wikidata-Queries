  filter(?country_count<2)
  ?item wdt:P106 ?P106.
  ?item wdt:P27 ?c.
#  filter not exists{?item wdt:P27 ?c.}
  ?item wdt:P31 wd:Q5.
  filter not exists {?item schema:description ?Den. filter(lang(?Den)="en")}
  optional {?item rdfs:label ?itemLabel. filter(lang(?itemLabel)="en")}
} group by ?item ?itemLabel ?c ?d order by desc(?occ_count)
