SELECT DISTINCT ?item ?itemLabel ?item_q_0Label (count(*) as ?succesful_candidacies) WHERE {
  ?item p:P31 ?item_s_0Statement.
  ?item_s_0Statement ps:P31 wd:Q5.
  ?item p:P39 ?item_s_1Statement.
  ?item_s_1Statement ps:P39 wd:Q32979666;
    pq:P2937 ?item_q_0.
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
GROUP BY ?item ?itemLabel ?item_q_0Label
HAVING (?succesful_candidacies > 1)
ORDER BY DESC(?succesful_candidacies)
