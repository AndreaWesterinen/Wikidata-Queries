SELECT ?item ?itemLabel ?value ?valueLabel ?snak ?rank ?statement
WHERE
{
  {
    SELECT ?item ?value ?result ?snak ?rank ?statement WHERE {
      {
        ?item p:P1434 ?statement .
        ?statement ps:P1434 ?value; wikibase:rank ?rank .
        BIND("mainsnak" AS ?snak) .
      } UNION {
        ?statement pq:P1434 ?value; wikibase:rank ?rank .
        ?item ?p1 ?statement .
        BIND("qualifier" AS ?snak) .
      } UNION {
        ?ref pr:P1434 ?value .
        ?statement prov:wasDerivedFrom ?ref; wikibase:rank ?rank .
        ?item ?p2 ?statement .
        BIND("reference" AS ?snak) .
      } .
      FILTER( ?value  IN ( wd:Q196600, wd:Q24856, wd:Q7058673, wd:Q8274, wd:Q1107, wd:Q21198342, wd:Q747381, wd:Q104213567, wd:Q21202185, wd:Q754669, wd:Q74262765, wd:Q63952888, wd:Q20650540, wd:Q220898, wd:Q1047299, wd:Q11086742, wd:Q100269041, wd:Q7889, wd:Q56884562, wd:Q13406463 ) ) .
    } LIMIT 100
  } .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
