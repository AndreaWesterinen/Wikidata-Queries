#title: Check links to the memory-alpha wikis
# Complex constraint from [[Property talk:P6262]]
# Check links to [http://memory-alpha.wikia.com memory-alpha.wikia.com]
SELECT ?item ?value {
    ?item wdt:P6262 ?value .
    FILTER(REGEX(?value, "^(([a-z]+.)?memory-alpha:)"))
    FILTER NOT EXISTS {
      VALUES ?v {wd:Q15773317 wd:Q21191270 wd:Q15831598 wd:Q47461344 wd:Q95074 wd:Q5446565 wd:Q55566151 wd:Q5 wd:Q1045481 wd:Q16017119 wd:Q61002 wd:Q3331189 }.
      ?item wdt:P31/wdt:P279* ?v.
    }
    FILTER NOT EXISTS {
      ?item wdt:P1080 wd:Q18043309.
    }
    FILTER NOT EXISTS {
      ?item wdt:P1434 wd:Q18043309.
    }
    FILTER (?item != wd:Q1428753).
}
