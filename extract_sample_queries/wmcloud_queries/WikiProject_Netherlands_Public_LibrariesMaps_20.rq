embed.html##Provincie Noord-Brabant
#defaultView:Map
SELECT ?Qvestiging ?QvestigingLabel ?coor ?partof ?partofLabel ?image ?layer WHERE {
#SELECT ?s ?sLabel ?coor ?image ?layer WHERE { 
  
       ?Qvestiging (p:P31/ps:P31) wd:Q28564;wdt:P17 wd:Q55;
          wdt:P625 ?coor ;
          wdt:P361 ?partof ;
          OPTIONAL {?Qvestiging wdt:P18 ?image .}
  
VALUES ?partof {
#Noord-Brabant
wd:Q59962203 #St.OB Theek5
wd:Q59961930 #St.Basisbieb Het Markiezaat
wd:Q59961932 #St OB Best
wd:Q59962033 #Nieuwe Nobelaer 
wd:Q59961951 #Bieb Breda
wd:Q59962015 #St. OB Eindhoven
wd:Q59962331 #St. de Bieb Veldhoven
wd:Q59962312 #St. Bieb Midden-Brabant
wd:Q59962038 #St. Bieb Dommeldal
                }
BIND(
#Noord-Brabant
IF(?partof = wd:Q59962203, "Oosterhout, Dongen, Drimmelen, Geertruidenberg, Gilze-Rijen en Baarle-Nassau",
IF(?partof = wd:Q59961930, "Bergen op Zoom, Steenbergen en Woensdrecht",
IF(?partof = wd:Q59961932, "Best",
IF(?partof = wd:Q59962033, "Etten-Leur",
IF(?partof = wd:Q59961951, "Breda",
IF(?partof = wd:Q59962015, "Eindhoven",
IF(?partof = wd:Q59962331, "Veldhoven",
IF(?partof = wd:Q59962312, "Tilburg, Waalwijk, Goirle, e.o.",
IF(?partof = wd:Q59962038, "Geldrop-Mierlo, Nuenen c.a., Son en Breugel, Heeze-Leende", 
   "")))))))))AS ?layer).  
 
SERVICE wikibase:label { bd:serviceParam wikibase:language "nl" }
}
ORDER BY ?layer ?partofLabel ?QvestigingLabel
