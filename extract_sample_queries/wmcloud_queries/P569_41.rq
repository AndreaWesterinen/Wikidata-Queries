SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P569 [] .
			MINUS {
				VALUES ?classes { wd:Q5 wd:Q95074 wd:Q21070568 wd:Q146 wd:Q144 wd:Q726 wd:Q3542731 wd:Q30017383 wd:Q13002315 wd:Q75855169 wd:Q64520857 wd:Q64643615 wd:Q110224119 wd:Q18347143 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
