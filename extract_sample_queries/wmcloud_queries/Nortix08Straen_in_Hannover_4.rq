SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity wdt:P31 wd:Q79007 ; wdt:P131* wd:Q1715 ; FILTER NOT EXISTS{ ?entity wdt:P5816 wd:Q63065035 } . 
  MINUS { ?entity wdt:P8138 []; wdt:P31 wd:Q79007 ; wdt:P131* wd:Q1715 ; FILTER NOT EXISTS{ ?entity wdt:P5816 wd:Q63065035 }  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
