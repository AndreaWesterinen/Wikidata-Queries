SELECT DISTINCT ?l ?word ?len WHERE {
 {
   ?l a ontolex:LexicalEntry ; dct:language wd:Q1860 ; wikibase:lexicalCategory wd:Q24905 ; wikibase:lemma ?word
   BIND(strlen(?word) as ?len)  
  } UNION {
   ?l a ontolex:LexicalEntry ; dct:language wd:Q1860 ; wikibase:lexicalCategory wd:Q24905 ; ontolex:lexicalForm/ontolex:representation ?word
   BIND(strlen(?word) as ?len)  
  }
} 
order by ?len 
LIMIT 100
