SELECT ?item ?item2 (REPLACE(CONCAT('[', ?formatter, ' $1]'), '\\$1', ?bnf) AS ?url) WITH {
  SELECT * {
    ?item wdt:P268/^wdt:P268 ?item2 .
    FILTER( STR( ?item ) < STR( ?item2 ) ) .
  }
} AS %duplicates WITH {
  SELECT * { wd:P268 wdt:P1630 ?formatter } LIMIT 1
} AS %formatter WHERE {
  INCLUDE %duplicates .
  INCLUDE %formatter .
  ?item wdt:P268 ?bnf .
  ?item2 wdt:P268 ?bnf .
} ORDER BY ?bnf
