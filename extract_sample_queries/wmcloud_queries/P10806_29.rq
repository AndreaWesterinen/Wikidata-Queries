#Target required claim report for P10806: report listing each item and value

SELECT ?item ?itemLabel ?value ?valueLabel ?target ?targetLabel ?snak
WHERE
{
	{
		SELECT DISTINCT ?item ?value ?target ?snak
		WHERE
		{
			{
				?item p:P10806/ps:P10806 ?value .
				BIND("mainsnak" AS ?snak) .
			} UNION {
				?statement0 pq:P10806 ?value .
				?item ?p0 ?statement0 .
				BIND("qualifier" AS ?snak) .
			} UNION {
				?ref pr:P10806 ?value .
				?statement1 prov:wasDerivedFrom ?ref .
				?item ?p1 ?statement1 .
				BIND("reference" AS ?snak) .
			} .
			VALUES ?values { wd:Q36834 wd:Q1415090 wd:Q753110 wd:Q488205 wd:Q639669 wd:Q63536580 wd:Q21680663 wd:Q21680731 wd:Q28771895 wd:Q13424456 wd:Q3355249 wd:Q1643514 } .
			MINUS {
				?value p:P106/ps:P106 ?values .
			} .
			OPTIONAL {
				?value p:P106/ps:P106 ?target .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
