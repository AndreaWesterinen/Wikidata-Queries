SELECT ?item ?itemLabel ?partLabel WHERE {
  ?item wdt:P17 wd:Q258.
  ?item wdt:P279* wd:Q35798.
  ?item wdt:P527 ?part.
  ?item wdt:P1001 ?juris .
  { 
    { ?juris wdt:P31/wdt:P279* wd:Q1530824 }
    UNION
    { ?juris wdt:P31/wdt:P279* wd:Q1500352 }
  }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
