#title: USSR is used as nationality for people born after 1991-12-26
# Complex constraint from [[Property talk:Q15180]]
# Items with [[Property:P27|country of citizenship&#32;<small dir="ltr">(P27)</small>]] equal to [[d:Q15180|Soviet Union <small>(Q15180)</small>]] and [[Property:P570|date of death&#32;<small dir="ltr">(P570)</small>]] after 1991-12-26
SELECT DISTINCT ?item WHERE {
  ?item wdt:P27 wd:Q15180 .
  ?item p:P569/psv:P569 ?node .
  ?node wikibase:timeValue ?born .
  ?node wikibase:timePrecision ?precision .
  FILTER (?born > "1991-12-26T00:00:00Z"^^xsd:dateTime)
  FILTER (?precision >= "9"^^xsd:integer)
}
