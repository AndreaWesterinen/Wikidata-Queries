#added before 2016-10
 SELECT DISTINCT ?item  ?Titre ?createur (year(?date) as ?AnneeCreation) ?image ?coord 
WHERE
{
   ?item wdt:P31/wdt:P279* wd:Q860861.                    # sculpture
  # ?item wdt:P136 wd:Q557141 .                            # genre : public art
   {?item wdt:P131 wd:Q11299.}                               # ... situated in New York
   UNION
   {?item wdt:P131 ?arr.                                  # ... or in the administrative territory of New York 
   ?arr wdt:P131 wd:Q11299. } 
   ?item rdfs:label ?Titre filter (lang(?Titre) = "en").  # Title
  
   OPTIONAL {?item wdt:P170 ?Qcreateur.                   # Creator
   ?Qcreateur rdfs:label ?createur filter (lang(?createur) = "en") .}
   OPTIONAL {?item wdt:P571 ?date.}                       # date of creation (option)
   OPTIONAL {?item wdt:P18  ?image.}                      # image (option)
   OPTIONAL {?item wdt:P625 ?coord.}                      # geographic coordinates (option)
}
