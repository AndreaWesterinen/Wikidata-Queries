#title: Labels in English would generally be different from Spanish (es)
# Complex constraint from [[Property talk:P2358]]
# output: item with English label, English label, Spanish label
SELECT ?item ?en ?es
{
  ?item wdt:P2358 [ ] ; wdt:P31 wd:Q5 .
  ?item rdfs:label ?en . FILTER( lang(?en) = "en" ) 
  ?item rdfs:label ?es . FILTER( lang(?es) = "es" ) 
  FILTER( str(?en) = str(?es) )
}
LIMIT 1000
