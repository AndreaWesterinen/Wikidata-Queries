SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P1114 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P582, wd:P580, wd:P585, wd:P805, wd:P1480, wd:P1012, wd:P1011, wd:P5102, wd:P6949, wd:P2241, wd:P7452, wd:P1013, wd:P1319, wd:P8555, wd:P8554, wd:P1326, wd:P642, wd:P1552, wd:P5949, wd:P518, wd:P459, wd:P5447, wd:P5448, wd:P2534, wd:P1269 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
