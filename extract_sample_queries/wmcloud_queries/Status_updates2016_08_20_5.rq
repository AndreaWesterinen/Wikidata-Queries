SELECT ?film ?filmLabel (COUNT(DISTINCT ?oscar) AS ?count)
WHERE
{
  ?film wdt:P31/wdt:P279* wd:Q11424;
        wdt:P166 ?oscar;
        wdt:P1411 ?nOscar.
  wd:Q19020 ^wdt:P31 ?oscar, ?nOscar.
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
GROUP BY ?film ?filmLabel
HAVING(COUNT(DISTINCT ?oscar) >= COUNT(DISTINCT ?nOscar) && ?count > 1)
ORDER BY DESC(?count) ?filmLabel
