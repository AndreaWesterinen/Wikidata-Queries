SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P443 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P407, wd:P5168, wd:P21, wd:P2241, wd:P7452, wd:P585, wd:P805, wd:P412, wd:P898, wd:P9533, wd:P7008, wd:P6072, wd:P5548, wd:P5237, wd:P6254 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
