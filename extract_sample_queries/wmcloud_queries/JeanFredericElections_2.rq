embed.html##defaultView:Map
PREFIX q: <http://www.wikidata.org/prop/qualifier/>
PREFIX v: <http://www.wikidata.org/prop/statement/>
SELECT ?depute ?deputeLabel ?birthplaceLabel ?coord
WHERE {
  ?depute wdt:P31 wd:Q5 .
  ?depute p:P39 ?mandate .
  ?mandate v:P39 wd:Q3044918 . # French depute
  ?mandate q:P2937 wd:Q24939798 . # 15th legislature
  ?depute wdt:P19 ?birthplace .
  ?birthplace wdt:P625 ?coord .
}
ORDER BY ?birthplaceLabel
