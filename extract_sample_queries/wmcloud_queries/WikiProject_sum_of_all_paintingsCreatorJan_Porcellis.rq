SELECT ?item ?rkdurl WHERE { 
  ?item wdt:P31 wd:Q3305213 . 
  ?item wdt:P170 wd:Q640415. 
  MINUS { ?item wdt:P31 wd:Q15727816 } 
  OPTIONAL {
  wd:P350 wdt:P1630 ?formatterurl .
  ?item wdt:P350 ?rkdid .
  BIND(CONCAT('[', REPLACE(?rkdid, '^(.+)$', ?formatterurl), ' ', ?rkdid, ']') AS ?rkdurl).
  } 
}
