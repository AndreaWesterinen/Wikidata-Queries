  ?item p:P27 [ wikibase:rank ?rank; ps:P27 wd:Q16957 ]; p:P1447/ps:P1447 ?sr .
  BIND(IRI(CONCAT('https://www.sports-reference.com/olympics/athletes/', ?sr, '.html')) AS ?srurl) .
  FILTER(?rank != wikibase:DeprecatedRank) .
  OPTIONAL {
    ?item wdt:P106/rdfs:label ?occLabel .
    FILTER(LANG(?occLabel) = 'en') .
  }
  OPTIONAL {
    ?item wdt:P569 ?dob .
  }
  OPTIONAL {
    ?item wdt:P734/rdfs:label ?surnameLabel .
    FILTER(LANG(?surnameLabel) = 'en') .
  }
  SERVICE wikibase:label { bd:serviceParam wikibase:language 'en,de,fr' }
} GROUP BY ?item ?itemLabel ?itemDescription ?srurl
