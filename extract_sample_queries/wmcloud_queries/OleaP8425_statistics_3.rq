SELECT ?grouping (SAMPLE(?_higher_grouping) as ?higher_grouping) (COUNT(DISTINCT ?entity) as ?count) (SAMPLE(?entity) as ?sample) WHERE { ?entity wdt:P8425 [];. ?entity wdt:P131 ?grouping. OPTIONAL { ?grouping wdt:P131  ?_higher_grouping } } GROUP BY ?grouping HAVING (?count > 5) ORDER BY DESC(?count) LIMIT 1000
