SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P170 [] .
			MINUS {
				VALUES ?classes { wd:Q386724 wd:Q18593264 wd:Q170584 wd:Q2684591 wd:Q1656682 wd:Q321839 wd:Q17489659 wd:Q18706315 wd:Q2424752 wd:Q16686448 wd:Q61788060 wd:Q80071 wd:Q151885 wd:Q58778 wd:Q18812548 wd:Q483394 wd:Q14897293 wd:Q102345381 wd:Q2800000 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
