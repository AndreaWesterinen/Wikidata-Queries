#title: date on January 1 with best rank
SELECT ?item ?itemLabel ?date
{
  ?item p:P5017 [ a wikibase:BestRank; psv:P5017 [ wikibase:timeValue ?date; wikibase:timePrecision 11 ]] . 
  FILTER( MONTH(?date) = 1 && DAY(?date) = 1 ) 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
LIMIT 1000
