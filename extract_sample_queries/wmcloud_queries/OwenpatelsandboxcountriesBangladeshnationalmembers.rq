SELECT ?item ?country ?legislature ?position ?positiontype ?electoraldistrict ?edtype ?parliamentaryterm ?starttime ?endtime ?parliametarygroup ?fbid WHERE { 
    BIND (wd:Q902 as ?country) .
    BIND (wd:Q42712773 as ?membership) .
    BIND (wd:Q13058882 as ?legislature ) .
    ?node ps:P39 ?membership .
    OPTIONAL { ?node pq:P4100 ?parliametarygroup }
    OPTIONAL { ?node pq:P2937 ?parliamentaryterm }
    OPTIONAL { ?node pq:P580 ?starttime }
    OPTIONAL { ?node pq:P768 ?electoraldistrict .
      OPTIONAL { ?electoraldistrict wdt:P31 ?edtype }
    }
    OPTIONAL { ?node pq:P582 ?endtime }
    ?node ps:P39 ?position .
    ?position wdt:P31 ?positiontype .
    ?item p:P39 ?node .
    OPTIONAL { ?item wdt:P2013 ?fbid }
}
ORDER BY ?item
