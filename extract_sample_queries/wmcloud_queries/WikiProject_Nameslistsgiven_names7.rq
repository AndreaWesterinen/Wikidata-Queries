SELECT DISTINCT ?item ?itemLabel 
{ 
	{ ?item wdt:P31 wd:Q202444 . } UNION { ?item wdt:P31 wd:Q11879590 . } UNION { ?item wdt:P31 wd:Q12308941 . } UNION { ?item wdt:P31 wd:Q3409032 . } 
	MINUS { ?item wdt:P31 wd:Q4167410 }
	MINUS { ?item wdt:P31 wd:Q101352 }
  	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" }
}
ORDER BY ?itemLabel ?item
OFFSET 30000
LIMIT 5000
