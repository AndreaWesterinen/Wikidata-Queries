SELECT DISTINCT ?item
WHERE
{
	?item wdt:P569 ?time0 .
	FILTER ( ?time0 >= "1900-01-01T00:00:00Z"^^xsd:dateTime && ?time0 <= "2015-09-18T00:00:00Z"^^xsd:dateTime )
	?item wdt:P21 wd:Q6581072 .
	?item wdt:P27 wd:Q31 .
	{ ?item wdt:P106 wd:Q1028181 } UNION
	{ ?item wdt:P106 wd:Q1281618 } UNION
	{ ?item wdt:P106 wd:Q16947657 } UNION
	{ ?item wdt:P106 wd:Q739437 } UNION
	{ ?item wdt:P106 wd:Q739437 } UNION
	{ ?item wdt:P106 wd:Q329439 } UNION
	{ ?item wdt:P106 wd:Q15296811 } UNION
	{ ?item wdt:P106 wd:Q10862983 } UNION
	{ ?item wdt:P106 wd:Q10694573 } UNION
	{ ?item wdt:P106 wd:Q3391743 } UNION
	{ ?item wdt:P106 wd:Q483501 } UNION
	{ ?item wdt:P106 wd:Q2500638 } UNION
	{ ?item wdt:P106 wd:Q33231 }
}
