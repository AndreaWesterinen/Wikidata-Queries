SELECT (wd:Q2481549 as ?item) ("people with articles in Wikipedia" as ?legend) (GROUP_CONCAT(?p;separator = ",") as ?labels) (GROUP_CONCAT(?ct;separator = ",") as ?values)
{
	{
		SELECT  ?p (COUNT(DISTINCT ?mainsubject) as ?ct)
		{
			?entry 	wdt:P31 wd:Q19389637
  			; 		wdt:P1433 wd:Q665807 .
          	?entry wdt:P921 ?mainsubject . ?mainsubject wdt:P31 wd:Q5 .
          	OPTIONAL { ?dob schema:about ?mainsubject ; schema:isPartOf <https://en.wikipedia.org/>  }
          	OPTIONAL { ?dod schema:about ?mainsubject ; schema:isPartOf <https://de.wikipedia.org/>  }
		BIND(CONCAT(IF(!BOUND(?dob),"---","enwiki-"),IF(!BOUND(?dod),"---","-dewiki")) as ?p)
		}
		GROUP BY  ?p
		ORDER BY ASC(?p)                  
	}
}
