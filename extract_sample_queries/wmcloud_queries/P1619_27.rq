SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P1619 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P518, wd:P2868, wd:P805, wd:P7452, wd:P2241, wd:P137, wd:P276, wd:P5102, wd:P1480, wd:P542, wd:P8555, wd:P16, wd:P5168, wd:P4241 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
