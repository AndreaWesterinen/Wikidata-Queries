select distinct (?l as ?item) (concat(replace(str(?l),str(wd:),"{{L|"),"}}") as ?l_) ?lemma {
  ?l dct:language wd:Q188;
     wikibase:lemma ?lemma;
     wikibase:lexicalCategory wd:Q1084;
     wdt:P31 wd:Q138246.

  filter exists { ?l ontolex:lexicalForm/wikibase:grammaticalFeature wd:Q110786 }
} order by ?lemma ?l
