SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity wdt:P31/wdt:279* wd:Q105543609. 
?sitelink schema:about ?entity. ?sitelink schema:inLanguage "ca" . 
  MINUS { ?entity wdt:P7937 []; wdt:P31/wdt:279* wd:Q105543609. 
?sitelink schema:about ?entity. ?sitelink schema:inLanguage "ca"  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
