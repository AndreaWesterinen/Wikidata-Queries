SELECT ?item ?itemLabel ?name ?gn 
{ 
	{ SELECT ?item ?itemLabel ?gn 
	  { 
		?wiki0 schema:about ?item 
        	   ; schema:isPartOf	<https://nl.wikipedia.org/> .
		{ ?item wdt:P27 wd:Q55 } UNION { ?item wdt:P27 wd:Q29999 }
		OPTIONAL { ?item wdt:P735 ?dummy0 } FILTER(!bound(?dummy0))
		?item wdt:P31 wd:Q5 ; rdfs:label ?itemLabel . 
  		FILTER(lang(?itemLabel)="nl")
   		BIND(str(strbefore(?itemLabel, " ")) as ?gn)
	  }	LIMIT 4000
	}
  	{ SELECT ?name (str(?nl) as ?n) { ?name wdt:P793 wd:Q21644845 ; wdt:P1705 ?nl } }
    FILTER(?n = ?gn)
}
