SELECT DISTINCT ?qid ("P131" AS ?pid) ?value ("/* add correct administrative entity statement (P131) */" AS ?comment) WHERE {
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
  ?item wdt:P131 ?admin.
  ?admin wdt:P31 wd:Q15830667.
  MINUS {?admin wdt:P31 wd:Q278976.}
  ?admin wdt:P131 ?admin2.
  ?admin2 wdt:P31 wd:Q278976.
  MINUS {?item wdt:P131 ?admin2. }
  MINUS {?item wdt:P582 ?end.}
  MINUS {?item wdt:P3999 ?close.}
  MINUS {?item wdt:P576 ?dissolve. }
  BIND(SUBSTR(STR(?item), (STRLEN(STR(<http://www.wikidata.org/entity/>))) + 1) AS ?qid)
  BIND(SUBSTR(STR(?admin2), (STRLEN(STR(<http://www.wikidata.org/entity/>))) + 1) AS ?value)

}
LIMIT 1000
