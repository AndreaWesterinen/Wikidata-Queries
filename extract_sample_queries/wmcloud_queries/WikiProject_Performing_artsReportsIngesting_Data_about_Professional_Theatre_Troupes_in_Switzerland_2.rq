embed.html#SELECT ?item ?countryLabel ?Label_en ?Label_de ?Label_fr ?Label_it WHERE {

 {?item wdt:P31 wd:Q2416217} . 
 # are instances of theatre troupes
 Optional { ?item wdt:P17 ?country }
 # show optionally the country
 OPTIONAL { ?item rdfs:label ?Label_en . FILTER (lang(?Label_en) = "en") }
 OPTIONAL { ?item rdfs:label ?Label_de . FILTER (lang(?Label_de) = "de") } 
 OPTIONAL { ?item rdfs:label ?Label_fr . FILTER (lang(?Label_fr) = "fr") }
 OPTIONAL { ?item rdfs:label ?Label_it . FILTER (lang(?Label_it) = "it") }
 # languages
 Service wikibase:label {
 bd:serviceParam wikibase:language "de, en, fr, ru, it" .
	}
 # used to show the Label of the country
}
