embed.html#SELECT
  ?cast ?castLabel ?castDescription 
  (COUNT(DISTINCT ?film) as ?count) 
  (SAMPLE(?film) as ?sample) (SAMPLE(?filmLabel) as ?sampleLabel) (SAMPLE(?filmDescription) as ?sampleDescription)
WHERE
{
  	?film wdt:P161 wd:Q465826 ; wdt:P161 ?cast .
    FILTER( ?cast != wd:Q465826 )
  	{ ?film wdt:P31/wdt:P279* wd:Q11424 } UNION { ?film wdt:P31 wd:Q5398426 }
    SERVICE wikibase:label
    {
      bd:serviceParam wikibase:language "en,en".
      ?cast rdfs:label ?castLabel . ?cast schema:description ?castDescription .
      ?film rdfs:label ?filmLabel . ?film schema:description ?filmDescription .                        
    }
}
GROUP BY ?cast ?castLabel ?castDescription
ORDER BY DESC(?count) ?castLabel
