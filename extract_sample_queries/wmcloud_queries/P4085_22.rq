SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P4085 [] .
			MINUS {
				VALUES ?classes { wd:Q15632617 wd:Q28020127 wd:Q30061312 wd:Q30061294 wd:Q2593744 wd:Q89050913 wd:Q15711870 wd:Q1114461 wd:Q80447738 wd:Q87576284 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
