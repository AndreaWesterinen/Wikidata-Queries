SELECT DISTINCT ?item ?itemLabel WHERE {
  ?item wdt:P31 wd:Q18127.
  ?item wdt:P17 ?Paese .
  ?item rdfs:label ?EngLab . FILTER(LANG(?EngLab) = "en").
  OPTIONAL {?item rdfs:label ?lab2 . FILTER(LANG(?lab2) = "it").}
  FILTER(!BOUND(?lab2))
  SERVICE wikibase:label {bd:serviceParam wikibase:language "en"}
  }
