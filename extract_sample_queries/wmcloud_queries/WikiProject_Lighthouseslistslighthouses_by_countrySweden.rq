#defaultView:Map
SELECT DISTINCT ?item ?itemlabel ?itemlabel2 ?coor ?image
{
	?item wdt:P31 wd:Q39715 . 
	?item wdt:P17 wd:Q34 .
	OPTIONAL { ?item wdt:P625 ?coor }
	OPTIONAL { ?item wdt:P18 ?image }  
	OPTIONAL { ?item rdfs:label ?itemlabel . FILTER(lang(?itemlabel)="sv")  }  
	OPTIONAL { ?item rdfs:label ?itemlabel2 . FILTER(lang(?itemlabel2)="fi")  } 
}
