# fictional things named after non-fictional things
SELECT DISTINCT ?item ?itemLabel ?itemDescription ?namedAfterLabel ?namedAfterDescription WHERE {
 ?item wdt:P31/wdt:P279* wd:Q14897293;
 wdt:P138 ?namedAfter.
 MINUS { ?namedAfter wdt:P31/wdt:P279* wd:Q14897293. }
 SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
