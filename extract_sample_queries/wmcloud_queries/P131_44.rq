SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P131 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P580, wd:P582, wd:P92, wd:P3831, wd:P518, wd:P1310, wd:P2241, wd:P276, wd:P3680, wd:P585, wd:P5102, wd:P1107, wd:P828, wd:P654, wd:P7452, wd:P1011, wd:P4856, wd:P6529, wd:P2868, wd:P805, wd:P8555, wd:P1319, wd:P8554, wd:P1326, wd:P1012, wd:P1480, wd:P1013, wd:P1534, wd:P10229, wd:P281, wd:P131, wd:P17, wd:P2043, wd:P2046 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
