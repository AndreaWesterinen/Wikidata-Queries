#title: Works with creator missing link
# Complex constraint from [[Property talk:P4581]]
# List of works that are in [[Property:P195|collection&#32;<small dir="ltr">(P195)</small>]] [[d:Q163804|Städel Museum <small>(Q163804)</small>]] and have [[Property:P170|creator&#32;<small dir="ltr">(P170)</small>]] set, but that creator doesn't have a [[Property:P4581|Städel Museum artist ID&#32;<small dir="ltr">(P4581)</small>]] link
SELECT DISTINCT ?item ?creator
{
	{ ?item wdt:P195 wd:Q163804 } . 
    ?item wdt:P170 ?creator .
	MINUS { ?creator wdt:P4581 [] } .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en,de" }
} ORDER BY ?creatorLabel
