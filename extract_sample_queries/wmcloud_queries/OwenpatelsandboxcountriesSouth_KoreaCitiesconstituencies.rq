SELECT DISTINCT ?item ?cities ?council WHERE { 
    VALUES ?citytypes {wd:Q29045219 wd:Q482821 wd:Q16181672 wd:Q4249901 wd:Q29045252}
    ?cities wdt:P31 ?citytypes .
    MINUS {?cities wdt:P31/wdt:P279* wd:Q10864048 }
    ?cities wdt:P1082 ?population .
    FILTER (?population > 250000) .
    ?council wdt:P1001 ?cities ;
           wdt:P31/wdt:P279* wd:Q11204 .
    MINUS { ?council wdt:P576 [] }
    ?node ps:P279 ?cons ;
          pq:P642 ?council .
    ?citycons p:P279 ?node .
    ?item wdt:P31 ?citycons
    MINUS { ?item wdt:P576 [] }
}
ORDER BY ?item
