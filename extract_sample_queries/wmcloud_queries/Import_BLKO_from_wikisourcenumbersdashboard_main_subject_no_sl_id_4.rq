SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity ^ wdt:P921/wdt:P1433 wd:Q665807; wikibase:sitelinks 0; wikibase:identifiers 0 . 
  MINUS { ?entity wdt:P31 []; ^ wdt:P921/wdt:P1433 wd:Q665807; wikibase:sitelinks 0; wikibase:identifiers 0  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
