embed.html##defaultView:BubbleChart
SELECT DISTINCT ?party ?partyLabel (COUNT(DISTINCT ?item) AS ?count) WHERE {
  ?item p:P39 [ ps:P39 wd:Q42310633 ; pq:P4100 ?party ].
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". } 
}
GROUP BY ?party ?partyLabel
ORDER BY DESC(?count) ?partyLabel
