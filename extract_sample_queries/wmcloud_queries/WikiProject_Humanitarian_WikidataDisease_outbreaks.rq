SELECT DISTINCT ?item
WHERE
{
	# find items of some type
    { ?item wdt:P31*/wdt:P279* wd:Q44512 . }
  UNION
    { ?item wdt:P31*/wdt:P361 wd:Q44512 . }
	# with a point in time or start date
    OPTIONAL {{ ?item wdt:P585 ?date .} UNION { ?item wdt:P580 ?date. }}
}
# newest first
ORDER BY DESC(?date) 
# limit to 1000 results in case there are more
LIMIT 1000
