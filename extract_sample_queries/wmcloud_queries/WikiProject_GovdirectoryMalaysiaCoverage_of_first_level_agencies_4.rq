SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity wdt:P31 ?type .
VALUES ?type { wd:Q15063586 wd:Q1008803 }
  ?entity wdt:P31 ?type . 
  MINUS { ?entity wdt:P31 []; wdt:P31 ?type .
VALUES ?type { wd:Q15063586 wd:Q1008803 }
  ?entity wdt:P31 ?type  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
