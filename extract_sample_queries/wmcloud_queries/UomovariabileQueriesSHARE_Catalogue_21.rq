#opere di autori nati in Campania
#morti fra 1800 e 1947
#con SHARECatID 
#presenti in Wikisource in italiano
SELECT ?book ?bookLabel ?author ?authorLabel ?YoD ?SHARECATid ?placeLabel ?page WHERE {
  ?book wdt:P50 ?author.
  ?author wdt:P19 ?place.
  ?place wdt:P131+ wd:Q1438.
  ?author wdt:P3987 ?SHARECATid.
  ?author wdt:P570 ?DoD.
  ?page schema:about ?book.
  ?page schema:isPartOf <https://it.wikisource.org/>.
  SERVICE wikibase:label { bd:serviceParam wikibase:language "it,en". }
  FILTER((?DoD >= "1800-01-01T00:00:00Z"^^xsd:dateTime) && (?DoD <= "1947-12-31T00:00:00Z"^^xsd:dateTime))
  BIND(YEAR(?DoD) AS ?YoD)
}
ORDER BY DESC (?YoD)
