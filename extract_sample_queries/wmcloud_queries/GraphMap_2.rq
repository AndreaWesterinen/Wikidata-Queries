#defaultView:Map
SELECT DISTINCT ?item ?itemLabel ?itemDescription ?img ?place ?placeLabel ?coor ?value
{
  ?entry wdt:P1433 wd:Q665807 ; wdt:P921 ?item .
  ?item wdt:P19 ?place .
  ?place wdt:P17 wd:Q40 ; wdt:P625 ?coor .
  ?item wdt:P31 wd:Q5 .
  OPTIONAL { ?item wdt:P18 ?img }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}         
