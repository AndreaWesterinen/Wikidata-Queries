SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P1630 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P8460, wd:P2916, wd:P4240, wd:P407, wd:P2701, wd:P2700, wd:P3831, wd:P366, wd:P137, wd:P1476, wd:P17, wd:P2241, wd:P6954, wd:P2283, wd:P1552, wd:P518, wd:P580, wd:P582, wd:P7452, wd:P282 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
