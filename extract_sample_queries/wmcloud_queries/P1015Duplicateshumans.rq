SELECT ?item ?item2 (REPLACE(CONCAT('[', ?formatter, ' $1]'), '\\$1', ?bibsys) AS ?url) WITH {
  SELECT * {
    ?item wdt:P1015/^wdt:P1015 ?item2 .
    FILTER( STR( ?item ) < STR( ?item2 ) ) .
  { ?item wdt:P31 wd:Q5 . } UNION { ?item2 wdt:P31 wd:Q5 . }
  }
} AS %duplicates WITH {
  SELECT * { wd:P1015 wdt:P1630 ?formatter } LIMIT 1
} AS %formatter WHERE {
  INCLUDE %duplicates .
  INCLUDE %formatter .
  ?item wdt:P1015 ?bibsys .
  ?item2 wdt:P1015 ?bibsys .
} ORDER BY ?bibsys
