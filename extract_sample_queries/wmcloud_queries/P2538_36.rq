#title: Works with creator missing link
# Complex constraint from [[Property talk:P2538]]
# List of works that are in [[Property:P195|collection&#32;<small dir="ltr">(P195)</small>]] [[d:Q842858|Nationalmuseum <small>(Q842858)</small>]] and have [[Property:P170|creator&#32;<small dir="ltr">(P170)</small>]] set, but that creator doesn't have a [[Property:P2538|Nationalmuseum Sweden ID&#32;<small dir="ltr">(P2538)</small>]] link
SELECT ?item ?creator
{
	?item wdt:P195 wd:Q842858 .
    ?item wdt:P170 ?creator .
	MINUS { ?creator wdt:P2538 [] } .
	MINUS { ?item wdt:P170 wd:Q4233718 } . # Filter out anonymous
    FILTER (! wikibase:isSomeValue(?creator) ) # Filter out "unknown value"
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en,en" }
} ORDER BY ?creatorLabel
