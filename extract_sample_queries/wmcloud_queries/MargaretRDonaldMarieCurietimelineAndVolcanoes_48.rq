SELECT DISTINCT ?female ?femaleLabel ?date_of_birth ?date_of_death WHERE {
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
  ?female wdt:P21 wd:Q6581072;# instance of female
    wdt:P6379 wd:Q705551.     # Has works in the collectin of AGNSW
  OPTIONAL { ?female wdt:P569 ?date_of_birth. }
  OPTIONAL { ?female wdt:P570 ?date_of_death. }
}
