#title: cadastral municipality in Austria without ID
# Complex constraint from [[Property talk:P8322]]
# cadastral municipality in Austria lacking a [[Property:P8322|cadastral municipality ID in Austria&#32;<small dir="ltr">(P8322)</small>]] statement specifying the [[d:Q56475664|cadastral municipality number in Austria <small>(Q56475664)</small>]]
SELECT ?item WHERE { ?item wdt:P31/wdt:P279* wd:Q253326 . ?item wdt:P17 wd:Q40 . MINUS { ?item wdt:P8322 ?any . } }
