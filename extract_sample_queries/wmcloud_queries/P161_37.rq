SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P161 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P453, wd:P1932, wd:P580, wd:P582, wd:P725, wd:P3831, wd:P4633, wd:P1545, wd:P2241, wd:P1552, wd:P585, wd:P5102, wd:P8555, wd:P1319, wd:P8554, wd:P1326, wd:P518, wd:P642, wd:P5800, wd:P1810 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
