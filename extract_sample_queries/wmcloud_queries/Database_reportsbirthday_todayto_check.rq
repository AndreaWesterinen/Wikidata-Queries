SELECT ?item  WHERE { ?item wdt:P569 ?time0 . FILTER ( ?time0 >= "1899-01-01T00:00:00Z"^^xsd:dateTime && ?time0 <= "1921-01-01T00:00:00Z"^^xsd:dateTime )  OPTIONAL {?item wdt:P570 ?dod}  FILTER (!bound(?dod)) . ?item wdt:P31 wd:Q5 .  OPTIONAL {?item wdt:P746 ?disap}  FILTER (!bound(?disap)) .  OPTIONAL {?item wdt:P1317 ?fl}  FILTER (!bound(?fl)) .  OPTIONAL {?item wdt:P793 ?se}  FILTER (!bound(?se)) .  FILTER (datatype(?time0) = xsd:dateTime) FILTER (month(?time0) = month(now())) FILTER (day(?time0) >= day(now())) FILTER (day(?time0) <= (day(now())+1) ) }
