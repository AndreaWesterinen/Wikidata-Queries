SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P1056 [] .
			MINUS {
				VALUES ?classes { wd:Q43229 wd:Q8148 wd:Q13226383 wd:Q3249551 wd:Q820477 wd:Q431289 wd:Q177634 wd:Q2207288 wd:Q327333 wd:Q28640 wd:Q12737077 wd:Q5 wd:Q268592 wd:Q1408286 wd:Q31464082 wd:Q1914636 wd:Q1183543 wd:Q14897293 wd:Q811701 wd:Q600134 wd:Q166142 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
