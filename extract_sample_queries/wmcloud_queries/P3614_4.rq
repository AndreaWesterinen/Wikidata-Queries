SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P3614 [] .
			MINUS {
				VALUES ?classes { wd:Q2177636 wd:Q814648 wd:Q62326 wd:Q12340483 wd:Q876730 wd:Q2445047 wd:Q668130 wd:Q26678376 wd:Q2996700 wd:Q12307270 wd:Q10466612 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
