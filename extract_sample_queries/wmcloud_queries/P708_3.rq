SELECT ?item ?itemLabel ?value ?valueLabel ?instance ?instanceLabel ?snak 
WHERE
{
	{
		SELECT DISTINCT ?item ?value ?instance ?snak {
			{
				?item wdt:P708 ?value .
				BIND("mainsnak" AS ?snak) .
			} UNION {
				?statement0 pq:P708 ?value .
				?item ?p0 ?statement0 .
				BIND("qualifier" AS ?snak) .
			} UNION {
				?ref pr:P708 ?value .
				?statement1 prov:wasDerivedFrom ?ref .
				?item ?p1 ?statement1 .
				BIND("reference" AS ?snak) .
			} .
			MINUS {
				VALUES ?classes { wd:Q285181 wd:Q620225 wd:Q2288631 wd:Q1531518 wd:Q1778235 wd:Q1431554 wd:Q384003 wd:Q3146899 wd:Q665487 wd:Q3732788 wd:Q1492823 wd:Q2665272 wd:Q105388829 wd:Q105390172 wd:Q105072162 } .			
				?value wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?value wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
