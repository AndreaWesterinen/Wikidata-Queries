SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P611 [] .
			MINUS {
				VALUES ?classes { wd:Q5 wd:Q618123 wd:Q43229 wd:Q160742 wd:Q1128397 wd:Q2750108 wd:Q3914 wd:Q16970 wd:Q1088552 wd:Q16334295 wd:Q9067730 wd:Q15632617 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
