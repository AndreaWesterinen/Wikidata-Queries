SELECT ?item (count(?m_items) as ?m) (count(?f_items) as ?f) (count(?all_items) as ?total) 
{ 
  {?item wdt:P31 wd:Q202444 . ?m_items wdt:P21 wd:Q6581097 ; wdt:P735 ?item ; wdt:P31 wd:Q5 MINUS { ?item wdt:P31 wd:Q12308941 } } 
 UNION 
  {?item wdt:P31 wd:Q202444 . ?f_items wdt:P21 wd:Q6581072 ; wdt:P735 ?item ; wdt:P31 wd:Q5 MINUS { ?item wdt:P31 wd:Q11879590 } } 
 UNION 
  {?item wdt:P31 wd:Q202444 . ?all_items wdt:P21 [] ; wdt:P735 ?item ; wdt:P31 wd:Q5 MINUS { ?item wdt:P31 wd:Q12308941 }  MINUS { ?item wdt:P31 wd:Q11879590 } }
} 
GROUP BY ?item
HAVING (ABS(?f / (?f + ?m) - 0.5) > 0.495)
ORDER BY DESC(?total) ?item
LIMIT 200
