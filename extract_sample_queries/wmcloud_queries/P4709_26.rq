#title: In the museum without a link
# Complex constraint from [[Property talk:P4709]]
# Items that have [[Property:P195|collection&#32;<small dir="ltr">(P195)</small>]] → [[d:Q808462|Barnes Foundation <small>(Q808462)</small>]], but that don't have a [[Property:P4709|Barnes Foundation ID&#32;<small dir="ltr">(P4709)</small>]] link
SELECT DISTINCT ?item ?url WHERE {
  ?item wdt:P195 wd:Q808462 .
  OPTIONAL { ?item wdt:P973 ?url } . 
  MINUS { ?item wdt:P4709 [] } .
}  LIMIT 500
