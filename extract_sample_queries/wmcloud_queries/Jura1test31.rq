SELECT DISTINCT ?item ?item2 ?d1
{
  	?item wdt:P569 ?d1 .
  	FILTER (?d1 > "1984-01-01T00:00:00Z"^^xsd:dateTime && ?d1 < "1985-01-01T00:00:00Z"^^xsd:dateTime) .
  	OPTIONAL { ?item wdt:P570 ?dummy1 } FILTER ( !bound(?dummy1) ) .
  	?item2 wdt:P569 ?d1 .
  	OPTIONAL { ?item2 wdt:P570 ?dummy2 } FILTER ( !bound(?dummy2) ) . 
  	?item wdt:P31 wd:Q5 .
  	?item2 wdt:P31 wd:Q5 .
  	?item wdt:P21 ?g .
  	?item2 wdt:P21 ?g .
	OPTIONAL { ?item wdt:P27 ?l1 }		OPTIONAL { ?item2 wdt:P27 ?l2 }		FILTER ( !( BOUND(?l1) && BOUND(?l2) && ?l1 != ?l2) )
	OPTIONAL { ?item wdt:P106 ?n1}		OPTIONAL { ?item2 wdt:P106 ?n2}		FILTER ( !( BOUND(?n1) && BOUND(?n2) && ?n1 != ?n2) )
  	OPTIONAL { ?item wdt:P19 ?b1 }		OPTIONAL { ?item2 wdt:P19 ?b2 }		FILTER ( !( BOUND(?b1) && BOUND(?b2) && ?b1 != ?b2) )
  	OPTIONAL { ?item wdt:P22 ?f1 }		OPTIONAL { ?item2 wdt:P22 ?f2 }		FILTER ( !( BOUND(?f1) && BOUND(?f2) && ?f1 != ?f2) )
  	OPTIONAL { ?item wdt:P25 ?m1 }		OPTIONAL { ?item2 wdt:P25 ?m2 }		FILTER ( !( BOUND(?m1) && BOUND(?m2) && ?m1 != ?m2) )
  	OPTIONAL { ?item wdt:P646 ?z1 }	OPTIONAL { ?item2 wdt:P646 ?z2 }	FILTER ( !( BOUND(?z1) && BOUND(?z2) && ?z1 != ?z2) )
  	OPTIONAL { ?item wdt:P413 ?w1 }	OPTIONAL { ?item2 wdt:P413 ?w2 }	FILTER ( !( BOUND(?w1) && BOUND(?w2) && ?w1 != ?w2) )  
  	FILTER ( str(?item) < str(?item2)  )
  	MINUS { ?item wdt:P7 ?item2 }		MINUS { ?item wdt:P9 ?item2 }		# twins
  	MINUS { ?item wdt:P1889 ?item2 }	MINUS { ?item wdt:P460 ?item2 }	# identified issues
}
LIMIT 5000
