#title: XXX6### codes should be [[Property:P131|located in the administrative territorial entity&#32;<small dir="ltr">(P131)</small>]]: [[d:Q34366|Tasmania <small>(Q34366)</small>]].
# Complex constraint from [[Property talk:P10112]]
#
SELECT ?item ?itemLabel ?admin ?adminLabel ?value
WHERE
{
	{
		SELECT DISTINCT ?item ?admin ?value {
			?item wdt:P10112 ?value .
			MINUS {
				?item wdt:P131|wdt:P131/wdt:P131 wd:Q34366 .
			} .
			?item wdt:P131 ?admin .
            FILTER(STRSTARTS(?value, "LGA6") || STRSTARTS(?value, "SED6") || STRSTARTS(?value, "CED6") || STRSTARTS(?value, "SAL6") ).
		} LIMIT 1000
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
