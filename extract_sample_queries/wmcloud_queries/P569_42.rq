SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P569 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P459, wd:P805, wd:P1319, wd:P1326, wd:P1480, wd:P1013, wd:P2241, wd:P1310, wd:P4241, wd:P4895, wd:P5102, wd:P3680, wd:P421, wd:P7452, wd:P1932, wd:P10663, wd:P837, wd:P3831 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
