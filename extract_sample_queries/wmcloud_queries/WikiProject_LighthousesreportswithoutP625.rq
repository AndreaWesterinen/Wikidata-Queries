SELECT ?item (GROUP_CONCAT(?wp) as ?wp)
{
	?item wdt:P31 wd:Q39715 . 
	OPTIONAL { ?item wdt:P625 ?coor }
    FILTER(!BOUND(?coor))
    OPTIONAL { [] schema:about ?item ; schema:isPartOf / wikibase:wikiGroup "wikipedia" ; schema:name ?atitle ; schema:inLanguage ?inlang BIND(CONCAT("[[:",?inlang,":",str(?atitle), "|",?inlang,"]]") as ?wp) }
}
GROUP BY ?item
