SELECT ?item (COUNT(?item) as ?count) WHERE {
  ?painting wdt:P31 wd:Q3305213 .  
  ?painting wdt:P170 ?item . 
  MINUS { ?painting wdt:P170 wd:Q4233718 } .
  FILTER EXISTS { ?painting wdt:P195 ?collection .
                  ?collection wdt:P17 wd:Q145 } 
  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "en" .
    ?item rdfs:label ?name .
   }
} GROUP BY ?item ?name  
HAVING (?count > 25)
ORDER BY DESC(?count) 
LIMIT 300
