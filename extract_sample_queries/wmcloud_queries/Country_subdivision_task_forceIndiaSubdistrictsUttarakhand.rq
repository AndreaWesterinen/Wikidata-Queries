SELECT ?item ?len ?lhi ?den ?dhi ?division ?district {
  { ?item wdt:P31 wd:Q7694920 } UNION { ?item wdt:P31 wd:Q12416354 }
  ?item wdt:P131* ?district . ?district wdt:P31 wd:Q1149652 ; wdt:P131/wdt:P131* wd:Q1499.
  OPTIONAL { ?item wdt:P131 ?division. ?division wdt:P31 wd:Q7631016 }
  OPTIONAL { ?item rdfs:label ?len. FILTER(LANG(?len)="en") }
  OPTIONAL { ?item rdfs:label ?lhi. FILTER(LANG(?lhi)="hi") }
  OPTIONAL { ?item schema:description ?den. FILTER(LANG(?den)="en") }
  OPTIONAL { ?item schema:description ?dhi. FILTER(LANG(?dhi)="hi") }
}
