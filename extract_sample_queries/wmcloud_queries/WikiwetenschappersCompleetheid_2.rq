SELECT ?grouping (SAMPLE(?_higher_grouping) as ?higher_grouping) (COUNT(DISTINCT ?entity) as ?count) (SAMPLE(?entity) as ?sample) WHERE { ?entity wdt:P108 ?university. ?university wdt:P463 wd:Q3212092. ?entity wdt:P108 ?grouping. OPTIONAL { ?grouping wdt:P17/wdt:P298  ?_higher_grouping } } GROUP BY ?grouping HAVING (?count > 20) ORDER BY DESC(?count) LIMIT 1000
