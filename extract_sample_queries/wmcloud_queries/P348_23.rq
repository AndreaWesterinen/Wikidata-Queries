SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P348 [] .
			MINUS {
				VALUES ?classes { wd:Q7397 wd:Q235557 wd:Q9143 wd:Q1172284 wd:Q35127 wd:Q7889 wd:Q386724 wd:Q7257461 wd:Q317623 wd:Q17176533 wd:Q241317 wd:Q725744 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
