#dead characters
SELECT DISTINCT ?item ?itemLabel ?dOD ?pODLabel ?kODLabel ?cODLabel WHERE {
  ?item wdt:P31/wdt:P279* wd:Q95074.
  {?item (wdt:P570 | wdt:P20 | wdt:P1196 | wdt:P509) []}
  OPTIONAL{?item wdt:P570 ?dOD} #date of Death
  OPTIONAL{?item wdt:P20 ?pOD} #place of Death
  OPTIONAL{?item wdt:P1196 ?kOD} #kind of Death
  OPTIONAL{?item wdt:P509 ?cOD} #cause of Death
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
