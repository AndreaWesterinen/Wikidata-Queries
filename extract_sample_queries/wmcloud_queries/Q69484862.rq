embed.html##Title:Library Twitter Handles in the United States
#defaultView:Map{"hide" : "?coords"}
SELECT DISTINCT ?bib ?bibLabel (IRI(CONCAT("https://twitter.com/", ?twitterUser)) AS ?twitter) ?logo ?coords WHERE {
  ?bib (wdt:P31/(wdt:P279*)) wd:Q7075;
    wdt:P17 wd:Q30;                    # Change Q30 in this line to any other country to update this query
    wdt:P2002 ?twitterUser.
  OPTIONAL { ?bib wdt:P154 ?logo. }
  OPTIONAL { ?bib wdt:P625 ?coords. }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
