SELECT DISTINCT ?item ?image WHERE {
  ?item wdt:P31 wd:Q3305213 .
  ?item wdt:P136 wd:Q134307 .
  {?item wdt:P180 wd:Q467 .}  
  UNION                                   
  {?item wdt:P180/wdt:P279* wd:Q6581072 .} 
  ?item wdt:P571 ?date.
  ?item wdt:P18 ?image .
  FILTER((?date >= "1650-01-01T00:00:00Z"^^xsd:dateTime) && (?date <= "1659-01-01T00:00:00Z"^^xsd:dateTime))
}
