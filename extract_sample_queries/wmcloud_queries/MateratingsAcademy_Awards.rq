          OPTIONAL { [] wdt:P31/wdt:P279* wd:Q24716199; wikibase:claim ?p; wikibase:statementProperty ?ps.
                    ?item ?p ?v .
                    OPTIONAL { { ?v pq:P2676 ?q }
