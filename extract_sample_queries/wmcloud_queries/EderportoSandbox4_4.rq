SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity wdt:P1343 wd:Q78782867; p:P1343 [ prov:wasDerivedFrom [ pr:P304 ?page ] ] . 
  MINUS { ?entity wdt:P31 []; wdt:P1343 wd:Q78782867; p:P1343 [ prov:wasDerivedFrom [ pr:P304 ?page ] ]  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
