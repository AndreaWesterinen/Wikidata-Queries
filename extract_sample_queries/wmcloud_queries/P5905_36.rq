SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P5905 [] .
			MINUS {
				VALUES ?classes { wd:Q1760610 wd:Q11424 wd:Q15416 wd:Q21191270 wd:Q5 wd:Q14897293 wd:Q8274 wd:Q14406742 wd:Q747381 wd:Q18706315 wd:Q618123 wd:Q16334295 wd:Q151885 wd:Q19958368 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
