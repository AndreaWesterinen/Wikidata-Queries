SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P286 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P580, wd:P582, wd:P1534, wd:P2047, wd:P1365, wd:P1366, wd:P585, wd:P1706, wd:P1545, wd:P3831, wd:P641, wd:P2241, wd:P7452, wd:P5102, wd:P8555, wd:P1319, wd:P8554, wd:P1326 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
