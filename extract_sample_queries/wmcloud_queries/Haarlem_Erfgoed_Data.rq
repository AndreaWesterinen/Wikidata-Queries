embed.html##defaultView:Map
SELECT ?street ?streetLabel ?vernoemd_naar ?vernoemd_naarLabel ?geografische_locatie ?layer WHERE {
  ?street (wdt:P31/wdt:P279*) wd:Q79007.
  ?street wdt:P131 wd:Q9920.
      MINUS { ?street wdt:P138 _:b2. }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "nl". }
  OPTIONAL { ?street wdt:P138 ?vernoemd_naar. }
  OPTIONAL { ?street wdt:P625 ?geografische_locatie. }
}
ORDER BY ?streetLabel
