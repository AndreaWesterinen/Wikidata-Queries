SELECT ?grouping (COUNT(DISTINCT ?entity) as ?count) (SAMPLE(?entity) as ?sample) WHERE { ?entity wdt:P31 ?type .
  VALUES ?type { wd:Q1589568  wd:Q1500352 wd:Q1530824 }
  MINUS {?entity wdt:P576 [] }. ?entity wdt:P31 ?grouping .} GROUP BY ?grouping HAVING (?count < 1) ORDER BY DESC(?count) LIMIT 1000
