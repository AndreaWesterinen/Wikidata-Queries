SELECT ?qid ("P159" AS ?pid) ?value ("/* set P159 for organisation based on P131 */" AS ?comment) WHERE {
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
  ?item wdt:P31/wdt:P279* wd:Q847017.
  ?item wdt:P131 ?admin.
  MINUS { ?item wdt:P159 ?seat. }
  BIND(SUBSTR(STR(?item), (STRLEN(STR(<http://www.wikidata.org/entity/>))) + 1) AS ?qid)
  BIND(SUBSTR(STR(?admin), (STRLEN(STR(<http://www.wikidata.org/entity/>))) + 1) AS ?value)
}
LIMIT 1000
