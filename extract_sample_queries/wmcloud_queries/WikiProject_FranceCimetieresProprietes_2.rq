SELECT ?grouping (SAMPLE(?_higher_grouping) as ?higher_grouping) (COUNT(DISTINCT ?entity) as ?count) (SAMPLE(?entity) as ?sample) WHERE { ?entity wdt:P131+ wd:Q142 ; (wdt:P31/wdt:P279*) wd:Q39614. ?entity wdt:P131 ?grouping. OPTIONAL { ?grouping wdt:P131/wdt:P2586  ?_higher_grouping } } GROUP BY ?grouping HAVING (?count > 20) ORDER BY DESC(?count) LIMIT 1000
