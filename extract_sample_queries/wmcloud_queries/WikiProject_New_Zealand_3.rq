#defaultView:Map
SELECT DISTINCT ?layer ?layerLabel ?dot ?dotLabel ?coord ?line 
  WITH { SELECT DISTINCT ?sea WHERE 
  {
    {?somethingelse wdt:P131/wdt:P131 wd:Q664 .} hint:Prior hint:runFirst true.
    ?somethingelse wdt:P403|wdt:P201 ?sea .
  } } as %i

  WITH { SELECT ?sea ?layer WHERE 
  {
    INCLUDE %i
    FILTER NOT EXISTS {?sea wdt:P31/wdt:P279* wd:Q355304 . hint:Prior hint:gearing "forward".
                      FILTER NOT EXISTS {?sea wdt:P31 wd:Q47053. }
                      FILTER NOT EXISTS {?sea wdt:P31 wd:Q1210950. } }
    FILTER NOT EXISTS {?sea wdt:P31/wdt:P279* wd:Q23397 . hint:Prior hint:gearing "forward". }
    FILTER NOT EXISTS {?sea wdt:P361|wdt:P206 ?maybelake . ?maybelake wdt:P31/wdt:P279* wd:Q23397 . hint:Prior hint:gearing "forward". }
    ?sea ^wdt:P403|^wdt:P201 ?layer.
    ?layer wdt:P131/wdt:P131 wd:Q664 . hint:Prior hint:gearing "forward".
} } as %j

WHERE
{
  INCLUDE %j
  ?layer (^wdt:P403|^wdt:P201)* ?dot.

  ?dot p:P625 ?stat . 
  ?stat a wikibase:BestRank .
  ?stat ps:P625 ?coord .
  ?stat psv:P625/wikibase:geoLongitude ?long.
  ?stat psv:P625/wikibase:geoLatitude ?lat.
  filter not exists {?stat pq:P518 wd:Q7376362 . }
  
  OPTIONAL 
  {
    ?dot wdt:P201|wdt:P403 ?dash.
    {?dash wdt:P31/wdt:P279* wd:Q355304 . hint:Prior hint:gearing "forward". }
    UNION {?dash wdt:P31/wdt:P279* wd:Q23397 . hint:Prior hint:gearing "forward". }
    UNION {?dash wdt:P31/wdt:P279* wd:Q19817101 . hint:Prior hint:gearing "forward". }
    ?dash p:P625 ?stat2 . 
    ?stat2 a wikibase:BestRank .
    ?stat2 ps:P625 ?coord2 .
    ?stat2 psv:P625/wikibase:geoLongitude ?long2.
    ?stat2 psv:P625/wikibase:geoLatitude ?lat2.
    filter not exists {?stat2 pq:P518 wd:Q7376362 . }
  }
  OPTIONAL 
  {
    ?dot wdt:P201|wdt:P403 ?dash.
    ?dash wdt:P31 wd:Q165 .
    ?dot p:P625 ?stat2 . 
    ?stat2 a wikibase:BestRank .
    ?stat2 ps:P625 ?coord2 .
    ?stat2 psv:P625/wikibase:geoLongitude ?long2.
    ?stat2 psv:P625/wikibase:geoLatitude ?lat2.
    filter not exists {?stat2 pq:P518 wd:Q7376362 . }
  }
  BIND(CONCAT('LINESTRING (', STR(?long), ' ', STR(?lat), ',', STR(?long2), ' ', STR(?lat2), ')') AS ?str) .
  BIND(STRDT(?str, geo:wktLiteral) AS ?line) 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[en". }
} |Query
