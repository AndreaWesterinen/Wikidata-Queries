SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P957 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P407, wd:P437, wd:P123, wd:P518, wd:P478, wd:P2241, wd:P7452, wd:P291, wd:P577, wd:P195, wd:P179, wd:P393, wd:P2701 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
