SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P195 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P580, wd:P582, wd:P217, wd:P518, wd:P1028, wd:P2868, wd:P828, wd:P585, wd:P276, wd:P1534, wd:P2241, wd:P7452, wd:P6241, wd:P8555, wd:P1319, wd:P8554, wd:P1326, wd:P1545, wd:P127, wd:P3831, wd:P459, wd:P1416, wd:P8324, wd:P10027, wd:P478, wd:P1706 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
