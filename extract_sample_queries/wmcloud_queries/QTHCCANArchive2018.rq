SELECT ?item ?itemLabel  ?year ?P31 ?P57
with { SELECT ?item ?itemLabel (count(distinct ?type) as ?pp) (group_concat(distinct ?typelabel) as ?P31) (min(year(?date)) as ?year) (group_concat(distinct ?dirLabel) as ?P57) WHERE 
{
  ?item wdt:P31/wdt:P279* wd:Q11424.
  optional {?item rdfs:label ?itemLabel. filter(lang(?itemLabel)="en")}
  ?item wdt:P31 ?type.
  ?type rdfs:label ?typelabel. filter(lang(?typelabel)="en")
  filter not exists {?item schema:description ?Len. filter(lang(?Len)="en")}
  optional {?item wdt:P577 ?date .}
  optional {?item wdt:P57 ?dir . optional {?dir rdfs:label ?dirLabel. filter(lang(?dirLabel)="en")} }
} group by ?item ?itemLabel} as %i
where {include %i
# filter (?pp <2)
      }
