SELECT ?item ?nr_s ?nr_e ?nr_all (str(?enlabel) as ?enlabels) ?sts
WHERE 
{  
  ?item wdt:P31 wd:Q21191270 .
  ?item wdt:P179 wd:Q754197 ; wikibase:statements ?sts .
  ?item wdt:P4908 ?season .  ?season p:P179 ?season_st .  ?season_st pq:P1545 ?nr_s  .
  OPTIONAL { ?item p:P4908 [ ps:P4908 ?season ; pq:P1545 ?nr_e ] }
  OPTIONAL { ?item p:P179 [ ps:P179 wd:Q754197 ; pq:P1545 ?nr_all ] }
  OPTIONAL { ?item wdt:P1476 ?enlabel } 
} 
ORDER BY xsd:integer(?nr_s) xsd:integer(?nr_e)
