select * {
  ?item wdt:P1273 ?v .

  bind (replace(substr(?v, 9, 1), "x", "10") as ?cd) .
  bind ((
      xsd:integer(substr(?v, 2, 1))*8
    + xsd:integer(substr(?v, 3, 1))*7
    + xsd:integer(substr(?v, 4, 1))*6
    + xsd:integer(substr(?v, 5, 1))*5
    + xsd:integer(substr(?v, 6, 1))*4
    + xsd:integer(substr(?v, 7, 1))*3
    + xsd:integer(substr(?v, 8, 1))*2
  ) as ?total) .
  bind ((?total - floor(?total/11)*11) as ?mod) .
  filter (!(xsd:string(?mod) = ?cd)) .
}
