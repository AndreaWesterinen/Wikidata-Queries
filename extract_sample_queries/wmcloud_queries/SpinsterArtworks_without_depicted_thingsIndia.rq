SELECT ?item (SHA512(CONCAT(str(?item),str(RAND()))) as ?random) ?wade WHERE {
  ?item wdt:P195 ?collection.
  ?collection wdt:P17 wd:Q668.
   ?item wdt:P18 ?image.
  MINUS { ?item wdt:P180 ?depicts. }
  BIND(REPLACE(STR(?item), "http://www.wikidata.org/entity/", "", "i") AS ?itemId)
  BIND(CONCAT("[https://art.wikidata.link/item/", ?itemId, " add depiction info]") AS ?wade)
}
ORDER BY ?random
LIMIT 50
