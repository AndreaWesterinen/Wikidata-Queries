PREFIX target: <http://www.wikidata.org/entity/Q213439>

SELECT DISTINCT ?item 
?count ?author
  (CONCAT(
      "[https://scholia.toolforge.org/organization/Q213439/topic/",
      ENCODE_FOR_URI(REPLACE(STR(?item), ".*Q", "Q")), " 📰]") AS ?publist)
WITH {
  SELECT DISTINCT ?a WHERE {
    { ?a ?property target:. }
    UNION
    {
      ?a ?property2 _:b9.
      _:b9 wdt:P361 target: .
    }
  }
} AS %authors  
WITH {
  SELECT DISTINCT ?item (COUNT(DISTINCT ?work) AS ?count) (SAMPLE(?a) AS ?author) WHERE {
    INCLUDE %authors
    ?work wdt:P50 ?a ; wdt:P921 ?item .
  }
  GROUP BY ?item ?count ?author
} AS %works  
WHERE {
  INCLUDE %works
  FILTER (?count > 9)
  ?item rdfs:label ?item_label.
  FILTER((LANG(?item_label)) = "en")
}
GROUP BY ?item 
?count ?author ?publist
ORDER BY DESC(?count) 
LIMIT 2000
