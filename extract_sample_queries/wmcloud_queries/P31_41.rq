#title: Can't be instance of both a disambiguation page and a human.
# Complex constraint from [[Property talk:P31]]
# Should not be an [[Property:P31|instance of&#32;<small dir="ltr">(P31)</small>]] both a [[d:Q4167410|Wikimedia disambiguation page <small>(Q4167410)</small>]] and a [[d:Q5|human <small>(Q5)</small>]]. This can be caused caused by an incorrect merge or a sitelink that is attached to a wrong item.
SELECT ?item WHERE {
  ?item (wdt:P31/(wdt:P279*)) wd:Q4167410, wd:Q5.
} GROUP BY ?item
