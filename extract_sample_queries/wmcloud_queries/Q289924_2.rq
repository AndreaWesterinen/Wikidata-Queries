SELECT DISTINCT ?film ?filmLabel ?filmDescription ?fr (str(?fr) = str(?filmLabel) as ?same) ?fr_date ?fr_article
{
  	hint:Query hint:optimizer "None" .
  	?film ?wdt wd:Q289924.
  	?property wikibase:directClaim ?wdt ; wikibase:claim ?p ; wikibase:statementProperty ?ps
  	OPTIONAL { ?film ?p ?statement . ?statement ?ps wd:Q289924 . ?statement pq:P453 ?role . OPTIONAL { ?statement pq:P794 ?as} }
  	OPTIONAL { ?film wdt:P577 ?pub BIND(YEAR(?pub) as ?year) }
  	{ ?film wdt:P31/wdt:P279* wd:Q11424 } UNION { ?film wdt:P31 wd:Q5398426 }
  	?film wikibase:sitelinks ?sitelinks; wikibase:statements ?statements ; wikibase:sitelinks ?ids .
    SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
    OPTIONAL { ?film rdfs:label ?fr . FILTER(lang(?fr)="fr") } 
    OPTIONAL { ?film p:P577 [ pq:P291 wd:Q142 ; ps:P577 ?fr_date ] }
    OPTIONAL { ?fr_article schema:about ?film ; schema:isPartOf <https://fr.wikipedia.org/> }
}
ORDER BY ?filmDescription ?item
