SELECT DISTINCT ?item ?itemLabel ?series_ordinal ?start ?end ?replaces ?replacesLabel ?replaced_by ?replaced_byLabel WHERE {
  ?item p:P39 ?term.
  ?term ps:P39 wd:Q14536141.
  OPTIONAL { ?term pq:P580 ?start. }
  OPTIONAL { ?term pq:P582 ?end. }
  OPTIONAL { ?term pq:P1365 ?replaces. }
  OPTIONAL { ?term pq:P1366 ?replaced_by. }
  OPTIONAL { ?term pq:P1545 ?series_ordinal. }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }

}
