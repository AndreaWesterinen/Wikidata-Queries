SELECT ?grouping (SAMPLE(?_higher_grouping) as ?higher_grouping) (COUNT(DISTINCT ?entity) as ?count) (SAMPLE(?entity) as ?sample) WHERE { ?entity (wdt:P31/(wdt:P279*)) wd:Q1030034; (wdt:P131/wdt:P131) wd:Q40430. ?entity wdt:P31 ?grouping. OPTIONAL { ?grouping wdt:P17/wdt:P131  ?_higher_grouping } } GROUP BY ?grouping HAVING (?count > 20) ORDER BY DESC(?count) LIMIT 1000
