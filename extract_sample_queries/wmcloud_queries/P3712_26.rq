SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P3712 [] .
			MINUS {
				VALUES ?classes { wd:Q170584 wd:Q11410 wd:Q1914636 wd:Q58778 wd:Q321839 wd:Q2695280 wd:Q3249551 wd:Q1371819 wd:Q43229 wd:Q4026292 wd:Q7748 wd:Q151885 wd:Q1190554 wd:Q20045456 wd:Q7397 wd:Q1156854 wd:Q1151067 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
