SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P7327 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P2676, wd:P580, wd:P7367, wd:P437, wd:P1810, wd:P4970, wd:P400, wd:P2047, wd:P582, wd:P3803, wd:P518, wd:P1319, wd:P8554, wd:P8555, wd:P1326 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
