SELECT DISTINCT ?item ?itemLabel ?name ?sitelink (CONCAT("[[:","ru",":",?name,"]]") as ?art) ?cat
WHERE
{
  hint:Query hint:optimizer "None".
  ?cat wdt:P971 wd:Q101352, wd:Q7737 .
  [] schema:about ?cat ; schema:isPartOf <https://ru.wikipedia.org/> ; schema:name ?sitelink . 
  SERVICE wikibase:mwapi {
     bd:serviceParam wikibase:endpoint "ru.wikipedia.org";
                     wikibase:api "Generator";
                     mwapi:generator "categorymembers";
                     mwapi:gcmtitle ?sitelink ;         
                     mwapi:gcmlimit "max".
     ?name wikibase:apiOutput mwapi:title.             
     ?item wikibase:apiOutputItem mwapi:item
    }
  FILTER NOT EXISTS { ?item wdt:P31/wdt:P279? wd:Q101352 }
  FILTER NOT EXISTS { ?item wdt:P31 wd:Q4167836}
  FILTER NOT EXISTS { ?item wdt:P31 wd:Q4167410}
  # SERVICE wikibase:label { bd:serviceParam wikibase:language "ru,en,it" }
}
ORDER BY ?sitelink ?name
