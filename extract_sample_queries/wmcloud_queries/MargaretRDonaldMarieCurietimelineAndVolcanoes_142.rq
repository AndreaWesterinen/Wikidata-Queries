# articles authored by Phillip Gerhard Kodela (with publication dates)
# the query also finds their article


SELECT DISTINCT ?date ?item ?itemLabel ?journal ?journalLabel WHERE {
  ?item wdt:P31 wd:Q13442814 ;         # is a scholarly article
    wdt:P50  wd:Q18986279 ;            # authored by Phillip Gerhard Kodela
    wdt:P1433 ?journal;
    wdt:P577  ?date .
    SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". } 
  }
 ORDER BY  ?date ?itemLabel ?journalLabel
 LIMIT 4000    
