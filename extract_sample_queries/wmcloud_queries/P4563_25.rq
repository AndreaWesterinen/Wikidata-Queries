#title: Works with creator missing link
# Complex constraint from [[Property talk:P4563]]
# List of works that are in [[Property:P195|collection&#32;<small dir="ltr">(P195)</small>]] [[d:Q1754105|Art Museum of Estonia <small>(Q1754105)</small>]] or have [[Property:P4564|Art Museum of Estonia artwork ID&#32;<small dir="ltr">(P4564)</small>]] and have [[Property:P170|creator&#32;<small dir="ltr">(P170)</small>]] set, but that creator doesn't have a [[Property:P4563|Art Museum of Estonia artist ID&#32;<small dir="ltr">(P4563)</small>]] link
SELECT DISTINCT ?item ?creator
{
	{ ?item wdt:P195 wd:Q1754105 } UNION
    { ?item wdt:P4564 [] } . 
    ?item wdt:P170 ?creator .
	MINUS { ?creator wdt:P4563 [] } .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en,et" }
} ORDER BY ?creatorLabel
