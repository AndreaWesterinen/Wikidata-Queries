SELECT DISTINCT ?item ?commune ?dep ?region WHERE {
  hint:Query hint:optimizer "None".
  ?item wdt:P1435 wd:Q96755602.
  OPTIONAL {
    ?item wdt:P131 ?commune;
      (wdt:P131*) ?dep.
    ?dep (wdt:P31/(wdt:P279*)) wd:Q6465.
    ?dep (wdt:P131*) ?region.
    ?region (wdt:P31/(wdt:P279*)) wd:Q36784
  }
}
