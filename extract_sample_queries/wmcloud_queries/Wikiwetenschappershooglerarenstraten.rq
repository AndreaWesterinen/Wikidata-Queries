#Straten vernoemd naar hoogleraren
SELECT ?item ?itemLabel ?gemeenteLabel ?hoogleraarLabel
WHERE 
{
  ?item (wdt:P31/wdt:P279*) wd:Q83620.
  ?item wdt:P17 wd:Q55.
  ?item wdt:P131 ?gemeente.
  ?item wdt:P138 ?hoogleraar.
  ?hoogleraar wdt:P106 wd:Q1622272.
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],nl". }
}
