SELECT ?item ?itemLabel ?value ?valueLabel ?instance ?instanceLabel ?snak 
WHERE
{
	{
		SELECT DISTINCT ?item ?value ?instance ?snak {
			{
				?item wdt:P463 ?value .
				BIND("mainsnak" AS ?snak) .
			} UNION {
				?statement0 pq:P463 ?value .
				?item ?p0 ?statement0 .
				BIND("qualifier" AS ?snak) .
			} UNION {
				?ref pr:P463 ?value .
				?statement1 prov:wasDerivedFrom ?ref .
				?item ?p1 ?statement1 .
				BIND("reference" AS ?snak) .
			} .
			MINUS {
				VALUES ?classes { wd:Q43229 wd:Q14623646 wd:Q16334295 wd:Q14514600 wd:Q49773 wd:Q1729207 wd:Q16887380 wd:Q34627 wd:Q48204 wd:Q49459835 wd:Q2638480 wd:Q55657615 wd:Q264965 wd:Q13473501 wd:Q431603 wd:Q627272 } .			
				?value wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?value wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
