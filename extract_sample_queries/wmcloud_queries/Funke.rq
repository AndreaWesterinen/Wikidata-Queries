SELECT DISTINCT ?item ?itemLabel ?Stra_enkennziffer ?Katastralgemeinde_Nummer ?Ortschaftskennziffer_in__sterreich ?liegt_in_der_Verwaltungseinheit ?liegt_in_der_VerwaltungseinheitLabel ?geographische_Koordinaten WHERE {
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE]". }
  {
    SELECT DISTINCT ?item WHERE {
      ?item p:P31 ?statement0.
      ?statement0 (ps:P31/(wdt:P279*)) wd:Q486972.
      ?item p:P131 ?statement1.
      ?statement1 (ps:P131/(wdt:P131*)) wd:Q40.
    }
  }
  OPTIONAL { ?item wdt:P10198 ?Stra_enkennziffer. }
  OPTIONAL { ?item wdt:P8322 ?Katastralgemeinde_Nummer. }
  OPTIONAL { ?item wdt:P8384 ?Ortschaftskennziffer_in__sterreich. }
  OPTIONAL { ?item wdt:P131 ?liegt_in_der_Verwaltungseinheit. }
  OPTIONAL { ?item wdt:P625 ?geographische_Koordinaten. }
}
LIMIT 3000
