SELECT ?item 
  (COUNT(DISTINCT ?gn) as ?count)
  (COUNT(DISTINCT ?p) as ?count_p)
  (SAMPLE(?gn) as ?sample_gn)
{
    ?gn wdt:P407 wd:Q9056 .
    ?gn wdt:P31/wdt:P279? wd:Q202444 .
    ?gn wdt:P31 ?item .
    OPTIONAL { ?p wdt:P735 ?gn }
}
GROUP BY ?item
HAVING ( ?count > 50) 
ORDER BY DESC(?count)
