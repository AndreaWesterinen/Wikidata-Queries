#defaultView:Map
SELECT ?s ?sLabel ?coor ?operator ?operatorLabel ?image ?layer WHERE {
 
    ?s wdt:P31/wdt:P279* wd:Q7075 ;
          wdt:P17 wd:Q145 ;
          wdt:P625 ?coor ;
          wdt:P137 ?operator ;
          OPTIONAL {?s wdt:P18 ?image .}
          
 VALUES ?operator { wd:Q319761 wd:Q790029 wd:Q5038449 wd:Q1035745 wd:Q7375001 wd:Q1420500 wd:Q1971174 wd:Q3400501 wd:Q4923796 wd:Q4966533 wd:Q5016926 wd:Q5038400 wd:Q5043224 wd:Q5064127 wd:Q5166758 wd:Q5256629 wd:Q16837157
                   wd:Q5623821 wd:Q6083890 wd:Q16997658 wd:Q6901162 wd:Q6984500 wd:Q16998902 wd:Q7161994 wd:Q7236943 wd:Q7321391
                                 wd:Q5123523 wd:Q6980600 wd:Q7825688 wd:Q1954765 wd:Q2046319 wd:Q3112646 wd:Q5142752 wd:Q7592929 wd:Q6820686 wd:Q7161992 wd:Q5142753 wd:Q5590045 wd:Q16891916 wd:Q5142762 wd:Q5038488 wd:Q20713648 wd:Q4966531 wd:Q17986585 wd:Q16890510 wd:Q7909538 wd:Q8038115 wd:Q4898241 wd:Q4667178 wd:Q4761763 wd:Q5038490 wd:Q5197211 wd:Q30287465 wd:Q18343995 wd:Q17018314 wd:Q7373981 wd:Q18358583 }

 
 
SERVICE wikibase:label { bd:serviceParam wikibase:language "en" }
}
ORDER BY ?operatorLabel ?sLabel
