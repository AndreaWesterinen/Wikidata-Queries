#title:location of items with property P821 statements (New Brunswick)
#defaultView:Map{"hide":["?coordinates"]}
SELECT DISTINCT ?site ?siteLabel ?coordinates ?image ?value
WHERE 
{
  ?site wdt:P821 ?value; wdt:P625 ?coordinates.
  OPTIONAL { ?site wdt:P18 ?image }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
  FILTER(STRSTARTS(?value, "D"))
}
