SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P553 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P554, wd:P407, wd:P580, wd:P582, wd:P2868, wd:P2699, wd:P1552, wd:P1065, wd:P3744, wd:P2960, wd:P2241, wd:P5436, wd:P459, wd:P7452, wd:P8555, wd:P1319, wd:P8554, wd:P1326, wd:P1534, wd:P585, wd:P1001, wd:P1810 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
