#defaultView:Map
SELECT DISTINCT ?item ?itemLabel ?coords ?image WHERE {
  ?item wdt:P31 wd:Q170980 ;
        wdt:P131* wd:Q220 .
  OPTIONAL { ?item wdt:P625 ?coords . }
  OPTIONAL { ?item wdt:P18 ?image . }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en" . }
} ORDER BY ?itemLabel
