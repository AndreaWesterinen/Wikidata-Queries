#title: Works with creator missing link
# Complex constraint from [[Property talk:P2041]]
# List of works that are in [[Property:P195|collection&#32;<small dir="ltr">(P195)</small>]] [[d:Q1464509|National Gallery of Victoria <small>(Q1464509)</small>]] and have [[Property:P170|creator&#32;<small dir="ltr">(P170)</small>]] set, but that creator doesn't have a [[Property:P2041|National Gallery of Victoria artist ID&#32;<small dir="ltr">(P2041)</small>]] link
SELECT ?item ?creator 
{
	?item wdt:P195 wd:Q1464509 .
    ?item wdt:P170 ?creator .
	MINUS { ?creator wdt:P2041 [] } .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en,en" }
} ORDER BY ?creatorLabel
