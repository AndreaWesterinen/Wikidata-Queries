select * {
  ?item p:P39 [ps:P39 ?position ; pq:P580 ?start] . 
  ?position  wdt:P361 wd:Q2396053 .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "bg". ?item rdfs:label ?xLabel . ?position rdfs:label ?positionLabel }
  filter(year(?start)>1989)
  minus {?item wdt:P18 ?image}
  optional{?wp schema:about ?item ; schema:isPartOf <https://bg.wikipedia.org/>}
}
