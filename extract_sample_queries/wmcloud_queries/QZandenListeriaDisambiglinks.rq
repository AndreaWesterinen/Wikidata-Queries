SELECT DISTINCT ?item (CONCAT("[[Property:P", STRAFTER(STR(?property), STR(wd:P)), "|P", STRAFTER(STR(?PROPERTY), STR(WD:P)), "&#32;<small dir="ltr">(P", STRAFTER(STR(?property), STR(wd:P)), ")</small>]]") AS ?prop) ?disambig WHERE {
  ?disambig wdt:P31 wd:Q4167410.
  ?item ?p _:b0.
  _:b0 ?ps ?disambig.
  ?ps ^wikibase:statementProperty ?property.
  MINUS { ?item (wdt:P31/wdt:P279?) wd:Q4167410. }
  MINUS { ?item (wdt:P31/wdt:P279?) wd:Q17362920. }
  FILTER(?property NOT IN(wd:P460, wd:P1889))
}
LIMIT 100
