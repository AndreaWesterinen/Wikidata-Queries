SELECT ?item ?itemLabel ?value ?valueLabel ?instance ?instanceLabel ?snak 
WHERE
{
	{
		SELECT DISTINCT ?item ?value ?instance ?snak {
			{
				?item wdt:P800 ?value .
				BIND("mainsnak" AS ?snak) .
			} UNION {
				?statement0 pq:P800 ?value .
				?item ?p0 ?statement0 .
				BIND("qualifier" AS ?snak) .
			} UNION {
				?ref pr:P800 ?value .
				?statement1 prov:wasDerivedFrom ?ref .
				?item ?p1 ?statement1 .
				BIND("reference" AS ?snak) .
			} .
			MINUS {
				VALUES ?classes { wd:Q386724 wd:Q1151067 wd:Q151885 wd:Q11862829 wd:Q211364 wd:Q1293220 wd:Q17737 wd:Q1799072 wd:Q14208553 wd:Q486902 wd:Q1298668 wd:Q170584 wd:Q36534 wd:Q12772819 wd:Q65943 wd:Q2424752 wd:Q43229 wd:Q2668072 wd:Q8261 wd:Q618779 wd:Q9081 wd:Q41553020 wd:Q1711593 wd:Q10541491 wd:Q7406919 wd:Q820655 wd:Q2095 wd:Q1914636 wd:Q1656682 wd:Q16510064 } .			
				?value wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?value wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
