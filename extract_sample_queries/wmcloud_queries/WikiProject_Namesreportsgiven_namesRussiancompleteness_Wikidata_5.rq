SELECT
  ?item
  (COUNT(DISTINCT ?p) as ?count) 
  (COUNT(DISTINCT ?p0) as ?with)
  (?count - ?with as ?todo)
  ( ROUND(?with / ?count * 100 ) as ?percentage)
  (SAMPLE(?p0) as ?samp)
WHERE
{
  # hint:Query hint:optimizer "None".
  VALUES ?item { wd:Q159 wd:Q15180 wd:Q34266 }
  ?p wdt:P27 ?item .
  hint:Prior hint:rangeSafe true .
  ?p wdt:P31 wd:Q5 .
  ?p rdfs:label ?l . FILTER(lang(?l)="ru")
  OPTIONAL {  ?p rdfs:label ?l0 . FILTER(lang(?l0)="ru" && REGEX( ?l0, "," ) ) . BIND( ?p as ?p0) }
}
GROUP BY ?item
ORDER BY DESC(?count)
