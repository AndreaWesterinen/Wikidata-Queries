SELECT DISTINCT ?item (?label AS ?Anl) (?labelEn AS ?Lnl) WHERE {
  ?item rdfs:label ?label.
  ?item rdfs:label ?labelEn.
  ?item wdt:P6379 ?collectie.
  ?item wdt:P31 wd:Q5.
  SERVICE wikibase:label { bd:serviceParam wikibase:language "nl, en". }
  FILTER((LANG(?label)) = "nl")
  FILTER(REGEX(?label, "^([A-Z][.]?)+ "))
  FILTER(REGEX(?labelEn, "^[A-z]{3,}"))
}
