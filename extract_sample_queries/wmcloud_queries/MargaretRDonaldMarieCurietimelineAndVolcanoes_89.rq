# Acacia species without a taxon range map image 
SELECT ?item ?stat ?taxon_name  WHERE {
  ?item p:P225 ?stat . 
  ?stat ps:P225 ?taxon_name.
  #?stat pq:P405 wd:Q18637582. 
  ?item wdt:P171 wd:Q81666. # parent taxon is Acacia
  MINUS {
     ?item wdt:P181 ?range_map.
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". } 
    }
}
ORDER BY ?taxon_name ?item
