PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>

SELECT ?instance ?instanceLabel ?count WHERE {
  {
    SELECT ?instance (COUNT(*) AS ?count) WHERE {
       ?a wdt:P31 ?instance .
       ?a wdt:P21 wd:Q6581097 .
    } GROUP BY ?instance 
  } . 
  FILTER (?instance != wd:Q5) .
  FILTER (?instance != wd:Q15632617) .
  FILTER (?instance != wd:Q95074) .
  FILTER (?instance != wd:Q159979) .
  FILTER (?instance != wd:Q13127686) .
  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "en,en" .
  }
}
ORDER BY DESC(?count) ?instance
LIMIT 120
