SELECT ?item ?itemLabel ?value ?valueLabel ?instance ?instanceLabel ?snak 
WHERE
{
	{
		SELECT DISTINCT ?item ?value ?instance ?snak {
			{
				?item wdt:P1001 ?value .
				BIND("mainsnak" AS ?snak) .
			} UNION {
				?statement0 pq:P1001 ?value .
				?item ?p0 ?statement0 .
				BIND("qualifier" AS ?snak) .
			} UNION {
				?ref pr:P1001 ?value .
				?statement1 prov:wasDerivedFrom ?ref .
				?item ?p1 ?statement1 .
				BIND("reference" AS ?snak) .
			} .
			MINUS {
				VALUES ?classes { wd:Q56061 wd:Q1048835 wd:Q82794 wd:Q3895768 wd:Q2882257 wd:Q3918 wd:Q7188 wd:Q44782 wd:Q5982983 wd:Q6087062 wd:Q13414953 wd:Q7278 wd:Q57662985 wd:Q31728 wd:Q2221906 wd:Q61005213 wd:Q4358176 wd:Q43229 } .			
				?value wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?value wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
