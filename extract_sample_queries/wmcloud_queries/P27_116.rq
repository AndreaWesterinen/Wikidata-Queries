SELECT ?item ?itemLabel ?value ?valueLabel ?instance ?instanceLabel ?snak 
WHERE
{
	{
		SELECT DISTINCT ?item ?value ?instance ?snak {
			{
				?item wdt:P27 ?value .
				BIND("mainsnak" AS ?snak) .
			} UNION {
				?statement0 pq:P27 ?value .
				?item ?p0 ?statement0 .
				BIND("qualifier" AS ?snak) .
			} UNION {
				?ref pr:P27 ?value .
				?statement1 prov:wasDerivedFrom ?ref .
				?item ?p1 ?statement1 .
				BIND("reference" AS ?snak) .
			} .
			MINUS {
				VALUES ?classes { wd:Q96196009 wd:Q57662985 wd:Q6266 wd:Q161243 wd:Q148837 wd:Q2775969 wd:Q231002 wd:Q170156 wd:Q6256 wd:Q3024240 wd:Q15239622 wd:Q1145276 wd:Q133442 wd:Q1048835 wd:Q3624078 wd:Q48349 wd:Q42138 wd:Q133156 wd:Q107390 } .			
				?value wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?value wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
