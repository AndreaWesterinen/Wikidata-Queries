PREFIX schema: <http://schema.org/>

#Missing description for a target language
#Search for missing descriptions in a target language.
#Can be input for Q29032512
SELECT ?item ?occupationLabel ?domainLabel ?positionLabel ?itemDescription WHERE {
  ?item wdt:P31 wd:Q5.
  ?item wdt:P27 wd:Q183.
  OPTIONAL {  }
  OPTIONAL { ?item wdt:P106 ?occupation. }
  OPTIONAL { ?item wdt:P101 ?domain. }
  OPTIONAL { ?item wdt:P39 ?position. }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "de". }
  ?item wdt:P21 wd:Q6581072.
  FILTER(NOT EXISTS {
    ?item schema:description ?itemdesc.
    FILTER((LANG(?itemdesc)) = "de")
  })
}
ORDER BY ?itemLabel
