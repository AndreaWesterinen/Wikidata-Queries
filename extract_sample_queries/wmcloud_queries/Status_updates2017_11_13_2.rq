#Canals within 800km of Glasgow

#defaultView:Map
SELECT ?place ?placeLabel ?location
WHERE
{
  # Glasgow coordinates
  wd:Q4093 wdt:P625 ?GlasgowLoc .
  SERVICE wikibase:around {
    ?place wdt:P625 ?location .
    bd:serviceParam wikibase:center ?GlasgowLoc .
    bd:serviceParam wikibase:radius "800" .
  } .
  # Is a canal
  FILTER EXISTS { ?place wdt:P31/wdt:P279* wd:Q12284 } .
  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "en" .
  } .
}
