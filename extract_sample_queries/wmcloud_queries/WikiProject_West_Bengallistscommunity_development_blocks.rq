SELECT ?item ?loc ?females2011 ?males2011 ?total2011 ?households2011 ?urban2011 ?rural2011 
WHERE {
  ?item wdt:P31 wd:Q2775236 ; wdt:P131/wdt:P131* ?loc. ?loc wdt:P31 wd:Q1149652 ; wdt:P131/wdt:P131* wd:Q1356.
OPTIONAL { ?item p:P1539 ?fps2011. ?fps2011 ps:P1539 ?females2011. ?fps2011 pq:P585 ?fp01d. FILTER(year(?fp01d) = 2011) }
OPTIONAL { ?item p:P1540 ?mps2011. ?mps2011 ps:P1540 ?males2011. ?mps2011 pq:P585 ?mp01d. FILTER(year(?mp01d) = 2011) }
OPTIONAL { ?item p:P1082 ?ps2011. ?ps2011 ps:P1082 ?total2011. ?ps2011 pq:P585 ?p01d. FILTER(year(?p01d) = 2011) }
OPTIONAL { ?item p:P1538 ?hps2011. ?hps2011 ps:P1538 ?households2011. ?hps2011 pq:P585 ?hp01d. FILTER(year(?hp01d) = 2011) }
OPTIONAL { ?item p:P6343 ?ups2011. ?ups2011 ps:P6343 ?urban2011. ?ups2011 pq:P585 ?up01d. FILTER(year(?up01d) = 2011) }
OPTIONAL { ?item p:P6344 ?rps2011. ?rps2011 ps:P6344 ?rural2011. ?rps2011 pq:P585 ?rp01d. FILTER(year(?rp01d) = 2011) }
}
