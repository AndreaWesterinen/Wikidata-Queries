SELECT ?person ?personLabel ?artukLabel ?ULANLabel ?OBINLabel ?article 
WHERE {
 
  ?person wdt:P1367 ?dummy1.
  
  OPTIONAL{?person wdt:P1367 ?artuk .} 
  OPTIONAL{?person wdt:P245 ?ULAN .} 
  OPTIONAL{?person wdt:P1415 ?OBIN .}
  OPTIONAL {?article 	schema:about ?person ;
			schema:isPartOf <https://en.wikipedia.org/> .}
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en" }
}
