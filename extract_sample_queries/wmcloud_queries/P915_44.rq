SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P915 [] .
			MINUS {
				VALUES ?classes { wd:Q11424 wd:Q3464665 wd:Q24856 wd:Q5398426 wd:Q15416 wd:Q1983062 wd:Q3895768 wd:Q34508 wd:Q1555508 wd:Q20899 wd:Q7889 wd:Q20742776 wd:Q17558136 wd:Q10590726 wd:Q112627928 wd:Q30070675 wd:Q2431196 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
