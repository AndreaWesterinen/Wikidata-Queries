SELECT ?item ?headofgov (GROUP_CONCAT(?headofgovinstanceof; SEPARATOR = "<br />")  AS ?hoginstancelist) ?council ?member (GROUP_CONCAT(?memberinstanceof; SEPARATOR = "<br />")  AS ?memberinstancelist) ?numberconstituencies (COUNT(?constituency) AS ?countconstituencies) (GROUP_CONCAT(?constituencyLab; SEPARATOR = "<br />") AS ?constituencyList) ?constype WHERE { 
  VALUES ?item { wd:Q8660 wd:Q11739 wd:Q173985 wd:Q93230 wd:Q24440 wd:Q243322 wd:Q549467 wd:Q185453 wd:Q1640079 wd:Q848613 wd:Q185458 wd:Q318156 wd:Q855997 wd:Q643883 wd:Q868631 wd:Q696605 wd:Q2503836 wd:Q2639823 wd:Q936703 wd:Q999076 wd:Q929062 wd:Q523778 wd:Q2379056 wd:Q2503839 wd:Q46785 wd:Q389161 wd:Q64170 wd:Q2503822 wd:Q74192 } .
  MINUS {?item p:P31 ?node .
         ?node ps:P31 ?citytypes ;
               pq:P582 []}
  OPTIONAL {?item wdt:P1313 ?headofgov .
            ?headofgov wdt:P31 ?headofgovinstanceof
            MINUS { ?headofgov wdt:P576 [] } 
           } 
  OPTIONAL {?item wdt:P194 ?council 
                  OPTIONAL { ?council wdt:P4253 ?numberconstituencies } 
            OPTIONAL {?member wdt:P361 ?council .
                      ?member wdt:P279 wd:Q708492 . 
                      ?member wdt:P31 ?memberinstanceof
                      MINUS {?member wdt:P576 [] } 
           } 
            OPTIONAL { ?statement ps:P279 wd:Q192611 ;
                                  pq:P642 ?council.
                      ?constype p:P279 ?statement .
                      ?constituency wdt:P31/wdt:P279* ?constype ;
                                    rdfs:label ?constituencyLab . 
                      FILTER(lang(?constituencyLab) = 'en') 
                      MINUS { ?constituency wdt:P576 [] }
                     }
            MINUS { ?council wdt:P576 [] } 
            }
  MINUS { ?item wdt:P576 [] }
} 
GROUP BY ?item ?headofgov ?headofgovinstanceof ?council ?member ?memberinstanceof ?numberconstituencies ?constype 
ORDER BY ?item ?constituency
