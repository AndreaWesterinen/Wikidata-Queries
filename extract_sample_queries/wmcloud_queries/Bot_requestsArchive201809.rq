SELECT DISTINCT ?item ?itemLabel ?len ?unitLabel
WHERE 
{
  ?item wdt:P31/wdt:P279* wd:Q12280.
  ?item p:P2043/psv:P2043 ?length.
  ?length wikibase:quantityAmount ?len.
  ?length wikibase:quantityUnit ?unit.
  filter(?unit = wd:Q3270676)
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
