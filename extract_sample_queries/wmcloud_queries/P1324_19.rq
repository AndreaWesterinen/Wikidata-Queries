SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P1324 [] .
			MINUS {
				VALUES ?classes { wd:Q7397 wd:Q9143 wd:Q35127 wd:Q213369 wd:Q3133368 wd:Q15184295 wd:Q11266439 wd:Q17451 wd:Q192776 wd:Q20819677 wd:Q317623 wd:Q49848 wd:Q1172284 wd:Q11173 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
