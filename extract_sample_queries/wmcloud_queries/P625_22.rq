#title: Places around the Sahara
# Complex constraint from [[Property talk:P625]]
# 50 km around the Sahara
SELECT ?item ?dist
{
  SERVICE wikibase:around { 
      ?item wdt:P625 ?location . 
      bd:serviceParam wikibase:center "Point(23.4035581 25.6623178)"^^geo:wktLiteral .
      bd:serviceParam wikibase:radius "50" . 
  }
  BIND(geof:distance("Point(23.4035581 25.6623178)"^^geo:wktLiteral, ?location) as ?dist)
} 
ORDER BY ?dist
