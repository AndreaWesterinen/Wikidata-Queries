SELECT ?item ?itemLabel ?libreviewsurl ?geo ?image
WHERE 
{
  ?item wdt:P3308 ?libreviewsid ;
        wdt:P131* wd:Q5963 .
  wd:P3308 wdt:P1630 ?formatterurl .
  BIND(IRI(REPLACE(?libreviewsid, '^(.+)$', ?formatterurl)) AS ?libreviewsurl).
  OPTIONAL { ?item wdt:P625 ?geo . }
  OPTIONAL { ?item wdt:P18 ?image . }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],de,en". } 
}
LIMIT 10
