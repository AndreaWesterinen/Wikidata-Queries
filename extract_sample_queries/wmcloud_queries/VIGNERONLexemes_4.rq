SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity dct:language wd:Q12107 ; wikibase:lexicalCategory ?cat ; wikibase:statements ?st 
GROUP BY ?l ?cat ?st . 
  MINUS { ?entity wdt:wikibase:lexicalCategory []; dct:language wd:Q12107 ; wikibase:lexicalCategory ?cat ; wikibase:statements ?st 
GROUP BY ?l ?cat ?st  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
