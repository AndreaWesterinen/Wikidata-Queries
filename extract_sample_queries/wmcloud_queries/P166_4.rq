#title: Check the prize 'Prix du jeune écrivain de langue française'
# Complex constraint from [[Property talk:P166]]
# Prize for a 15 to 27 years old person
SELECT ?item ?date ?diff WHERE {
     ?item p:P166 ?statement.
     ?statement ps:P166 wd:Q3405865.
     ?statement pq:P585 ?date.
     ?item wdt:P569 ?born.
     BIND((?date - ?born)/365 AS ?diff).
     FILTER (?diff > 27 || 15 > ?diff)
} ORDER BY ?diff
