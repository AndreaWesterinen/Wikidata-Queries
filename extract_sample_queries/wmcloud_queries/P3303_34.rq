SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P3303 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P8460, wd:P2916, wd:P4240, wd:P137, wd:P2701, wd:P366, wd:P642, wd:P407, wd:P2283, wd:P2241, wd:P1932 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
