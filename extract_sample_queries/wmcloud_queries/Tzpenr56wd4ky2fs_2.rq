SELECT ?award ?awardLabel ?total ?women ?women_percentage
WHERE {
  hint:Query hint:optimizer "None" .
  {
    SELECT ?award (COUNT(*) AS ?total) (SUM(IF(?gender = wd:Q6581072, 1, 0)) AS ?women) (ROUND(1000 / COUNT(*) * SUM(IF(?gender = wd:Q6581072, 1, 0))) / 10 AS ?women_percentage)
    WHERE {
      ?human wdt:P166 ?award ; wdt:P21 ?gender ; wdt:P31 wd:Q5 .
    }
    GROUP BY ?award
    ORDER BY DESC(?total)
    LIMIT 200
  } .
  ?award rdfs:label ?awardLabel .
  FILTER (LANG(?awardLabel) = "en") .
}
ORDER BY DESC(?total)
