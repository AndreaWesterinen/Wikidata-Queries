SELECT ?item ?itemLabel ?value ?valueLabel
{
  hint:Query hint:optimizer "None".
  ?item wdt:P1629 ?value .
  ?item wikibase:propertyType wikibase:ExternalId .
  FILTER NOT EXISTS { ?item wdt:P1629/wdt:P31/wdt:P279* wd:Q8513 .hint:Prior hint:gearing "forward" }
  FILTER NOT EXISTS { ?item wdt:P1629/wdt:P31/wdt:P279* wd:Q47461344 .hint:Prior hint:gearing "forward" }
  FILTER NOT EXISTS { ?item wdt:P1629/wdt:P31/wdt:P279* wd:Q5962346 .hint:Prior hint:gearing "forward" }
  FILTER NOT EXISTS { ?item wdt:P1629/wdt:P279/wdt:P279* wd:Q853614 .hint:Prior hint:gearing "forward" }
  FILTER NOT EXISTS { ?item wdt:P1629/wdt:P31/wdt:P279* wd:Q853614 .hint:Prior hint:gearing "forward" }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en,en"  }
}
