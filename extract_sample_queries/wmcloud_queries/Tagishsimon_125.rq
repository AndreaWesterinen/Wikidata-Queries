SELECT DISTINCT ?item ?itemLabel ?sitelinks ?coord  ?layer WITH { SELECT ?item ?layer
WHERE 
{
    {?item wdt:P131/wdt:P131 wd:Q22 . } hint:Prior hint:runFirst true.
  ?item wdt:P31/wdt:P279* wd:Q23397. hint:Prior hint:gearing "forward".
  
  optional  {?item wdt:P201 [] . bind("outflow" as ?layer) }
  filter not exists {?item wdt:P131 wd:Q80967 . } # Outer Hebrides
  filter not exists {?item wdt:P131 wd:Q47134 . } # Shetland Islands
  filter not exists {?item wdt:P131 wd:Q100166 . } # Orkney Islands

} } as %i
WHERE
{
  INCLUDE %i
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". } 
  ?item wikibase:sitelinks ?sitelinks.
  ?item wdt:P625 ?coord .
  BIND(if(!BOUND(?layer),"No",?layer) as ?layer)
} order by desc(?sitelinks) ?itemLabel
