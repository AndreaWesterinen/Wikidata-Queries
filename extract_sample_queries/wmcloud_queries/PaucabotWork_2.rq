#Llista d'edificis de les Illes Balears
SELECT ?s ?label ?sDescription
WHERE {
    ?s wdt:P131 ?place.
    ?place wdt:P131*/wdt:P706* wd:Q5765.
    ?s wdt:P31 ?tip.
    ?tip wdt:P31*/wdt:P279* wd:Q41176.
    ?s rdfs:label ?label filter (lang(?label) = "ca")
    SERVICE wikibase:label {bd:serviceParam wikibase:language "ca,es,en,fr" .}
 }
