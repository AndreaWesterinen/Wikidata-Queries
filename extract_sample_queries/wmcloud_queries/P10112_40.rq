#title: XXX4### codes should be [[Property:P131|located in the administrative territorial entity&#32;<small dir="ltr">(P131)</small>]]: [[d:Q35715|South Australia <small>(Q35715)</small>]].
# Complex constraint from [[Property talk:P10112]]
#
SELECT ?item ?itemLabel ?admin ?adminLabel ?value
WHERE
{
	{
		SELECT DISTINCT ?item ?admin ?value {
			?item wdt:P10112 ?value .
			MINUS {
				?item wdt:P131|wdt:P131/wdt:P131 wd:Q35715 .
			} .
			?item wdt:P131 ?admin .
            FILTER(STRSTARTS(?value, "LGA4") || STRSTARTS(?value, "SED4") || STRSTARTS(?value, "CED4") || STRSTARTS(?value, "SAL4") ).
		} LIMIT 1000
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
