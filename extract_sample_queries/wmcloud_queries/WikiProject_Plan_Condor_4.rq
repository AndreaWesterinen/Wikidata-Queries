embed.html##desapariciones forzadas por lugar de reclusión
#defaultView:Graph
SELECT ?item ?itemLabel ?itemimagen ?centro ?centroLabel ?centroImagen {
  ?item wdt:P31 wd:Q5.
  ?item wdt:P27 wd:Q77.
  OPTIONAL {?item wdt:P18 ?itemimagen}.
  ?item wdt:P746 [].
  ?item wdt:P2632 ?centro.
  OPTIONAL {?centro wdt:P18 ?centroImagen}.
  
          SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],es". }
}
