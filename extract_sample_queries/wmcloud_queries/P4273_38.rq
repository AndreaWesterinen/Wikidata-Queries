#title: Items whitout listing date
# Complex constraint from [[Property talk:P4273]]
# Items that do have [[d:Q19825927|New York City Landmark <small>(Q19825927)</small>]] in [[Property:P1435|heritage designation&#32;<small dir="ltr">(P1435)</small>]], but not the qualifier [[Property:P580|start time&#32;<small dir="ltr">(P580)</small>]].
SELECT ?item WHERE { ?item wdt:P1435 wd:Q19825927 . MINUS { ?item p:P1435 [ ps:P1435 wd:Q19825927 ; pq:P580 [] ] } } LIMIT 1000
