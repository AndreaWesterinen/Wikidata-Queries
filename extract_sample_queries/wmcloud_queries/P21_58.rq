SELECT ?item ?itemLabel ?value ?valueLabel ?snak ?rank ?statement
WHERE
{
  {
    SELECT ?item ?value ?result ?snak ?rank ?statement WHERE {
      {
        ?item p:P21 ?statement .
        ?statement ps:P21 ?value; wikibase:rank ?rank .
        BIND("mainsnak" AS ?snak) .
      } UNION {
        ?statement pq:P21 ?value; wikibase:rank ?rank .
        ?item ?p1 ?statement .
        BIND("qualifier" AS ?snak) .
      } UNION {
        ?ref pr:P21 ?value .
        ?statement prov:wasDerivedFrom ?ref; wikibase:rank ?rank .
        ?item ?p2 ?statement .
        BIND("reference" AS ?snak) .
      } .
      FILTER( ?value NOT IN ( wd:Q6581097, wd:Q6581072, wd:Q1097630, wd:Q1052281, wd:Q2449503, wd:Q48270, wd:Q1399232, wd:Q3277905, wd:Q746411, wd:Q350374, wd:Q660882, wd:Q44148, wd:Q43445, wd:somevalue, wd:novalue, wd:Q301702, wd:Q27679766, wd:Q27679684, wd:Q3177577, wd:Q28873047, wd:Q505371, wd:Q12964198, wd:Q18116794, wd:Q1289754, wd:Q179294, wd:Q7130936, wd:Q64017034, wd:Q52261234, wd:Q16674976, wd:Q15145779, wd:Q15145778, wd:Q48279, wd:Q96000630, wd:Q93954933, wd:Q93955709, wd:Q859614, wd:Q189125, wd:Q17148251, wd:Q4700377, wd:Q56315990, wd:Q25388691, wd:Q97595519, wd:Q8053770, wd:Q99519347, wd:Q104717073, wd:Q430711, wd:Q7677449, wd:Q113124952, wd:Q107427210, wd:Q112597587, wd:Q88293285, wd:Q116254116 ) ) .
    } LIMIT 100
  } .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
