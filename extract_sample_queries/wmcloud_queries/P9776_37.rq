#title: Invalid Researcher Number
# Complex constraint from [[Property talk:P9776]]
# Researcher Number that have wrong checksum (see [[:ja:研究者番号]])
SELECT ?item ?value
  {       { ?item      wdt:P9776          ?value
          }
    UNION { ?statement pq:P9776             ?value
          . ?item      ?p                  ?statement
          . ?prop      wikibase:claim      ?p
          }
    UNION { ?ref       pr:P9776             ?value
          . ?statement prov:wasDerivedFrom ?ref
          . ?item      ?p                  ?statement
          . ?prop      wikibase:claim      ?p
          }
  . FILTER( STRLEN(?value) = 8 )
  . BIND(
    - xsd:integer(SUBSTR(?value,  1, 1)) +
      xsd:integer(SUBSTR(?value,  2, 1)) +
      xsd:integer(SUBSTR(?value,  4, 1)) +
      xsd:integer(SUBSTR(?value,  6, 1)) +
      xsd:integer(SUBSTR(?value,  8, 1)) +
    ( xsd:integer(SUBSTR(?value,  3, 1)) +
      xsd:integer(SUBSTR(?value,  5, 1)) +
      xsd:integer(SUBSTR(?value,  7, 1)) ) * 2 AS ?checksum )
  . FILTER( FLOOR(?checksum / 10) != (?checksum / 10) )
  }
  ORDER BY ?value
