select ?occup ?occupLabel (COUNT(DISTINCT ?rider) AS ?count) where {
  ?team wdt:P31/wdt:P279* wd:Q1785271 .
  ?team wdt:P527 ?rider .
  optional { ?rider wdt:P106 ?occup . }
  
    SERVICE wikibase:label {
        bd:serviceParam wikibase:language "de,fr,en" .
    }

  }group by ?occup ?occupLabel
ORDER BY DESC (?count)
