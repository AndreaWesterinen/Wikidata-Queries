SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P2093 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P1545, wd:P642, wd:P3831, wd:P1416, wd:P1778, wd:P6424, wd:P2699, wd:P2241, wd:P7452, wd:P1932, wd:P2868, wd:P410, wd:P9687, wd:P9688, wd:P1889 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
