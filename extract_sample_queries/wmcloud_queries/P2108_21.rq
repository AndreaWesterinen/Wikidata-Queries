#title: Items with creator not linked to Kunstindeks Danmark
# Complex constraint from [[Property talk:P2108]]
# Items that have [[Property:P170|creator&#32;<small dir="ltr">(P170)</small>]], but that item doesn't have [[Property:P1138|Kunstindeks Danmark Artist ID&#32;<small dir="ltr">(P1138)</small>]]. Missing link can probably be added
SELECT  (SAMPLE(?item) AS ?item) (COUNT(?item) as ?count) ?creator {
	?item wdt:P2108 ?value .
    ?item wdt:P170 ?creator .
    MINUS { ?creator wdt:P1138 [] } 
} GROUP BY ?creator
ORDER BY DESC(?count) LIMIT 1000
