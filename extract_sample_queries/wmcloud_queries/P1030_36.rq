#title: basic patterns without an item
# Complex constraint from [[Property talk:P1030]]
# create an item for the light characteristic. Ensure patterns are normalized before creating items for them.
SELECT (SAMPLE(?item) as ?item) ?value (COUNT(DISTINCT ?item) as ?count)
{ 
  ?item wdt:P1030 ?value . 
  FILTER NOT EXISTS { ?pattern wdt:P1030 ?value ; wdt:P31 wd:Q1738955 } . 
  FILTER(REGEX(?value, "^(Iso\u007CFl\u007COc\u007CQ\u007CLFl\u007CVQ)(\\(\\d\\))? [WRGY]{1,4} [\\d\\.]+s$"))
  FILTER(!REGEX(?value, "FI"))   
}
GROUP BY ?value 
ORDER BY DESC(?count)
LIMIT 20
