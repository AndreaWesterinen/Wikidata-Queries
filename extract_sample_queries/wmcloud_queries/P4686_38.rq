#title: In the museum without a link
# Complex constraint from [[Property talk:P4686]]
# Items that have [[Property:P195|collection&#32;<small dir="ltr">(P195)</small>]] -> [[d:Q1043967|Carnegie Museum of Art <small>(Q1043967)</small>]], but that don't have a [[Property:P4686|Carnegie Museum of Art ID&#32;<small dir="ltr">(P4686)</small>]] link
SELECT DISTINCT ?item ?url WHERE {
  ?item wdt:P195 wd:Q1043967 .
  OPTIONAL { ?item wdt:P973 ?url } . 
  MINUS { ?item wdt:P4686 [] } .
}  LIMIT 500
