#defaultView:BubbleChart
SELECT ?cid ?firstname (COUNT(*) AS ?count) WHERE {
  ?pid wdt:P19 ?pob .
  ?pob wdt:P17 wd:Q408 .

  ?pid wdt:P735 ?cid.
  OPTIONAL {
    ?cid rdfs:label ?firstname 
    FILTER((LANG(?firstname)) = "en")
  }
}
GROUP BY ?cid ?firstname
ORDER BY DESC(?count) ?firstname
LIMIT 500
