# taxa without an article where taxon ancestor is Chrysomelinae
SELECT ?item  ?taxon_name ?afd_id ?author ?authorLabel ?rankLabel WHERE {
  ?item wdt:P171* wd:Q134997.
  ?item p:P225 ?stat . 
  ?stat ps:P225 ?taxon_name.
  OPTIONAL {
      ?item wdt:P105 ?rank. 
      ?stat pq:P405 ?author. 
      ?item wdt:P6039 ?afd_id. }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". } 
    }
ORDER BY ?taxon_name ?item
