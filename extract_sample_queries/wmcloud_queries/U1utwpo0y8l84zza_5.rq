#defaultView:Map
SELECT DISTINCT ?department ?departmentLabel ?highest_pointLabel ?elevation ?coords ?image WHERE {
  ?department wdt:P31/wdt:P279* wd:Q6465 ;
              wdt:P610 ?highest_point . 
  ?highest_point wdt:P625 ?coords ;
                 p:P2044/psv:P2044 [
    wikibase:quantityAmount ?baseElevation;
    wikibase:quantityUnit [
      p:P2370/psv:P2370 [
        wikibase:quantityAmount ?unitElevation;
        wikibase:quantityUnit wd:Q11573
      ]
    ]
  ] .
  BIND(ROUND(?baseElevation * ?unitElevation) AS ?elevation)
  
  OPTIONAL { ?highest_point wdt:P18 ?image }

  SERVICE wikibase:label { bd:serviceParam wikibase:language "fr" . }
} ORDER BY ?elevation ?departmentLabel
