embed.html#SELECT ?l ?lemma ?length WHERE {
   ?l a ontolex:LexicalEntry ; dct:language ?language ;
        wikibase:lemma ?lemma .
  ?language wdt:P218 'fr' .
  FILTER REGEX ( ?lemma, "[aàâ]")
  FILTER REGEX ( ?lemma, "[eéèêë]")
  FILTER REGEX ( ?lemma, "[iîï]")
  FILTER REGEX ( ?lemma, "[oôö]")
  FILTER REGEX ( ?lemma, "[uûü]")
  FILTER REGEX ( ?lemma, "[yÿ]")
  BIND ( strlen(?lemma) as ?length )
}
ORDER BY ?length
