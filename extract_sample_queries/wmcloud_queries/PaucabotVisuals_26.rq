# Llocs a menys de 180 km de Sineu
#defaultView:Map
SELECT ?place ?placeLabel ?location ?dist WHERE {

  # Coordenades de Sineu
  wd:Q943922 wdt:P625 ?sineuLoc . 
  SERVICE wikibase:around { 
      ?place wdt:P625 ?location . 
      bd:serviceParam wikibase:center ?sineuLoc . 
      bd:serviceParam wikibase:radius "180" . 
  } 
  # Llocs
  ?place wdt:P625 ?coord .
  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "ca" . 
  }
  MINUS { ?place wdt:P131*/wdt:P706* wd:Q5765 . }
  BIND(geof:distance(?sineuLoc, ?location) as ?dist) 
} ORDER BY ?dist
