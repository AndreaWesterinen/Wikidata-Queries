sparql?query=SELECT DISTINCT ?item { ?item schema:dateModified ?date . FILTER( NOW() - ?date < 1 ) . ?item ^schema:about [ schema:isPartOf <https://commons.wikimedia.org/>; schema:name ?sitelink ] . MINUS { ?item wdt:P373 [] } . MINUS { ?item p:P31/ps:P31 wd:Q4167410 } . MINUS { ?item p:P31/ps:P31 wd:Q4167836 } . FILTER( STRSTARTS( ?sitelink, 'Category:' ) ) . BIND( STRAFTER( STR( ?sitelink ), 'Category:' ) AS ?cat ) . MINUS { ?cat ^wdt:P373 [] } .}
