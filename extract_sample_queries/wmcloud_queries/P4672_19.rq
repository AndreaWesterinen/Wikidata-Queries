SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P4672 [] .
			MINUS {
				VALUES ?classes { wd:Q17334923 wd:Q618123 wd:Q82794 wd:Q47495022 wd:Q20203388 wd:Q4130 wd:Q17350442 wd:Q190463 wd:Q2133296 wd:Q1299240 wd:Q188193 wd:Q712378 wd:Q40397 wd:Q4936952 wd:Q15989253 wd:Q988108 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
