SELECT DISTINCT ?item ?itemLabel ?article
	(strafter( str(?item),"y/") as ?a)
	("P2860" as ?b)
	("Q97578864" as ?c)
WHERE
{ 
  BIND( '"Hanslick Eduard. Aus dem Concertsaal. Kritiken und Schilderungen aus den letzten 20 Jahren des Wiener Musiklebens u. s. w."~ BLKO' as ?search)
  SERVICE wikibase:mwapi { 
      bd:serviceParam wikibase:endpoint "de.wikisource.org" ;  wikibase:api "Generator" ;
                      mwapi:generator "search" ;              mwapi:gsrsearch ?search ;
                      mwapi:gsrlimit "max" ;                  mwapi:gsrnamespace "0" .    
      ?title wikibase:apiOutput mwapi:title .
      ?item wikibase:apiOutputItem mwapi:item . 
  }
  hint:Prior hint:runFirst true.
  BIND(URI(CONCAT("https://de.wikisource.org/wiki/",?title) )  as ?article)   
  ?item wdt:P1433 wd:Q665807 .
  FILTER NOT EXISTS { ?item wdt:P2860 wd:Q97578864 }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en,de" . }
}
