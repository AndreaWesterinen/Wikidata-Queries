# countries with most cities named after saints
SELECT ?country ?countryLabel (COUNT(DISTINCT ?city) AS ?count) WHERE {
  ?city wdt:P31/wdt:P279* wd:Q486972;
        wdt:P17 ?country;
        wdt:P138 [ wdt:P411 wd:Q43115 ].
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
GROUP BY ?country ?countryLabel
ORDER BY DESC(?count)
