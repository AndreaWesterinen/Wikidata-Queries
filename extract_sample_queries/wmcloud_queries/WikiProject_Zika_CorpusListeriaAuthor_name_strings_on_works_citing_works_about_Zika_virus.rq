SELECT
  # Sample work citing a Zika work
  DISTINCT ?item 

 # Number of works with the coauthor
  ?count

  # The citing author as a string, - rather than as an item
  ?citing_author

  # Build URL to the Author disambiguator tool
  (CONCAT(
      'https://tools.wmflabs.org/author-disambiguator/?doit=Look+for+author&name=',
      ENCODE_FOR_URI(?citing_author)) AS ?string_resolver)

WHERE {
  SELECT
    (COUNT(DISTINCT ?citing_work) as ?count)
    ?citing_author
    (SAMPLE(?citing_work) AS ?item) 
  WHERE {
    ?work wdt:P921 wd:Q202864 .
    ?citing_work wdt:P2860 ?work .
    ?citing_work wdt:P2093 ?citing_author .
  }
  GROUP BY ?citing_author
}
ORDER BY DESC(?count)
LIMIT 1000
