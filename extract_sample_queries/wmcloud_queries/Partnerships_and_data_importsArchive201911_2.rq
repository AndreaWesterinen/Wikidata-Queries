SELECT ?human_settlement ?human_settlementLabel ?population ?OSM_relation_ID WHERE {
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
  ?human_settlement wdt:P31 wd:Q12813115;
    wdt:P17 wd:Q34.
  ?human_settlement wdt:P1082 ?population.
  OPTIONAL { ?human_settlement wdt:P402 ?OSM_relation_ID. }
  
}
ORDER BY DESC(?population)
