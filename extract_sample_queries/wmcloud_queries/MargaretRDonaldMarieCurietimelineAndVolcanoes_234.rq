# taxa with/without an article where author name is Heinrich Hugo Karny
SELECT ?item  ?taxon_name ?article ?afd_id WHERE {
  ?item p:P225 ?stat . 
  ?stat ps:P225 ?taxon_name.
  ?stat pq:P405 wd:Q5700163.
  OPTIONAL {?item wdt:P6039 ?afd_id.}
  OPTIONAL {
     ?article schema:about ?item. # and have an article about them
     ?article schema:isPartOf <https://en.wikipedia.org/> . # on *English* Wikipedia}
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". } 
    }
}
ORDER BY ?taxon_name ?item
