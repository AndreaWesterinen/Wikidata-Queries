SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P4438 [] .
			MINUS {
				VALUES ?classes { wd:Q5 wd:Q11424 wd:Q15416 wd:Q21191270 wd:Q1762059 wd:Q24856 wd:Q375336 wd:Q16334295 wd:Q2088357 wd:Q95074 wd:Q14514600 wd:Q431289 wd:Q59755569 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
