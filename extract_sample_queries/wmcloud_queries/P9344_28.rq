SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P9344 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P3831, wd:P361, wd:P518, wd:P4878, wd:P2677, wd:P547, wd:P462, wd:P7452, wd:P2241, wd:P6568, wd:P1684, wd:P527, wd:P642, wd:P5422 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
