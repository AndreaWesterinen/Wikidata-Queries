SELECT ?discoverer ?discovererLabel ?instrument ?creator ?creatorLabel ?point_in_time WHERE {
  ?instrument (wdt:P31/(wdt:P279*)) wd:Q188451;
    wdt:P61 ?discoverer.
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
  
  
  
  OPTIONAL { ?instrument wdt:P170 ?creator. }
  OPTIONAL { ?instrument wdt:P575 ?point_in_time. }
}
