SELECT DISTINCT ?x
WHERE {
  ?x wdt:P31 wd:Q1134686 ;
     p:P131 ?city1stmt ;
     p:P131 ?city2stmt ;
     schema:description ?desc .
  FILTER (lang(?desc) = "it")
  FILTER regex(?desc, "^frazione del comune italiano di")
  
  ?city1stmt ps:P131 ?city1 . ?city1 wdt:P31 wd:Q747074 .
  ?city2stmt ps:P131 ?city2 . ?city2 wdt:P31 wd:Q747074 .
  FILTER (?city1 != ?city2) .
  FILTER NOT EXISTS { ?city1stmt pq:P582  ?_ . }
  FILTER NOT EXISTS { ?city2stmt pq:P582  ?_ . }
  FILTER NOT EXISTS { ?city1stmt pq:P2241 ?_ . }
  FILTER NOT EXISTS { ?city2stmt pq:P2241 ?_ . }
  
  MINUS { VALUES ?x { wd:Q2069883 wd:Q1963104 wd:Q2005058 wd:Q3646478 wd:Q3946463 } } #false positives
}
