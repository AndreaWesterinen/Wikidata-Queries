#title: Qualifier only valid to use with "Commons link constraint"
# Complex constraint from [[Property talk:P2307]]
# This property must only be used as a qualifier for [[Property:P2302|property constraint&#32;<small dir="ltr">(P2302)</small>]] values of [[d:Q21510852|Commons link constraint <small>(Q21510852)</small>]].
SELECT ?item ?itemLabel ?constraint ?constraintLabel ?namespace WHERE {
  ?item p:P2302 [ps:P2302 ?constraint; pq:P2307 ?namespace].
  FILTER (?constraint != wd:Q21510852).
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
