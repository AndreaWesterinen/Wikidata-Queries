embed.html#PREFIX wdname: <http://www.wikidata.org/entity/Q1418855>
#defaultView:LineChart
SELECT ?year (COUNT(DISTINCT ?item) as ?ct) 
{
    hint:Query hint:optimizer "None".
    ?item wdt:P735 wdname: ; wdt:P569 ?b . 
    ?item p:P569/psv:P569 [ wikibase:timeValue ?b ; wikibase:timePrecision ?precision ]  
    FILTER(?precision > 7 )  
    BIND( (FLOOR(YEAR(?b)/10)*10) as ?year) 
}  
GROUP BY ?year
ORDER BY ?year
