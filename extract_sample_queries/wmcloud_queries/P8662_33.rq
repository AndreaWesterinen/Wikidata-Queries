#title: Candidates for this property
# Complex constraint from [[Property talk:P8662]]
# add [[Property:P8662|Les Roses cultivées à L&#39;Haÿ en 1902 ID&#32;<small dir="ltr">(P8662)</small>]]; use "[[Help:Statements#Unknown_or_no_values|novalue]]" when not found
SELECT DISTINCT ?item ?year
WHERE
{
	?item wdt:P31 wd:Q26817508 ; wdt:P571 ?d
	MINUS { ?item p:P8662 [] }
	BIND(YEAR(?d) as ?year)
	FILTER( ?year < 1902 )
}
ORDER BY ?year ?item
