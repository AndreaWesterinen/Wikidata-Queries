#Obres que passen a les Illes Balears
SELECT ?film ?label ?filmDescription ?place ?placeLabel
WHERE {
    ?film wdt:P840 ?place.
    ?place wdt:P131*/wdt:P706* wd:Q5765.
    ?film rdfs:label ?label filter (lang(?label) = "ca")
    SERVICE wikibase:label {bd:serviceParam wikibase:language "ca" .}
 }
