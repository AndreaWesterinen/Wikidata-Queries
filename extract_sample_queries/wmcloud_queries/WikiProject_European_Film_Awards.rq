SELECT ?ceremony (xsd:integer(?number) AS ?edition) ?count ((COUNT(?item) - ?count) AS ?diff)
WITH {
    SELECT DISTINCT ?item ?ceremony ?st ?number WHERE {
    ?ceremony wdt:P31 wd:Q4504495; wdt:P1269 wd:Q223740; wdt:P393 ?number.
    ?st pq:P805 ?ceremony.
    ?item p:P1411 ?st; wdt:P31/wdt:P279* wd:Q2431196.
    }
} AS %nominees
WHERE {
    VALUES (?ed ?count) {
    (1 52) #1988
    (2 49) #1989
    (3 36) #1990
    (4 18) #1991
    (5 23) #1992
    (6 15) #1993
    (7 6) #1994
    (8 6) #1995
    (9 6) #1996
    (10 26) #1997
    (11 35) #1998
    (12 44) #1999
    (13 56) #2000
    (14 118) #2001
    (15 120) #2002
    (16 102) #2003
    (17 108) #2004
    (18 122) #2005
    (19 75) #2006
    (20 79) #2007
    (21 81) #2008
    (22 82) #2009
    (23 75) #2010
    (24 73) #2011
    (25 81) #2012
    (26 71) #2013
    (27 68) #2014
    (28 72) #2015
    (29 78) #2016
    (30 75) #2017
    (31 77) #2018
    (32 70) #2019
    (33 62) #2020
    (34 60) #2021
    (35 61) #2022
    } 
   INCLUDE %nominees
   FILTER(?ed = xsd:integer(?number))
}
GROUP BY ?ceremony ?number ?count
ORDER BY ?edition
