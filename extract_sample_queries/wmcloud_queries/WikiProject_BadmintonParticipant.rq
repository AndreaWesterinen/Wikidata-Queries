SELECT ?item (COUNT(?sitelink) AS $slcnt) WHERE {
  ?item wdt:P31 wd:Q57733494 .
  ?item wdt:P585 ?time 
  FILTER (?time <= "2020-03-01T00:00:00Z"^^xsd:dateTime) .
  FILTER EXISTS { ?item wdt:P585 ?dummy0 }
  FILTER EXISTS { ?item wdt:P17 ?dummy0 } 
  FILTER EXISTS { ?item wdt:P361 ?dummy0 } 
  FILTER NOT EXISTS { ?item wdt:P710 ?dummy0 }
  FILTER NOT EXISTS { ?item wdt:P3085 ?dummy0 }
  FILTER NOT EXISTS { ?item wdt:P2094 wd:Q57749193 }
  FILTER NOT EXISTS { ?item wdt:P2094 wd:Q57749192 }
  FILTER NOT EXISTS { ?item wdt:P2094 wd:Q57750246 }
  FILTER NOT EXISTS { ?item wdt:P373 ?dummy0 }
  OPTIONAL { ?sitelink schema:about ?item . }
} 
GROUP BY(?item) ORDER BY DESC(?slcnt) LIMIT 11000
