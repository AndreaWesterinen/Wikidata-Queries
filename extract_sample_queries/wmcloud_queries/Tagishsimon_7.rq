SELECT ?item ?itemLabel  ?year ?P31 ?P175
with { SELECT ?item  ?itemLabel (count(distinct ?type) as ?typecount) (group_concat(distinct ?typelabel) as ?P31) (count(distinct ?performer) as ?perfcount) (group_concat(distinct ?plabel) as ?P175)  (min(year(?date)) as ?year) WHERE 
{
  ?item wdt:P31/wdt:P279* wd:Q482994.
  optional {?item rdfs:label ?itemLabel. filter(lang(?itemLabel)="en")}
  ?item wdt:P31 ?type.
  ?type rdfs:label ?typelabel. filter(lang(?typelabel)="en")
  filter not exists {?item schema:description ?Len. filter(lang(?Len)="en")}
 optional {?item wdt:P175 ?performer.
 ?performer rdfs:label ?plabel. filter(lang(?plabel)="en")}
  optional {?item wdt:P577 ?date .}
} group by ?item ?itemLabel} as %i
where {include %i
               filter (?typecount <2)
               filter (?perfcount <2)
                       
      }
