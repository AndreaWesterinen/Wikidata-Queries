SELECT ?item ?itemLabel ?value ?valueLabel ?class ?classLabel ?snak 
WHERE
{
	{
		SELECT DISTINCT ?item ?value ?class ?snak {
			{
				?item wdt:P3491 ?value .
				BIND("mainsnak" AS ?snak) .
			} UNION {
				?statement0 pq:P3491 ?value .
				?item ?p0 ?statement0 .
				BIND("qualifier" AS ?snak) .
			} UNION {
				?ref pr:P3491 ?value .
				?statement1 prov:wasDerivedFrom ?ref .
				?item ?p1 ?statement1 .
				BIND("reference" AS ?snak) .
			} .
			MINUS {
				VALUES ?classes { wd:Q66394244 } .			
				?value wdt:P279* ?classes .
			} .
			OPTIONAL {
				?value wdt:P279 ?class .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
