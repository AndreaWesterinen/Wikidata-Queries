SELECT DISTINCT ?item ?label WHERE {
  {?item wdt:P1216 [] . } UNION   {?item wdt:P1459 [] . }   UNION {?item wdt:P709 [] . } 
  ?item wdt:P3417 [] .
  ?item rdfs:label ?label.
  FILTER(LANG(?label) = "en").
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
  }
GROUP BY ?item ?label
