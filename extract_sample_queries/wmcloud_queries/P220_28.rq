SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P220 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P580, wd:P582, wd:P1012, wd:P1534, wd:P2241, wd:P7452, wd:P8555, wd:P1319, wd:P8554, wd:P1326, wd:P2378, wd:P282, wd:P1552, wd:P180, wd:P1268, wd:P5102 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
