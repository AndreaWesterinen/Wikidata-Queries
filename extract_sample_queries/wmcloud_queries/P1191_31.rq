SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P1191 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P276, wd:P272, wd:P3300, wd:P175, wd:P2241, wd:P7452, wd:P1552, wd:P1071, wd:P3301, wd:P371, wd:P1480, wd:P642, wd:P161, wd:P291, wd:P4241 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
