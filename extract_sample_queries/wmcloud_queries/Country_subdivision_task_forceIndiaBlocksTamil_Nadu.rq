SELECT ?item ?len ?lta ?den ?dta ?district {
  ?item wdt:P31 wd:Q2775236 ; wdt:P131* ?district . ?district wdt:P31 wd:Q1149652 ; wdt:P131/wdt:P131* wd:Q1445.
  OPTIONAL { ?item rdfs:label ?len. FILTER(LANG(?len)="en") }
  OPTIONAL { ?item rdfs:label ?lta. FILTER(LANG(?lta)="ta") }
  OPTIONAL { ?item schema:description ?den. FILTER(LANG(?den)="en") }
  OPTIONAL { ?item schema:description ?dta. FILTER(LANG(?dta)="ta") }
}
