embed.html#SELECT DISTINCT ?prop ?propLabel ?propDescription WHERE {
    { ?prop wdt:P31/wdt:P279* wd:Q15720608 }
    UNION { ?prop p:P2302 [ ps:P2302 wd:Q53869507; pq:P5314 wd:Q54828449 ] }
    FILTER NOT EXISTS { ?prop wdt:P31/wdt:P279* wd:Q61719274 }
    FILTER NOT EXISTS { ?prop wdt:P31/wdt:P279* wd:Q61719275 }
    SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
