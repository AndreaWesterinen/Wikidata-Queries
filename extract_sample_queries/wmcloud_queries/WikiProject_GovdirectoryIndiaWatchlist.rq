SELECT ?item WHERE {
  BIND(wd:Q668 AS ?country)
  VALUES ?type {
    wd:Q24952557 # union governement ministries (52)
    wd:Q12443800 # states (28)
    wd:Q467745 # union territories (8)
  }
  ?item wdt:P31 ?type ;
       wdt:P17 ?country .

  MINUS { ?item wdt:P576 [] }
  MINUS { ?item wdt:P1366 [] }
  MINUS { ?item wdt:P3999 [] }
}
