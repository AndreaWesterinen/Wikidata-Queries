SELECT DISTINCT ?item ?itemLabel ?count 
WHERE
{
	{ 	SELECT ?item (count(*) as ?count) 
      	WHERE
		{
      		?pid wdt:P136 ?item .
    	}
    	GROUP BY ?item
		ORDER BY DESC(?count)
		LIMIT 300                 
	}
  	SERVICE wikibase:label { bd:serviceParam wikibase:language "ar" . }
}
ORDER BY DESC(?count)
