#added before 2016-10
#defaultView:Map
SELECT ?place ?placeLabel ?location ?inadmin ?inadminLabel
WHERE
{
  wd:Q19876824 wdt:P625 ?loc00 . 
  SERVICE wikibase:around { 
    ?place wdt:P625 ?location . 
    bd:serviceParam wikibase:center ?loc00 . 
    bd:serviceParam wikibase:radius "2400" . 
  }
  OPTIONAL {?place wdt:P131 ?inadmin .}
  MINUS {?place a wdno:P131 .} #to exclude (e.g. Australia) where there is explicitly "admin district= no value"

  FILTER(!BOUND(?inadmin))
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en" .  }
}
ORDER BY ?placeLabel
