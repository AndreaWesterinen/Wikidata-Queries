SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P3279 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P1351, wd:P54, wd:P1013, wd:P1129, wd:P2241, wd:P7452, wd:P1358, wd:P518, wd:P1532, wd:P1706, wd:P1114, wd:P166, wd:P2781 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
