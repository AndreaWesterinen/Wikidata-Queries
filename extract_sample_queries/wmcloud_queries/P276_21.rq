SELECT ?item ?itemLabel ?value ?valueLabel ?instance ?instanceLabel ?snak 
WHERE
{
	{
		SELECT DISTINCT ?item ?value ?instance ?snak {
			{
				?item wdt:P276 ?value .
				BIND("mainsnak" AS ?snak) .
			} UNION {
				?statement0 pq:P276 ?value .
				?item ?p0 ?statement0 .
				BIND("qualifier" AS ?snak) .
			} UNION {
				?ref pr:P276 ?value .
				?statement1 prov:wasDerivedFrom ?ref .
				?item ?p1 ?statement1 .
				BIND("reference" AS ?snak) .
			} .
			MINUS {
				VALUES ?classes { wd:Q17334923 wd:Q618123 wd:Q82794 wd:Q3895768 wd:Q1656682 wd:Q47495022 wd:Q20203388 wd:Q4130 wd:Q634 wd:Q17350442 wd:Q190463 wd:Q2133296 wd:Q1299240 wd:Q188193 wd:Q712378 wd:Q40397 wd:Q4936952 wd:Q15989253 wd:Q988108 wd:Q22698 wd:Q89464513 wd:Q11033 wd:Q2385804 wd:Q36133 wd:Q13226383 wd:Q2221906 wd:Q18670171 wd:Q3238337 } .			
				?value wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?value wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
