#Llicències
#defaultView:BubbleChart
SELECT ?name ?nameLabel (count(*) as ?count)
WHERE {
    ?prog wdt:P31 ?lic .
    ?lic wdt:P31*/wdt:P279* wd:Q341.
	?prog wdt:P275 ?name .
  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "en,es,ca" .
  }
}
GROUP BY ?name ?nameLabel
ORDER BY DESC(?count)
