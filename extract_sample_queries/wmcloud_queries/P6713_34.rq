SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P6713 [] .
			MINUS {
				VALUES ?classes { wd:Q5 wd:Q2221906 wd:Q1190554 wd:Q176799 wd:Q18593264 wd:Q618123 wd:Q1229765 wd:Q327333 wd:Q180684 wd:Q186081 wd:Q7725634 wd:Q3331189 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
