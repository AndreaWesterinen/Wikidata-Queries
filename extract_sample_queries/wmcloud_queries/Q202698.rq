                      wd:Q107080092
                      wd:Q47000326
                      wd:Q64100970
                      wd:Q20871935
                      wd:Q11931373
                      wd:Q25203386
                      wd:Q677466
                      wd:Q20077126
                      wd:Q3302947
                     }
  ?item wdt:P31 ?glam;
  wdt:P31 wd:Q134556.
 OPTIONAL { ?item   wdt:P2550 ?basat. }
}
LIMIT 500
