SELECT
  (SAMPLE(?item2) as ?item)
  ?soundex
  (GROUP_CONCAT(DISTINCT ( CONCAT("[[",strafter(str(?item2),"y/"),"|",?nl,"]]")) ; separator=", " ) as ?names)
WHERE
{
    ?item2 wdt:P31 wd:Q101352 ; wdt:P1705 ?nl ; wdt:P3878 ?soundex .
    FILTER(substr(?soundex,1,1)="I")
}
GROUP BY ?soundex
ORDER BY ?soundex
