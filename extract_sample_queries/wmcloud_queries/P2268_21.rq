#title: Works with creator missing link
# Complex constraint from [[Property talk:P2268]]
# List of works that are in [[Property:P195|collection&#32;<small dir="ltr">(P195)</small>]] [[d:Q23402|Musée d&#39;Orsay <small>(Q23402)</small>]] and have [[Property:P170|creator&#32;<small dir="ltr">(P170)</small>]] set, but that creator doesn't have a [[Property:P2268|Musée d&#39;Orsay artist ID&#32;<small dir="ltr">(P2268)</small>]] link
SELECT ?item ?creator
{
	?item wdt:P195 wd:Q23402 .
    ?item wdt:P170 ?creator .
	MINUS { ?creator wdt:P2268 [] } .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" }
} ORDER BY ?creatorLabel
