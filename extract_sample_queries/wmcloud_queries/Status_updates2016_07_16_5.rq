SELECT DISTINCT ?wife ?wifeLabel ?wifeDescription
WHERE
{
  ?wife wdt:P31 wd:Q5;
        wdt:P21 wd:Q6581072;
        p:P26 [];
        rdfs:label ?wifeLabel;
        schema:description ?wifeDescription.
  FILTER(LANG(?wifeLabel) = "en").
  FILTER(LANG(?wifeDescription) = "en").
  FILTER(CONTAINS(?wifeDescription, "wife")).
}
