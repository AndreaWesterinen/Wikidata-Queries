select distinct (?l as ?item) (concat(replace(str(?l),str(wd:),"{{L|"),"}}") as ?l_) ?lemma {
  ?l dct:language wd:Q7737;
     wikibase:lemma ?lemma;
     wikibase:lexicalCategory wd:Q1084.

  filter not exists { ?l ontolex:lexicalForm/wikibase:grammaticalFeature wd:Q146786 }
  filter not exists { ?l wdt:P31 wd:Q604984 }
} order by ?lemma ?l
