SELECT ?item ?council WHERE { 
  VALUES ?flacs {wd:Q2225003 wd:Q83020 wd:Q706447} #three types of FLACS in Taiwan, but only one of these subclassed from Q10864048
  VALUES ?cons { wd:Q49924492 }
  ?region wdt:P31/wdt:P279* ?flacs ; 
          wdt:P17 wd:Q865.
  OPTIONAL {?council wdt:P1001 ?region ;
                     wdt:P31 wd:Q11204 .
            MINUS { ?council wdt:P576 [] }
    }
    ?item wdt:P31/wdt:P279* ?cons .
    ?item wdt:P131 ?region
  MINUS { ?item wdt:P576 [] }
}
ORDER BY ?item
