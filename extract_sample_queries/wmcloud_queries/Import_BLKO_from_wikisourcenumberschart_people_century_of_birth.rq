SELECT
  (wd:Q2481549 as ?item) 
  ("century" as ?xAxisTitle) 
  ("people born in century" as ?yAxisTitle)
  (GROUP_CONCAT(?century;separator=",") as ?x)
  (GROUP_CONCAT(?count_all;separator=",") as ?y)
  ("fontsize:10,offset:5,angle:0" as ?showValues)
  ("rect" as ?type)
  ("200" as ?heigth) 
  ("600" as ?width) 
WHERE
{
  { SELECT ?century (COUNT(DISTINCT ?item) as ?count_all)
  {
    ?entry wdt:P1433 wd:Q665807 ; wdt:P921 ?item .
    ?item wdt:P569 ?d . 
    FILTER( YEAR(?d) > 999 && YEAR(?d) < 1890 )
    BIND( FLOOR( YEAR(?d)/100) *100 as ?century) 
    ?item wdt:P31 wd:Q5 .
  }
  GROUP BY ?century
  ORDER BY DESC(?century)
  }
}
