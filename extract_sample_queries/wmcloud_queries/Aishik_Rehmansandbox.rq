SELECT ?item
        WHERE {
            SERVICE bd:sample {
                ?item wdt:P31 wd:Q4167836 .
                bd:serviceParam bd:sample.limit 10000 .
                bd:serviceParam bd:sample.sampleType "RANDOM" .
            }
        ?item schema:description "Wikimedia category"@en.
        OPTIONAL { ?item schema:description ?itemDescription. FILTER(LANG(?itemDescription) = "as").  }
        FILTER (!BOUND(?itemDescription))
        }
