SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P403 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P3871, wd:P131, wd:P625, wd:P2241, wd:P7452, wd:P2044, wd:P276, wd:P580, wd:P582, wd:P613, wd:P1810, wd:P1932, wd:P1534 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
