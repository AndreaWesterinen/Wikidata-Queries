SELECT DISTINCT ?item ?itemLabel WHERE {
  ?item wdt:P31 wd:Q5.
  {  }
  UNION
  {  }
  UNION
  {  }
  { ?item wdt:P27 wd:Q29999. }
  UNION
  {
    ?item wdt:P19 ?pob.
    ?pob wdt:P17 wd:Q55.
  }
  UNION
  {
    ?item wdt:P937 ?pow.
    ?pow wdt:P17 wd:Q55.
  }
  UNION
  {
    ?item wdt:P551 ?por.
    ?por wdt:P17 wd:Q55.
  }
  UNION
  {
    ?item wdt:P937 ?pod.
    ?pod wdt:P17 wd:Q55.
  }
  ?item wdt:P569 ?born.
  FILTER(?born > "1860-01-01T00:00:00Z"^^xsd:dateTime)
  ?item wdt:P570 ?death.
  FILTER(?death < "1948-01-01T00:00:00Z"^^xsd:dateTime)
  FILTER(?death > "1935-01-01T00:00:00Z"^^xsd:dateTime)
  ?item wdt:P106 wd:Q36834.
}
