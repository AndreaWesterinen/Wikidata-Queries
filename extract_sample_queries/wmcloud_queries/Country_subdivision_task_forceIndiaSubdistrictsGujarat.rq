SELECT ?item ?len ?lgu ?den ?dgu ?subdivision ?district {
  ?item wdt:P31 wd:Q7694920 ; wdt:P131* ?district . ?district wdt:P31 wd:Q1149652 ; wdt:P131/wdt:P131* wd:Q1061.
  OPTIONAL { ?item wdt:P131 ?subdivision. ?subdivision wdt:P31 wd:Q7631016 }
  OPTIONAL { ?item rdfs:label ?len. FILTER(LANG(?len)="en") }
  OPTIONAL { ?item rdfs:label ?lgu. FILTER(LANG(?lgu)="gu") }
  OPTIONAL { ?item schema:description ?den. FILTER(LANG(?den)="en") }
  OPTIONAL { ?item schema:description ?dgu. FILTER(LANG(?dgu)="gu") }
}
