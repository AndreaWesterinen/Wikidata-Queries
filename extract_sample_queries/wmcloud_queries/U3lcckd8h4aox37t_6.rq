#defaultView:LineChart
SELECT ?age (COUNT(?gender) as ?count) (SAMPLE(?genderLabel) AS ?genderLabel ) WHERE {
  ?film wdt:P31 wd:Q11424.
  ?film wdt:P577 ?date .
  ?film wdt:P161 ?cast .
  # 57=director   58=screenwriter  86=composer  161=cast member  162=producer 344=photography    1431=executive producer
  ?cast wdt:P27 wd:Q30 .
  ?cast wdt:P569 ?dob .
  ?cast wdt:P21 ?gender .
  ?gender rdfs:label ?genderLabel .
  FILTER((LANG(?genderLabel)) = "en")
  bind( 1000+year(?date)-year(?dob) as ?age_num )
  bind( SUBSTR(str(?age_num),1,4) as ?age )
  FILTER(BOUND(?age_num))
  FILTER(?age_num<=1100)
  FILTER(?age_num>=1000)
  FILTER(year(?date)>2000)
  #FILTER(year(?date)<2010)
}
GROUP BY ?genderLabel ?age
#ORDER BY ?genderLabel ?age
