SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity wdt:P31 wd:Q1195098; wdt:P131* wd:Q1186; wdt:P131 ?group; wdt:P361 [ wdt:P31 wd:Q2732840 ] . 
  MINUS { ?entity wdt:P131 []; wdt:P31 wd:Q1195098; wdt:P131* wd:Q1186; wdt:P131 ?group; wdt:P361 [ wdt:P31 wd:Q2732840 ]  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
