SELECT ?Wikidata ?ATRF_ID ?taxon_name WHERE {
  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en".
    ?Wikidata wdt:P6904 ?ATRF_ID.
    ?item wdt:P6904 ?ATRF_ID.
  }
  OPTIONAL { ?Wikidata wdt:P6904 ?ATRF_ID. }
  OPTIONAL { ?Wikidata wdt:P225 ?taxon_name. }
}
ORDER BY ?taxon_name
