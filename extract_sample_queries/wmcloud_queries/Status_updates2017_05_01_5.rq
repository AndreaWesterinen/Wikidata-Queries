SELECT ?person1Label ?person2Label ?person3Label ?person4Label ?person5Label ?person6Label ?person7Label ?person8Label ?person9Label ?person10Label WITH {
  SELECT * WHERE {
    ?person1 wdt:P734/^wdt:P1533/^wdt:P735 ?person2.
    ?person2 wdt:P734/^wdt:P1533/^wdt:P735 ?person3.
    ?person3 wdt:P734/^wdt:P1533/^wdt:P735 ?person4.
    ?person4 wdt:P734/^wdt:P1533/^wdt:P735 ?person5.
    ?person5 wdt:P734/^wdt:P1533/^wdt:P735 ?person6.
    ?person6 wdt:P734/^wdt:P1533/^wdt:P735 ?person7.
    ?person7 wdt:P734/^wdt:P1533/^wdt:P735 ?person8.
    ?person8 wdt:P734/^wdt:P1533/^wdt:P735 ?person9.
    ?person9 wdt:P734/^wdt:P1533/^wdt:P735 ?person10.
  }
  LIMIT 1
} AS %persons WHERE {
  INCLUDE %persons.
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
