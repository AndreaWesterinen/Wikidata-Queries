SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P4549 [] .
			MINUS {
				VALUES ?classes { wd:Q5 wd:Q87167 wd:Q7725634 wd:Q223393 wd:Q1053916 wd:Q384515 wd:Q179461 wd:Q1650727 wd:Q185363 wd:Q240911 wd:Q25379 wd:Q15632617 wd:Q3479856 wd:Q3326717 wd:Q867335 wd:Q4271324 wd:Q1897671 wd:Q95074 wd:Q2239243 wd:Q13002315 wd:Q16334295 wd:Q109551565 wd:Q47461344 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
