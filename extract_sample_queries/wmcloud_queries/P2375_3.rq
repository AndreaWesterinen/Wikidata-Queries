#Target required claim report for P2375: report listing each item and value

SELECT ?item ?itemLabel ?value ?valueLabel ?target ?targetLabel ?snak
WHERE
{
	{
		SELECT DISTINCT ?item ?value ?target ?snak
		WHERE
		{
			{
				?item p:P2375/ps:P2375 ?value .
				BIND("mainsnak" AS ?snak) .
			} UNION {
				?statement0 pq:P2375 ?value .
				?item ?p0 ?statement0 .
				BIND("qualifier" AS ?snak) .
			} UNION {
				?ref pr:P2375 ?value .
				?statement1 prov:wasDerivedFrom ?ref .
				?item ?p1 ?statement1 .
				BIND("reference" AS ?snak) .
			} .
			VALUES ?values { wd:Q22675015 } .
			MINUS {
				?value p:P31/ps:P31 ?values .
			} .
			OPTIONAL {
				?value p:P31/ps:P31 ?target .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
