SELECT DISTINCT ?item ?itemLabel ?parclassLabel ?ofLabel
WHERE
{
  {?item p:P31 ?inst_stm .
  ?inst_stm ps:P31 ?parclass .}
  UNION
  {?item p:P279 ?inst_stm .
  ?inst_stm ps:P279 ?parclass .}
  {?parclass wdt:P279* wd:Q1207505 .}
  UNION
  {?parclass wdt:P279* wd:Q937228 .}
  UNION
  {?parclass wdt:P279* wd:Q96253971 .}
  UNION
  {?parclass wdt:P279* wd:Q930933 .}
  FILTER NOT EXISTS {?item wdt:P31 wd:Q1207505 .}
  FILTER NOT EXISTS {?item wdt:P31 wd:Q937228 .}
  FILTER NOT EXISTS {?item wdt:P31 wd:Q96253971 .}
  ?inst_stm pq:P642 ?of .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". } # Helps get the label in your language, if not, then en language
}
