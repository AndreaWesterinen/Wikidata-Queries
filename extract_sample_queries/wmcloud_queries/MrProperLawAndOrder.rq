#Unique value constraint report for P7902: report listing each item

SELECT DISTINCT ?item2  ?item1  
{
	?item1 wdt:P7902 ?value .
	?item2 wdt:P7902 ?value .
	FILTER( ?item1 != ?item2 && STR( ?item1 ) < STR( ?item2 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 10000
