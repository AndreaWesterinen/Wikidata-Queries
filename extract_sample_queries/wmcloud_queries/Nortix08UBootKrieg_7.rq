#defaultView:Map{"hide":["?location"]}
SELECT DISTINCT ?uboat ?uboatLabel (SAMPLE(?location) AS ?location) (SAMPLE(?date) AS ?date) ?layer
WHERE
{
  ?uboat wdt:P31 wd:Q428661 ; # ist ein Weltkriegs-U-Boot
         wdt:P137 wd:Q151701 . # Betreiber ist Kriegsmarine
  OPTIONAL {
    ?uboat p:P793 ?event . # hat ein Schlüsselereignis…
    ?event ps:P793 wd:Q17781833 ; # …vom Typ Zerstörung…
           pq:P585 ?date ; # …mit dem Zeitpunkt…
           pq:P625 ?location . # …und den Koordinaten
    BIND ("Zerstörung" AS ?layer)
  }

 OPTIONAL {
    ?uboat p:P793 ?event .
    ?event ps:P793 wd:Q1786766 ;
           pq:P585 ?date ;
           pq:P625 ?location .
    BIND ("Selbstversenkung" AS ?layer)
  }

OPTIONAL {
    ?uboat p:P793 ?event .
    ?event ps:P793 wd:Q30880545 ;
           pq:P585 ?date ;
           pq:P625 ?location .
    FILTER("1939-09-01"^^xsd:dateTime <= ?date && ?date < "1945-05-09"^^xsd:dateTime).
    BIND ("Versenkung" AS ?layer)
  }

OPTIONAL {
    ?uboat p:P793 ?event .
    ?event ps:P793 wd:Q217901 ;
           pq:P585 ?date ;
           pq:P625 ?location .
    BIND ("Kapitulation" AS ?layer)
  }

OPTIONAL {
    ?uboat p:P793 ?event .
    ?event ps:P793 wd:Q2344557 ;
           pq:P580 ?date ;
           pq:P625 ?location .
    BIND ("Vermisst" AS ?layer)
  }

OPTIONAL {
    ?uboat p:P793 ?event .
    ?event ps:P793 wd:Q7497952 ;
           pq:P585 ?date ;
           pq:P625 ?location .
    BIND ("Ausserdienststellung" AS ?layer)
  }

SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],de,en". }
}
GROUP BY ?uboat ?uboatLabel ?date ?layer
