SELECT ?item 
  (GROUP_CONCAT(DISTINCT ?cctLabel; separator="<br>") as ?ccts) 
  (GROUP_CONCAT(DISTINCT ?cct2Label; separator="<br>") as ?cct2s)
  (GROUP_CONCAT(DISTINCT ?gender; separator="<br>") as ?cct3s)
  (SAMPLE(?sl) as ?sl)
WHERE
{ 
    ?item wdt:P971 wd:Q10833314 .
    OPTIONAL { ?item wdt:P971 ?cct . FILTER (?cct != wd:Q10833314) . FILTER NOT EXISTS { VALUES ?c { wd:Q6256 wd:Q3024240 wd:Q47488809 wd:Q48277 } ?cct wdt:P31 ?c }   } 
    OPTIONAL { ?item wdt:P971 ?cct2 . FILTER (?cct2 != wd:Q10833314) . FILTER EXISTS { VALUES ?c { wd:Q6256 wd:Q3024240 wd:Q47488809 } ?cct2 wdt:P31 ?c }   } 
    OPTIONAL { ?item wdt:P971 ?cct3 . ?cct3 p:P1813 [pq:P3831 wd:Q7884742; ps:P1813 ?gender] }                                            
    SERVICE wikibase:label { bd:serviceParam wikibase:language "en". 
                            ?cct rdfs:label ?cctLabel .
                            ?cct2 rdfs:label ?cct2Label .
                           }
    OPTIONAL { ?item wikibase:sitelinks ?sl }
}
GROUP BY ?item
ORDER BY ?ccts ?cct2s ?cct3s ?item
LIMIT 5000
