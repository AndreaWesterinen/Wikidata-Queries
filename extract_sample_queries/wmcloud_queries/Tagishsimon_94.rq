SELECT DISTINCT ?river ?riverLabel ?claims WITH {
  SELECT distinct ?river WHERE {
  #  VALUES ?river {wd:Q19721}
   ?river wdt:P131/wdt:P131 wd:Q22 . 
    } } as %i
WITH {
  SELECT distinct ?river WHERE {
    INCLUDE %i
    ?river wdt:P31/wdt:P279* wd:Q23397. hint:Prior hint:gearing "forward".
    } } as %j
WITH {
  SELECT ?river  WHERE {
    INCLUDE %j
    ?thing wdt:P403 ?river . 
    filter not exists {?river wdt:P201 [].}
  } } as %k
WHERE
{
  INCLUDE %k
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". } 
} order by DESC(?claims)
