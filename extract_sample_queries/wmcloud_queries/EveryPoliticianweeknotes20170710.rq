#Ancess who have an unbroken line of MPs as direct ancestors (usually fathers)

SELECT DISTINCT ?person1 ?person1Label ?person2Label ?person3Label ?person4Label ?person5Label ?person6Label ?person7Label ?person8Label
WHERE {
  
            { ?person1 wdt:P31 wd:Q5 ; wdt:P39 wd:Q16707842 }
      UNION { ?person1 wdt:P31 wd:Q5 ; wdt:P39 wd:Q18015642 } 
      UNION { ?person1 wdt:P31 wd:Q5 ; wdt:P39 wd:Q18018860 }
  # person 1 is an MP
            { ?person2 wdt:P31 wd:Q5 ; wdt:P39 wd:Q16707842 ; wdt:P40 ?person1 } 
      UNION { ?person2 wdt:P31 wd:Q5 ; wdt:P39 wd:Q18015642 ; wdt:P40 ?person1 }
      UNION { ?person2 wdt:P31 wd:Q5 ; wdt:P39 wd:Q18018860 ; wdt:P40 ?person1 }
  # person 2 is an MP, and person 1 is their child      
            { ?person3 wdt:P31 wd:Q5 ; wdt:P39 wd:Q16707842 ; wdt:P40 ?person2 } 
      UNION { ?person3 wdt:P31 wd:Q5 ; wdt:P39 wd:Q18015642 ; wdt:P40 ?person2 }
      UNION { ?person3 wdt:P31 wd:Q5 ; wdt:P39 wd:Q18018860 ; wdt:P40 ?person2 }      
  # person 3 is an MP, and person 2 is their child
            { ?person4 wdt:P31 wd:Q5 ; wdt:P39 wd:Q16707842 ; wdt:P40 ?person3 } 
      UNION { ?person4 wdt:P31 wd:Q5 ; wdt:P39 wd:Q18015642 ; wdt:P40 ?person3 }
      UNION { ?person4 wdt:P31 wd:Q5 ; wdt:P39 wd:Q18018860 ; wdt:P40 ?person3 }     
  # person 4 is an MP, and person 3 is their child
            { ?person5 wdt:P31 wd:Q5 ; wdt:P39 wd:Q16707842 ; wdt:P40 ?person4 } 
      UNION { ?person5 wdt:P31 wd:Q5 ; wdt:P39 wd:Q18015642 ; wdt:P40 ?person4 }
      UNION { ?person5 wdt:P31 wd:Q5 ; wdt:P39 wd:Q18018860 ; wdt:P40 ?person4 }     
  # person 5 is an MP, and person 6 is their child
            { ?person6 wdt:P31 wd:Q5 ; wdt:P39 wd:Q16707842 ; wdt:P40 ?person5 } 
      UNION { ?person6 wdt:P31 wd:Q5 ; wdt:P39 wd:Q18015642 ; wdt:P40 ?person5 }
      UNION { ?person6 wdt:P31 wd:Q5 ; wdt:P39 wd:Q18018860 ; wdt:P40 ?person5 }     
  # person 6 is an MP, and person 5 is their child
            { ?person7 wdt:P31 wd:Q5 ; wdt:P39 wd:Q16707842 ; wdt:P40 ?person6 } 
      UNION { ?person7 wdt:P31 wd:Q5 ; wdt:P39 wd:Q18015642 ; wdt:P40 ?person6 }
      UNION { ?person7 wdt:P31 wd:Q5 ; wdt:P39 wd:Q18018860 ; wdt:P40 ?person6 }     
  # person 7 is an MP, and person 6 is their child
            { ?person8 wdt:P31 wd:Q5 ; wdt:P39 wd:Q16707842 ; wdt:P40 ?person7 } 
      UNION { ?person8 wdt:P31 wd:Q5 ; wdt:P39 wd:Q18015642 ; wdt:P40 ?person7 }
      UNION { ?person8 wdt:P31 wd:Q5 ; wdt:P39 wd:Q18018860 ; wdt:P40 ?person7 }     
  # person 8 is an MP, and person 7 is their child
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
