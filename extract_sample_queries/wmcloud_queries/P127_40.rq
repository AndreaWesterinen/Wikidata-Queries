SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P127 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P580, wd:P582, wd:P1107, wd:P585, wd:P518, wd:P828, wd:P1319, wd:P1326, wd:P729, wd:P730, wd:P1932, wd:P5102, wd:P1480, wd:P1012, wd:P1011, wd:P1545, wd:P2241, wd:P7452, wd:P1534, wd:P8555, wd:P8554, wd:P1028, wd:P1114, wd:P805, wd:P1365, wd:P1366, wd:P1810, wd:P642, wd:P276, wd:P10663, wd:P1706 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
