SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity wdt:P1435 wd:Q811165; wdt:P131* wd:Q470577; FILTER NOT EXISTS{ ?entity wdt:P5816 wd:Q63065035 } . 
  MINUS { ?entity wdt:P8138 []; wdt:P1435 wd:Q811165; wdt:P131* wd:Q470577; FILTER NOT EXISTS{ ?entity wdt:P5816 wd:Q63065035 }  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
