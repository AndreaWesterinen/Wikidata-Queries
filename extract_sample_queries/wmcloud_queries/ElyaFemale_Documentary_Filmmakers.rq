SELECT ?item ?itemLabel ?itemDescription ?birth ?death ?img WHERE { ?item wdt:P106 wd:Q1235146 ; wdt:P21 wd:Q6581072; wdt:P569 ?birth. OPTIONAL {?item wdt:P570 ?death.} OPTIONAL {  ?item wdt:P18 ?img. }  ?sitelink schema:about ?item . FILTER NOT EXISTS { ?article schema:about ?item . ?article schema:isPartOf <https://de.wikipedia.org/> . } SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en,fr,es,de"
