#title: In the museum without a link
# Complex constraint from [[Property talk:P4740]]
# Items that have [[Property:P195|collection&#32;<small dir="ltr">(P195)</small>]] → [[d:Q632682|Brooklyn Museum <small>(Q632682)</small>]], but that don't have a [[Property:P4740|Brooklyn Museum artwork ID&#32;<small dir="ltr">(P4740)</small>]] link
SELECT DISTINCT ?item ?url WHERE {
  ?item wdt:P195 wd:Q632682 .
  OPTIONAL { ?item wdt:P973 ?url } . 
  MINUS { ?item wdt:P4740 [] } .
}  LIMIT 500
