SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P1923 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P1358, wd:P1359, wd:P1351, wd:P1356, wd:P1357, wd:P1355, wd:P1350, wd:P1352, wd:P115, wd:P1618, wd:P2094, wd:P2955, wd:P2241, wd:P7452, wd:P1810, wd:P5102, wd:P286, wd:P5828, wd:P8884, wd:P3085, wd:P2443, wd:P17, wd:P527, wd:P1532, wd:P2868, wd:P166, wd:P1268, wd:P3831 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
