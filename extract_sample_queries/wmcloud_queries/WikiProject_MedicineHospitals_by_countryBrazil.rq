SELECT DISTINCT ?item ?ac ?status ?pt
WHERE 
{ ?item wdt:P31/wdt:P279* wd:Q16917; wdt:P17 wd:Q155
OPTIONAL { ?item p:P31/ps:P31 wd:Q64578911 . BIND(wd:Q64578911 as ?status1) } BIND(COALESCE(?status1,wd:Q64624840) as ?status)
OPTIONAL { ?item rdfs:label ?pt . FILTER(lang(?pt)="pt-br") }
OPTIONAL { ?item wdt:P131/wdt:P131* ?ac . ?ac wdt:P31 wd:Q485258 }
}
