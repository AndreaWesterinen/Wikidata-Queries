SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P21 [] .
			MINUS {
				VALUES ?classes { wd:Q215627 wd:Q729 wd:Q21070598 wd:Q15619164 wd:Q95074 wd:Q24334685 wd:Q201662 wd:Q40614 wd:Q7239 wd:Q11012 wd:Q10832 wd:Q79600797 wd:Q16521 wd:Q1285470 wd:Q26513 wd:Q2345820 wd:Q111282474 wd:Q2593744 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
