#title: Items without ID
# Complex constraint from [[Property talk:P2525]]
# Items that do have [[d:Q20905436|Ramsar site <small>(Q20905436)</small>]] in [[Property:P1435|heritage designation&#32;<small dir="ltr">(P1435)</small>]], but not [[Property:P2525|Ramsar Sites Information Service ID&#32;<small dir="ltr">(P2525)</small>]]
SELECT DISTINCT ?item WHERE { VALUES ?value { wd:Q20905436 } . ?item wdt:P1435 ?value . MINUS { ?item wdt:P2525 [] } }
