SELECT ?item ?itemLabel ?naamsoortLabel
WHERE 
{
  ?item wdt:P31 wd:Q5.
  ?item wdt:P6379 wd:Q17153751.
  ?item wdt:P735 ?voornaam.
  FILTER NOT EXISTS {
    ?item wdt:P21 [].
   }
  ?voornaam wdt:P31 ?naamsoort.
  ?voornaam wdt:P31 wd:Q12308941
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
