SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P7085 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P407, wd:P580, wd:P582, wd:P1552, wd:P3744, wd:P3740, wd:P585, wd:P1810, wd:P1001, wd:P3831, wd:P2868, wd:P805, wd:P1480, wd:P1319, wd:P8554, wd:P8555, wd:P1326, wd:P1065, wd:P2960, wd:P7452, wd:P10649, wd:P137, wd:P1534, wd:P921, wd:P554, wd:P2241 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
