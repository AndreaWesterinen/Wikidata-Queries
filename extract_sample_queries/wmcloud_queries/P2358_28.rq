#title: Labels in Polish would generally be different from Latin
# Complex constraint from [[Property talk:P2358]]
# output: item with English label, Polish label, Latin label
SELECT ?item ?pl ?la
{
  ?item wdt:P2358 [ ] ; wdt:P31 wd:Q5 .
  ?item rdfs:label ?la . FILTER( lang(?la) = "la" ) 
  ?item rdfs:label ?pl . FILTER( lang(?pl) = "pl" ) 
  FILTER( str(?pl) = str(?la)  && !REGEX(?la, "^[^ ]+a( [^ ]+a)?$" ) )
}
LIMIT 1000
