SELECT ?item ?spaces ?first ?itemAltLabel ?l ?O ?last ?aftercomma
WHERE
{
    ?item wdt:P27 wd:Q27 ; wdt:P31 wd:Q5 . 
    MINUS { ?item wdt:P735 [] } . 
