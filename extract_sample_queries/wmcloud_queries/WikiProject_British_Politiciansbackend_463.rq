# Finds items with a term in the 1558-1603 period, but sourced *only* to a different HoP volume


SELECT DISTINCT ?item ?itemLabel ?termLabel ?constituencyLabel {
  ?item p:P39 ?positionStatement . 
  ?positionStatement ps:P39 ?term . ?term wdt:P279 wd:Q18018860 . 
  OPTIONAL { ?positionStatement pq:P768 ?constituency . }
  
  ?term wdt:P571 ?termstart . bind(year(?termstart) as ?startyear) . 
  filter (?startyear >= 1558 ) . filter (?startyear <= 1603 ) .
  
 ?positionStatement prov:wasDerivedFrom ?ref . 
         ?ref pr:P1614 ?refhop . FILTER(!STRSTARTS(?refhop, "1558")).

 minus { ?positionStatement prov:wasDerivedFrom ?ref1558 . 
         ?ref1558 pr:P1614 ?refhop1558 . FILTER(STRSTARTS(?refhop1558, "1558")). }  

  
  SERVICE wikibase:label { bd:serviceParam wikibase:language 'en' }
} 
