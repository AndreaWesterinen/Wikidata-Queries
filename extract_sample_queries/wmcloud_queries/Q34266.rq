#title: Russian Empire is used as death place qualifier value for people dead before 1721-10-22
# Complex constraint from [[Property talk:Q34266]]
# Items with [[Property:P17|country&#32;<small dir="ltr">(P17)</small>]] qualifier of [[Property:P20|place of death&#32;<small dir="ltr">(P20)</small>]] equal to [[d:Q34266|Russian Empire <small>(Q34266)</small>]] and [[Property:P570|date of death&#32;<small dir="ltr">(P570)</small>]] before 1721-10-22
SELECT DISTINCT ?item WHERE {
    ?item p:P570/psv:P570 ?node .
    ?node wikibase:timeValue ?dead .
    ?node wikibase:timePrecision ?precision .
    ?item wdt:P19 ?deathPlace .
    ?deathPlace pq:P17 wd:Q34266 .
    FILTER (?dead < "1721-10-22T00:00:00Z"^^xsd:dateTime)
    FILTER (?precision >= "9"^^xsd:integer)
  }
