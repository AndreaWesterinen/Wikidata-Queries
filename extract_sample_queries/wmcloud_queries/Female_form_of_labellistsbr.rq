SELECT DISTINCT ?item ?itemlabelfr ?fr ?itemlabelbr ?br ?field ?fieldlabel { ?item wdt:P2521 ?br . FILTER(lang(?br)="br") OPTIONAL {	?item wdt:P2521 ?fr . 	FILTER(lang(?fr)="fr") } OPTIONAL { 	?item wdt:P425 ?field   SERVICE wikibase:label { bd:serviceParam wikibase:language "br" . ?field rdfs:label ?fieldlabel } } SERVICE wikibase:label { bd:serviceParam wikibase:language "br" . ?item rdfs:label ?itemlabelbr } SERVICE wikibase:label { bd:serviceParam wikibase:language "fr" . ?item rdfs:label ?itemlabelfr } }
