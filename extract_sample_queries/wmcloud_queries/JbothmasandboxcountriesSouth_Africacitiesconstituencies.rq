SELECT ?item ?council WHERE { 
  VALUES ?cons { wd:Q192611 }
  OPTIONAL { 
    { ?region wdt:P31/wdt:P279* wd:Q1530824 }
    UNION
    { ?region wdt:P31/wdt:P279* wd:Q1500352 }
  }
  ?region wdt:P17 wd:Q258.
  {
    ?council wdt:P1001 ?region ;
             wdt:P31 wd:Q11204 .
    MINUS { ?council wdt:P576 [] }
  }
  # ?item wdt:P31/wdt:P279* ?cons .
  ?item wdt:P131 ?region
  MINUS { ?item wdt:P576 [] }
}
ORDER BY ?item
ORDER BY ?item
