SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P94 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P580, wd:P582, wd:P585, wd:P237, wd:P2096, wd:P2441, wd:P2241, wd:P7452, wd:P8555, wd:P1319, wd:P8554, wd:P1326, wd:P180, wd:P571, wd:P1001, wd:P170 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
