#Target required claim report for P1811: report listing each item and value

SELECT ?item ?itemLabel ?value ?valueLabel ?target ?targetLabel ?snak
WHERE
{
	{
		SELECT DISTINCT ?item ?value ?target ?snak
		WHERE
		{
			{
				?item p:P1811/ps:P1811 ?value .
				BIND("mainsnak" AS ?snak) .
			} UNION {
				?statement0 pq:P1811 ?value .
				?item ?p0 ?statement0 .
				BIND("qualifier" AS ?snak) .
			} UNION {
				?ref pr:P1811 ?value .
				?statement1 prov:wasDerivedFrom ?ref .
				?item ?p1 ?statement1 .
				BIND("reference" AS ?snak) .
			} .
			VALUES ?values { wd:Q1983062 wd:Q21191270 wd:Q7724161 wd:Q61855877 wd:Q102364578 wd:Q1464125 } .
			MINUS {
				?value p:P360/ps:P360 ?values .
			} .
			OPTIONAL {
				?value p:P360/ps:P360 ?target .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
