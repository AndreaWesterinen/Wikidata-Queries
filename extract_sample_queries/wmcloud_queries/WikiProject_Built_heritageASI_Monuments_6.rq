#defaultView:Map
SELECT ?item ?itemLabel ?location ?locationLabel ?coord ?img ?asi WHERE {
  ?item wdt:P1435 wd:Q17047615.
  ?item wdt:P131 ?location.
    ?location wdt:P131 wd:Q1193.
  OPTIONAL { ?item wdt:P625 ?coord. }
  OPTIONAL { ?item wdt:P18 ?img. }
  OPTIONAL { ?item wdt:P1371 ?asi. }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
