SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity wdt:P31 wd:Q2919801.
  ?entity wdt:P17 wd:Q32 .

  MINUS { ?entity wdt:P576 [] }
  MINUS { ?entity wdt:P1366 [] }
  MINUS {
    ?entity wdt:P31 wd:Q2919801;
    p:P31 [
      pq:P582 ?end
    ].
  } . 
  MINUS { ?entity wdt:P31 []; wdt:P31 wd:Q2919801.
  ?entity wdt:P17 wd:Q32 .

  MINUS { ?entity wdt:P576 [] }
  MINUS { ?entity wdt:P1366 [] }
  MINUS {
    ?entity wdt:P31 wd:Q2919801;
    p:P31 [
      pq:P582 ?end
    ].
  }  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
