SELECT ?word ?fID WHERE{?l a ontolex:LexicalEntry;dct:language ?language;ontolex:lexicalForm ?fID.?fID ontolex:representation ?word2.?language wdt:P218 'cs'.{SELECT ?word WHERE{?l a ontolex:LexicalEntry;dct:language ?language;ontolex:lexicalForm ?form.?form ontolex:representation ?word.?language wdt:P218 'cs'.FILTER(NOT EXISTS{?form wdt:P5279 ?o})}LIMIT 1}FILTER(?word2 = ?word)}
