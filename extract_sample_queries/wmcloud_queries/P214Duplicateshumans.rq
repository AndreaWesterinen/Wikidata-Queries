SELECT ?item ?item2 (REPLACE(CONCAT('[', ?formatter, ' $1]'), '\\$1', ?viaf) AS ?url) WITH {
  SELECT * {
    ?item wdt:P214/^wdt:P214 ?item2 .
    FILTER( STR( ?item ) < STR( ?item2 ) ) .
    { ?item wdt:P31 wd:Q5 . } UNION { ?item2 wdt:P31 wd:Q5 . }
  } LIMIT 1000
} AS %duplicates WITH {
  SELECT * { wd:P214 wdt:P1630 ?formatter } LIMIT 1
} AS %formatter WHERE {
  INCLUDE %duplicates .
  INCLUDE %formatter .
  ?item wdt:P214 ?viaf .
  ?item2 wdt:P214 ?viaf .
} ORDER BY xsd:integer(?viaf)
