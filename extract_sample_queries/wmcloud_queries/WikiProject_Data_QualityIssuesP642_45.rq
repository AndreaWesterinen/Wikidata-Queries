#Not institution, periodical, collection/database, online publication/web service, BEACON, info, manifestation, work, or digital good
SELECT DISTINCT ?item ?itemLabel ?ofLabel
WHERE
{
  ?item p:P2699 ?stm .
  ?stm pq:P642 ?of .
   FILTER NOT EXISTS {  
   ?of wdt:P31/wdt:P279* wd:Q178706.
   }
   FILTER NOT EXISTS {  
   ?of wdt:P31/wdt:P279* wd:Q1002697.
   }
  FILTER NOT EXISTS {  
   ?of wdt:P31/wdt:P279* wd:Q2668072.
   }
   FILTER NOT EXISTS {  
   ?of wdt:P31/wdt:P279* wd:Q8513.
   }
   FILTER NOT EXISTS {  
   ?of wdt:P31/wdt:P279* wd:Q1714118.
   }
   FILTER NOT EXISTS {  
   ?of wdt:P31/wdt:P279* wd:Q193424.
   }
   FILTER NOT EXISTS {  
   ?of wdt:P279+ wd:Q11028.
   }
   FILTER NOT EXISTS {  
   ?of wdt:P279+ wd:Q286583.
   }
   FILTER NOT EXISTS {  
   ?of wdt:P279+ wd:Q386724.
   }
   FILTER NOT EXISTS {  
   ?of wdt:P279+ wd:Q1224899.
   }
   FILTER (?of != wd:Q109380637 )
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". } # Helps get the label in your language, if not, then en language
}
