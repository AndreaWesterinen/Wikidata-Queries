sparql?query=SELECT ?l1 ?l2 ?lemma ?l1catLabel ?l2catLabel WITH {
  SELECT * WHERE {
    ?l1 a ontolex:LexicalEntry ; wikibase:lemma ?lemma ; dct:language wd:Q1860 ; wikibase:lexicalCategory ?l1cat .
    ?l2 a ontolex:LexicalEntry ; wikibase:lemma ?lemma ; dct:language wd:Q1860 ; wikibase:lexicalCategory ?l2cat .
}} AS %i
WHERE {
  include %i
  FILTER(?l1 != ?l2 && ?l1cat = ?l2cat)
#  MINUS {
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
} order by ?lemma ?l1cat
