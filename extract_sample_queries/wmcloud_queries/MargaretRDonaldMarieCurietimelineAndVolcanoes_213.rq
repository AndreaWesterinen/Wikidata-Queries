# Taxa with author citation containing Navás and which have AFD_ids
SELECT ?item ?itemLabel ?citation ?article ?image_title
WITH
{
  SELECT ?item ?citation ?article 
  WHERE 
  {
    ?article schema:about ?item ;
             schema:isPartOf <https://en.wikipedia.org/> .
    ?item wdt:P31 wd:Q16521 .
    ?item wdt:P6507 ?citation .
    ?item wdt:P6039 ?afd_id .
    FILTER (CONTAINS(STR(?citation),"Navás"))
    #FILTER (CONTAINS(STR(?article),"wiki/P"))  
    #BIND (SUBSTR(wikibase:decodeUri(STR(?image)), 52) AS ?image_title)
  }
} AS %i

WHERE
{
  INCLUDE %i
  #INCLUDE %wanted_image_titles
  #FILTER NOT EXISTS
  #{ 
   # ?article2 schema:about ?item ;
   #           schema:isPartOf <https://en.wikipedia.org/> .
  #}
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
}
