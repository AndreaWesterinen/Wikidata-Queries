SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity ^ wdt:P921/wdt:P1433 wd:Q665807; wdt:P31 wd:Q5 . 
  MINUS { ?entity wdt:P19/wdt:P17 []; ^ wdt:P921/wdt:P1433 wd:Q665807; wdt:P31 wd:Q5  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
