#defaultView:Timeline
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dbc: <http://dbpedia.org/resource/Category:>
PREFIX yago: <http://dbpedia.org/class/yago/>

SELECT  DISTINCT ?wditem ?wditemLabel ?date ?work ?workLabel ?image WHERE {  
    SERVICE <http://dbpedia.org/sparql> {
        ?item dct:subject|dct:subject/skos:broader|dct:subject/skos:broader/skos:broader dbc:Italian_Renaissance_humanists ;
#        ?item rdf:type yago:WikicatPioneersOfPhotography ;
              owl:sameAs ?wditem FILTER regex (?wditem, "wikidata.org") .
    }        
    SERVICE <https://query.wikidata.org/sparql> {
	  ?wditem wdt:P569 ?date .
#      OPTIONAL {?wditem wdt:P800 ?work }
      OPTIONAL {?wditem wdt:P18 ?image } .  
      ?wditem rdfs:label ?wditemLabel FILTER (LANG(?wditemLabel)="en") .
    }
}
