SELECT ?item ?itemLabel ?value ?valueLabel ?instance ?instanceLabel ?snak 
WHERE
{
	{
		SELECT DISTINCT ?item ?value ?instance ?snak {
			{
				?item wdt:P135 ?value .
				BIND("mainsnak" AS ?snak) .
			} UNION {
				?statement0 pq:P135 ?value .
				?item ?p0 ?statement0 .
				BIND("qualifier" AS ?snak) .
			} UNION {
				?ref pr:P135 ?value .
				?statement1 prov:wasDerivedFrom ?ref .
				?item ?p1 ?statement1 .
				BIND("reference" AS ?snak) .
			} .
			MINUS {
				VALUES ?classes { wd:Q3533467 wd:Q1387659 wd:Q2738074 wd:Q2198855 wd:Q23834194 wd:Q49773 wd:Q2915955 wd:Q28820001 wd:Q968159 wd:Q1792644 wd:Q2054106 wd:Q1826286 wd:Q7254446 wd:Q12765852 wd:Q17399019 } .			
				?value wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?value wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
