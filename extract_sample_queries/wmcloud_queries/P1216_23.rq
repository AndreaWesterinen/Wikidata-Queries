#title: National Heritage List for England without number
# Complex constraint from [[Property talk:P1216]]
# Items that do have [[Property:P1435|heritage designation&#32;<small dir="ltr">(P1435)</small>]]: [[d:Q15700818|Grade I listed building <small>(Q15700818)</small>]]/[[d:Q15700834|Grade II listed building <small>(Q15700834)</small>]]/[[d:Q15700831|Grade II* listed building <small>(Q15700831)</small>]], but not this property or [[Property:P1459|Cadw Building ID&#32;<small dir="ltr">(P1459)</small>]] (some of these may be in Wales).
SELECT DISTINCT ?item
{
      { ?item wdt:P1435 wd:Q15700818  } UNION
      { ?item wdt:P1435 wd:Q15700834  } UNION
      { ?item wdt:P1435 wd:Q15700831  } MINUS
      { ?item p:P1216 [] } MINUS 
      { ?item p:P1459 [] }
}
