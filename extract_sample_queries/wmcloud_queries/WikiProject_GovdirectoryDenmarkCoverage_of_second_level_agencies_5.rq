SELECT ?grouping (COUNT(DISTINCT ?entity) as ?count) (SAMPLE(?entity) as ?sample) WHERE { ?entity wdt:P17 wd:Q35 ;
        wdt:P31/wdt:P279* wd:Q13220204 .
  MINUS{ ?entity wdt:P576 [] }
  MINUS{ ?entity wdt:P1366 [] }
  MINUS{ ?entity wdt:P31/wdt:P279* wd:Q19953632 }. ?entity wdt:P31 ?grouping .} GROUP BY ?grouping HAVING (?count < 90) ORDER BY DESC(?count) LIMIT 1000
