SELECT ?grouping (COUNT(DISTINCT ?entity) as ?count) (SAMPLE(?entity) as ?sample) WHERE { ?entity wdt:P108 [(wdt:P31/(wdt:P279*)) wd:Q33506; wdt:P17 ?country];  wdt:P21 ?gender FILTER (?gender IN (wd:Q6581072, wd:Q6581097, wd:Q1097630, wd:Q1052281, wd:Q2449503, wd:Q48270)). VALUES ?country {wd:Q40 wd:Q39 wd:Q183 }. ?entity wdt:P21 ?grouping .} GROUP BY ?grouping HAVING (?count >= 1) ORDER BY DESC(?count) LIMIT 1000
