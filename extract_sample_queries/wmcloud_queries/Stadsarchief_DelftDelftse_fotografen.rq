SELECT DISTINCT ?item ?itemLabel WHERE {
  ?item wdt:P31 wd:Q5.
  	# beroep = fotograaf of onderliggend
  ?item (wdt:P106/wdt:P279*) wd:Q33231.
  {?item wdt:P19 wd:Q33432813
   	# OR work location stad Delft
	} UNION  {?item wdt:P937 wd:Q33432813}
   	# OR residency within stad Delft
	UNION  {?item wdt:P551 wd:Q33432813}
   	# OR place of death stad Delft
	UNION  
        {?item wdt:P20 wd:Q33432813}
        UNION
        {?item wdt:P19 wd:Q690}
   	# OR work location gemeente Delft
	UNION  {?item wdt:P937 wd:Q690}
   	# OR residency gemeente Delft
	UNION  {?item wdt:P551 wd:Q690}
   	# OR place of death gemeente Delft
	UNION  {?item wdt:P20 wd:Q690}
  SERVICE wikibase:label { bd:serviceParam wikibase:language "nl, en". }
}
