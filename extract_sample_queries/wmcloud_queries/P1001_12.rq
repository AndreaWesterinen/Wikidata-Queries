SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P1001 [] .
			MINUS {
				VALUES ?classes { wd:Q1151067 wd:Q895526 wd:Q80071 wd:Q43229 wd:Q216353 wd:Q4164871 wd:Q18616576 wd:Q1140371 wd:Q15617994 wd:Q15097084 wd:Q30634609 wd:Q43306178 wd:Q3917681 wd:Q372690 wd:Q213283 wd:Q7843791 wd:Q35535 wd:Q8161 wd:Q7748 wd:Q42470 wd:Q2385804 wd:Q2135465 wd:Q473972 wd:Q40357 wd:Q21004260 wd:Q1864008 wd:Q14659 wd:Q686822 wd:Q191072 wd:Q15238777 wd:Q1530022 wd:Q618779 wd:Q65554936 wd:Q1445650 wd:Q105985 wd:Q8142 wd:Q4992061 wd:Q176799 wd:Q329525 wd:Q214995 wd:Q317557 wd:Q55876909 wd:Q17143723 wd:Q12798556 wd:Q12804010 wd:Q102496 wd:Q689044 wd:Q56061 wd:Q7397 wd:Q20045456 wd:Q1572600 wd:Q567696 wd:Q905765 wd:Q223729 wd:Q321839 wd:Q13406463 wd:Q21451536 wd:Q187588 wd:Q1456832 wd:Q13582682 wd:Q166140 wd:Q14623646 wd:Q1523821 wd:Q99045339 wd:Q1505023 wd:Q10541491 wd:Q7406919 wd:Q769696 wd:Q3150005 wd:Q41487 wd:Q63705939 wd:Q334453 wd:Q9261468 wd:Q481182 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
