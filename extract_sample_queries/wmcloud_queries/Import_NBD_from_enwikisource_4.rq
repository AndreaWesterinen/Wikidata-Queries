SELECT
# Readable output:
	?item ?itemLabel ?subject ?subjectLabel 
# Output for QuickStatements:
	(strafter(str(?subject), "entity/") as ?QuickStatementsItem)
	("P241" as ?QuickStatementsProperty)
	("Q172771" as ?QuickStatementsValue)
WHERE
{
	?item wdt:P1433 wd:Q16055052 .
  	?item wdt:P921 ?subject .
  	?subject wdt:P31 wd:Q5 .  
	MINUS { ?subject wdt:P241 wd:Q172771 }
  	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" }
}
