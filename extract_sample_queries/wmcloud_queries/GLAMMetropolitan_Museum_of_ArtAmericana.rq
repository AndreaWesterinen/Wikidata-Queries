SELECT ?item ?meturl ?wadelink
WHERE
{
  VALUES ?id {"687670" "687677" "11157" "19144" "19141" "13084" "11721" "701989" "11269" "501247" "501231" "503267" "717556" "318359" "269555" "267576" "283224" "24960" "285755" "268324" "19003" "11859" "264711" "11866" "689997" "283221" "10481" "10497" "10501" "10946" "11311" "10154" "10890" "10068" "432231" "268330" "285833" "268340" "286586" "24648" "8218" "11417" "388957" "365208" "389056" "80403" "155774" "157537" "33021" "745991" "812826" "263204" "4593" "802" "5505" "10531" "12600" "16584" "11040" "200" "1997" "21698" "13134" "134" } 
  ?item wdt:P3634 ?id .
  ?item wdt:P217 ?inv .
  BIND ((CONCAT ("[http://www.metmuseum.org/art/collection/search/", ?id, " ", ?id, "/", ?inv, "]")) as ?meturl) .
  BIND ((CONCAT ("[https://art.wikidata.link/item/", SUBSTR(STR(?item),32), " ", SUBSTR(STR(?item),32), "]")) as ?wadelink) .
}
