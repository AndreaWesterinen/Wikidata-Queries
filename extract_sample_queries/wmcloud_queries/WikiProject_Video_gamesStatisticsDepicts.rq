SELECT ?item ?itemLabel (CONCAT('[[Wikidata:WikiProject Video games/Reports/Motif/', ?itemLabel,']]') as ?link) (COUNT(?game) as ?count) WHERE {
  ?game (wdt:P31/wdt:P279*) wd:Q7889.
  OPTIONAL { ?game wdt:P180 ?item. }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
} GROUP BY ?item ?itemLabel
ORDER BY DESC(?count)
