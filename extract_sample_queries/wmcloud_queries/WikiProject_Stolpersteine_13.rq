embed.html##defaultView:Map
SELECT ?Stolperstein ?StolpersteinLabel ?geographische_Koordinaten WHERE {
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
  ?Stolperstein wdt:P31 wd:Q26703203.
  ?Stolperstein wdt:P625 ?geographische_Koordinaten.
  MINUS { ?Stolperstein wdt:P131 ?liegt_in_der_Verwaltungseinheit. }
}
