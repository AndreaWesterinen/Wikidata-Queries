SELECT ?item ?itemLabel ?value ?valueLabel ?snak ?rank ?statement
WHERE
{
  {
    SELECT ?item ?value ?result ?snak ?rank ?statement WHERE {
      {
        ?item p:P5386 ?statement .
        ?statement ps:P5386 ?value; wikibase:rank ?rank .
        BIND("mainsnak" AS ?snak) .
      } UNION {
        ?statement pq:P5386 ?value; wikibase:rank ?rank .
        ?item ?p1 ?statement .
        BIND("qualifier" AS ?snak) .
      } UNION {
        ?ref pr:P5386 ?value .
        ?statement prov:wasDerivedFrom ?ref; wikibase:rank ?rank .
        ?item ?p2 ?statement .
        BIND("reference" AS ?snak) .
      } .
      FILTER( ?value NOT IN ( wd:Q54216807, wd:Q54216808, wd:Q54216809, wd:Q54216811, wd:Q54216812, wd:Q54216813, wd:Q54216815, wd:Q54216817, wd:Q54216818, wd:Q24887965, wd:Q55085388, wd:Q55085389, wd:Q116733910, wd:Q116733891, wd:Q116733896, wd:Q116733899, wd:Q116733904 ) ) .
    } LIMIT 100
  } .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
