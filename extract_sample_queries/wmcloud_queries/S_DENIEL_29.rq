SELECT ?item ?itemLabel ?nomméref ?fantoirLabel ?OpenLabel WHERE {
  ?item wdt:P131 wd:Q12193;
    wdt:P31 wd:Q79007.
  OPTIONAL { ?item wdt:P138 ?nomméref. }
  OPTIONAL { ?item wdt:P3182 ?fantoir. }
  OPTIONAL { ?item wdt:P402 ?OpenLabel. }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en,nl,fr,es". }
}
