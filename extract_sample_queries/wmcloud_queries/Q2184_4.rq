#title: RSFSR is used as born place qualifier value for people born after 1991-12-12
# Complex constraint from [[Property talk:Q2184]]
# Items with [[Property:P17|country&#32;<small dir="ltr">(P17)</small>]] qualifier of [[Property:P19|place of birth&#32;<small dir="ltr">(P19)</small>]] equal to [[d:Q2184|Russian Soviet Federative Socialist Republic <small>(Q2184)</small>]] and [[Property:P569|date of birth&#32;<small dir="ltr">(P569)</small>]] after 1991-12-12
SELECT DISTINCT ?item WHERE {
    ?item p:P569/psv:P569 ?node .
    ?node wikibase:timeValue ?born .
    ?node wikibase:timePrecision ?precision .
    ?item wdt:P19 ?bornPlace .
    ?bornPlace pq:P17 wd:QQ2184 .
    FILTER (?born > "1991-12-12T00:00:00Z"^^xsd:dateTime)
    FILTER (?precision >= "9"^^xsd:integer)
  }
