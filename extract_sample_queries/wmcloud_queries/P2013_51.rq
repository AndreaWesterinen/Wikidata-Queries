SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P2013 [] .
			MINUS {
				VALUES ?classes { wd:Q5 wd:Q43229 wd:Q386724 wd:Q1190554 wd:Q340169 wd:Q6576792 wd:Q11012 wd:Q4164871 wd:Q177634 wd:Q16979650 wd:Q193424 wd:Q26401003 wd:Q102345381 wd:Q101420143 wd:Q15632617 wd:Q618779 wd:Q431289 wd:Q15720625 wd:Q3542731 wd:Q13226383 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
