SELECT ?item ?itemLabel (COUNT(DISTINCT ?film) AS ?count) WHERE { hint:Query hint:optimizer "None" . ?statement v:P161 ?item . ?film p:P161 ?statement . ?statement ?pq_qual wd:Q18086706 . wd:P453 wikibase:qualifier ?pq_qual . VALUES ?filmtype {wd:Q11424 wd:Q24862 wd:Q20667187 wd:Q226730} . ?film wdt:P31 ?filmtype . SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } } GROUP BY ?item ?itemLabel ORDER BY DESC (?count) LIMIT 12
