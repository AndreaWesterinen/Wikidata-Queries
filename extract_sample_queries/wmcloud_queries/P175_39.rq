SELECT ?item ?itemLabel ?value ?valueLabel ?instance ?instanceLabel ?snak 
WHERE
{
	{
		SELECT DISTINCT ?item ?value ?instance ?snak {
			{
				?item wdt:P175 ?value .
				BIND("mainsnak" AS ?snak) .
			} UNION {
				?statement0 pq:P175 ?value .
				?item ?p0 ?statement0 .
				BIND("qualifier" AS ?snak) .
			} UNION {
				?ref pr:P175 ?value .
				?statement1 prov:wasDerivedFrom ?ref .
				?item ?p1 ?statement1 .
				BIND("reference" AS ?snak) .
			} .
			MINUS {
				VALUES ?classes { wd:Q5 wd:Q2088357 wd:Q15632617 wd:Q60614352 wd:Q215380 wd:Q52688389 wd:Q6619719 wd:Q15711870 wd:Q15773317 wd:Q59755569 wd:Q18510489 wd:Q2416217 wd:Q15267437 wd:Q66481339 wd:Q65209857 } .			
				?value wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?value wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
