SELECT ?q ?qLabel (COUNT(DISTINCT ?sitelink) as ?linkcount) {
  ?q (wdt:P31/wdt:P279*) wd:Q7725634 . # Literary work
  ?q wdt:P364 wd:Q188 . # Q188=German Language
  ?sitelink schema:about ?q
  SERVICE wikibase:label { bd:serviceParam wikibase:language "de" }       
  }
GROUP BY ?q ?qLabel
ORDER BY DESC(?linkcount)
LIMIT 500
