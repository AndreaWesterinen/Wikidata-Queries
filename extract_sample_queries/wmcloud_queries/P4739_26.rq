#title: In the museum without a link
# Complex constraint from [[Property talk:P4739]]
# Items that have [[Property:P195|collection&#32;<small dir="ltr">(P195)</small>]] → [[d:Q2711480|Musée des Augustins <small>(Q2711480)</small>]], but that don't have a [[Property:P4739|Musée des Augustins artwork ID (former scheme)&#32;<small dir="ltr">(P4739)</small>]] link
SELECT DISTINCT ?item ?url WHERE {
  ?item wdt:P195 wd:Q2711480 .
  OPTIONAL { ?item wdt:P973 ?url } . 
  MINUS { ?item wdt:P4739 [] } .
}  LIMIT 500
