SELECT ?item ?itemLabel ?instance ?instanceLabel
WHERE
{
	{
		SELECT DISTINCT ?item ?instance {
			?item wdt:P1031 [] .
			MINUS {
				VALUES ?classes { wd:Q820655 wd:Q686822 wd:Q1864008 wd:Q10429085 wd:Q1505023 wd:Q846882 wd:Q98491862 wd:Q99045339 wd:Q905765 wd:Q223729 wd:Q20669447 } .
				?item wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?item wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
