SELECT DISTINCT ?item WHERE {
  ?item wdt:P31/wdt:P279* wd:Q40231 .
  # make sure it has an exact datem and isn't deprecated
  ?item p:P585 ?tst .
    ?tst ps:P585 ?when ; psv:P585/wikibase:timePrecision "11"^^xsd:integer .
    MINUS { ?tst wikibase:rank wikibase:DeprecatedRank } .
  FILTER NOT EXISTS { ?item wdt:P1001 [] }
  FILTER (?when < NOW())
}
ORDER BY DESC(?when)
LIMIT 500
