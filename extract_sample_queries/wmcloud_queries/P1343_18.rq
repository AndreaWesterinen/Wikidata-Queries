SELECT ?item ?itemLabel ?value ?valueLabel ?instance ?instanceLabel ?snak 
WHERE
{
	{
		SELECT DISTINCT ?item ?value ?instance ?snak {
			{
				?item wdt:P1343 ?value .
				BIND("mainsnak" AS ?snak) .
			} UNION {
				?statement0 pq:P1343 ?value .
				?item ?p0 ?statement0 .
				BIND("qualifier" AS ?snak) .
			} UNION {
				?ref pr:P1343 ?value .
				?statement1 prov:wasDerivedFrom ?ref .
				?item ?p1 ?statement1 .
				BIND("reference" AS ?snak) .
			} .
			MINUS {
				VALUES ?classes { wd:Q386724 wd:Q3331189 wd:Q151885 wd:Q1277575 wd:Q12139612 wd:Q36774 wd:Q571 wd:Q7433672 wd:Q36279 wd:Q1030034 wd:Q34508 wd:Q17489659 wd:Q2085381 wd:Q111590499 wd:Q43229 } .			
				?value wdt:P31/wdt:P279* ?classes .
			} .
			OPTIONAL {
				?value wdt:P31 ?instance .
			} .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
