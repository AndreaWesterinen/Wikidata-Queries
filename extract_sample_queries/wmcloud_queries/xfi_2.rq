PREFIX psn: <http://www.wikidata.org/prop/statement/value-normalized/>

#defaultView:Map
SELECT ?item ?itemLabel ?itemDescription ?geocoordinates ?elevation ?layer WHERE {
 wd:Q804330 ^(wdt:P706|wdt:P361|wdt:P4552|wdt:P4688)+ ?item.
 wd:Q271669 (^wdt:P279*/^wdt:P31) ?item.
 OPTIONAL { ?item wdt:P31 ?instance. }
 OPTIONAL { ?item wdt:P625 ?geocoordinates. }
 OPTIONAL { ?item (p:P2044/psn:P2044/wikibase:quantityAmount) ?ele. }
 BIND(CONCAT("ele: ", STR(ROUND(?ele)), " m") AS ?elevation)
 SERVICE wikibase:label { bd:serviceParam wikibase:language "cs,sk,[AUTO_LANGUAGE],en,sv,ceb". 
             ?item rdfs:label ?itemLabel. 
             ?instance rdfs:label ?instanceLabel.
             }
 BIND (?instanceLabel as ?layer).
}
LIMIT 10000
