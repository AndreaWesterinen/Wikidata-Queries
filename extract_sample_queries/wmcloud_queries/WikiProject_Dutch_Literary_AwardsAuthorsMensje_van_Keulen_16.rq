# Works for which ?author was nominated for an award, but did not win
SELECT DISTINCT 
?authorLabel 
?work ?workLabel ?workDescription (GROUP_CONCAT(DISTINCT ?IsALabel ; separator = "****") as ?WorkIsA)
?award ?awardLabel ?nominatedyear
WHERE
{
  #Works written or translated by a given Author  
  BIND(wd:Q4362745 as ?author) . 
  BIND(wd:Q4362745 as ?translator) 
  {?work wdt:P50 ?author} UNION {?work wdt:P655 ?translator}.
  ?work wdt:P31 ?IsA.
  
  # that were nominated for an award
    ?work p:P1411  ?s. 
    ?s ps:P1411 ?award. # award nominated for
    ?s pq:P585 ?year1.
    BIND(YEAR(?year1) AS ?nominatedyear).

  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "nl" .
    ?IsA rdfs:label ?IsALabel.
    ?work rdfs:label ?workLabel .
    ?work schema:description ?workDescription .
    ?author rdfs:label ?authorLabel .
    ?award rdfs:label ?awardLabel .
    
  }
} GROUP BY ?work ?workLabel ?authorLabel ?workDescription ?award ?awardLabel ?nominatedyear
ORDER BY ?nominatedyear
