SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity (wdt:P31/(wdt:P279*)) wd:Q486972;  wdt:P17 ?countries FILTER (?countries IN (wd:Q1032)) . 
  MINUS { ?entity wdt:P17 []; (wdt:P31/(wdt:P279*)) wd:Q486972;  wdt:P17 ?countries FILTER (?countries IN (wd:Q1032))  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
