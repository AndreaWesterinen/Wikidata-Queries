SELECT ?item ( concat( '[https://query.wikidata.org/#SELECT%20%3Fitem%20%3FitemLabel%20%3FitemDescription%20WHERE%20%7B%0A%20%20%3Fitem%20wdt%3AP279%20%3C', str( ?item ), '%3E%20.%0A%20%20SERVICE%20wikibase%3Alabel%20%7B%20bd%3AserviceParam%20wikibase%3Alanguage%20%22%5BAUTO_LANGUAGE%5D%2Cen%22.%20%7D%0A%7D ', str( ?countN ), ']' ) as ?count ) WHERE {
  { SELECT ?item (count(*) as ?countN) WHERE {
    ?class wdt:P279 ?item .
  } group by ?item  having (?countN > 1000) }
} order by desc(?countN)
