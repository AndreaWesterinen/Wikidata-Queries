#by CamelCaseNick
select (?stolperstein as ?item) ?inscription where {
  ?stolperstein wdt:P31 wd:Q26703203;
                wdt:P1684 ?inscription.

  filter(!regex(?inscription, "(?: |/)(?:Jg|Jahrg|geboren|born(?: Dublin)?|NATO|născută?|nascut|nat|ur|geb|nar|rođena|s|lětnik|n[ée]e?|dz|fødselsår|født|născuta|née? (?:le|en))(?:\\.|,|\\:)? ?(?:\\d{1,2}[\\./](?:\\d{1,2}[\\./]| \\p{L}+\\.? ))?(\\d{4}|unbekannt)", "i"))
  filter(!regex(?inscription, "(geb|Jg)\\. ?\\?"))
  filter(!regex(?inscription, "�"))
  minus {
    values ?stolperstein {
      # no date of birth
      wd:Q43651536
