#SELECT DISTINCT ?POP_workID ?item ?title ?publication ?publicationLabel ?author ?authorLabel ?date1 ?date2 (CONCAT(?issue1,"-",?issue2) AS ?number) ?vol ?publisher ?publisherLabel ?place ?placeLabel ?fulltext WHERE {
SELECT DISTINCT ?POP_workID ?item ?title ?publication ?publicationLabel ?author ?authorLabel ?date1 ?date2 (CONCAT(?issue1,"-",?issue2) AS ?number) ?vol ?publisher ?publisherLabel ?place ?placeLabel WHERE {

  ?penny wdt:P1433 wd:Q109839011 .
  ?penny ?prop ?statement .
  ?statement rdf:type wikibase:BestRank .
  ?statement (prov:wasDerivedFrom/pr:P9622) ?POP_workID.  
  ?work wdt:P9622 ?POP_workID .
  
    { ?work ( wdt:P747 | wdt:P4969 | wdt:P179 | wdt:P155 | wdt:P156 | wdt:P144 | wdt:P1433 | wdt:P629 | wdt:P9745 | wdt:P6524 | wdt:P5059 )* ?item .}
  UNION
    { ?work (wdt:P527 | wdt:P361 ) ?item .}
  UNION
    { ?item ( wdt:P144 | wdt:P629 | wdt:P9745 | wdt:P6524 | wdt:P2550 | wdt:P5059 )* / ( wdt:P144 | wdt:P629 | wdt:P9745 | wdt:P6524 | wdt:P2550 | wdt:P5059 )+  ?work .}
  
  VALUES ?p { wdt:P144 wdt:P629 wdt:P9745 wdt:P6524 wdt:P2550 wdt:P5059 wdt:P747 wdt:P4969 wdt:P179 wdt:P155 wdt:P156 wdt:P1433 wdt:P361 wdt:P527 }  
    { ?item ?p ?value }
    UNION
    { ?value ?p ?item }  
  
  FILTER EXISTS{?item wdt:P31 wd:Q3374808}

  ?item wdt:P577 ?date ; 
        wdt:P1476 ?title_ . 
  OPTIONAL { ?item wdt:P433 ?issue } 
  OPTIONAL { ?item wdt:P1433 ?publication }
  OPTIONAL { ?item wdt:P123 ?publisher . ?item wdt:P291 ?place }
  OPTIONAL { ?item wdt:P1680 ?subtitle .}
  OPTIONAL { ?item p:P577 [ps:P577 ?date1 ; pq:P3831 wd:Q19269277] . ?item p:P577 [ps:P577 ?date2 ; pq:P3831 wd:Q30013662] }
  OPTIONAL { ?item p:P433 [ps:P433 ?issue1 ; pq:P3831 wd:Q19269277] . ?item p:P433 [ps:P433 ?issue2 ; pq:P3831 wd:Q30013662] }
  OPTIONAL { ?item p:P478 [ps:P478 ?vol1 ; pq:P3831 wd:Q19269277] . ?item p:P478 [ps:P478 ?vol2 ; pq:P3831 wd:Q30013662] . BIND(CONCAT(?vol1,"-",?vol2) AS ?vol) . }
  OPTIONAL { ?item wdt:P478 ?vol .}
  OPTIONAL { {?item p:P50 [ps:P50 ?author ; pq:P1545 ?ordinal] . } UNION {?item p:P50 [ps:P50 ?author ; pq:P1545 ?ordinal ; pq:P1932 ?statedAs] . } UNION {?item p:P2093 [ps:P2093 ?author ; pq:P1545 ?ordinal] } }
  OPTIONAL { ?item wdt:P953 ?fulltext .}

  BIND(IF(bound(?subtitle), CONCAT(?title_," ",?subtitle), ?title_) AS ?title)
  BIND(IF(!bound(?date1), ?date, ?date3) AS ?date1)
  BIND(IF(!bound(?issue1), ?issue, ?issue3) AS ?number)
  
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en". }
  
  }
#GROUP BY ?penny ?title ?subtitle ?author ?authorLabel ?ordinal ?statedAs ?date1 ?date2 ?issue1 ?issue2 ?vol
ORDER BY ?date1 ?POP_workID ?title
