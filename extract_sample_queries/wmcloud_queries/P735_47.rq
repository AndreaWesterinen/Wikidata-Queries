SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P735 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P1545, wd:P1449, wd:P3831, wd:P407, wd:P580, wd:P582, wd:P585, wd:P518, wd:P138, wd:P1001, wd:P2241, wd:P5102, wd:P1480, wd:P1013, wd:P7338, wd:P5168, wd:P1552, wd:P7452, wd:P742, wd:P4970, wd:P8555, wd:P1319, wd:P8554, wd:P1326, wd:P3938, wd:P3415, wd:P3416, wd:P8338, wd:P10663, wd:P1932, wd:P5548, wd:P282, wd:P1814 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
