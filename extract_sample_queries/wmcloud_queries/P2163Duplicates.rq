SELECT ?item ?item2 (REPLACE(CONCAT('[', ?formatter, ' $1]'), '\\$1', ?fast) AS ?url) WITH {
  SELECT * {
    ?item wdt:P2163/^wdt:P2163 ?item2 .
    FILTER( STR( ?item ) < STR( ?item2 ) ) .
  }
} AS %duplicates WITH {
  SELECT * { wd:P2163 wdt:P1630 ?formatter } LIMIT 1
} AS %formatter WHERE {
  INCLUDE %duplicates .
  INCLUDE %formatter .
  ?item wdt:P2163 ?fast .
  ?item2 wdt:P2163 ?fast .
} ORDER BY ?fast
