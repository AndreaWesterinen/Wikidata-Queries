#Makers with works in collection of museums whose work is represented by Pictoright who have died less than 70 years ago or are still alive
SELECT ?maker ?makerLabel ?born ?died ?copyrightrep WHERE {
  ?maker wdt:P31 wd:Q5 .              # mens
  ?maker wdt:P6379 wd:Q679527 .       # werk in collectie: Boijmans van Beuningen
  ?maker wdt:P6275 ?copyrightrep .   # copyrightrep
OPTIONAL {
  ?maker wdt:P569 ?born .             # geboortedatum
  }

BIND(NOW() AS ?date)
FILTER (?born >= "1800-01-01T00:00:00Z"^^xsd:dateTime)
OPTIONAL { ?maker wdt:P570 ?died. }
FILTER(!BOUND(?died) || ?date < ?died || ?died >= "1949-01-01T00:00:00Z"^^xsd:dateTime) # nog niet dood

SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],nl,en".} 
}

GROUP BY ?maker ?makerLabel ?born ?died ?copyrightrep
ORDER BY ASC(?born)
