SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P551 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P580, wd:P582, wd:P1534, wd:P2047, wd:P2348, wd:P1264, wd:P585, wd:P17, wd:P625, wd:P131, wd:P654, wd:P4856, wd:P670, wd:P6375, wd:P669, wd:P1545, wd:P1706, wd:P3831, wd:P2868, wd:P4626, wd:P4649, wd:P1552, wd:P828, wd:P39, wd:P1810, wd:P1932, wd:P5102, wd:P805, wd:P3680, wd:P1310, wd:P1480, wd:P459, wd:P4241, wd:P1319, wd:P8555, wd:P8554, wd:P1326, wd:P1317, wd:P18, wd:P1065, wd:P2960, wd:P2241, wd:P7452, wd:P10663, wd:P7528, wd:P276 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
