SELECT DISTINCT ?item ?label WHERE {
  ?item wdt:P1216 [] .
  OPTIONAL { ?item wdt:P31 ?dummy0 . }
  FILTER(!bound(?dummy0)).
  ?item rdfs:label ?label.
  FILTER(LANG(?label) = "en").
#  FILTER(CONTAINS(STR(?label), "Castle")).
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
  }
GROUP BY ?item ?label
