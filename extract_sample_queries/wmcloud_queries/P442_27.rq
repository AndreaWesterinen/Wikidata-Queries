SELECT ?item ?itemLabel ?value
WHERE
{
	{
		SELECT DISTINCT ?item ?property ?value {
			?item wdt:P442 ?value .
          MINUS { ?item rdfs:label ?label .
                 FILTER( LANG(?label)="zh"||LANG(?label)="zh-cn" ) }			
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
