#library buildings in New South Wales
#defaultView:Map
SELECT ?item ?itemLabel ?image ?geo ?url
WHERE {
  ?item wdt:P31 wd:Q856584; 
        wdt:P131 [ wdt:P131 wd:Q3224 ];
        wdt:P625 ?geo.
  OPTIONAL {?item wdt:P18 ?image;
                  wdt:P856 ?url.
  }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en".}
}
