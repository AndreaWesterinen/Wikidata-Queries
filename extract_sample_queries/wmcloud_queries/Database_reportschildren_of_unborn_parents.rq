SELECT ?item ?bdate (CONCAT("{","{Q\u007C",STRAFTER(STR(?child),"Q"),"}","}") as ?ch) ?cbdate {?item wdt:P31 wd:Q5 ; p:P569/psv:P569 ?bdate_node ; wdt:P40 ?child . ?bdate_node wikibase:timePrecision "11"^^xsd:integer ; wikibase:timeValue ?bdate . ?child p:P569/psv:P569 ?cbdate_node . ?cbdate_node wikibase:timePrecision "11"^^xsd:integer ; wikibase:timeValue ?cbdate . FILTER (?bdate >= ?cbdate)} order by ?child ?item
