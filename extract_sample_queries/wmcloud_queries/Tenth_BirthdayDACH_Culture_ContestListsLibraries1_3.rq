SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity (wdt:P31/(wdt:P279*)) wd:Q7075;  wdt:P17 ?countries FILTER (?countries IN (wd:Q40, wd:Q183, wd:Q39)) . 
  MINUS { ?entity wdt:P17 []; (wdt:P31/(wdt:P279*)) wd:Q7075;  wdt:P17 ?countries FILTER (?countries IN (wd:Q40, wd:Q183, wd:Q39))  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
