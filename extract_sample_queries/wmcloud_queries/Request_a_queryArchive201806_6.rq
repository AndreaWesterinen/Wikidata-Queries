SELECT ?language ?Anna_Ancher ?Sofonisba_Anguissola ?Julia_Margaret_Cameron ?Rosalba_Carriera ?Lili_Elbe ?Natalia_Goncharova ?Hanna_Hirsch_Pauli ?Judith_Leyster ?Berthe_Morisot ?Josefa_de_Obidos ?Maria_Sibylla_Merian ?Maria_Wiik 
 WHERE {
#LANGUAGE VALUE STATEMENT
  values (?language ?langcode) { ("French" "fr") ("German" "de") ("Italian" "it") ("Polish" "pl") ("Spanish" "es") ("Finnish" "fi") ("English" "en") ("Portuguese" "pt") ("Croatian" "hr") ("Dutch" "nl") ("Romanian" "ro") ("Bulgarian" "bg") ("Swedish" "sv") ("Danish" "da") ("Czech" "cs") ("Slovak" "sk") ("Slovene" "sl") ("Hungarian" "hu") ("Estonian" "et") ("Latvian" "lv") ("Lithuanian" "lt") ("Greek" "el") ("Irish" "ga") ("Maltese" "mt") ("Catalan" "ca")} .
  BIND(IRI(CONCAT("https://",str(?langcode),".wikipedia.org/"))AS ?wikilangs)
#PEOPLE VALUE STATEMENTS
  values ?person2 {wd:Q232423} .
  values ?person3 {wd:Q236038} . 
  values ?person4 {wd:Q1140735} .
  values ?person5 {wd:Q269338} .
  values ?person6 {wd:Q4110933} . #put the Qid of the sixth selected person here
  values ?person7 {wd:Q436803} .
  values ?person8 {wd:Q105320} .
  values ?person9 {wd:Q232391} .
  values ?person10 {wd:Q253446} .
  values ?person11 {wd:Q237726} .
  values ?person12 {wd:Q62530} .
  values ?person13 {wd:Q230120} .


#OPTIONAL STATEMENTS
  optional { ?wp2 schema:about ?person2 . ?wp2 schema:name ?article_p2 . ?wp2 schema:isPartOf ?wikilangs . optional {?wp2 wikibase:badge ?badge_p2 .}  } 
  optional { ?wp3 schema:about ?person3 . ?wp3 schema:name ?article_p3 . ?wp3 schema:isPartOf ?wikilangs . optional {?wp3 wikibase:badge ?badge_p3 .}  } 
  optional { ?wp4 schema:about ?person4 . ?wp4 schema:name ?article_p4 . ?wp4 schema:isPartOf ?wikilangs . optional {?wp4 wikibase:badge ?badge_p4 .}  } 
  optional { ?wp5 schema:about ?person5 . ?wp5 schema:name ?article_p5 . ?wp5 schema:isPartOf ?wikilangs . optional {?wp5 wikibase:badge ?badge_p5 .}  } 
  optional { ?wp6 schema:about ?person6 . ?wp6 schema:name ?article_p6 . ?wp6 schema:isPartOf ?wikilangs . optional {?wp6 wikibase:badge ?badge_p6 .}  } 
  optional { ?wp7 schema:about ?person7 . ?wp7 schema:name ?article_p7 . ?wp7 schema:isPartOf ?wikilangs . optional {?wp7 wikibase:badge ?badge_p7 .}  } 
  optional { ?wp8 schema:about ?person8 . ?wp8 schema:name ?article_p8 . ?wp8 schema:isPartOf ?wikilangs . optional {?wp8 wikibase:badge ?badge_p8 .}  } 
  optional { ?wp9 schema:about ?person9 . ?wp9 schema:name ?article_p9 . ?wp9 schema:isPartOf ?wikilangs . optional {?wp9 wikibase:badge ?badge_p9 .}  } 
  optional { ?wp10 schema:about ?person10 . ?wp10 schema:name ?article_p10 . ?wp10 schema:isPartOf ?wikilangs . optional {?wp10 wikibase:badge ?badge_p10 .}  } 
  optional { ?wp11 schema:about ?person11 . ?wp11 schema:name ?article_p11 . ?wp11 schema:isPartOf ?wikilangs . optional {?wp11 wikibase:badge ?badge_p11 .}  } 
  optional { ?wp12 schema:about ?person12 . ?wp12 schema:name ?article_p12 . ?wp12 schema:isPartOf ?wikilangs . optional {?wp12 wikibase:badge ?badge_p12 .}  } 
  optional { ?wp13 schema:about ?person13 . ?wp13 schema:name ?article_p13 . ?wp13 schema:isPartOf ?wikilangs . optional {?wp13 wikibase:badge ?badge_p13 .}  } 

   
#BIND STATEMENTS     
  bind(if(bound(?article_p2),"Yes","") as ?ap2)
  bind(if(bound(?badge_p2),if(?badge_p2=wd:Q17437798,"Good","Featured"),"") as ?bp2)
  bind(if(?bp2!="",?bp2,?ap2) as ?Judith_Leyster)                                    #put the variable name for the second selected person here
  
  bind(if(bound(?article_p3),"Yes","") as ?ap3)
  bind(if(bound(?badge_p3),if(?badge_p3=wd:Q17437798,"Good","Featured"),"") as ?bp3)
  bind(if(?bp3!="",?bp3,?ap3) as ?Sofonisba_Anguissola) 
  
   bind(if(bound(?article_p4),"Yes","") as ?ap4)
  bind(if(bound(?badge_p4),if(?badge_p4=wd:Q17437798,"Good","Featured"),"") as ?bp4)
  bind(if(?bp4!="",?bp4,?ap4) as ?Lili_Elbe)

  bind(if(bound(?article_p5),"Yes","") as ?ap5)
  bind(if(bound(?badge_p5),if(?badge_p5=wd:Q17437798,"Good","Featured"),"") as ?bp5)
  bind(if(?bp5!="",?bp5,?ap5) as ?Josefa_de_Obidos)

  bind(if(bound(?article_p6),"Yes","") as ?ap6)
  bind(if(bound(?badge_p6),if(?badge_p6=wd:Q17437798,"Good","Featured"),"") as ?bp6)
  bind(if(?bp6!="",?bp6,?ap6) as ?Maria_Wiik)
   
  bind(if(bound(?article_p7),"Yes","") as ?ap7)
  bind(if(bound(?badge_p7),if(?badge_p7=wd:Q17437798,"Good","Featured"),"") as ?bp7)
  bind(if(?bp7!="",?bp7,?ap7) as ?Hanna_Hirsch_Pauli)
   
  bind(if(bound(?article_p8),"Yes","") as ?ap8)
  bind(if(bound(?badge_p8),if(?badge_p8=wd:Q17437798,"Good","Featured"),"") as ?bp8)
  bind(if(?bp8!="",?bp8,?ap8) as ?Berthe_Morisot)

  bind(if(bound(?article_p9),"Yes","") as ?ap9)
  bind(if(bound(?badge_p9),if(?badge_p9=wd:Q17437798,"Good","Featured"),"") as ?bp9)
  bind(if(?bp9!="",?bp9,?ap9) as ?Natalia_Goncharova)
   
  bind(if(bound(?article_p10),"Yes","") as ?ap10)
  bind(if(bound(?badge_p10),if(?badge_p10=wd:Q17437798,"Good","Featured"),"") as ?bp10)
  bind(if(?bp10!="",?bp10,?ap10) as ?Anna_Ancher)  
  
  bind(if(bound(?article_p11),"Yes","") as ?ap11)
  bind(if(bound(?badge_p11),if(?badge_p11=wd:Q17437798,"Good","Featured"),"") as ?bp11)
  bind(if(?bp11!="",?bp11,?ap11) as ?Rosalba_Carriera) 
   
  bind(if(bound(?article_p12),"Yes","") as ?ap12)
  bind(if(bound(?badge_p12),if(?badge_p12=wd:Q17437798,"Good","Featured"),"") as ?bp12)
  bind(if(?bp12!="",?bp12,?ap12) as ?Maria_Sibylla_Merian)  
   
  bind(if(bound(?article_p13),"Yes","") as ?ap13)
  bind(if(bound(?badge_p13),if(?badge_p13=wd:Q17437798,"Good","Featured"),"") as ?bp13)
  bind(if(?bp13!="",?bp13,?ap13) as ?Julia_Margaret_Cameron)

 } order by ?language
