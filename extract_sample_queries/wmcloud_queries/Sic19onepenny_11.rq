           hint:Query hint:optimizer "None" .
           ?work wdt:P9622 []. {?work wdt:P4969 ?expression} UNION {?expression wdt:P144 ?work} UNION {?expression wdt:P6524 ?work}. 
                                            ?item ( wdt:P5059 | wdt:P9745 ) ?expression  .
           ?item ?p ?stmt .  ?prop wikibase:claim ?p .
           ?stmt ?v ?value. ?prop wikibase:statementProperty ?v.
           ?value wdt:P31 ?class .
        }  GROUP BY ?item ?prop ?value ?level ?rgb ?class
