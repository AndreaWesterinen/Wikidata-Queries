           hint:Query hint:optimizer "None" .
           ?work wdt:P9622 []. {?work wdt:P4969 ?item } UNION {?item  wdt:P144 ?work} UNION {?item  wdt:P6524 ?work} .  
#           ?item wdt:P9622 [] .
           ?item ?p ?stmt .  ?prop wikibase:claim ?p .
           ?stmt ?v ?value. ?prop wikibase:statementProperty ?v.
           ?value wdt:P31 ?class .
        }  GROUP BY ?item ?prop ?value ?level ?rgb ?class
    } BIND("expression" AS ?level) BIND("008000" AS ?rgb)
    } UNION {
    {
