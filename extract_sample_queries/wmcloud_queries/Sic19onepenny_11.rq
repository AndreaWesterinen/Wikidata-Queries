#SELECT ?item ?itemLabel ?level ?rgb ?prop ?propLabel ?value ?valueLabel ?class ?classLabel WHERE {
SELECT ?item ?itemLabel ?level ?rgb ?prop ?propLabel ?class ?classLabel WHERE {
#SELECT ?level ?prop ?propLabel ?class ?classLabel WHERE {
    { {
      SELECT ?item ?prop ?value ?level ?rgb ?class WHERE {
           VALUES ?p { p:P31 p:P747 p:P4969 p:P179 p:P155 p:P156 p:P144 p:P1433 p:P361 p:P941 p:P527 p:P9745 }
           hint:Query hint:optimizer "None" .
           ?item wdt:P9622 [] .
           ?item ?p ?stmt .  ?prop wikibase:claim ?p .
           ?stmt ?v ?value. ?prop wikibase:statementProperty ?v.
           ?value wdt:P31 ?class .
        }  GROUP BY ?item ?prop ?value ?level ?rgb ?class
    } BIND("work" AS ?level) BIND("ff0000" AS ?rgb)
    } UNION {
    {
         SELECT ?item ?prop ?value ?level ?rgb ?class WHERE {
           VALUES ?p { p:P31 wdt:P6524 wdt:P629 wdt:P144 wdt:P155 wdt:P941 wdt:P527 wdt:P156 wdt:P361 wdt:P1574 wdt:P1433 wdt:P2550 wdt:P4969 wdt:P747 wdt:P6166 wdt:P4330 wdt:P2860 }
           hint:Query hint:optimizer "None" .
           ?item wdt:P9622 [] .  
           ?value ?p ?item .
           ?prop wikibase:directClaim ?p .
           ?value wdt:P31 ?class .
        }  GROUP BY ?item ?prop ?value ?level ?rgb ?class
    } BIND("work" AS ?level) BIND("ff0000" AS ?rgb) 
    } UNION {
    {
      SELECT ?item ?prop ?value ?level ?rgb ?class WHERE {
