           ?value ?p ?item .
           ?prop wikibase:directClaim ?p .
           ?value wdt:P31 ?class .
        }  GROUP BY ?item ?prop ?value ?level ?rgb ?class
    } BIND("expression" AS ?level) BIND("008000" AS ?rgb)
    } UNION {
