#title: No localitzat a un municipi de Catalunya
# Complex constraint from [[Property talk:P1600]]
# element amb identificador IPAC però no localitzat a un municipi de Catalunya (o una subdivisió seva, o una subdivisió d'una subdivisió seva)
select ?item where {
  ?item wdt:P1600 [] .
  minus { ?item wdt:P131?/wdt:P131?/wdt:P131?/wdt:P31 wd:Q33146843 }
}
