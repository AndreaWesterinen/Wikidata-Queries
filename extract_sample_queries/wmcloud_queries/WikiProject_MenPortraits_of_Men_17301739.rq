SELECT DISTINCT ?item ?image WHERE {
  ?item wdt:P31 wd:Q3305213 .
  ?item wdt:P136 wd:Q134307 .
  {?item wdt:P180/wdt:P21 wd:Q6581097 .}  
  UNION                                   
  {?item wdt:P180/wdt:P279* wd:Q6581097 .} 
  ?item wdt:P571 ?date.
  ?item wdt:P18 ?image .
  FILTER((?date >= "1730-01-01T00:00:00Z"^^xsd:dateTime) && (?date <= "1739-01-01T00:00:00Z"^^xsd:dateTime))
}
