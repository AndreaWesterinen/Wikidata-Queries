SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity wdt:P31 ?grouping.
BIND(wd:Q30 AS ?country)
{
VALUES ?type {
wd:Q20857065 
wd:Q1752939
}
?entity wdt:P31 ?type; wdt:P17 ?country .
} 
MINUS { ?entity wdt:P576 [] }
MINUS { ?entity wdt:P1366 [] }
MINUS { ?entity wdt:P3999 [] } . 
  MINUS { ?entity wdt:P31 []; wdt:P31 ?grouping.
BIND(wd:Q30 AS ?country)
{
VALUES ?type {
wd:Q20857065 
wd:Q1752939
}
?entity wdt:P31 ?type; wdt:P17 ?country .
} 
MINUS { ?entity wdt:P576 [] }
MINUS { ?entity wdt:P1366 [] }
MINUS { ?entity wdt:P3999 [] }  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
