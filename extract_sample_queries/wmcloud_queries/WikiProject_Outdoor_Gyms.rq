embed.html##defaultView:Map{"hide":["?coord"], "layer": "?MapService"}
#title: Outdoor gym missing Google map identifier in wd - link Google Map
SELECT ?id ?item ?itemLabel ?itemDescription ?img ?coord ?www ?adminLabel ?OSM1 ?OSM2 ?Map ?MapService 
(IRI(CONCAT("https://www.google.com/maps/?q=", STR(?lat), ",", STR(?lon))) AS ?GoogleMap) 

WHERE {
  ?item wdt:P6104 wd:Q107186275.
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en,sv,de". }
  OPTIONAL {
    { ?item wdt:P402 ?OSMrel. }
    UNION
    { ?item wdt:P10689 ?OSMnode. }
  }
  MINUS { ?item wdt:P3749 ?GMapid. }
  OPTIONAL { ?item wdt:P18 ?img. }
  OPTIONAL { ?item wdt:P131 ?admin. }
  OPTIONAL { ?item wdt:P856 ?www. }
  ?item wdt:P625 ?coord.            
  ?item p:P625 [
            psv:P625 [
             wikibase:geoLatitude ?lat ;
             wikibase:geoLongitude ?lon ;
             wikibase:geoGlobe ?globe ;
           ]] .
  OPTIONAL { ?item wdt:P217 ?id. }
  BIND(URI(CONCAT("https://www.openstreetmap.org/", ?OSMnode)) AS ?OSM1)
  BIND(URI(CONCAT("https://www.openstreetmap.org/", ?OSMrel)) AS ?OSM2)
  BIND(URI(CONCAT("https://www.google.com/maps?cid=", ?GMapid)) AS ?Map)
  BIND(IF(BOUND(?Map), "Google", "OSM") AS ?MapService)
}
