#title: Unsuitable IMDb identifier for human
# Complex constraint from [[Property talk:P345]]
# Person with IMDb identifier but prefix is not ''nm'' or ''ch''
SELECT DISTINCT ?item WHERE { ?item wdt:P31 wd:Q5; p:P345/ps:P345 ?imdb. ?item p:P345 ?imdbStatement . ?imdbStatement wikibase:rank ?rank . FILTER(!STRSTARTS(?imdb, 'nm') && !STRSTARTS(?imdb, 'ch') && ?rank != wikibase:DeprecatedRank) }
