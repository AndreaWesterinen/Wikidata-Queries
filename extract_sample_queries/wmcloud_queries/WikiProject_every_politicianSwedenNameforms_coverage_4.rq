SELECT ?entity ?entityLabel ?entityDescription 
WHERE
{
  ?entity wdt:P39 ?position. ?position wdt:P279 wd:Q10655178 . 
  MINUS { ?entity wdt:P39 []; wdt:P39 ?position. ?position wdt:P279 wd:Q10655178  } 
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" }
}
LIMIT 1000
