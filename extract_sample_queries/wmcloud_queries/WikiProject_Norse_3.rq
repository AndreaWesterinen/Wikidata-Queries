#Items which are ultimately instances of any class which is ultimately part of Norse culture or whose culture is Norse culture.
SELECT DISTINCT ?item ?itemLabel WHERE {
  ?NorseClass wdt:P361+|wdt:P2596 wd:Q24175569 .
  ?item wdt:P31/wdt:P279* ?NorseClass .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en" . }
}
