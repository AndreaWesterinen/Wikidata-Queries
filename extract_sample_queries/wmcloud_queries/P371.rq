#Target required claim report for P371: report listing each item and value

SELECT ?item ?itemLabel ?value ?valueLabel ?snak
WHERE
{
	{
		SELECT DISTINCT ?item ?value ?snak
		WHERE
		{
			{
				?item p:P371/ps:P371 ?value .
				BIND("mainsnak" AS ?snak) .
			} UNION {
				?statement0 pq:P371 ?value .
				?item ?p0 ?statement0 .
				BIND("qualifier" AS ?snak) .
			} UNION {
				?ref pr:P371 ?value .
				?statement1 prov:wasDerivedFrom ?ref .
				?item ?p1 ?statement1 .
				BIND("reference" AS ?snak) .
			} .
			MINUS { ?value p:P21 [] } .
		} LIMIT 100
	} .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
