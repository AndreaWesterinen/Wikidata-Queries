#title: Value "Dominica" and place of birth in the "Dominican Republic"
# Complex constraint from [[Property talk:P27]]
# Possible, but likely an error. TODO: double-check, then add a reference to the P27 statement or fix P27=[[d:Q784|Dominica <small>(Q784)</small>]] -> [[d:Q786|Dominican Republic <small>(Q786)</small>]]
SELECT DISTINCT ?item 
{ 
  ?item wdt:P27 wd:Q784 .
  ?item wdt:P19/wdt:P17? wd:Q786 .
  FILTER NOT EXISTS { ?item wdt:P27 wd:Q786 }
  ?item wdt:P31 wd:Q5.
  ?item p:P27 ?claim .
  ?claim ps:P27 wd:Q784 .
  OPTIONAL { ?claim prov:wasDerivedFrom ?source . ?source ?p ?v . FILTER NOT EXISTS { ?v wdt:P31 wd:Q10876391 } } 
  FILTER(!bound(?source)) 
}
