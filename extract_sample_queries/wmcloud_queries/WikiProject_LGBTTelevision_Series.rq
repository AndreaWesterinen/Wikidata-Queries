SELECT DISTINCT ?item
{
  {
    SELECT ?item
    WHERE {
      ?item wdt:P136 wd:Q85133165
    }
  }
  UNION
  {
    SELECT ?item
    WHERE {
      ?item wdt:P921 wd:Q85133165
    }
  }
  UNION
  {
    SELECT ?item
    WHERE {
      ?item wdt:P921 wd:Q17884
    }
  }
  ?item wdt:P31/wdt:P279* wd:Q5398426.
}
