#Overview of contributions to alba amicorum of the KB 
SELECT DISTINCT 
?contribNr ?item ?itemLabel ?album ?albumLabel ?KBcatalogURL ?inventorynumber
?dateOfCreation ?placeOfCreationLabel ?LatLonOfCreation 
WHERE 
{
  VALUES ?album {wd:Q98277268 wd:Q98277046 wd:Q98277045 wd:Q98277114 wd:Q98277545 wd:Q99189800 wd:Q98277231 wd:Q98277179 wd:Q98277080 wd:Q72752496 wd:Q72752530 wd:Q98831708 wd:Q72752451 wd:Q72752427 wd:Q99973604}
  ?item  p:P31/ps:P31 wd:Q81564326 .
  ?item  p:P195/ps:P195 wd:Q1526131.
  ?item p:P361/ps:P361 ?album
  OPTIONAL {?item p:P18/ps:P18 ?image.}
  OPTIONAL {?item p:P1476/ps:P1476 ?title.}
  OPTIONAL {?item p:P217/ps:P217 ?inventorynumber.}
  OPTIONAL {?item  p:P528/ps:P528 ?catalogcode_PPN.
  OPTIONAL {?item p:P1343 [ps:P1343 wd:Q82260552; pq:P958 ?contribNr].}
  OPTIONAL {?item p:P571/ps:P571 ?dateOfCreation.}
  OPTIONAL {?item p:P1071/ps:P1071 ?placeOfCreation.
            ?placeOfCreation p:P625/ps:P625 ?LatLonOfCreation.}
  BIND(URI(CONCAT("https://resolver.kb.nl/resolve?urn=PPN:", ?catalogcode_PPN)) as ?KBcatalogURL).}
  SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en".} 
} ORDER BY ?contribNr
