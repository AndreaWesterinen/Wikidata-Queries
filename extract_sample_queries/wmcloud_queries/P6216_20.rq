SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value ?valueLabel
WHERE
{
	?item p:P6216 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P1001, wd:P580, wd:P582, wd:P275, wd:P518, wd:P50, wd:P170, wd:P459, wd:P1310, wd:P3680, wd:P3893, wd:P1480, wd:P577, wd:P3014, wd:P1932, wd:P1433, wd:P98, wd:P2241, wd:P7452, wd:P6305, wd:P1319, wd:P8554, wd:P8555, wd:P1326, wd:P144, wd:P2868, wd:P9905, wd:P5102 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
