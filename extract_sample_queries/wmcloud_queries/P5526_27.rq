SELECT ?item ?itemLabel ?prop ?propLabel ?rank ?value 
WHERE
{
	?item p:P5526 [ ?pq ?value; wikibase:rank ?rank ] .
	?prop wikibase:qualifier ?pq .
	FILTER( ?prop NOT IN ( wd:P1013, wd:P1683, wd:P2241, wd:P5102, wd:P5830, wd:P805, wd:P2868, wd:P5980, wd:P3831, wd:P5548, wd:P9971, wd:P5713 ) ) .
	SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
LIMIT 100
