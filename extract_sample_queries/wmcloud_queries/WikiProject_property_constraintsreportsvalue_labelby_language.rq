SELECT *
{
SELECT ?item ?lang (COUNT(DISTINCT ?prop) as ?count) (SAMPLE(CONCAT("<code><","nowiki>",?t,"</","nowiki></code>")) as ?sample) (SAMPLE((CONCAT("[[Property:",strafter(str(?prop),"y/"),"#P1552","|",strafter(str(?prop),"y/"),"]]"))) as ?propsample)
WHERE
{
	hint:Query hint:optimizer "None".
	?prop p:P1552 [ ps:P1552 wd:Q100884525 ; pq:P8770 ?t ] .
    BIND(lang(?t) as ?lang)
	?item wdt:P424 ?lang ; wdt:P305 [] .
}
GROUP BY ?item ?lang 
}              
ORDER BY DESC(?count) ?lang
