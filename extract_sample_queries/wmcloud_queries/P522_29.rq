SELECT ?item ?itemLabel ?value ?valueLabel ?snak ?rank ?statement
WHERE
{
  {
    SELECT ?item ?value ?result ?snak ?rank ?statement WHERE {
      {
        ?item p:P522 ?statement .
        ?statement ps:P522 ?value; wikibase:rank ?rank .
        BIND("mainsnak" AS ?snak) .
      } UNION {
        ?statement pq:P522 ?value; wikibase:rank ?rank .
        ?item ?p1 ?statement .
        BIND("qualifier" AS ?snak) .
      } UNION {
        ?ref pr:P522 ?value .
        ?statement prov:wasDerivedFrom ?ref; wikibase:rank ?rank .
        ?item ?p2 ?statement .
        BIND("reference" AS ?snak) .
      } .
      FILTER( ?value NOT IN ( wd:Q663611, wd:Q218414, wd:Q218056, wd:Q192316, wd:Q472251, wd:Q746711, wd:Q1138649, wd:Q174241, wd:Q737809, wd:Q38982, wd:Q1133479, wd:Q210448, wd:Q3884965, wd:Q97359969, wd:Q7834023, wd:Q1436769, wd:Q3884961, wd:Q53865977 ) ) .
    } LIMIT 100
  } .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en" } .
}
