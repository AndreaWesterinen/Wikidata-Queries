PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  schema: <http://schema.org/>
PREFIX  skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT  ?item ?label ?description ?alternate
WHERE
  { ?item  wdt:P31  wd:Q2031121
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "de" )
      }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "en" )
      }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "mul" )
      }
    BIND(if(bound(?item__label_value), str(?item__label_value), strafter(str(?item), "entity/")) AS ?label)
    OPTIONAL
      { ?item  schema:description  ?item__description_value
        FILTER ( lang(?item__description_value) = "de" )
      }
    OPTIONAL
      { ?item  schema:description  ?item__description_value
        FILTER ( lang(?item__description_value) = "en" )
      }
    BIND(str(?item__description_value) AS ?description)
    OPTIONAL
      { SELECT  ?item (GROUP_CONCAT(DISTINCT ?item__alias_value ; separator=', ') AS ?alternate)
        WHERE
          { { SELECT DISTINCT  ?item
              WHERE
                { ?item  wdt:P31  wd:Q2031121 }
            }
            ?item  skos:altLabel  ?item__alias_value
            FILTER ( lang(?item__alias_value) = "de" )
          }
        GROUP BY ?item
      }
    OPTIONAL
      { SELECT  ?item (GROUP_CONCAT(DISTINCT ?item__alias_value ; separator=', ') AS ?alternate)
        WHERE
          { { SELECT DISTINCT  ?item
              WHERE
                { ?item  wdt:P31  wd:Q2031121 }
            }
            ?item  skos:altLabel  ?item__alias_value
            FILTER ( lang(?item__alias_value) = "en" )
          }
        GROUP BY ?item
      }
    OPTIONAL
      { SELECT  ?item (GROUP_CONCAT(DISTINCT ?item__alias_value ; separator=', ') AS ?alternate)
        WHERE
          { { SELECT DISTINCT  ?item
              WHERE
                { ?item  wdt:P31  wd:Q2031121 }
            }
            ?item  skos:altLabel  ?item__alias_value
            FILTER ( lang(?item__alias_value) = "mul" )
          }
        GROUP BY ?item
      }
  }
