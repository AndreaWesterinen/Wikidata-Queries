PREFIX bd: <http://www.bigdata.com/rdf#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>

SELECT ?item ?label ?description ?alternate
       ?item__label_subject ?item__label_value
       ?item__description_value ?item__alias_value
WHERE {
  ?item wdt:P31 wd:Q515 .
  BIND("occupied subject" AS ?item__label_subject)
  BIND("occupied label" AS ?item__label_value)
  BIND("occupied description" AS ?item__description_value)
  BIND("occupied alias" AS ?item__alias_value)
  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "de,en" .
    ?item rdfs:label ?label .
    ?item schema:description ?description .
    ?item skos:altLabel ?alternate .
  }
}
