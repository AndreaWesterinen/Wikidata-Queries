PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT  ?item ?itemLabel ?itemDescription ?itemAltLabel
WHERE
  { ?item  wdt:P31  wd:Q515
    OPTIONAL
      { ?item  <http://www.w3.org/2000/01/rdf-schema#label>  ?item__label_value
        FILTER ( lang(?item__label_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?item  <http://www.w3.org/2000/01/rdf-schema#label>  ?item__label_value
        FILTER ( lang(?item__label_value) = "de" )
      }
    OPTIONAL
      { ?item  <http://www.w3.org/2000/01/rdf-schema#label>  ?item__label_value
        FILTER ( lang(?item__label_value) = "en" )
      }
    OPTIONAL
      { ?item  <http://www.w3.org/2000/01/rdf-schema#label>  ?item__label_value
        FILTER ( lang(?item__label_value) = "mul" )
      }
    BIND(if(bound(?item__label_value), str(?item__label_value), strafter(str(?item), "entity/")) AS ?itemLabel)
    OPTIONAL
      { ?item  <http://schema.org/description>  ?item__description_value
        FILTER ( lang(?item__description_value) = "[AUTO_LANGUAGE]" )
      }
    OPTIONAL
      { ?item  <http://schema.org/description>  ?item__description_value
        FILTER ( lang(?item__description_value) = "de" )
      }
    OPTIONAL
      { ?item  <http://schema.org/description>  ?item__description_value
        FILTER ( lang(?item__description_value) = "en" )
      }
    BIND(str(?item__description_value) AS ?itemDescription)
    OPTIONAL
      { SELECT  ?item (GROUP_CONCAT(DISTINCT ?item__alias_value ; separator=', ') AS ?itemAltLabel)
        WHERE
          { { SELECT DISTINCT  ?item
              WHERE
                { ?item  wdt:P31  wd:Q515 }
            }
            ?item  <http://www.w3.org/2004/02/skos/core#altLabel>  ?item__alias_value
            FILTER ( lang(?item__alias_value) = "[AUTO_LANGUAGE]" )
          }
        GROUP BY ?item
      }
    OPTIONAL
      { SELECT  ?item (GROUP_CONCAT(DISTINCT ?item__alias_value ; separator=', ') AS ?itemAltLabel)
        WHERE
          { { SELECT DISTINCT  ?item
              WHERE
                { ?item  wdt:P31  wd:Q515 }
            }
            ?item  <http://www.w3.org/2004/02/skos/core#altLabel>  ?item__alias_value
            FILTER ( lang(?item__alias_value) = "de" )
          }
        GROUP BY ?item
      }
    OPTIONAL
      { SELECT  ?item (GROUP_CONCAT(DISTINCT ?item__alias_value ; separator=', ') AS ?itemAltLabel)
        WHERE
          { { SELECT DISTINCT  ?item
              WHERE
                { ?item  wdt:P31  wd:Q515 }
            }
            ?item  <http://www.w3.org/2004/02/skos/core#altLabel>  ?item__alias_value
            FILTER ( lang(?item__alias_value) = "en" )
          }
        GROUP BY ?item
      }
    OPTIONAL
      { SELECT  ?item (GROUP_CONCAT(DISTINCT ?item__alias_value ; separator=', ') AS ?itemAltLabel)
        WHERE
          { { SELECT DISTINCT  ?item
              WHERE
                { ?item  wdt:P31  wd:Q515 }
            }
            ?item  <http://www.w3.org/2004/02/skos/core#altLabel>  ?item__alias_value
            FILTER ( lang(?item__alias_value) = "mul" )
          }
        GROUP BY ?item
      }
  }
