PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wikibase: <http://wikiba.se/ontology#>

SELECT  ?itemLabel ?propertyLabel
WHERE
  { OPTIONAL
      { wd:Q999999999
                  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "zz" )
      }
    OPTIONAL
      { wd:Q999999999
                  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "mul" )
      }
    BIND(if(bound(?item__label_value), str(?item__label_value), strafter(str(wd:Q999999999), "entity/")) AS ?itemLabel)
    OPTIONAL
      { wd:P999999999
                  rdfs:label  ?property__label_value
        FILTER ( lang(?property__label_value) = "zz" )
      }
    OPTIONAL
      { wd:P999999999
                  rdfs:label  ?property__label_value
        FILTER ( lang(?property__label_value) = "mul" )
      }
    BIND(if(bound(?property__label_value), str(?property__label_value), strafter(str(wd:P999999999), "entity/")) AS ?propertyLabel)
  }
