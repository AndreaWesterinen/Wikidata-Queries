PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT  ?item ?iLabel ?country ?countryLabel
WHERE
  { ?item  wdt:P31  wd:Q515 ;
           wdt:P17  ?country
    OPTIONAL
      { ?item  <http://www.w3.org/2000/01/rdf-schema#label>  ?item__label_value
        FILTER ( lang(?item__label_value) = "de" )
      }
    OPTIONAL
      { ?item  <http://www.w3.org/2000/01/rdf-schema#label>  ?item__label_value
        FILTER ( lang(?item__label_value) = "mul" )
      }
    BIND(if(bound(?item__label_value), str(?item__label_value), strafter(str(?item), "entity/")) AS ?iLabel)
    { SELECT  ?country ?countryLabel
      WHERE
        { ?country  wdt:P31  wd:Q6256
          OPTIONAL
            { ?country  <http://www.w3.org/2000/01/rdf-schema#label>  ?country__label_value
              FILTER ( lang(?country__label_value) = "en" )
            }
          OPTIONAL
            { ?country  <http://www.w3.org/2000/01/rdf-schema#label>  ?country__label_value
              FILTER ( lang(?country__label_value) = "mul" )
            }
          BIND(if(bound(?country__label_value), str(?country__label_value), strafter(str(?country), "entity/")) AS ?countryLabel)
        }
      LIMIT   1
    }
  }
