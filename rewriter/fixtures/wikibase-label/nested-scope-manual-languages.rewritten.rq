PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>

SELECT  ?item ?outerLabel ?country ?innerLabel
WHERE
  { ?item  wdt:P31  wd:Q2031121
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "de" )
      }
    OPTIONAL
      { ?item  rdfs:label  ?item__label_value
        FILTER ( lang(?item__label_value) = "mul" )
      }
    BIND(if(bound(?item__label_value), str(?item__label_value), strafter(str(?item), "entity/")) AS ?outerLabel)
    { SELECT  ?country ?innerLabel
      WHERE
        { ?country  wdt:P31  wd:Q6256
          OPTIONAL
            { ?country  rdfs:label  ?country__label_value
              FILTER ( lang(?country__label_value) = "en" )
            }
          OPTIONAL
            { ?country  rdfs:label  ?country__label_value
              FILTER ( lang(?country__label_value) = "mul" )
            }
          BIND(if(bound(?country__label_value), str(?country__label_value), strafter(str(?country), "entity/")) AS ?innerLabel)
        }
      LIMIT   1
    }
  }
