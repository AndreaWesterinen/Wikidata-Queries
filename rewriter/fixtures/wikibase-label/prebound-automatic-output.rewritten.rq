PREFIX  wd:   <http://www.wikidata.org/entity/>

SELECT  ?item ?itemLabel
WHERE
  { VALUES ( ?item ?itemLabel ) {
      ( wd:Q42 "sentinel" )
      ( wd:Q1 UNDEF )
    }
    OPTIONAL
      { SELECT  ?item ?itemLabel
        WHERE
          { { SELECT DISTINCT  ?item
              WHERE
                { VALUES ( ?item ?itemLabel ) {
                    ( wd:Q42 "sentinel" )
                    ( wd:Q1 UNDEF )
                  }
                }
            }
            OPTIONAL
              { ?item  <http://www.w3.org/2000/01/rdf-schema#label>  ?item__label_value
                FILTER ( lang(?item__label_value) = "en" )
              }
            OPTIONAL
              { ?item  <http://www.w3.org/2000/01/rdf-schema#label>  ?item__label_value
                FILTER ( lang(?item__label_value) = "mul" )
              }
            BIND(if(bound(?item__label_value), str(?item__label_value), strafter(str(?item), "entity/")) AS ?itemLabel)
          }
      }
  }
