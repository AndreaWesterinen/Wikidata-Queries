PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>
PREFIX  wikibase: <http://wikiba.se/ontology#>

SELECT  ?a ?aLabel ?b ?bLabel
WHERE
  { ?a  wdt:P31   wd:Q5 ;
        wdt:P106  wd:Q252924
    OPTIONAL
      { ?a  wdt:P25  ?b }
    OPTIONAL
      { ?a  <http://www.w3.org/2000/01/rdf-schema#label>  ?a__label_value
        FILTER ( lang(?a__label_value) = "en" )
      }
    OPTIONAL
      { ?a  <http://www.w3.org/2000/01/rdf-schema#label>  ?a__label_value
        FILTER ( lang(?a__label_value) = "mul" )
      }
    BIND(if(bound(?a__label_value), str(?a__label_value), strafter(str(?a), "entity/")) AS ?aLabel)
    BIND(if(bound(?b), ?b, "unbound") AS ?b__label_subject)
    OPTIONAL
      { ?b__label_subject
                  <http://www.w3.org/2000/01/rdf-schema#label>  ?b__label_value
        FILTER ( lang(?b__label_value) = "en" )
      }
    OPTIONAL
      { ?b__label_subject
                  <http://www.w3.org/2000/01/rdf-schema#label>  ?b__label_value
        FILTER ( lang(?b__label_value) = "mul" )
      }
    BIND(if(bound(?b__label_value), str(?b__label_value), strafter(str(?b), "entity/")) AS ?bLabel)
  }
