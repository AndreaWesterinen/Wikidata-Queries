PREFIX  skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX  wd:   <http://www.wikidata.org/entity/>
PREFIX  wdt:  <http://www.wikidata.org/prop/direct/>
PREFIX  wikibase: <http://wikiba.se/ontology#>

SELECT  ?item ?aliases
WHERE
  { ?item  wdt:P31  wd:Q515
    OPTIONAL
      { SELECT  ?item (GROUP_CONCAT(DISTINCT ?item__alias_value ; separator=', ') AS ?aliases)
        WHERE
          { { SELECT DISTINCT  ?item
              WHERE
                { ?item  wdt:P31  wd:Q515 }
            }
            ?item  skos:altLabel  ?item__alias_value
            FILTER ( lang(?item__alias_value) = "de" )
          }
        GROUP BY ?item
      }
    OPTIONAL
      { SELECT  ?item (GROUP_CONCAT(DISTINCT ?item__alias_value ; separator=', ') AS ?aliases)
        WHERE
          { { SELECT DISTINCT  ?item
              WHERE
                { ?item  wdt:P31  wd:Q515 }
            }
            ?item  skos:altLabel  ?item__alias_value
            FILTER ( lang(?item__alias_value) = "en" )
          }
        GROUP BY ?item
      }
    OPTIONAL
      { SELECT  ?item (GROUP_CONCAT(DISTINCT ?item__alias_value ; separator=', ') AS ?aliases)
        WHERE
          { { SELECT DISTINCT  ?item
              WHERE
                { ?item  wdt:P31  wd:Q515 }
            }
            ?item  skos:altLabel  ?item__alias_value
            FILTER ( lang(?item__alias_value) = "mul" )
          }
        GROUP BY ?item
      }
  }
