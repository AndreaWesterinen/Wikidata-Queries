PREFIX engineHint: <http://www.bigdata.com/queryHints#>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>

SELECT ?item WHERE {
  engineHint:Query engineHint:optimizer "None" ;
                   engineHint:analytic false .
  ?item wdt:P31 wd:Q2031121 .
  <http://www.bigdata.com/queryHints#Prior> engineHint:runFirst true .
  engineHint:Group engineHint:optimizer "Runtime" .
  engineHint:GroupAndSubGroups engineHint:analytic true .
  {
    SELECT ?item WHERE {
      engineHint:SubQuery engineHint:optimizer "None" .
      ?item wdt:P31 wd:Q2031121 .
    }
  }
}
